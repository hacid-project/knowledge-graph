    <!-- http://sweetontology.net/humanEnvirControl/WellInjection -->

    <owl:Class rdf:about="http://sweetontology.net/humanEnvirControl/WellInjection">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/humanEnvirControl/EnvironmentalControlStrategy"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sohueccont:WellInjection</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The subsurface emplacement of ‘fluids’ through a bored, drilled, or driven ‘well’, or through a dug well, where the depth of the dug well is greater than the largest surface dimension.</rdfs:comment>
        <rdfs:label xml:lang="en">well injection</rdfs:label>
    </owl:Class>
    


