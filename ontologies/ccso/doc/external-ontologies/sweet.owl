        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenMixing/Diffusion"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophm:EddyDiffusion</metadata:prefixIRI>
        <rdfs:label xml:lang="en">eddy diffusion</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenMixing/Entrainment -->

    <owl:Class rdf:about="http://sweetontology.net/phenMixing/Entrainment">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procPhysical/PhysicalProcess"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenMixing/Mixing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophm:Entrainment</metadata:prefixIRI>
        <rdfs:label xml:lang="en">entrainment</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenMixing/FickianDiffusion -->

    <owl:Class rdf:about="http://sweetontology.net/phenMixing/FickianDiffusion">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenMixing/Diffuse"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenMixing/Diffusion"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophm:FickianDiffusion</metadata:prefixIRI>
        <rdfs:label xml:lang="en">fickian diffusion</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenMixing/Mix -->

