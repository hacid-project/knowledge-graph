<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/hacid/onto/top-level#"
     xml:base="https://w3id.org/hacid/onto/top-level"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:dcterms="http://purl.org/dc/terms/"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#">
    <owl:Ontology rdf:about="https://w3id.org/hacid/onto/top-level">
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <prov:wasDerivedFrom rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl"/>
        <rdfs:comment xml:lang="en">The HACID top-level ontology. It replicates, in the HACID namespace, part of DOLCE+DnS Ultralite (DUL), and extends it with terms shared by the HACID ontology modules. The correspondence between replicated terms and DUL terms is formalised in https://github.com/hacid-project/knowledge-graph/blob/main/ontologies/top-level/alignment/top-level-dul-alignment.ttl; for replicated terms, rdfs:comment gives the DUL definition and skos:scopeNote gives HACID-specific notes.</rdfs:comment>
        <rdfs:label xml:lang="en">HACID top-level ontology</rdfs:label>
    </owl:Ontology>
    


    <!--
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->




    <!-- http://purl.org/dc/terms/license -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://www.w3.org/ns/prov#wasDerivedFrom -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#wasDerivedFrom"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#scopeNote -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#scopeNote"/>



    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/hacid/onto/top-level/associatedWith -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/associatedWith">
        <rdfs:comment xml:lang="it">Una proprietà generica (catch-all), utile per l&apos;allineamento e l&apos;interrogazione.
È dichiarata sia transitiva sia simmetrica, per ragionare su una chiusura massimale delle associazioni tra individui.</rdfs:comment>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:comment xml:lang="en">A catch-all object property, useful for alignment and querying purposes.
It is declared as both transitive and symmetric, in order to reason an a maximal closure of associations between individuals.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">associated with</rdfs:label>
        <rdfs:label xml:lang="it">associato a</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/atTime -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/atTime">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/isTimeOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/TemporalEntity"/>
        <rdfs:comment xml:lang="it">La relazione esistente tra una qualsiasi entità ed un&apos;entità temporale.</rdfs:comment>
        <rdfs:comment xml:lang="en">The relation holding between an entity ad a temporal entity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">al tempo</rdfs:label>
        <rdfs:label xml:lang="en">at time</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/classifies -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/classifies">
        <rdfs:comment xml:lang="it">Una relazione tra un Concept e un&apos;Entity, ad es. il Role &apos;studente&apos; classifica una Person &apos;John&apos;.</rdfs:comment>
        <rdfs:comment xml:lang="en">A relation between a Concept and an Entity, e.g. the Role &apos;student&apos; classifies a Person &apos;John&apos;.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/isClassifiedBy"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Concept"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <skos:scopeNote xml:lang="it">La proprietà utilizzata per affermare che un concetto classificava una certa entità.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">The property used to state that a concept classified a certain entity.</skos:scopeNote>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">classifica</rdfs:label>
        <rdfs:label xml:lang="en">classifies</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/defines -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/defines">
        <rdfs:comment xml:lang="it">Una relazione tra una Description e un Concept, ad es. un Workflow per un&apos;Organization governativa definisce il Role &apos;funzionario&apos;, oppure &apos;il Codice della strada italiano definisce il ruolo Veicolo&apos;.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/usesConcept"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/isDefinedIn"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Description"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Concept"/>
        <rdfs:comment xml:lang="en">A relation between a Description and a Concept, e.g. a Workflow for a governmental Organization defines the Role &apos;officer&apos;, or &apos;the Italian Traffic Law defines the role Vehicle&apos;.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">defines</rdfs:label>
        <rdfs:label xml:lang="it">definisce</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/definesRole -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/definesRole">
        <rdfs:comment xml:lang="it">Una relazione tra una descrizione e un ruolo, ad es. la ricetta di una torta definisce il ruolo &apos;ingrediente&apos;.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/defines"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/isRoleDefinedIn"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Description"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Role"/>
        <rdfs:comment xml:lang="en">A relation between a description and a role, e.g. the recipe for a cake defines the role &apos;ingredient&apos;.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">defines role</rdfs:label>
        <rdfs:label xml:lang="it">definisce il ruolo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/definesTask -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/definesTask">
        <rdfs:comment xml:lang="it">Una relazione tra una descrizione e un task, ad es. la ricetta di una torta definisce il task &apos;bollire&apos;.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/defines"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/isTaskDefinedIn"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Description"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Task"/>
        <rdfs:comment xml:lang="en">A relation between a description and a task, e.g. the recipe for a cake defines the task &apos;boil&apos;.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">defines task</rdfs:label>
        <rdfs:label xml:lang="it">definisce il task</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/describes -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/describes">
        <rdfs:comment xml:lang="it">La relazione tra una Description e un&apos;Entity: una Description dà unità a una Collection di parti (i componenti), o di costituenti, assegnando un Role a ciascuno di essi nel contesto di un Object complessivo (il sistema).
A una stessa Entity si possono dare descrizioni diverse: ad esempio, a una vecchia culla si può dare una Description unificante basata sul design estetico originale, sulla funzionalità per cui è stata costruita, o su una nuova funzionalità estetica in cui può essere usata come vaso da fiori.</rdfs:comment>
        <rdfs:comment xml:lang="en">The relation between a Description and an Entity : a Description gives a unity to a Collection of parts (the components), or constituents, by assigning a Role to each of them in the context of a whole Object (the system).
A same Entity can be given different descriptions, for example, an old cradle can be given a unifying Description based on the original aesthetic design, the functionality it was built for, or a new aesthetic functionality in which it can be used as a flower pot.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/isDescribedBy"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Description"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <skos:scopeNote xml:lang="it">La realazione per associare una descrizione all&apos;entità oggetto di tale descrizione.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">The relation for associating a description with the entity being described.</skos:scopeNote>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">descrive</rdfs:label>
        <rdfs:label xml:lang="en">describes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/directlyFollows -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/directlyFollows">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/follows"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/directlyPrecedes"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:comment xml:lang="it">L&apos;intransitivo segue la relazione. Ad esempio, il martedì segue direttamente il lunedì. L&apos;immediatezza della precedenza dipende dalla concettualizzazione del progettista.</rdfs:comment>
        <rdfs:comment xml:lang="en">The intransitive follows relation. For example, Tuesday directly follows Monday. Directness of precedence depends on the designer conceptualization.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">directly follows</rdfs:label>
        <rdfs:label xml:lang="it">segue direttamente</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/directlyPrecedes -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/directlyPrecedes">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/precedes"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:comment xml:lang="it">L&apos;intransitivo precede la relazione. Ad esempio, il lunedì precede direttamente il martedì. L&apos;immediatezza della precedenza dipende dalla concettualizzazione del progettista.</rdfs:comment>
        <rdfs:comment xml:lang="en">The intransitive precedes relation. For example, Monday directly precedes Tuesday. Directness of precedence depends on the designer conceptualization.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">directly precedes</rdfs:label>
        <rdfs:label xml:lang="it">precede direttamente</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/executesTask -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/executesTask">
        <rdfs:comment xml:lang="it">Una relazione tra un&apos;azione e un task, ad es. &apos;mettere dell&apos;acqua in una pentola e mettere la pentola sul fuoco finché l&apos;acqua comincia a bollire&apos; esegue il task &apos;bollire&apos;.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/isClassifiedBy"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/isExecutedIn"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Action"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Task"/>
        <rdfs:comment xml:lang="en">A relation between an action and a task, e.g. &apos;putting some water in a pot and putting the pot on a fire until the water starts bubbling&apos; executes the task &apos;boiling&apos;.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">esegue il task</rdfs:label>
        <rdfs:label xml:lang="en">executes task</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/follows -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/follows">
        <rdfs:comment xml:lang="en">A relation between entities, expressing a &apos;sequence&apos; schema. 
E.g. &apos;year 2000 follows 1999&apos;, &apos;preparing coffee&apos; follows &apos;deciding what coffee to use&apos;, &apos;II World War follows I World War&apos;, etc. 
It can be used between tasks, processes or time intervals, and subproperties would fit best in order to distinguish the different uses.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/precedes"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:comment xml:lang="it">Una relazione tra entità, che esprime uno schema di &apos;sequenza&apos;.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">follows</rdfs:label>
        <rdfs:label xml:lang="it">segue</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/hasApproximateRegion -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/hasApproximateRegion">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/hasRegion"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/isApproximateRegionFor"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Region"/>
        <rdfs:comment xml:lang="en">A relation between an entity and a region representing an approximate quantification of some aspect/quality of that entity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">has approximate region</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/hasAssignedRole -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/hasAssignedRole">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/isAssignedRoleIn"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/ObjectRoleAssignment"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Role"/>
        <rdfs:comment xml:lang="en">Associates the assignment with the assigned role.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">has assigned role</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/hasAssigneeObject -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/hasAssigneeObject">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/isAssigneeObjectIn"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/ObjectRoleAssignment"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Object"/>
        <rdfs:comment xml:lang="en">Associates the assignment with the object to which the corresponding role is assigned.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">has assignee object</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/hasBroader -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/hasBroader">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/hasNarrower"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Concept"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Concept"/>
        <rdfs:comment xml:lang="it">La relazione per creare tassonomie di concetti dal più specifico al più generale.</rdfs:comment>
        <rdfs:comment xml:lang="en">The relation for creating hierarchies of concepts from the most specific to the most general.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">ha più generale</rdfs:label>
        <rdfs:label xml:lang="en">has broader</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/hasCharacteristic -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/hasCharacteristic">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/isCharacteristicOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Characteristic"/>
        <rdfs:comment xml:lang="it">La relazione di primo livello che intercorre tra un&apos;entità e una delle sue caratteristiche.</rdfs:comment>
        <rdfs:comment xml:lang="en">The top-level relation holding between an entity and one of its characteristics.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">ha caratteristica</rdfs:label>
        <rdfs:label xml:lang="en">has characteristic</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/hasCollection -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/hasCollection">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/isCollectionOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Collection"/>
        <rdfs:comment xml:lang="it">La relazione esistente tra un&apos;entità ed una collezione.</rdfs:comment>
        <rdfs:comment xml:lang="en">The relation holding between an entity and a collection.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">ha collezione</rdfs:label>
        <rdfs:label xml:lang="en">has collection</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/hasComponent -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/hasComponent">
        <rdfs:comment xml:lang="it">La relazione hasProperPart senza transitività, tra un Object (il sistema) e un altro (il componente), che presuppone un Design che struttura l&apos;Object.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/hasProperPart"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/isComponentOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:comment>The hasProperPart relation without transitivity, holding between an Object (the system) and another (the component), and assuming a Design that structures the Object.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">ha componente</rdfs:label>
        <rdfs:label xml:lang="en">has component</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/hasConstituent -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/hasConstituent">
        <rdfs:comment xml:lang="it">La &apos;costituzione&apos; dipende da una stratificazione del mondo descritto dall&apos;ontologia. Ad esempio, le granularità scientifiche (ad es. corpo-organo-tessuto-cellula) o gli &apos;strati&apos; ontologici (ad es. sociale-mentale-biologico-fisico) sono stratificazioni tipiche.
Intuitivamente, un costituente è una parte che appartiene a uno strato inferiore. Poiché la stratificazione è in realtà una partizione del mondo descritto dall&apos;ontologia, i costituenti non sono propriamente classificati come parti, sebbene questa affinità possa essere intuitiva per il senso comune.
Un vantaggio di questa distinzione è che si può parlare, ad es., di costituenti fisici di oggetti non fisici (ad es. sistemi), cosa non possibile in termini di parti.
Esempi sono le persone che costituiscono un sistema sociale, le molecole che costituiscono una persona, gli atomi che costituiscono un fiume, ecc.
In tutti questi esempi si nota una tipica discontinuità tra l&apos;oggetto costituito e il costituente: ad es. un sistema sociale è concettualizzato a uno strato diverso da quello delle persone che lo costituiscono, una persona a uno strato diverso da quello delle molecole che la costituiscono, e un fiume a uno strato diverso da quello degli atomi che lo costituiscono.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/isConstituentOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:comment>&apos;Constituency&apos; depends on some layering of  the world described by the ontology. For example, scientific granularities (e.g. body-organ-tissue-cell) or ontological &apos;strata&apos; (e.g. social-mental-biological-physical) are  typical layerings. 
Intuitively, a constituent is a part belonging to a lower layer. Since layering is actually a partition of the world described by the ontology, constituents are not properly classified as parts, although this kinship can be intuitive for common sense.
A desirable advantage of this distinction is that we are able to talk e.g. of physical constituents of non-physical objects (e.g. systems), while this is not possible in terms of parts.
Example of are the persons constituting a social system, the molecules constituting a person, the atoms constituting a river, etc. 
In all these examples, we notice a typical discontinuity between the constituted and the constituent object: e.g. a social system is conceptualized at a different layer from the persons that constitute it, a person is conceptualized at a different layer from the molecules that constitute them, and a river is conceptualized at a different layer from the atoms that constitute it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">ha costituente</rdfs:label>
        <rdfs:label xml:lang="en">has constituent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/hasCreator -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/hasCreator">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/isCreatorOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:comment xml:lang="it">Relazione per associare ad un&apos;entità un agente creatore.</rdfs:comment>
        <rdfs:comment xml:lang="en">The relation for associating an entity to an agent being the creator.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">ha creatore</rdfs:label>
        <rdfs:label xml:lang="en">has creator</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/hasDescription -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/hasDescription">
        <owl:equivalentProperty rdf:resource="https://w3id.org/hacid/onto/top-level/isDescribedBy"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/isDescriptionOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Description"/>
        <rdfs:comment xml:lang="en">Property that associates an entity with its description.</rdfs:comment>
        <rdfs:comment xml:lang="it">Proprietà che associa un&apos;entità alla sua descrizione.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">ha descrizione</rdfs:label>
        <rdfs:label xml:lang="en">has description</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/hasEventuality -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/hasEventuality">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/hasSetting"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/isEventualityOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Situation"/>
        <rdfs:comment xml:lang="it">La relazione esistente tra una qualsiasi entità ed una di tipo Eventualità.</rdfs:comment>
        <rdfs:comment xml:lang="en">The relationship existing between any entity and another typed as Eventuality.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">ha eventualità</rdfs:label>
        <rdfs:label xml:lang="en">has eventuality</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/hasExactRegion -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/hasExactRegion">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/hasRegion"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/isExactRegionFor"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Region"/>
        <rdfs:comment xml:lang="en">A relation between an entity and a region representing an exact quantification of some aspect/quality of that entity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">has exact region</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/hasExpectedType -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/hasExpectedType">
        <rdfs:comment xml:lang="en">Constraint not expressible in OWL 2 DL (stated here, not axiomatised): the object of this property is a class (an instance of rdfs:Class, typically an owl:Class used as an individual through OWL 2 punning).</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/isExpectedTypeOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/InformationRole"/>
        <rdfs:comment xml:lang="en">A relation between information roles and their expected types, expressed RDFS/OWL classes.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">has expected type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/hasIdentifierSchema -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/hasIdentifierSchema">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/hasDescription"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/isIdentifierSchemaOf"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/IdentifierSchema"/>
        <rdfs:comment xml:lang="it">La relazione che lega un identificativo unico al suo schema di definizione.</rdfs:comment>
        <rdfs:comment xml:lang="en">The relation that associates a unique identifier to its defining schema.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">ha schema di identificazione</rdfs:label>
        <rdfs:label xml:lang="en">has identifier schema</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/hasInputRole -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/hasInputRole">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/isInputRoleOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Task"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Role"/>
        <rdfs:comment xml:lang="en">Associates a task with roles that are expected to be fulfilled by objects consumed by any action executing the task.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">has input role</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/hasLocation -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/hasLocation">
        <rdfs:comment xml:lang="en">A generic, relative spatial location, holding between any entities. E.g. &apos;the cat is on the mat&apos;, &apos;Omar is in Samarcanda&apos;, &apos;the wound is close to the femural artery&apos;.
For &apos;absolute&apos; locations, see SpaceRegion</rdfs:comment>
        <rdfs:comment xml:lang="it">Una localizzazione generica e relativa, tra entità qualsiasi. Ad es. &apos;il gatto è sul tappeto&apos;, &apos;Omar è a Samarcanda&apos;, &apos;la ferita è vicina all&apos;arteria femorale&apos;.
Per localizzazioni &apos;assolute&apos;, vedere SpaceRegion.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/isLocationOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">ha localizzazione</rdfs:label>
        <rdfs:label xml:lang="en">has location</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/hasLowerBoundary -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/hasLowerBoundary">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/isLowerBoundaryOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Interval"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Region"/>
        <rdfs:comment xml:lang="en">The relation between an Interval and the Region that is its lower boundary. In the linear case the lower boundary is the point where the interval begins, e.g. the start of a time interval or the minimum of a range of values; in a multi-dimensional space ordered component-wise it is the corner whose coordinates are all minimal, e.g. the south-west corner of a latitude-longitude bounding box.</rdfs:comment>
        <rdfs:comment xml:lang="it">La relazione tra un Interval e la Region che ne costituisce l&apos;estremo inferiore. Nel caso lineare l&apos;estremo inferiore è il punto in cui l&apos;intervallo inizia, ad es. l&apos;inizio di un intervallo di tempo o il minimo di un intervallo di valori; in uno spazio multidimensionale ordinato componente per componente è il vertice con tutte le coordinate minime, ad es. il vertice sud-ovest di un riquadro di latitudine e longitudine.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">has lower boundary</rdfs:label>
        <rdfs:label xml:lang="it">ha estremo inferiore</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/hasMember -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/hasMember">
        <rdfs:comment xml:lang="it">Una relazione tra collezioni ed entità, ad es. &apos;la mia collezione di sassofoni include un vecchio contralto originale Adolphe Sax&apos; (cioè la mia collezione ha come membro un contralto Adolphe Sax).</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/isCollectionOf"/>
        <rdfs:comment xml:lang="en">A relation between collections and entities, e.g. &apos;my collection of saxophones includes an old Adolphe Sax original alto&apos; (i.e. my collection has member an Adolphe Sax alto).</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/isMemberOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Collection"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <skos:scopeNote xml:lang="it">La relazione di membership.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">The membership relation.</skos:scopeNote>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">ha membro</rdfs:label>
        <rdfs:label xml:lang="en">has member</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/hasNarrower -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/hasNarrower">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Concept"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Concept"/>
        <rdfs:comment xml:lang="it">La relazione per creare tassonomie di concetti dal più generale al più specifico.</rdfs:comment>
        <rdfs:comment xml:lang="en">The relation for generating taxonomies of concepts from the most general to the most specific.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">ha più specifico</rdfs:label>
        <rdfs:label xml:lang="en">has narrower</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/hasNominalRegion -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/hasNominalRegion">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/hasRegion"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/isNominalRegionFor"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Region"/>
        <rdfs:comment xml:lang="en">A relation between an entity and a region representing the nominal (according to some specification) quantification of some aspect/quality of that entity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">has nominal region</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/hasOutput -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/hasOutput">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Action"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Object"/>
        <rdfs:comment xml:lang="en">Associates an action with a produced object. The object typically fulfills one the output roles of the executed task.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">has output</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/hasOutputRole -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/hasOutputRole">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/isOutputRoleOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Task"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Role"/>
        <rdfs:comment xml:lang="en">Associates a task with roles that are expected to be fulfilled by objects produced by any action executing the task.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">has output role</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/hasPart -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/hasPart">
        <rdfs:comment xml:lang="it">Una relazione schematica tra entità qualsiasi, ad es. &apos;il corpo umano ha come parte un cervello&apos;, &apos;il XX secolo contiene l&apos;anno 1923&apos;, &apos;la Seconda guerra mondiale include l&apos;evento di Pearl Harbour&apos;.

La relazione di parte dovrebbe avere le proprietà di base della mereologia: transitività, antisimmetria e riflessività (la parte propria ovviamente non è riflessiva).
Tuttavia, l&apos;antisimmetria non è supportata esplicitamente in OWL2, quindi DUL deve adottare uno di due pattern:
1) eliminare gli assiomi di asimmetria, mantenendo la riflessività: la simmetria non è imposta, ma è permessa per il caso della riflessività. Naturalmente, in questo modo non si possono impedire usi simmetrici di hasPart;
2) eliminare l&apos;assioma di riflessività e imporre l&apos;asimmetria: in questo caso si impedirebbero tutti gli usi simmetrici, ma si perderebbe la possibilità di imporre la riflessività, che è di senso comune per la relazione di parte.
In DUL si adotta il pattern 1 per partOf e il pattern 2 per properPartOf, il che sembra una buona approssimazione: poiché le caratteristiche delle proprietà non vengono ereditate, ogni asserzione asimmetrica di hasProperPart sarebbe anche un&apos;asserzione riflessiva di hasPart (design pattern della riduzione riflessiva).

Sottoproprietà e restrizioni possono essere usate per specializzare hasPart per oggetti, eventi, ecc.</rdfs:comment>
        <rdfs:comment xml:lang="en">A schematic relation between any entities, e.g. &apos;the human body has a brain as part&apos;, &apos;20th century contains year 1923&apos;, &apos;World War II includes the Pearl Harbour event&apos;.

Parthood should assume the basic properties of mereology: transitivity, antisymmetry, and reflexivity (propert Parthood of course misses reflexivity). 
However, antisymmetry is not supported in OWL2 explicitly, therefore DUL has to adopt one of two patterns:
1) dropping asymmetry axioms, while granting reflexivity: this means that symmetry is not enforced, but permitted for the case of reflexivity. Of course, in this way we cannot prevent symmetric usages of hasPart;
2) dropping the reflexivity axiom, and enforce asymmetry: in this case, we would prevent all symmetric usages, but we loose the possibility of enforcing reflexivity, which is commonsensical in parthood.
In DUL, we adopt pattern #1 for partOf, and pattern #2 for properPartOf, which seems a good approximation: due to the lack of inheritance of property characteristics, each asymmetric hasPropertPart assertion would also be a reflexive hasPart assertion (reflexive reduction design pattern).

Subproperties and restrictions can be used to specialize hasPart for objects, events, etc.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/isPartOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ReflexiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <skos:scopeNote xml:lang="it">La relazione di parte definita come proprietà transitiva e riflessiva.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">The parthood relation defined as a transitive and reflexive property.</skos:scopeNote>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">ha parte</rdfs:label>
        <rdfs:label xml:lang="en">has part</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/hasParticipant -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/hasParticipant">
        <rdfs:comment xml:lang="it">Una relazione tra un oggetto e un processo, ad es. &apos;John ha preso parte alla discussione&apos;, &apos;una grande massa di neve è caduta durante la valanga&apos;, oppure &apos;un cuoco, dello zucchero, della farina, ecc. sono tutti presenti nella preparazione di una torta&apos;.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/isParticipantIn"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Event"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Object"/>
        <rdfs:comment xml:lang="en">A relation between an object and a process, e.g. &apos;John took part in the discussion&apos;, &apos;a large mass of snow fell during the avalanche&apos;, or &apos;a cook, some sugar, flour, etc. are all present in the cooking of a cake&apos;.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">ha come partecipante</rdfs:label>
        <rdfs:label xml:lang="en">has participant</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/hasProperPart -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/hasProperPart">
        <rdfs:comment xml:lang="en">Asymmetric (so including irreflexive) parthood.</rdfs:comment>
        <rdfs:comment xml:lang="en">The property is transitive. Asymmetry (and hence irreflexivity) cannot be declared in OWL 2 DL for a transitive property, so it is part of the intended meaning but is not axiomatised. For direct, design-based parthood use hasComponent.</rdfs:comment>
        <rdfs:comment xml:lang="it">Relazione di parte asimmetrica (quindi anche irriflessiva) e transitiva. L&apos;asimmetria non è esprimibile in OWL 2 DL per una proprietà transitiva, quindi fa parte del significato inteso ma non è assiomatizzata. Per la relazione di parte diretta, basata su un progetto, usare &apos;ha componente&apos;.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/hasPart"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/isProperPartOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">ha parte propria</rdfs:label>
        <rdfs:label xml:lang="en">has proper part</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/hasQuality -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/hasQuality">
        <rdfs:comment xml:lang="it">Una relazione tra entità e qualità, ad es. &apos;la pelle di Dmitri è giallastra&apos;.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/isQualityOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Quality"/>
        <rdfs:comment>A relation between entities and qualities, e.g. &apos;Dmitri&apos;s skin is yellowish&apos;.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">ha qualità</rdfs:label>
        <rdfs:label xml:lang="en">has quality</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/hasRegion -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/hasRegion">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/isRegionFor"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Region"/>
        <rdfs:comment xml:lang="en">A relation between entities and regions, e.g. &apos;the number of wheels of that truck is 12&apos;, &apos;the time of the experiment is August 9th, 2004&apos;, &apos;the whale has been localized at 34 degrees E, 20 degrees S&apos;.</rdfs:comment>
        <rdfs:comment xml:lang="it">Una relazione tra entità e regioni, ad es. &apos;il numero di ruote di quel camion è 12&apos;, &apos;l&apos;ora dell&apos;esperimento è il 9 agosto 2004&apos;, &apos;la balena è stata localizzata a 34 gradi E, 20 gradi S&apos;</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">ha attributo</rdfs:label>
        <rdfs:label xml:lang="en">has region</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/hasRole -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/hasRole">
        <rdfs:comment xml:lang="it">Una relazione tra un oggetto e un ruolo, ad es. la persona &apos;John&apos; ha il ruolo &apos;studente&apos;.</rdfs:comment>
        <rdfs:comment xml:lang="en">A relation between an object and a role, e.g. the person &apos;John&apos; has role &apos;student&apos;.</rdfs:comment>
        <skos:scopeNote xml:lang="en">In the top-level the domain is widened from Object to Entity: any entity can have a role.</skos:scopeNote>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/isClassifiedBy"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/isRoleOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Role"/>
        <skos:scopeNote xml:lang="it">La relazione che permette di classificare un&apos;entità in base al ruolo che essa ricopre.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">The relationship that allows you to classify an entity based on the role it holds.</skos:scopeNote>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">ha ruolo</rdfs:label>
        <rdfs:label xml:lang="en">has role</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/hasSetting -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/hasSetting">
        <rdfs:comment xml:lang="it">Una relazione tra entità e situazioni, ad es. &apos;stamattina ho preparato il caffè con un nuovo fantastico Arabica&apos;, cioè: (una quantità di) un nuovo fantastico Arabica ha come contesto (hasSetting) la preparazione del mio caffè di stamattina.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/isSettingFor"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Situation"/>
        <rdfs:comment xml:lang="en">A relation between entities and situations, e.g. &apos;this morning I&apos;ve prepared my coffee with a new fantastic Arabica&apos;, i.e.: (an amount of) a new fantastic Arabica hasSetting the preparation of my coffee this morning.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">has setting</rdfs:label>
        <rdfs:label xml:lang="it">è nel contesto di</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/hasSource -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/hasSource">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/isSourceOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:comment xml:lang="it">La relazione che permette di stabilire che una certa entità è sorgente di un&apos;altra.</rdfs:comment>
        <rdfs:comment xml:lang="en">The relation that allows one that a certain entity is the source of another.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">ha sorgente</rdfs:label>
        <rdfs:label xml:lang="en">has source</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/hasSystem -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/hasSystem">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/isSystemOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/System"/>
        <rdfs:comment xml:lang="it">La relazione che sussiste tra una qualsiasi entità ed un sistema.</rdfs:comment>
        <rdfs:comment xml:lang="en">The relation holding between any entity and a system.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">has system</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/hasTask -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/hasTask">
        <rdfs:comment xml:lang="it">Una relazione tra ruoli e task, ad es. &apos;gli studenti hanno il dovere di sostenere esami&apos; (cioè il Role &apos;studente&apos; ha il Task &apos;sostenere esami&apos;).</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/isRelatedToConcept"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/isTaskOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Role"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Task"/>
        <rdfs:comment xml:lang="en">A relation between roles and tasks, e.g. &apos;students have the duty of giving exams&apos; (i.e. the Role &apos;student&apos; hasTask the Task &apos;giving exams&apos;).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">ha come obiettivo</rdfs:label>
        <rdfs:label xml:lang="en">has task</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/hasTimeInterval -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/hasTimeInterval">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/hasRegion"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/isTimeIntervalOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Event"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/TimeInterval"/>
        <rdfs:comment xml:lang="it">La relazione generica tra eventi e intervalli di tempo.</rdfs:comment>
        <rdfs:comment xml:lang="en">The generic relation between events and time intervals.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">ha intervallo temporale</rdfs:label>
        <rdfs:label xml:lang="en">has time interval</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/hasUniqueIdentifier -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/hasUniqueIdentifier">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/hasCharacteristic"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/isUniqueIdentifierOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:comment xml:lang="it">La relazione esistente tra un&apos;entità e il suo identificatore univoco.</rdfs:comment>
        <rdfs:comment xml:lang="en">The relation holding between an entity and its unique identifier.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">ha identificativo univoco</rdfs:label>
        <rdfs:label xml:lang="en">has unique identifier</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/hasUnitOfMeasure -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/hasUnitOfMeasure">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/hasCharacteristic"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/isUnitOfMeasureOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/UnitOfMeasure"/>
        <rdfs:comment xml:lang="en">Property that links an object that can be measured to its corresponding unit of measure.</rdfs:comment>
        <rdfs:comment xml:lang="it">Proprietà che collega un oggetto misurabile alla sua unità di misura corrispondente.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">ha unità di misura</rdfs:label>
        <rdfs:label xml:lang="en">has unit of measure</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/hasUpperBoundary -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/hasUpperBoundary">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/isUpperBoundaryOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Interval"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Region"/>
        <rdfs:comment xml:lang="en">The relation between an Interval and the Region that is its upper boundary. In the linear case the upper boundary is the point where the interval ends, e.g. the end of a time interval or the maximum of a range of values; in a multi-dimensional space ordered component-wise it is the corner whose coordinates are all maximal, e.g. the north-east corner of a latitude-longitude bounding box.</rdfs:comment>
        <rdfs:comment xml:lang="it">La relazione tra un Interval e la Region che ne costituisce l&apos;estremo superiore. Nel caso lineare l&apos;estremo superiore è il punto in cui l&apos;intervallo finisce, ad es. la fine di un intervallo di tempo o il massimo di un intervallo di valori; in uno spazio multidimensionale ordinato componente per componente è il vertice con tutte le coordinate massime, ad es. il vertice nord-est di un riquadro di latitudine e longitudine.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">has upper boundary</rdfs:label>
        <rdfs:label xml:lang="it">ha estremo superiore</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/hasValue -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/hasValue">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/hasCharacteristic"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/isValueOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Value"/>
        <rdfs:comment xml:lang="it">La relazione esistente tra un&apos;entità ed il valore ad essa associata.</rdfs:comment>
        <rdfs:comment xml:lang="en">The relationship between an entity and the value it is associated with.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">ha valore</rdfs:label>
        <rdfs:label xml:lang="en">has value</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/inScheme -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/inScheme">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/includesInScheme"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/ConceptScheme"/>
        <rdfs:comment xml:lang="en">Relates a resource (for example a concept) to a concept scheme in which it is included.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">in scheme</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/includesEvent -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/includesEvent">
        <rdfs:comment xml:lang="it">Una relazione tra situazioni ed eventi, ad es. &apos;stamattina ho preparato il caffè e mi sono bruciato le dita&apos; (cioè: la preparazione del mio caffè di stamattina ha incluso una bruciatura delle mie dita).</rdfs:comment>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Situation"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Event"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/isSettingFor"/>
        <rdfs:comment xml:lang="en">A relation between situations and events, e.g. &apos;this morning I&apos;ve prepared my coffee and had my fingers burnt&apos; (i.e.: the preparation of my coffee this morning included a burning of my fingers).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">include l&apos;evento</rdfs:label>
        <rdfs:label xml:lang="en">includes event</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/includesInScheme -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/includesInScheme">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/ConceptScheme"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:comment xml:lang="en">Relates a concept scheme to a included resource (for example a concept).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">includes in scheme</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/includesObject -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/includesObject">
        <rdfs:comment xml:lang="it">Una relazione tra situazioni e oggetti, ad es. &apos;stamattina ho preparato il caffè e mi sono bruciato le dita&apos; (cioè: la preparazione del mio caffè di stamattina ha incluso me).</rdfs:comment>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Situation"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Object"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/isSettingFor"/>
        <rdfs:comment xml:lang="en">A relation between situations and objects, e.g. &apos;this morning I&apos;ve prepared my coffee and had my fingers burnt&apos; (i.e.: the preparation of my coffee this morning included me).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">include l&apos;oggetto</rdfs:label>
        <rdfs:label xml:lang="en">includes object</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/involves -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/involves">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/isSettingFor"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/isInvolvedIn"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Situation"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:comment xml:lang="it">La proprietà per collegare una situazione con i suoi argomenti.</rdfs:comment>
        <rdfs:comment xml:lang="it">Questa proprietà permette di collegare una situazione con le entità che costituiscono i suoi argomenti.</rdfs:comment>
        <rdfs:comment xml:lang="en">The property for associating a situation with its arguments.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">coinvolge</rdfs:label>
        <rdfs:label xml:lang="en">involves</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isApproximateRegionFor -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isApproximateRegionFor">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/isRegionFor"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Region"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:comment xml:lang="en">A relation between a region and an entity such that the region is an approximate quantification of some aspect/quality of the entity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is approximate region for</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isAssignedRoleIn -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isAssignedRoleIn">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Role"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/ObjectRoleAssignment"/>
        <rdfs:comment xml:lang="en">Associates a role with an assignment of that role.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is assigned role in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isAssigneeObjectIn -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isAssigneeObjectIn">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Object"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/ObjectRoleAssignment"/>
        <rdfs:comment xml:lang="en">Associates an object with an assignment of some role to such object.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is assignee object in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isCharacteristicOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isCharacteristicOf">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Characteristic"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:comment xml:lang="it">La relazione che collega una caratteristica all&apos;entità a cui essa può essere associata.</rdfs:comment>
        <rdfs:comment xml:lang="en">The relationship that links a characteristic to the entity it can be associated with.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is characteristic of</rdfs:label>
        <rdfs:label xml:lang="it">è caratteristica di</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isClassifiedBy -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isClassifiedBy">
        <rdfs:comment xml:lang="it">Una relazione tra un Concept e un&apos;Entity, ad es. &apos;John è considerato un tipico uomo maleducato&apos;; &apos;il tuo ultimo concerto costituisce il risultato di una vita&apos;; &apos;avere 20 anni significa che è abbastanza matura&apos;.</rdfs:comment>
        <rdfs:comment xml:lang="en">A relation between a Concept and an Entity, e.g. &apos;John is considered a typical rude man&apos;; your last concert constitutes the achievement of a lifetime; &apos;20-year-old means she&apos;s mature enough&apos;.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Concept"/>
        <skos:scopeNote xml:lang="it">La proprietà per stabilire che un certo concetto viene usato per classificare una certa entità.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">The property to state that a certain concept is used to classify a certain entity.</skos:scopeNote>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is classified by</rdfs:label>
        <rdfs:label xml:lang="it">è classificato da</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isCollectionOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isCollectionOf">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Collection"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:comment xml:lang="it">La relazione esistente tra una collezione ed una qualsiasi entità.</rdfs:comment>
        <rdfs:comment xml:lang="en">The relation holding between a collection and any possible entity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is collection of</rdfs:label>
        <rdfs:label xml:lang="it">è collezione di</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isComponentOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isComponentOf">
        <rdfs:comment xml:lang="it">La relazione asimmetrica isProperPartOf senza transitività, tra un Object (il sistema) e un altro (il componente), che presuppone un Design che struttura l&apos;Object.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/isProperPartOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:comment>The asymmetric isProperPartOf relation without transitivity, holding between an Object (the system) and another (the component), and assuming a Design that structures the Object.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is component of</rdfs:label>
        <rdfs:label xml:lang="it">è componente di</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isConceptUsedIn -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isConceptUsedIn">
        <rdfs:comment xml:lang="it">Una relazione più generica tra una Description e un Concept. Per essere usato, un Concept deve essere stato prima definito (isDefinedIn) in un&apos;altra Description.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/usesConcept"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Concept"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Description"/>
        <rdfs:comment xml:lang="en">A more generic relation holding between a Description and a Concept. In order to be used, a Concept must be previously definedIn another Description</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is concept used in</rdfs:label>
        <rdfs:label xml:lang="it">è un concetto usato in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isConstituentOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isConstituentOf">
        <rdfs:comment xml:lang="it">La &apos;costituzione&apos; dipende da una stratificazione del mondo descritto dall&apos;ontologia. Ad esempio, le granularità scientifiche (ad es. corpo-organo-tessuto-cellula) o gli &apos;strati&apos; ontologici (ad es. sociale-mentale-biologico-fisico) sono stratificazioni tipiche.
Intuitivamente, un costituente è una parte che appartiene a uno strato inferiore. Poiché la stratificazione è in realtà una partizione del mondo descritto dall&apos;ontologia, i costituenti non sono propriamente classificati come parti, sebbene questa affinità possa essere intuitiva per il senso comune.
Un vantaggio di questa distinzione è che si può parlare, ad es., di costituenti fisici di oggetti non fisici (ad es. sistemi), cosa non possibile in termini di parti.
Esempi sono le persone che costituiscono un sistema sociale, le molecole che costituiscono una persona, gli atomi che costituiscono un fiume, ecc.
In tutti questi esempi si nota una tipica discontinuità tra l&apos;oggetto costituito e il costituente: ad es. un sistema sociale è concettualizzato a uno strato diverso da quello delle persone che lo costituiscono, una persona a uno strato diverso da quello delle molecole che la costituiscono, e un fiume a uno strato diverso da quello degli atomi che lo costituiscono.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:comment>&apos;Constituency&apos; depends on some layering of  the world described by the ontology. For example, scientific granularities (e.g. body-organ-tissue-cell) or ontological &apos;strata&apos; (e.g. social-mental-biological-physical) are  typical layerings. 
Intuitively, a constituent is a part belonging to a lower layer. Since layering is actually a partition of the world described by the ontology, constituents are not properly classified as parts, although this kinship can be intuitive for common sense.
A desirable advantage of this distinction is that we are able to talk e.g. of physical constituents of non-physical objects (e.g. systems), while this is not possible in terms of parts.
Example of are the persons constituting a social system, the molecules constituting a person, the atoms constituting a river, etc. 
In all these examples, we notice a typical discontinuity between the constituted and the constituent object: e.g. a social system is conceptualized at a different layer from the persons that constitute it, a person is conceptualized at a different layer from the molecules that constitute them, and a river is conceptualized at a different layer from the atoms that constitute it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is constituent of</rdfs:label>
        <rdfs:label xml:lang="it">è costituente di</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isCreatorOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isCreatorOf">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:comment xml:lang="it">La relazione per associare un agente creatore ad un&apos;entità creata.</rdfs:comment>
        <rdfs:comment xml:lang="en">The relation for asserting that a certain agent is the creator of an entity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is creator of</rdfs:label>
        <rdfs:label xml:lang="it">è creatore di</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isDefinedIn -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isDefinedIn">
        <rdfs:comment xml:lang="it">Una relazione tra una Description e un Concept, ad es. un Workflow per un&apos;Organization governativa definisce il Role &apos;funzionario&apos;, oppure &apos;il Codice della strada italiano definisce il ruolo Veicolo&apos;.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/isConceptUsedIn"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Concept"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Description"/>
        <rdfs:comment xml:lang="en">A relation between a Description and a Concept, e.g. a Workflow for a governmental Organization defines the Role &apos;officer&apos;, or &apos;the Italian Traffic Law defines the role Vehicle&apos;.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is defined in</rdfs:label>
        <rdfs:label xml:lang="it">è definito in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isDescribedBy -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isDescribedBy">
        <rdfs:comment xml:lang="it">La relazione tra un&apos;Entity e una Description: una Description dà unità a una Collection di parti (i componenti), o di costituenti, assegnando un Role a ciascuno di essi nel contesto di un Object complessivo (il sistema).
A una stessa Entity si possono dare descrizioni diverse: ad esempio, a una vecchia culla si può dare una Description unificante basata sul design estetico originale, sulla funzionalità per cui è stata costruita, o su una nuova funzionalità estetica in cui può essere usata come vaso da fiori.</rdfs:comment>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Description"/>
        <rdfs:comment xml:lang="en">The relation between an Entity and a Description: a Description gives a unity to a Collection of parts (the components), or constituents, by assigning a Role to each of them in the context of a whole Object (the system).
A same Entity can be given different descriptions, for example, an old cradle can be given a unifying Description based on the original aesthetic design, the functionality it was built for, or a new aesthetic functionality in which it can be used as a flower pot.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <skos:scopeNote xml:lang="it">La relazione per associare un&apos;entità alla sua descrizione.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">The relation to associate an entity with its description.</skos:scopeNote>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is described by</rdfs:label>
        <rdfs:label xml:lang="it">è descritto da</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isDescriptionOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isDescriptionOf">
        <owl:equivalentProperty rdf:resource="https://w3id.org/hacid/onto/top-level/describes"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Description"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:comment xml:lang="it">La relazione esistente tra una descrizione e l&apos;entità descritta.</rdfs:comment>
        <rdfs:comment xml:lang="en">The relationship between a description and the entity described.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is description of</rdfs:label>
        <rdfs:label xml:lang="it">è descrizione di</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isEventualityOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isEventualityOf">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/isSettingFor"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Situation"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:comment xml:lang="it">Il rapporto esistente tra un&apos;eventualità e qualsiasi entità possibile.</rdfs:comment>
        <rdfs:comment xml:lang="en">The relationship existing between an eventuality and any possible entity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is eventuality of</rdfs:label>
        <rdfs:label xml:lang="it">è eventualità di</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isExactRegionFor -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isExactRegionFor">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/isRegionFor"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Region"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:comment xml:lang="en">A relation between a region and an entity such that the region is an exact quantification of some aspect/quality of the entity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is exact region for</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isExecutedIn -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isExecutedIn">
        <rdfs:comment xml:lang="it">Una relazione tra un&apos;azione e un task, ad es. &apos;mettere dell&apos;acqua in una pentola e mettere la pentola sul fuoco finché l&apos;acqua comincia a bollire&apos; esegue il task &apos;bollire&apos;.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/classifies"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Task"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Action"/>
        <rdfs:comment xml:lang="en">A relation between an action and a task, e.g. &apos;putting some water in a pot and putting the pot on a fire until the water starts bubbling&apos; executes the task &apos;boiling&apos;.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is executed in</rdfs:label>
        <rdfs:label xml:lang="it">è eseguito mediante</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isExpectedTypeOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isExpectedTypeOf">
        <rdfs:comment xml:lang="en">Constraint not expressible in OWL 2 DL (stated here, not axiomatised): the subject of this property is a class (an instance of rdfs:Class, typically an owl:Class used as an individual through OWL 2 punning).</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/InformationRole"/>
        <rdfs:comment xml:lang="en">A relation between classes and information roles for which they formalise their expected types.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is expected type of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isIdentifierSchemaOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isIdentifierSchemaOf">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/isDescriptionOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/IdentifierSchema"/>
        <rdfs:comment xml:lang="it">La relazione che lega uno schema di identificazione ad un identificativo unico.</rdfs:comment>
        <rdfs:comment xml:lang="en">The relation between an identifier schema and a unique identifier.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is identifier schema of</rdfs:label>
        <rdfs:label xml:lang="it">è schema identificativo di</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isInputRoleOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isInputRoleOf">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Role"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Task"/>
        <rdfs:comment xml:lang="en">Inverse property of hasInputRole.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is input role of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isInvolvedIn -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isInvolvedIn">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/hasSetting"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Situation"/>
        <rdfs:comment xml:lang="it">La proprietà per associare un&apos;entità ad una situazione.</rdfs:comment>
        <rdfs:comment xml:lang="en">The property for associating an entity with a situation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is involved in</rdfs:label>
        <rdfs:label xml:lang="it">è coinvolto in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isIssuedBy -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isIssuedBy">
        <rdfs:comment xml:lang="en">The relation that allows one to state that an entity is issued by a given agent.</rdfs:comment>
        <rdfs:comment xml:lang="it">La relazione che consente di affermare che un&apos;entità è emessa da un determinato agente.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/issues"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">è emesso da</rdfs:label>
        <rdfs:label xml:lang="en">is issued by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isLocationOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isLocationOf">
        <rdfs:comment xml:lang="en">A generic, relative localization, holding between any entities. E.g. &apos;Rome is the seat of the Pope&apos;, &apos;the liver is the location of the tumor&apos;.
For &apos;absolute&apos; locations, see SpaceRegion</rdfs:comment>
        <rdfs:comment xml:lang="it">Una localizzazione generica e relativa, tra entità qualsiasi. Ad es. &apos;Roma è la sede del Papa&apos;, &apos;il fegato è la sede del tumore&apos;.
Per localizzazioni &apos;assolute&apos;, vedere SpaceRegion.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is location of</rdfs:label>
        <rdfs:label xml:lang="it">è una localizzazione di</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isLowerBoundaryOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isLowerBoundaryOf">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Region"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Interval"/>
        <rdfs:comment xml:lang="en">The relation between a Region and an Interval of which it is the lower boundary.</rdfs:comment>
        <rdfs:comment xml:lang="it">La relazione tra una Region e un Interval di cui costituisce l&apos;estremo inferiore.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is lower boundary of</rdfs:label>
        <rdfs:label xml:lang="it">è estremo inferiore di</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isMemberOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isMemberOf">
        <rdfs:comment xml:lang="it">Una relazione tra collezioni ed entità, ad es. &apos;la Ronda di notte di Rembrandt è nella collezione del Rijksmuseum&apos;; &apos;Davide è membro del Pen Club&apos;, &apos;Igor è uno dei soggetti scelti per l&apos;esperimento&apos;.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/hasCollection"/>
        <rdfs:comment xml:lang="en">A relation between collections and entities, e.g. &apos;the Night Watch by Rembrandt is in the Rijksmuseum collection&apos;; &apos;Davide is member of the Pen Club&apos;, &apos;Igor is one the subjects chosen for the experiment&apos;.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Collection"/>
        <skos:scopeNote xml:lang="it">La relazione inversa di &apos;ha membro&apos;. Come la sua inversa permette di stabilire relazione di memberhip tra un elemento ed la sua collezione.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">The inverse relation of &apos;has member&apos;. It allows to represent membership relations.</skos:scopeNote>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is member of</rdfs:label>
        <rdfs:label xml:lang="it">è membro di</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isNominalRegionFor -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isNominalRegionFor">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/isRegionFor"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Region"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:comment xml:lang="en">A relation between a region and an entity such that the region is a nominal quantification of some aspect/quality of the entity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is nominal region for</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isOutputRoleOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isOutputRoleOf">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Role"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Task"/>
        <rdfs:comment xml:lang="en">Inverse property of hasOutputRole.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is output role of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isParametrisedBy -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isParametrisedBy">
        <rdfs:comment xml:lang="it">La relazione tra un Parameter, ad es. &apos;MaggioreEtà&apos;, e una Region, ad es. &apos;&gt;17 anni&apos;.</rdfs:comment>
        <rdfs:comment xml:lang="en">The relation between a Parameter, e.g. &apos;MajorAge&apos;, and a Region, e.g. &apos;&gt;17 year&apos;.</rdfs:comment>
        <skos:scopeNote xml:lang="en">In the top-level the domain is widened from Region to Entity.</skos:scopeNote>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/isClassifiedBy"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/parametrises"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Parameter"/>
        <skos:scopeNote xml:lang="it">La relazione che sussiste tra l&apos;entità oggetto della parametrizzazione ed il parametro.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">The relation holding between the entity being object of the parametrisation and a parameter.</skos:scopeNote>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is parametrised by</rdfs:label>
        <rdfs:label xml:lang="it">è parametrizzato da</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isPartOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isPartOf">
        <rdfs:comment xml:lang="it">Una relazione tra entità qualsiasi, ad es. &apos;il cervello è una parte del corpo umano&apos;. Si veda dul:hasPart per ulteriore documentazione.</rdfs:comment>
        <rdfs:comment xml:lang="en">A relation between any entities, e.g. &apos;brain is a part of the human body&apos;. See dul:hasPart for additional documentation.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ReflexiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <skos:scopeNote xml:lang="it">L&apos;inversa di &apos;ha parte&apos; per rappresentare la relazione di parte dal punto di vista della parte. La proprietà è definita come riflessiva e transitiva.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">The inverse of &apos;has part&apos; for representing parthood from the perspective of the part. The property is defined as reflexive and transitive.</skos:scopeNote>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is part of</rdfs:label>
        <rdfs:label xml:lang="it">è parte di</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isParticipantIn -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isParticipantIn">
        <rdfs:comment xml:lang="it">Una relazione tra un oggetto e un processo, ad es. &apos;John ha preso parte alla discussione&apos;, &apos;una grande massa di neve è caduta durante la valanga&apos;, oppure &apos;un cuoco, dello zucchero, della farina, ecc. sono tutti presenti nella preparazione di una torta&apos;.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Object"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Event"/>
        <rdfs:comment xml:lang="en">A relation between an object and a process, e.g. &apos;John took part in the discussion&apos;, &apos;a large mass of snow fell during the avalanche&apos;, or &apos;a cook, some sugar, flour, etc. are all present in the cooking of a cake&apos;.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is participant in</rdfs:label>
        <rdfs:label xml:lang="it">è un partecipante a</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isProperPartOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isProperPartOf">
        <rdfs:comment xml:lang="en">The inverse of hasProperPart. See hasProperPart for additional documentation.</rdfs:comment>
        <rdfs:comment xml:lang="en">The property is transitive. Asymmetry (and hence irreflexivity) cannot be declared in OWL 2 DL for a transitive property, so it is part of the intended meaning but is not axiomatised. For direct, design-based parthood use isComponentOf.</rdfs:comment>
        <rdfs:comment xml:lang="it">L&apos;inversa di &apos;ha parte propria&apos;: relazione di parte asimmetrica (quindi anche irriflessiva) e transitiva. L&apos;asimmetria non è esprimibile in OWL 2 DL per una proprietà transitiva, quindi fa parte del significato inteso ma non è assiomatizzata. Per la relazione di parte diretta, basata su un progetto, usare &apos;è componente di&apos;.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/isPartOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is proper part of</rdfs:label>
        <rdfs:label xml:lang="it">è parte propria di</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isQualityOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isQualityOf">
        <rdfs:comment xml:lang="it">Una relazione tra entità e qualità, ad es. &apos;la pelle di Dmitri è giallastra&apos;.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Quality"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:comment>A relation between entities and qualities, e.g. &apos;Dmitri&apos;s skin is yellowish&apos;.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is quality of</rdfs:label>
        <rdfs:label xml:lang="it">è una qualità di</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isRegionFor -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isRegionFor">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Region"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:comment xml:lang="en">A relation between entities and regions, e.g. &apos;the color of my car is red&apos;.</rdfs:comment>
        <rdfs:comment xml:lang="it">Una relazione tra entità e regioni, ad es. &apos;il colore della mia macchina è rosso&apos;.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is region for</rdfs:label>
        <rdfs:label xml:lang="it">è una regione di</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isRelatedToConcept -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isRelatedToConcept">
        <rdfs:comment xml:lang="it">Qualsiasi relazione tra concetti, ad es. sovraordinazione, parte concettuale, avere un parametro, avere un task, ecc.</rdfs:comment>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Concept"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Concept"/>
        <rdfs:comment xml:lang="en">Any relation between concepts, e.g. superordinated, conceptual parthood, having a parameter, having a task, superordination, etc.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is related to concept</rdfs:label>
        <rdfs:label xml:lang="it">è associato al concetto</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isRoleDefinedIn -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isRoleDefinedIn">
        <rdfs:comment xml:lang="it">Una relazione tra una descrizione e un ruolo, ad es. il ruolo &apos;Ingrediente&apos; è definito nella ricetta di una torta.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/isDefinedIn"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Role"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Description"/>
        <rdfs:comment xml:lang="en">A relation between a description and a role, e.g. the role &apos;Ingredient&apos; is defined in the recipe for a cake.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is role defined in</rdfs:label>
        <rdfs:label xml:lang="it">è un ruolo definito in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isRoleInvolvedIn -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isRoleInvolvedIn">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/hasEventuality"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Role"/>
        <rdfs:comment xml:lang="it">La relazione che collega un ruolo alla situazione ruolo-agente in cui esso partecipa.</rdfs:comment>
        <rdfs:comment xml:lang="en">The relationship that links a role to the agent-role situation it is involved in.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is role involved in</rdfs:label>
        <rdfs:label xml:lang="it">è il ruolo coinvolto in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isRoleOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isRoleOf">
        <rdfs:comment xml:lang="it">Una relazione tra un oggetto e un ruolo, ad es. &apos;studente&apos; è il ruolo di &apos;John&apos;.</rdfs:comment>
        <rdfs:comment xml:lang="en">A relation between an object and a role, e.g. &apos;student&apos; is the role of &apos;John&apos;.</rdfs:comment>
        <skos:scopeNote xml:lang="en">In the top-level the range is widened from Object to Entity: a role can be the role of any entity.</skos:scopeNote>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/classifies"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Role"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <skos:scopeNote xml:lang="it">La relazione che consente di utilizzare un ruolo per classificare una determinata entità.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">The relation that allows you to use a role for classifying a certain entity.</skos:scopeNote>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is role of</rdfs:label>
        <rdfs:label xml:lang="it">è un ruolo di</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isSatisfiedBy -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isSatisfiedBy">
        <rdfs:comment xml:lang="it">Una relazione tra una Situation e una Description, ad es. l&apos;esecuzione di un Plan soddisfa quel piano.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/satisfies"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Description"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Situation"/>
        <rdfs:comment xml:lang="en">A relation between a Situation and a Description, e.g. the execution of a Plan satisfies that plan.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is satisfied by</rdfs:label>
        <rdfs:label xml:lang="it">è soddisfatta da</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isSettingFor -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isSettingFor">
        <rdfs:comment xml:lang="it">Una relazione tra situazioni ed entità, ad es. &apos;stamattina ho preparato il caffè con un nuovo fantastico Arabica&apos;, cioè: la preparazione del mio caffè di stamattina è il contesto (isSettingFor) per (una quantità di) un nuovo fantastico Arabica.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Situation"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:comment xml:lang="en">A relation between situations and entities, e.g. &apos;this morning I&apos;ve prepared my coffee with a new fantastic Arabica&apos;, i.e.: the preparation of my coffee this morning is the setting for (an amount of) a new fantastic Arabica.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">include</rdfs:label>
        <rdfs:label xml:lang="en">is setting for</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isSouceOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isSouceOf">
        <owl:equivalentProperty rdf:resource="https://w3id.org/hacid/onto/top-level/isSourceOf"/>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <rdfs:comment xml:lang="en">Deprecated misspelling of isSourceOf, kept for backward compatibility.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is source of (deprecated)</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isSourceOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isSourceOf">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:comment xml:lang="en">Inverse object property of hasSource.</rdfs:comment>
        <rdfs:comment xml:lang="it">Object property inversa di hasSource.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is source of</rdfs:label>
        <rdfs:label xml:lang="it">è sorgente di</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isSpecialisedBy -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isSpecialisedBy">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/specialises"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:comment xml:lang="it">La relazione inverse di &apos;specializza&apos;.</rdfs:comment>
        <rdfs:comment xml:lang="en">The inverse releation of &apos;specialises&apos;</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is specialised by</rdfs:label>
        <rdfs:label xml:lang="it">è specializzato da</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isSpecializedBy -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isSpecializedBy">
        <rdfs:comment xml:lang="it">Una relazione d&apos;ordine parziale tra oggetti sociali. Rappresenta la relazione di sussunzione tra, ad es., un Concept e un altro Concept più ampio nell&apos;interpretazione estensionale, ma più ristretto nell&apos;interpretazione intensionale.
Ad es. il Role DottorandoDiRicerca specializza il Role Studente.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/isSpecialisedBy"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <owl:inverseOf rdf:resource="https://w3id.org/hacid/onto/top-level/specializes"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/SocialObject"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/SocialObject"/>
        <rdfs:comment>A partial order relation that holds between social objects. It represents the subsumption relation between e.g. a Concept and another Concept that is broader in extensional interpretation, but narrowe in intensional interpretation.
E.g. PhDStudent Role specializes Student Role</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is specialized by</rdfs:label>
        <rdfs:label xml:lang="it">è specializzato da</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isSystemOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isSystemOf">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/System"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:comment xml:lang="it">La relazione che sussiste tra un sistema ed una qualsiasi entità.</rdfs:comment>
        <rdfs:comment xml:lang="en">The relationship holding between a system and any entity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is system of</rdfs:label>
        <rdfs:label xml:lang="it">è sistema di</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isTaskDefinedIn -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isTaskDefinedIn">
        <rdfs:comment xml:lang="it">Una relazione tra una descrizione e un task, ad es. il task &apos;bollire&apos; è definito in una ricetta per una torta.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/isDefinedIn"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Task"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Description"/>
        <rdfs:comment xml:lang="en">A relation between a description and a task, e.g. the task &apos;boil&apos; is defined in a recipe for a cake.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is task defined in</rdfs:label>
        <rdfs:label xml:lang="it">è un task definito in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isTaskOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isTaskOf">
        <rdfs:comment xml:lang="it">Una relazione tra ruoli e task, ad es. &apos;gli studenti hanno il dovere di sostenere esami&apos; (cioè il Role &apos;studente&apos; ha il Task &apos;sostenere esami&apos;).</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/isRelatedToConcept"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Task"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Role"/>
        <rdfs:comment xml:lang="en">A relation between roles and tasks, e.g. &apos;students have the duty of giving exams&apos; (i.e. the Role &apos;student&apos; hasTask the Task &apos;giving exams&apos;).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is task of</rdfs:label>
        <rdfs:label xml:lang="it">è un obiettivo per</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isTimeIntervalOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isTimeIntervalOf">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/isRegionFor"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/TimeInterval"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Event"/>
        <rdfs:comment xml:lang="it">La relazione generica tra eventi e intervalli di tempo.</rdfs:comment>
        <rdfs:comment xml:lang="en">The generic relation between time intervals and events.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">intervallo temporale di</rdfs:label>
        <rdfs:label xml:lang="en">is time interval of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isTimeOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isTimeOf">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/TemporalEntity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:comment xml:lang="it">La relazione esistente tra un&apos;entità temporale ed una qualsiasi altra entità.</rdfs:comment>
        <rdfs:comment xml:lang="en">The relationship existing between a time entity and any other entity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is time of</rdfs:label>
        <rdfs:label xml:lang="it">è tempo di</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isUniqueIdentifierOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isUniqueIdentifierOf">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/isCharacteristicOf"/>
        <rdfs:comment xml:lang="en">La relazione che sussiste tra un identificatore univoco e l&apos;entità che identifica.</rdfs:comment>
        <rdfs:comment xml:lang="en">The relation holding between a unique identifier and the entity it identifies.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is unique identifier of</rdfs:label>
        <rdfs:label xml:lang="it">è identificativo univoco di</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isUnitOfMeasureOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isUnitOfMeasureOf">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/isCharacteristicOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/UnitOfMeasure"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:comment xml:lang="en">Property that links a unit of measure to the object or measured value.</rdfs:comment>
        <rdfs:comment xml:lang="it">Proprietà che collega un&apos;unità di misura all&apos;oggetto o al valore misurato.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is unit of measure of</rdfs:label>
        <rdfs:label xml:lang="it">è unità di misura di</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isUpperBoundaryOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isUpperBoundaryOf">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Region"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Interval"/>
        <rdfs:comment xml:lang="en">The relation between a Region and an Interval of which it is the upper boundary.</rdfs:comment>
        <rdfs:comment xml:lang="it">La relazione tra una Region e un Interval di cui costituisce l&apos;estremo superiore.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is upper boundary of</rdfs:label>
        <rdfs:label xml:lang="it">è estremo superiore di</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/isValueOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/isValueOf">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/isCharacteristicOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Value"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:comment xml:lang="it">La relazione esistente tra un valore ed un&apos;entità a cui tale valore è associato.</rdfs:comment>
        <rdfs:comment xml:lang="en">The relationship between a value and an entity to which that value is associated.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">is value of</rdfs:label>
        <rdfs:label xml:lang="it">è valore di</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/issues -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/issues">
        <rdfs:comment xml:lang="en">The relation that allows one to state that a certain agent issues a certain entity.</rdfs:comment>
        <rdfs:comment xml:lang="it">La relazione che consente di affermare che un determinato agente emette una certa entità.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">issues</rdfs:label>
        <rdfs:label xml:lang="it">emette</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/parametrises -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/parametrises">
        <rdfs:comment xml:lang="it">La relazione tra un Parameter, ad es. &apos;LimiteMaggioreEtà&apos;, e una Region, ad es. &apos;18_anni&apos;.
Per una relazione più orientata ai dati, si veda hasDataValue.</rdfs:comment>
        <rdfs:comment xml:lang="en">The relation between a Parameter, e.g. &apos;MajorAgeLimit&apos;, and a Region, e.g. &apos;18_year&apos;.
For a more data-oriented relation, see hasDataValue</rdfs:comment>
        <skos:scopeNote xml:lang="en">In the top-level the range is widened from Region to Entity.</skos:scopeNote>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/classifies"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Parameter"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <skos:scopeNote xml:lang="it">La relazione che sussiste tra un parametro e l&apos;entità oggetto della parametrizzazione.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">The relation holding between a parameter and the entity being object of the parametrisation.</skos:scopeNote>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">parametrises</rdfs:label>
        <rdfs:label xml:lang="it">parametrizza</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/precedes -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/precedes">
        <rdfs:comment xml:lang="en">A relation between entities, expressing a &apos;sequence&apos; schema. 
E.g. &apos;year 1999 precedes 2000&apos;, &apos;deciding what coffee to use&apos; precedes &apos;preparing coffee&apos;, &apos;World War II follows World War I&apos;, &apos;in the Milan to Rome autoroute, Bologna precedes Florence&apos;, etc.
It can then be used between tasks, processes, time intervals, spatially locate objects, situations, etc. 
Subproperties can be defined in order to distinguish the different uses.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:comment xml:lang="it">Una relazione tra entità, che esprime uno schema di &apos;sequenza&apos;.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">precede</rdfs:label>
        <rdfs:label xml:lang="en">precedes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/satisfies -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/satisfies">
        <rdfs:comment xml:lang="it">Una relazione tra una Situation e una Description, ad es. l&apos;esecuzione di un Plan soddisfa quel piano.</rdfs:comment>
        <rdfs:comment xml:lang="en">A relation between a Situation and a Description, e.g. the execution of a Plan satisfies that plan.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Situation"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Description"/>
        <skos:scopeNote xml:lang="it">La proprietà usata per asserire che un&apos;eventualità soddisfa una certa descrizione.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">The property for asserting that an eventuality satisfies a description.</skos:scopeNote>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">satisfies</rdfs:label>
        <rdfs:label xml:lang="it">soddisfa</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/specialises -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/specialises">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:comment xml:lang="it">La proprietà per esprimere relazioni di specializzazione.</rdfs:comment>
        <rdfs:comment xml:lang="en">The property for expressing specialisation relations.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">specialises</rdfs:label>
        <rdfs:label xml:lang="it">specializza</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/specializes -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/specializes">
        <rdfs:comment xml:lang="it">Una relazione d&apos;ordine parziale tra oggetti sociali.
Rappresenta principalmente la relazione di sussunzione tra, ad es., un Concept o una Description e un altro Concept (risp. Description) più ampio nell&apos;interpretazione estensionale, ma più ristretto nell&apos;interpretazione intensionale. Ad esempio, il ruolo DottorandoDiRicerca specializza il ruolo Studente.
Un altro uso possibile è tra una Collection coperta (isCoveredBy) da un Concept A e un&apos;altra Collection coperta da un Concept B che a sua volta specializza A. Ad esempio, la Collection dei sassofoni Selmer Mark VI della serie 70.000 specializza la Collection dei sassofoni Selmer Mark VI.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/specialises"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/SocialObject"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/SocialObject"/>
        <rdfs:comment>A partial order relation that holds between social objects. 
It mainly represents the subsumption relation between e.g. a Concept or Description and another Concept (resp. Description) that is broader in extensional interpretation, but narrower in intensional interpretation. For example, the role PhDStudent specializes the role Student.
Another possible use is between a Collection that isCoveredBy a Concept A, and another Collection that isCoveredBy a Concept B that on its turm specializes A. For example, the 70,000 series Selmer Mark VI saxophone Collection specializes the Selmer Mark VI saxophone Collection.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">specializes</rdfs:label>
        <rdfs:label xml:lang="it">specializza</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/usesConcept -->

    <owl:ObjectProperty rdf:about="https://w3id.org/hacid/onto/top-level/usesConcept">
        <rdfs:comment xml:lang="it">Una relazione generica tra una Description e un Concept. Per essere usato, un Concept deve essere stato prima definito (definedIn) in un&apos;altra Description. Quest&apos;ultima condizione non può essere codificata per le object property in OWL.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/associatedWith"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Description"/>
        <rdfs:range rdf:resource="https://w3id.org/hacid/onto/top-level/Concept"/>
        <rdfs:comment xml:lang="en">A generic relation holding between a Description and a Concept. In order to be used, a Concept must be previously definedIn another Description. This last condition cannot be encoded for object properties in OWL.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">usa il concetto</rdfs:label>
        <rdfs:label xml:lang="en">uses concept</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/hacid/onto/top-level/acronym -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/hacid/onto/top-level/acronym">
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="en">A value for the acronym that is used for referring to an entity.</rdfs:comment>
        <rdfs:comment xml:lang="it">Un valore per l&apos;acronimo utilizzato per fare riferimento a un&apos;entità.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">acronimo</rdfs:label>
        <rdfs:label xml:lang="en">acronym</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/altLabel -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/hacid/onto/top-level/altLabel">
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">An alternative label (in respect to rdfs:label).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">alt label</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/componentIdentifier -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/hacid/onto/top-level/componentIdentifier">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/identifier"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:comment xml:lang="en">The literal value of an identifier, local to the parent entity in a top:hasComponent hierarchy. It is well defined if and only if the subject entity has a single parent.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">component identifier</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/definition -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/hacid/onto/top-level/definition">
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Concept"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="en">A statement or formal explanation of the meaning of a concept.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">definition</rdfs:label>
        <rdfs:label xml:lang="it">definizione</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/endTime -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/hacid/onto/top-level/endTime">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/time"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/upperBoundaryValue"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/TimeInterval"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">The end of a TimeInterval, i.e. its upper boundary, as an xsd:dateTime literal.</rdfs:comment>
        <rdfs:comment xml:lang="it">La fine di un TimeInterval, cioè il suo estremo superiore, come letterale xsd:dateTime.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">end time</rdfs:label>
        <rdfs:label xml:lang="it">tempo di fine</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/hasDataValue -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/hacid/onto/top-level/hasDataValue">
        <rdfs:comment xml:lang="it">Una proprietà di tipo datatype che codifica, per un&apos;Entity, valori di un datatype.
In DOLCE (Ultralite) ci sono diversi modi per codificare valori:

1) asserire direttamente un valore xsd:_ per un&apos;Entity usando hasDataValue;
2) asserire una Region per un&apos;Entity usando hasRegion, e poi asserire un valore xsd:_ per quella Region usando hasRegionDataValue;
3) asserire una Quality per un&apos;Entity usando hasQuality, poi asserire una Region per quella Quality, e asserire un valore xsd:_ per quella Region usando hasRegionDataValue;
4) quando il valore è richiesto ma non osservato direttamente, asserire un Parameter per un valore xsd:_ usando hasParameterDataValue, e poi associare il Parameter a un&apos;Entity usando isConstraintFor;
5) quando il valore è richiesto ma non osservato direttamente, si può anche asserire un Parameter per una Region usando parametrizes, e poi asserire un valore xsd:_ per quella Region usando hasRegionDataValue.

I cinque approcci rispondono a requisiti diversi.
Ad esempio, un valore semplice può essere asserito facilmente con il pattern (1), ma se si deve asserire un intervallo tra due valori, si dovrebbe introdurre una Region per materializzare quell&apos;intervallo, come suggerisce il pattern (2).
Inoltre, se si deve distinguere la Quality individuale di un valore, ad es. la natura particolare della densità di una sostanza, si può usare il pattern (3).
I pattern (4) e (5) dovrebbero invece essere usati quando si modella un vincolo o una selezione, indipendentemente dall&apos;osservazione effettiva dei valori nel mondo reale.</rdfs:comment>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:comment xml:lang="en">A datatype property that encodes values from a datatype for an Entity. 
There are several ways to encode values in DOLCE (Ultralite):

1) Directly assert an xsd:_ value to an Entity by using hasDataValue
2) Assert a Region for an Entity by using hasRegion, and then assert an xsd:_ value to that Region, by using hasRegionDataValue
3) Assert a Quality for an Entity by using hasQuality, then assert a Region for that Quality, and assert an xsd:_ value to that Region, by using hasRegionDataValue
4) When the value is required, but not directly observed, assert a Parameter for an xsd:_ value by using hasParameterDataValue, and then associate the Parameter to an Entity by using isConstraintFor
5) When the value is required, but not directly observed, you can also assert a Parameter for a Region by using parametrizes, and then assert an xsd:_ value to that Region, by using hasRegionDataValue

The five approaches obey different requirements. 
For example, a simple value can be easily asserted by using pattern (1), but if one needs to assert an interval between two values, a Region should be introduced to materialize that interval, as pattern (2) suggests. 
Furthermore, if one needs to distinguish the individual Quality of a value, e.g. the particular nature of the density of a substance, pattern (3) can be used. 
Patterns (4) and (5) should be used instead when a constraint or a selection is modeled, independently from the actual observation of values in the real world.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">ha valore</rdfs:label>
        <rdfs:label xml:lang="en">has data value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/hasRegionDataValue -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/hacid/onto/top-level/hasRegionDataValue">
        <rdfs:comment xml:lang="it">Una proprietà di tipo datatype che codifica valori per una Region, ad es. un float per la Region Altezza.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/hasDataValue"/>
        <rdfs:label xml:lang="it">regione ha valore</rdfs:label>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Region"/>
        <rdfs:comment xml:lang="en">A datatype property that encodes values for a Region, e.g. a float for the Region Height.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">has region data value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/identifier -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/hacid/onto/top-level/identifier">
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:comment xml:lang="it">Il valore letterale di un identificativo, ex. il codice WMO &apos;6100218&apos;.</rdfs:comment>
        <rdfs:comment xml:lang="en">The literal value of an identifier, e.g. the WMO code &apos;6100218&apos;.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">identificativo</rdfs:label>
        <rdfs:label xml:lang="en">identifier</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/lowerBoundaryValue -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/hacid/onto/top-level/lowerBoundaryValue">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/hasRegionDataValue"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Interval"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="en">The literal value of the lower boundary of an Interval in a linear dimensional space, e.g. 10 for the temperature range from 10 to 20 degrees Celsius. It is a shortcut for hasLowerBoundary followed by hasRegionDataValue. The unit of measure, if any, is the one of the Interval.</rdfs:comment>
        <rdfs:comment xml:lang="it">Il valore letterale dell&apos;estremo inferiore di un Interval in uno spazio dimensionale lineare, ad es. 10 per l&apos;intervallo di temperatura da 10 a 20 gradi Celsius. È una scorciatoia per hasLowerBoundary seguita da hasRegionDataValue. L&apos;eventuale unità di misura è quella dell&apos;Interval.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">lower boundary value</rdfs:label>
        <rdfs:label xml:lang="it">valore dell&apos;estremo inferiore</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/name -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/hacid/onto/top-level/name">
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">Il letterale che rappresenta il nome di un&apos;entità.</rdfs:comment>
        <rdfs:comment xml:lang="en">The literal representing the name of an entity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">name</rdfs:label>
        <rdfs:label xml:lang="it">nome</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/startTime -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/hacid/onto/top-level/startTime">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/time"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/lowerBoundaryValue"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/TimeInterval"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">The start of a TimeInterval, i.e. its lower boundary, as an xsd:dateTime literal.</rdfs:comment>
        <rdfs:comment xml:lang="it">L&apos;inizio di un TimeInterval, cioè il suo estremo inferiore, come letterale xsd:dateTime.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">start time</rdfs:label>
        <rdfs:label xml:lang="it">tempo di inizio</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/symbol -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/hacid/onto/top-level/symbol">
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:comment xml:lang="en">Property used to specify a symbol. For instance the symbol of a unit of measure</rdfs:comment>
        <rdfs:comment xml:lang="it">Proprietà  utilizzata per specificare un simbolo. Ad esempio il simbolo dell&apos;unità di misura</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">simbolo</rdfs:label>
        <rdfs:label xml:lang="en">symbol</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/time -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/hacid/onto/top-level/time">
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="it">La proprietà per associare la rappresentazione letterale del tempo a un&apos;entità.</rdfs:comment>
        <rdfs:comment xml:lang="en">The property for associating the literal representation of time to an entity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">tempo</rdfs:label>
        <rdfs:label xml:lang="en">time</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/upperBoundaryValue -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/hacid/onto/top-level/upperBoundaryValue">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/hacid/onto/top-level/hasRegionDataValue"/>
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Interval"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="en">The literal value of the upper boundary of an Interval in a linear dimensional space, e.g. 20 for the temperature range from 10 to 20 degrees Celsius. It is a shortcut for hasUpperBoundary followed by hasRegionDataValue. The unit of measure, if any, is the one of the Interval.</rdfs:comment>
        <rdfs:comment xml:lang="it">Il valore letterale dell&apos;estremo superiore di un Interval in uno spazio dimensionale lineare, ad es. 20 per l&apos;intervallo di temperatura da 10 a 20 gradi Celsius. È una scorciatoia per hasUpperBoundary seguita da hasRegionDataValue. L&apos;eventuale unità di misura è quella dell&apos;Interval.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">upper boundary value</rdfs:label>
        <rdfs:label xml:lang="it">valore dell&apos;estremo superiore</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/hacid/onto/top-level/value -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/hacid/onto/top-level/value">
        <rdfs:domain rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="it">La rappresentazione letterale di un valore.</rdfs:comment>
        <rdfs:comment xml:lang="en">The literal representation of a value.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">valore</rdfs:label>
        <rdfs:label xml:lang="en">value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/hacid/onto/top-level/Abstract -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/Abstract">
        <rdfs:comment xml:lang="it">Qualsiasi Entity che non può essere localizzata nello spazio-tempo. Ad es. entità matematiche: entità formali semantiche, regioni in spazi dimensionali, ecc.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <owl:disjointWith rdf:resource="https://w3id.org/hacid/onto/top-level/Event"/>
        <owl:disjointWith rdf:resource="https://w3id.org/hacid/onto/top-level/Object"/>
        <owl:disjointWith rdf:resource="https://w3id.org/hacid/onto/top-level/Quality"/>
        <rdfs:comment xml:lang="en">Any Entity that cannot be located in space-time. E.g. mathematical entities: formal semantics elements, regions within dimensional spaces, etc.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">Abstract</rdfs:label>
        <rdfs:label xml:lang="it">Astratto</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/Action -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/Action">
        <rdfs:comment xml:lang="it">Un Event con almeno un Agent che vi partecipa (isParticipantIn) e che esegue un Task, tipicamente definito (isDefinedIn) in un Plan, un Workflow, un Project, ecc.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/hasParticipant"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/hacid/onto/top-level/Agent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/executesTask"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Event"/>
        <rdfs:comment xml:lang="en">An Event with at least one Agent that isParticipantIn it, and that executes a Task that typically isDefinedIn a Plan, Workflow, Project, etc.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">Action</rdfs:label>
        <rdfs:label xml:lang="it">Azione</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/Agent -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/Agent">
        <rdfs:comment xml:lang="it">Commento aggiuntivo: un agente computazionale può essere considerato come un PhysicalAgent che realizza una certa classe di algoritmi (che possono essere considerati istanze di InformationObject), i quali permettono di ottenere comportamenti considerati tipici degli agenti in generale. Per un&apos;ontologia degli oggetti computazionali basata su DOLCE si vedano ad es. http://www.loa-cnr.it/COS/COS.owl e http://www.loa-cnr.it/KCO/KCO.owl.</rdfs:comment>
        <rdfs:comment xml:lang="it">Qualsiasi Object agentivo, sia fisico (ad es. una balena, un robot, una quercia) sia sociale (ad es. una società, un&apos;istituzione, una comunità).</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Object"/>
        <rdfs:comment xml:lang="en">Additional comment: a computational agent can be considered as a PhysicalAgent that realizes a certain class of algorithms (that can be considered as instances of InformationObject) that allow to obtain some behaviors that are considered typical of agents in general. For an ontology of computational objects based on DOLCE see e.g. http://www.loa-cnr.it/COS/COS.owl, and http://www.loa-cnr.it/KCO/KCO.owl.</rdfs:comment>
        <rdfs:comment xml:lang="en">Any agentive Object , either physical (e.g. a whale, a robot, an oak), or social (e.g. a corporation, an institution, a community).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">Agent</rdfs:label>
        <rdfs:label xml:lang="it">Agente</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/Amount -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/Amount">
        <rdfs:comment xml:lang="it">Una quantità, indipendentemente da come viene misurata, calcolata, ecc.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Region"/>
        <owl:disjointWith rdf:resource="https://w3id.org/hacid/onto/top-level/TimeInterval"/>
        <rdfs:comment>A quantity, independently from how it is measured, computed, etc.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">Amount</rdfs:label>
        <rdfs:label xml:lang="it">Quantità</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/Characteristic -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/Characteristic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:comment xml:lang="it">La classe delle caratteristiche, intese come aspetti, attributi o qualità di un&apos;entità. Ex. una quantità, qualità estetica, colore, etc.</rdfs:comment>
        <rdfs:comment xml:lang="en">The class of characteristics, intended as any aspect, attribuite, or quality of an entity. E.g. a certain size, aesthetic quality, color, etc.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">Caratteristica</rdfs:label>
        <rdfs:label xml:lang="en">Characteristic</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/Collection -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/Collection">
        <rdfs:comment xml:lang="it">Qualsiasi contenitore di entità che condividono una o più proprietà comuni. Ad es. &quot;gli oggetti di pietra&quot;, &quot;le infermiere&quot;, &quot;la collezione egizia del Louvre&quot;, tutte le elezioni del Presidente della Repubblica Italiana.
Una collezione non è una classe logica: una collezione è un&apos;entità del primo ordine, mentre una classe è del secondo ordine.
Una collezione non è nemmeno un aggregato delle entità che ne sono membri (si veda ad es. la classe ObjectAggregate).</rdfs:comment>
        <rdfs:comment xml:lang="en">Any container for entities that share one or more common properties. E.g. &quot;stone objects&quot;, &quot;the nurses&quot;, &quot;the Louvre Aegyptian collection&quot;, all the elections for the Italian President of the Republic. 
A collection is not a logical class: a collection is a first-order entity, while a class is second-order.
A collection is neither an aggregate of its member entities (see e.g. ObjectAggregate class).</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/SocialObject"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/hasMember"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/hasPart"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/hacid/onto/top-level/Collection"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:scopeNote xml:lang="it">La classe per rappresentare collezioni che rendono possibile l&apos;aggregazione di oggetti.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">The class for representing collections and aggregating objects into collections.</skos:scopeNote>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">Collection</rdfs:label>
        <rdfs:label xml:lang="it">Collezione</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/Concept -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/Concept">
        <rdfs:comment xml:lang="it">Un Concept è un SocialObject ed è definito (isDefinedIn) in qualche Description; una volta definito, un Concept può essere usato in altre Description. Se un Concept è definito in esattamente una Description, si veda la classe LocalConcept.
La relazione classifies collega Concept a Entity in un certo TimeInterval.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/hasPart"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/hacid/onto/top-level/Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/hacid/onto/top-level/SocialAgent"/>
        <rdfs:comment xml:lang="en">A Concept is a SocialObject, and isDefinedIn some Description; once defined, a Concept can be used in other Description(s). If a Concept isDefinedIn exactly one Description, see the LocalConcept class.
The classifies relation relates Concept(s) to Entity(s) at some TimeInterval</rdfs:comment>
        <owl:disjointWith rdf:resource="https://w3id.org/hacid/onto/top-level/Situation"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/SocialObject"/>
        <skos:scopeNote xml:lang="en">It is an object that is defined in some description. Once defined it can be used in other descriptions</skos:scopeNote>
        <skos:scopeNote xml:lang="it">È un oggetto che è definito in qualche descrizione. Una volta definito può essere utilizzato in altre descrizioni</skos:scopeNote>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">Concept</rdfs:label>
        <rdfs:label xml:lang="it">Concetto</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/ConceptScheme -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/ConceptScheme">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Description"/>
        <rdfs:comment xml:lang="en">A set of concepts, optionally including statements about semantic relationships between those concepts.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">Concept scheme</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/Description -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/Description">
        <rdfs:comment xml:lang="it">Una Description è un SocialObject che rappresenta una concettualizzazione.
Può essere pensata anche come un &apos;contesto descrittivo&apos; che usa o definisce concetti per creare una vista su un &apos;contesto relazionale&apos; (cfr. Situation) a partire da un insieme di dati o osservazioni.
Ad esempio, un Plan è una Description di alcune azioni da eseguire da parte di agenti in un certo modo, con certi parametri; una Diagnosis è una Description che fornisce un&apos;interpretazione di un insieme di entità osservate, ecc.
Le Description &apos;definiscono&apos; o &apos;usano&apos; concetti, e possono essere &apos;soddisfatte&apos; da situazioni.</rdfs:comment>
        <owl:disjointWith rdf:resource="https://w3id.org/hacid/onto/top-level/SocialAgent"/>
        <rdfs:comment xml:lang="en">A Description is a SocialObject that represents a conceptualization. 
It can be thought also as a &apos;descriptive context&apos; that uses or defines concepts in order to create a view on a &apos;relational context&apos; (cf. Situation) out of a set of data or observations. 
For example, a Plan is a Description of some actions to be executed by agents in a certain way, with certain parameters; a Diagnosis is a Description that provides an interpretation for a set of observed entities, etc.
Descriptions &apos;define&apos; or &apos;use&apos; concepts, and can be &apos;satisfied&apos; by situations.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/SocialObject"/>
        <owl:disjointWith rdf:resource="https://w3id.org/hacid/onto/top-level/Situation"/>
        <skos:scopeNote xml:lang="it">La classe degli oggetti costruiti socialmente (testi, valori, categorie, relazioni, contesti) usati per descrivere qualcos&apos;altro in modo structuratto. Gli esempi includono i piani (come descrizioni strutturate di azioni da eseguire ex. in un processo industriale), le diagnosi (come descrizioni strutturate di situazioni osservate ex. clinicamente), le spiegazioni (come testi strutturati per chiarire ex. un concetto in un sistema normativo), osservazioni oggettive (come insiemi di valori strutturati che identificano una situazione rilevante ex. da un sistema di sensori).</skos:scopeNote>
        <skos:scopeNote xml:lang="en">The class of socially-created objects (texts, values, categories, relations, contexts) used to describe something else in a structured way. Examples include plans (as structured descriptions of actions to be executed), diagnoses (as structured descriptions of observed situations, explanations (as structured texts clarifying e.g. a concept), objective observations (as structured sets of values that identify a relevant situation).</skos:scopeNote>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">Description</rdfs:label>
        <rdfs:label xml:lang="it">Descrizione</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/Entity -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/Entity">
        <rdfs:comment xml:lang="it">Qualsiasi cosa, reale, possibile o immaginaria, di cui un modellatore voglia parlare per qualche scopo.</rdfs:comment>
        <rdfs:comment xml:lang="en">Anything: real, possible, or imaginary, which some modeller wants to talk about for some purpose.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">Entity</rdfs:label>
        <rdfs:label xml:lang="it">Entità</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/Event -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/Event">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/hasConstituent"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/hacid/onto/top-level/Event"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Any physical, social, or mental process, event, or state.

More theoretically, events can be classified in different ways, possibly based on &apos;aspect&apos; (e.g. stative, continuous, accomplishement, achievement, etc.), on &apos;agentivity&apos; (e.g. intentional, natural, etc.), or on &apos;typical participants&apos; (e.g. human, physical, abstract, food, etc.).
Here no special direction is taken, and the following explains why: events are related to observable situations, and they can have different views at a same time.
If a position has to be suggested here anyway, the participant-based classification of events seems the most stable and appropriate for many modelling problems.

(1) Alternative aspectual views

Consider a same event &apos;rock erosion in the Sinni valley&apos;: it can be conceptualized as an accomplishment (what has brought a certain state to occur), as an achievement (the state resulting from a previous accomplishment), as a punctual event (if we collapse the time interval of the erosion into a time point), or as a transition (something that has changed from a state to a different one). 
In the erosion case, we could therefore have good motivations to shift from one aspect to another: a) causation focus, b) effectual focus, c) historical condensation, d) transition (causality).

The different views refer to the same event, but are still different: how to live with this seeming paradox? 
A typical solution e.g. in linguistics (cf. Levin&apos;s aspectual classes) and in DOLCE Full (cf. WonderWeb D18 axiomatization) is to classify events based on aspectual differences. But this solution would create different identities for a same event, where the difference is only based on the modeller&apos;s attitude.
An alternative solution is suggested here, and exploits the notion of (observable) Situation; a Situation is a view, consistent with a Description, which can be observed of a set of entities. It can also be seen as a &apos;relational context&apos; created by an observer on the basis of a &apos;frame&apos;. Therefore, a Situation allows to create a context where each particular view can have a proper identity, while the Event preserves its own identity. 
For example, ErosionAsAccomplishment is a Situation where rock erosion is observed as a process leading to a certain achievement: the conditions (roles, parameters) that suggest such view are stated in a Description, which acts as a &apos;theory of accomplishments&apos;. Similarly, ErosionAsTransition is a Situation where rock erosion is observed as an event that has changed a state to another: the conditions for such interpretation are stated in a different Description, which acts as a &apos;theory of state transitions&apos;.
Consider that in no case the actual event is changed or enriched in parts by the aspectual view.

(2) Alternative intentionality views

Similarly to aspectual views, several intentionality views can be provided for a same Event. For example, one can investigate if an avalanche has been caused by immediate natural forces, or if there is any hint of an intentional effort to activate those natural forces.
Also in this case, the Event as such has not different identities, while the causal analysis generates situations with different identities, according to what Description is taken for interpreting the Event. 
On the other hand, if the possible actions of an Agent causing the starting of an avalanche are taken as parts of the Event, then this makes its identity change, because we are adding a part to it. 
Therefore, if intentionality is a criterion to classify events or not, this depends on if an ontology designer wants to consider causality as a relevant dimension for events&apos; identity.

(3) Alternative participant views

A slightly different case is when we consider the basic participants to an Event. In this case, the identity of the Event is affected by the participating objects, because it depends on them. 
For example, if snow, mountain slopes, wind, waves, etc. are considered as an avalanche basic participants, or if we also want to add water, human agents, etc., that makes the identity of an avalanche change.
Anyway, this approach to event classification is based on the designer&apos;s choices, and more accurately mirrors lexical or commonsense classifications (see. e.g. WordNet &apos;supersenses&apos; for verb synsets).

Ultimately, this discussion has no end, because realists will keep defending the idea that events in reality are not changed by the way we describe them, while constructivists will keep defending the idea that, whatever &apos;true reality&apos; is about, it can&apos;t be modelled without the theoretical burden of how we observe and describe it. 
Both positions are in principle valid, but, if taken too radically, they focus on issues that are only partly relevant to the aim of computational ontologies, which assist domain experts in representing a certain portion of reality according to their own assumptions and requirements. 

For this reason, in this ontology version of DOLCE, both events and situations are allowed, together with descriptions (the reason for the inclusion of the D&amp;S framewrok in DOLCE), in order to encode the modelling needs, independently from the position (if any) chosen by the model designer.</rdfs:comment>
        <owl:disjointWith rdf:resource="https://w3id.org/hacid/onto/top-level/Quality"/>
        <owl:disjointWith rdf:resource="https://w3id.org/hacid/onto/top-level/Object"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/hasPart"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/hacid/onto/top-level/Event"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="it">Qualsiasi processo, evento o stato fisico, sociale o mentale.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">Event</rdfs:label>
        <rdfs:label xml:lang="it">Evento</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/EventType -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/EventType">
        <rdfs:comment xml:lang="it">Un Concept che classifica un Event. Un tipo di evento descrive come un Event dovrebbe essere interpretato, eseguito, atteso, visto, ecc., secondo la Description in cui l&apos;EventType è definito (isDefinedIn) o usato.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/classifies"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/hacid/onto/top-level/Event"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Concept"/>
        <owl:disjointWith rdf:resource="https://w3id.org/hacid/onto/top-level/Parameter"/>
        <owl:disjointWith rdf:resource="https://w3id.org/hacid/onto/top-level/Role"/>
        <rdfs:comment xml:lang="en">A Concept that classifies an Event . An event type describes how an Event should be interpreted, executed, expected, seen, etc., according to the Description that the EventType isDefinedIn (or used in)</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">Event type</rdfs:label>
        <rdfs:label xml:lang="it">Tipo di evento</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/FormalEntity -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/FormalEntity">
        <rdfs:comment xml:lang="en">Entities that are formally defined and are considered independent from the social context in which they are used. They cannot be localized in space or time. Also called &apos;Platonic entities&apos;.
Mathematical and logical entities are included in this class: sets, categories, tuples, costants, variables, etc.
Abstract formal entities are distinguished from information objects, which are supposed to be part of a social context, and are localized in space and time, therefore being (social) objects.
For example, the class &apos;Quark&apos; is an abstract formal entity from the purely set-theoretical perspective, but it is an InformationObject from the viewpoint of ontology design, when e.g. implemented in a logical language like OWL.
Abstract formal entities are also distinguished from Concept(s), Collection(s), and Description(s), which are part of a social context, therefore being SocialObject(s) as well.
For example, the class &apos;Quark&apos; is an abstract FormalEntity from the purely set-theoretical perspective, but it is a Concept within history of science and cultural dynamics.

These distinctions allow to represent two different notions of &apos;semantics&apos;: the first one is abstract and formal (&apos;formal semantics&apos;), and formallyInterprets symbols that are about entities whatsoever; for example, the term &apos;Quark&apos; isAbout the Collection of all quarks, and that Collection isFormalGroundingFor the abstract class &apos;Quark&apos; (in the extensional sense). 
The second notion is social, localized in space-time (&apos;social semantics&apos;), and can be used to interpret entities in the intensional sense. For example, the Collection of all quarks isCoveredBy the Concept &apos;Quark&apos;, which is also expressed by the term &apos;Quark&apos;.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Abstract"/>
        <rdfs:comment xml:lang="it">Entità formalmente definite e considerate indipendenti dal contesto sociale in cui vengono utilizzate. Non possono essere localizzati nello spazio o nel tempo. Chiamate anche &quot;entità platoniche&quot;.
In questa classe sono incluse le entità matematiche e logiche: insiemi, categorie, tuple, costanti, variabili, ecc.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">Entità formale astratta</rdfs:label>
        <rdfs:label xml:lang="en">Formal entity</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/Goal -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/Goal">
        <rdfs:comment xml:lang="it">La Description di una Situation desiderata da un Agent, solitamente associata a un Plan che descrive come raggiungerla effettivamente.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Description"/>
        <rdfs:comment xml:lang="en">The Description of a Situation that is desired by an Agent, and usually associated to a Plan that describes how to actually achieve it</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">Goal</rdfs:label>
        <rdfs:label xml:lang="it">Scopo</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/IdentifierSchema -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/IdentifierSchema">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Description"/>
        <rdfs:comment xml:lang="en">A schema for identifiers.</rdfs:comment>
        <rdfs:comment xml:lang="it">Uno schema di identificativi.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">Identifier schema</rdfs:label>
        <rdfs:label xml:lang="it">Schema di identificatori</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/InformationEntity -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/InformationEntity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:comment xml:lang="en">A piece of information, be it concretely realised or not. It is a catchall class, intended to bypass the ambiguities of many data or text that could denote either a an expression or a concrete realisation of that expression.
In a semiotic model, there is no special reason to distinguish between them, however we may want to distinguish between a pure information content (e.g. the 3rd Gymnopedie by Satie), and its possible concrete realisations as a music sheet, a piano execution, the reproduction of the execution, its publishing as a record, etc.).</rdfs:comment>
        <rdfs:comment xml:lang="it">Un&apos;informazione, concretamente realizzata o meno. È una classe generica, intesa a superare le ambiguità di molti dati o testo che potrebbero denotare un&apos;espressione o una realizzazione concreta di tale espressione.
In un modello semiotico non vi è alcuna ragione particolare per distinguerli, tuttavia potremmo voler distinguere tra un contenuto puramente informativo (ad esempio la 3a Gymnopedie di Satie) e le sue possibili realizzazioni concrete come uno spartito, un&apos;esecuzione pianistica, il riproduzione dell&apos;esecuzione, sua pubblicazione in forma verbale, ecc.).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">Entità informativa</rdfs:label>
        <rdfs:label xml:lang="en">Information entity</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/InformationRole -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/InformationRole">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Role"/>
        <rdfs:comment xml:lang="en">A role that classifies information.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">Information role</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/InputInformationRole -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/InputInformationRole">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/InformationRole"/>
        <rdfs:comment xml:lang="en">A role that classifies information and corresponds to a process input in a particular context.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">Input information role</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/Interval -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/Interval">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Region"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/hasLowerBoundary"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/hacid/onto/top-level/Region"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/hasUpperBoundary"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/hacid/onto/top-level/Region"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/lowerBoundaryValue"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/upperBoundaryValue"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A Region delimited by a lower and an upper boundary.
In the linear case, i.e. in a one-dimensional dimensional space whose points are totally ordered (e.g. time, temperature, altitude), an Interval is the set of the points lying between its lower boundary and its upper boundary, e.g. the period from 1991 to 2020, or the temperatures from 10 to 20 degrees Celsius.
The definition extends to any dimensional space whose points are (possibly partially) ordered: an Interval is the set of the points x such that lower boundary ≤ x ≤ upper boundary. In a multi-dimensional space ordered component-wise (e.g. latitude × longitude, or the combination of several quantities), the two boundaries are opposite corners and the Interval is a box (hyperrectangle), i.e. the Cartesian product of the linear intervals it spans on each dimension, e.g. a latitude-longitude bounding box. In a cyclic dimensional space (e.g. longitude, direction, day of the year), an Interval is the arc going from the lower boundary to the upper boundary in the positive direction, so that e.g. the longitude interval from 170° E to 170° W crosses the antimeridian. The notion does not apply to dimensional spaces with no order, such as nominal ones.
The boundaries are Regions of the same dimensional space (typically points, i.e. degenerate regions) and are given with hasLowerBoundary and hasUpperBoundary; in the linear case their values can also be given directly as literals with lowerBoundaryValue and upperBoundaryValue. An Interval with no boundary on one side is unbounded on that side. Whether the boundaries themselves belong to the Interval (closed, open or half-open interval) is not specified by this class.</rdfs:comment>
        <rdfs:comment xml:lang="it">Una Region delimitata da un estremo inferiore e da un estremo superiore.
Nel caso lineare, cioè in uno spazio dimensionale unidimensionale i cui punti sono totalmente ordinati (ad es. tempo, temperatura, altitudine), un Interval è l&apos;insieme dei punti compresi tra il suo estremo inferiore e il suo estremo superiore, ad es. il periodo dal 1991 al 2020, o le temperature da 10 a 20 gradi Celsius.
La definizione si estende a qualsiasi spazio dimensionale i cui punti siano ordinati (anche parzialmente): un Interval è l&apos;insieme dei punti x tali che estremo inferiore ≤ x ≤ estremo superiore. In uno spazio multidimensionale ordinato componente per componente (ad es. latitudine × longitudine, o la combinazione di più grandezze), i due estremi sono vertici opposti e l&apos;Interval è un parallelepipedo (iperrettangolo), cioè il prodotto cartesiano degli intervalli lineari che esso copre su ciascuna dimensione, ad es. un riquadro di latitudine e longitudine. In uno spazio dimensionale ciclico (ad es. longitudine, direzione, giorno dell&apos;anno), un Interval è l&apos;arco che va dall&apos;estremo inferiore all&apos;estremo superiore in senso positivo, così che ad es. l&apos;intervallo di longitudine da 170° E a 170° O attraversa l&apos;antimeridiano. La nozione non si applica a spazi dimensionali privi di ordine, come quelli nominali.
Gli estremi sono Region dello stesso spazio dimensionale (tipicamente punti, cioè regioni degeneri) e sono indicati con hasLowerBoundary e hasUpperBoundary; nel caso lineare i loro valori possono anche essere indicati direttamente come letterali con lowerBoundaryValue e upperBoundaryValue. Un Interval privo di estremo da un lato è illimitato da quel lato. Questa classe non specifica se gli estremi appartengano all&apos;Interval (intervallo chiuso, aperto o semiaperto).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">Interval</rdfs:label>
        <rdfs:label xml:lang="it">Intervallo</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/Judgement -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/Judgement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:comment xml:lang="it">Il processo di formazione di un&apos;opinione o di valutazione attraverso il discernimento e il confronto.</rdfs:comment>
        <rdfs:comment xml:lang="en">The process of forming an opinion or evaluation by discerning and comparing.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">Giudizio</rdfs:label>
        <rdfs:label xml:lang="en">Judgement</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/Location -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/Location">
        <rdfs:comment xml:lang="it">Localizzazioni dipendenti socialmente o cognitivamente: entità geografiche politiche (Roma, Lesotho) e localizzazioni non materiali determinate dalla presenza di altre entità (&quot;l&apos;area vicino a Roma&quot;) o di eventi o segni di riferimento (&quot;l&apos;area in cui è caduto l&apos;elicottero&quot;), oppure identificate come complementi di altre entità (&quot;l&apos;area sotto il tavolo&quot;), ecc.
In questo senso generico, un Place è una localizzazione &apos;dipendente&apos;. Per le localizzazioni &apos;non dipendenti&apos;, cfr. la classe PhysicalPlace. Per una localizzazione astratta (dimensionale), cfr. la classe SpaceRegion.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/isLocationOf"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Socially or cognitively dependent locations: political geographic entities (Rome, Lesotho), and non-material locations determined by the presence of other entities (&quot;the area close to Rome&quot;) or of pivot events or signs (&quot;the area where the helicopter fell&quot;), as well as identified as complements to other entities (&quot;the area under the table&quot;), etc. 
In this generic sense, a Place is a &apos;dependent&apos; location. For &apos;non-dependent&apos; locations, cf. the PhysicalPlace class. For an abstract (dimensional) location, cf. the SpaceRegion class.</rdfs:comment>
        <skos:scopeNote xml:lang="en">This class replicates dul:Place.</skos:scopeNote>
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/SocialObject"/>
        <skos:scopeNote xml:lang="it">Il concetto più generico per rappresentare ad alto livello qualsiasi tipo di oggetto che possa essere identificato come luogo.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">The most generic concept for any kind of location.</skos:scopeNote>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">Luogo</rdfs:label>
        <rdfs:label xml:lang="en">Place</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/Material -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/Material">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Characteristic"/>
        <rdfs:comment xml:lang="it">La classe dei materiali.</rdfs:comment>
        <rdfs:comment xml:lang="en">The material class</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">Material</rdfs:label>
        <rdfs:label xml:lang="it">Materiale</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/Method -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/Method">
        <rdfs:comment xml:lang="it">Un metodo è una Description che definisce o usa concetti per guidare l&apos;esecuzione di azioni volte a una soluzione rispetto a un problema.
È diverso da un Plan, perché dei piani possono essere eseguiti per seguire un metodo, ma un metodo può essere seguito eseguendo piani alternativi.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Description"/>
        <rdfs:comment>A method is a Description that defines or uses concepts in order to guide carrying out actions aimed at a solution with respect to a problem. 
It is different from a Plan, because plans could be carried out in order to follow a method, but a method can be followed by executing alternative plans.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">Method</rdfs:label>
        <rdfs:label xml:lang="it">Metodo</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/Object -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/Object">
        <rdfs:comment xml:lang="it">Qualsiasi oggetto fisico, sociale o mentale, o una sostanza. Seguendo DOLCE Full, gli oggetti partecipano sempre a qualche evento (almeno la loro stessa vita) e sono localizzati nello spazio.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/hasPart"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/hacid/onto/top-level/Object"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/hasConstituent"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/hacid/onto/top-level/Object"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/hacid/onto/top-level/Quality"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:comment xml:lang="en">Any physical, social, or mental object, or a substance. Following DOLCE Full, objects are always participating in some event (at least their own life), and are spatially located.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">Object</rdfs:label>
        <rdfs:label xml:lang="it">Oggetto</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/ObjectRoleAssignment -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/ObjectRoleAssignment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Situation"/>
        <rdfs:comment xml:lang="en">The assignement of an object to a role contextualized to a specific situation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">Object role assignement</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/Operation -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/Operation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Description"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Task"/>
        <rdfs:comment xml:lang="en">A task that is not specific to a plan, i.e. it is self described.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">Operation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/Organization -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/Organization">
        <rdfs:comment xml:lang="en">An internally structured, conventionally created SocialAgent, needing a specific Role and Agent that plays it, in order to act.</rdfs:comment>
        <rdfs:comment xml:lang="it">Un agente sociale strutturato internamente e creato convenzionalmente. Per agire, ha bisogno di ruoli e agenti che li ricoprano.</rdfs:comment>
        <skos:scopeNote xml:lang="en">In the top-level, Organization is disjoint with Person.</skos:scopeNote>
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/SocialAgent"/>
        <owl:disjointWith rdf:resource="https://w3id.org/hacid/onto/top-level/Person"/>
        <skos:scopeNote xml:lang="en">An organisation.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Un&apos;organizzazione.</skos:scopeNote>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">Organization</rdfs:label>
        <rdfs:label xml:lang="it">Organizzazione</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/OutputInformationRole -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/OutputInformationRole">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/InformationRole"/>
        <rdfs:comment xml:lang="en">A role that classifies information and corresponds to a process output in a particular context.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">Output information role</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/Parameter -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/Parameter">
        <rdfs:comment xml:lang="it">Un Concept che classifica una Region; la differenza tra una Region e un Parameter è che le regioni rappresentano insiemi di valori osservabili, ad es. l&apos;altezza di un dato edificio, mentre i parametri rappresentano vincoli o selezioni sui valori osservabili, ad es. &apos;MoltoAlto&apos;. Pertanto, i parametri possono essere usati anche per vincolare regioni, ad es. MoltoAlto su un sottoinsieme dei valori della Region Altezza applicata agli edifici, o per aggiungere alle regioni un criterio di selezione esterno, come le unità di misura, ad es. Metro su un sottoinsieme dei valori della Region Lunghezza applicata alle strade.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/hasPart"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/hacid/onto/top-level/Parameter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A Concept that classifies a Region; the difference between a Region and a Parameter is that regions represent sets of observable values, e.g. the height  of a given building, while parameters represent constraints or selections on observable values, e.g. &apos;VeryHigh&apos;. Therefore, parameters can also be used to constrain regions, e.g. VeryHigh on a subset of values of the Region Height applied to buildings, or to add an external selection criterion , such as measurement units, to regions, e.g. Meter on a subset of values from the Region Length applied to the Region Length applied to roads.</rdfs:comment>
        <skos:scopeNote xml:lang="en">In the top-level, Parameter is also a Characteristic.</skos:scopeNote>
        <owl:disjointWith rdf:resource="https://w3id.org/hacid/onto/top-level/Role"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Characteristic"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Concept"/>
        <skos:scopeNote xml:lang="it">La classe dei parametri. Esempio, il parametro di un&apos;osservazione.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">The class of parameters. Example, the parameter of an observation.</skos:scopeNote>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">Parameter</rdfs:label>
        <rdfs:label xml:lang="it">Parametro</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/Person -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/Person">
        <rdfs:comment xml:lang="it">Le persone secondo l&apos;intuizione del senso comune, che apparentemente non distingue tra persone fisiche e persone giuridiche.</rdfs:comment>
        <rdfs:comment xml:lang="en">Persons in commonsense intuition, which does not apparently distinguish between either natural or social persons.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Agent"/>
        <skos:scopeNote xml:lang="en">A person</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Una persona.</skos:scopeNote>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">Person</rdfs:label>
        <rdfs:label xml:lang="it">Persona</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/PhysicalObject -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/PhysicalObject">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/hasPart"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/hacid/onto/top-level/PhysicalObject"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/hacid/onto/top-level/SocialObject"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Object"/>
        <rdfs:comment xml:lang="en">Any Object that has a proper space region. The prototypical physical object has also an associated mass, but the nature of its mass can greatly vary based on the epistemological status of the object (scientifically measured, subjectively possible, imaginary).</rdfs:comment>
        <rdfs:comment xml:lang="it">Qualsiasi oggetto che abbia una propria regione spaziale. L&apos;oggetto fisico prototipico ha anche una massa associata, ma la natura della sua massa può variare notevolmente in base allo status epistemologico dell&apos;oggetto (scientificamente misurato, soggettivamente possibile, immaginario).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">Oggetto fisico</rdfs:label>
        <rdfs:label xml:lang="en">Physical object</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/Plan -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/Plan">
        <rdfs:comment xml:lang="it">Una Description con un Goal esplicito, da raggiungere eseguendo il piano.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/hasComponent"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/hacid/onto/top-level/Goal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Description"/>
        <rdfs:comment xml:lang="en">A Description having an explicit Goal, to be achieved by executing the plan</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">Piano</rdfs:label>
        <rdfs:label xml:lang="en">Plan</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/Quality -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/Quality">
        <rdfs:comment xml:lang="it">Qualsiasi aspetto di un&apos;Entity (ma non una sua parte), che non può esistere senza quell&apos;Entity. Ad esempio, l&apos;aspetto della superficie di uno specifico PhysicalObject, o la luce specifica di un luogo in un certo momento, sono esempi di Quality, mentre la codifica di una Quality in, ad es., un PhysicalAttribute dovrebbe essere modellata come Region.
Dal punto di vista della progettazione, la distinzione Quality-Region è utile solo quando nel dominio del discorso si considerano gli aspetti individuali di un&apos;Entity.
Ad esempio, in un contesto automobilistico sarebbe irrilevante considerare gli aspetti dei finestrini di una specifica automobile, a meno che la fabbrica non voglia verificare uno specifico finestrino rispetto ai parametri di progetto (rilevamento di anomalie).
D&apos;altra parte, nel contesto dell&apos;antiquariato, gli aspetti individuali di uno specifico mobile sono un fuoco principale dell&apos;attenzione e possono costituire il vero valore aggiunto, perché i parametri di progetto dei mobili antichi spesso non sono fissi e non possono essere visti come &apos;anomalie&apos;.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/hasRegion"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/hacid/onto/top-level/Region"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/isQualityOf"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/hasConstituent"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/hacid/onto/top-level/Quality"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/hasPart"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/hacid/onto/top-level/Quality"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Any aspect of an Entity (but not a part of it), which cannot exist without that Entity. For example, the way the surface of a specific PhysicalObject looks like, or the specific light of a place at a certain time, are examples of Quality, while the encoding of a Quality into e.g. a PhysicalAttribute should be modeled as a Region. 
From the design viewpoint, the Quality-Region distinction is useful only when individual aspects of an Entity are considered in a domain of discourse. 
For example, in an automotive context, it would be irrelevant to consider the aspects of car windows for a specific car, unless the factory wants to check a specific window against design parameters (anomaly detection). 
On the other hand, in an antiques context, the individual aspects for a specific piece of furniture are a major focus of attention, and may constitute the actual added value, because the design parameters for old furniture are often not fixed, and may not be viewed as &apos;anomalies&apos;.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">Quality</rdfs:label>
        <rdfs:label xml:lang="it">Qualità</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/Region -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/Region">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/hasPart"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/hacid/onto/top-level/Region"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/precedes"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/hacid/onto/top-level/Region"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/hasConstituent"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/hacid/onto/top-level/Region"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Abstract"/>
        <rdfs:comment xml:lang="en">Any region in a dimensional space (a dimensional space is a maximal Region), which can be used as a value for a quality of an Entity . For example, TimeInterval, SpaceRegion, PhysicalAttribute, Amount, SocialAttribute are all subclasses of Region. 
Regions are not data values in the ordinary knowledge representation sense; in order to get patterns for modelling data, see the properties: representsDataValue and hasDataValue</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/FormalEntity"/>
        <rdfs:comment xml:lang="it">Qualsiasi regione in uno spazio dimensionale (uno spazio dimensionale è una regione massimale), che può essere utilizzata come valore per una qualità di un&apos;entità. Ad esempio, TimeInterval, SpaceRegion, PhysicalAttribute, Amount, SocialAttribute sono tutte sottoclassi di Region.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">Region</rdfs:label>
        <rdfs:label xml:lang="it">Regione</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/Role -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/Role">
        <rdfs:comment xml:lang="it">Un Concept che classifica un Object.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/hasPart"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/hacid/onto/top-level/Role"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A Concept that classifies an Object</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Concept"/>
        <skos:scopeNote xml:lang="it">La classe per rappresentare i ruoli.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">The class for representing roles.</skos:scopeNote>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">Role</rdfs:label>
        <rdfs:label xml:lang="it">Ruolo</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/Situation -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/Situation">
        <rdfs:comment xml:lang="it">Una vista, coerente con una Description (che la &apos;soddisfa&apos;), su un insieme di entità.
Può essere vista anche come un &apos;contesto relazionale&apos; creato da un osservatore sulla base di una &apos;cornice&apos; (cioè una Description).
Ad esempio, una PlanExecution è un contesto che include alcune azioni eseguite da agenti secondo certi parametri e i task attesi da realizzare secondo un Plan; una DiagnosedSituation è un contesto di entità osservate interpretato sulla base di una Diagnosis, ecc.
Situation può rappresentare anche relazioni n-arie reificate, dove isSettingFor è la relazione di più alto livello per tutte le proiezioni binarie della relazione n-aria.
Se usata in un pattern di trasformazione per relazioni n-arie, il progettista dovrebbe aggiungere (alcune o tutte) le chiavi OWL2 corrispondenti alle proiezioni binarie della relazione n-aria a una sottoclasse di Situation. Altrimenti il &apos;vincolo di identificazione&apos; (Calvanese et al., IJCAI 2001) potrebbe essere violato.</rdfs:comment>
        <rdfs:comment xml:lang="en">A view, consistent with (&apos;satisfying&apos;) a Description, on a set of entities. 
It can also be seen as a &apos;relational context&apos; created by an observer on the basis of a &apos;frame&apos; (i.e. a Description). 
For example, a PlanExecution is a context including some actions executed by agents according to certain parameters and expected tasks to be achieved from a Plan; a DiagnosedSituation is a context of observed entities that is interpreted on the basis of a Diagnosis, etc.
Situation is also able to represent reified n-ary relations, where isSettingFor is the top-level relation for all binary projections of the n-ary relation. 
If used in a transformation pattern for n-ary relations, the designer should take care of adding (some or all) OWL2 keys, corresponding to binary projections of the n-ary, to a subclass of Situation. Otherwise the &apos;identification constraint&apos; (Calvanese et al., IJCAI 2001) might be violated.</rdfs:comment>
        <skos:scopeNote xml:lang="en">In HACID, Situation is also used as a catch-all class for eventualities: any event, situation, activity, event type, etc. It abstracts from the formal criteria that distinguish between event occurrences, their types, and constructed objects (situations, tropes, qua-entities) that provide a setting for multiple entities, and it makes sense of ambiguous data that cannot be made more precise, e.g. at the lexical level. This usage follows d0:Eventuality (http://www.ontologydesignpatterns.org/ont/d0.owl); the properties involves/isInvolvedIn and hasEventuality/isEventualityOf reflect it.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">In HACID, Situazione è usata anche come classe generica per le eventualità: qualsiasi evento, situazione, attività, tipo di evento, ecc. Astrae dai criteri formali che distinguono tra occorrenze di eventi, i loro tipi e oggetti costruiti (situazioni, tropi, qua-entità) che forniscono un&apos;ambientazione per più entità, e permette di dare un senso a dati ambigui che non possono essere resi più precisi, ad es. a livello lessicale. Questo uso segue d0:Eventuality (http://www.ontologydesignpatterns.org/ont/d0.owl); le proprietà &apos;coinvolge&apos;/&apos;è coinvolto in&apos; e &apos;ha eventualità&apos;/&apos;è eventualità di&apos; lo riflettono.</skos:scopeNote>
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/satisfies"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/hacid/onto/top-level/Description"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">Situation</rdfs:label>
        <rdfs:label xml:lang="it">Situazione</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/SocialAgent -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/SocialAgent">
        <rdfs:comment xml:lang="it">Qualsiasi individuo la cui esistenza è garantita semplicemente dalla sua comunicabilità sociale e dalla sua capacità di agire (tramite qualche PhysicalAgent).</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Agent"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/SocialObject"/>
        <rdfs:comment xml:lang="en">Any individual whose existence is granted simply by its social communicability and capability of action (through some PhysicalAgent).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">Agente sociale</rdfs:label>
        <rdfs:label xml:lang="en">Social agent</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/SocialObject -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/SocialObject">
        <rdfs:comment xml:lang="it">Qualsiasi Object che esiste solo all&apos;interno di un Event di comunicazione, al quale partecipa almeno un PhysicalObject.
In altre parole, tutti gli oggetti che sono stati o sono creati nel processo di comunicazione sociale: ai fini della comunicazione (InformationObject), per incorporare nuovi individui (SocialAgent, Place), per contestualizzare o interpretare entità esistenti (Description, Concept), o per raccogliere entità esistenti (Collection).
Dipendendo dalla comunicazione, tutti gli oggetti sociali devono essere espressi da qualche oggetto informativo (gli oggetti informativi esprimono se stessi).</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/hasPart"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/hacid/onto/top-level/SocialObject"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Object"/>
        <rdfs:comment xml:lang="en">Any Object that exists only within some communication Event, in which at least one PhysicalObject participates in. 
In other words, all objects that have been or are created in the process of social communication: for the sake of communication (InformationObject), for incorporating new individuals (SocialAgent, Place), for contextualizing or intepreting existing entities (Description, Concept), or for collecting existing entities (Collection).
Being dependent on communication, all social objects need to be expressed by some information object (information objects are self-expressing).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">Oggetto sociale</rdfs:label>
        <rdfs:label xml:lang="en">Social object</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/System -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/System">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:comment xml:lang="en">Any possible kind of system.</rdfs:comment>
        <rdfs:comment xml:lang="it">Ogni possibile tipo di sistema.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">Sistema</rdfs:label>
        <rdfs:label xml:lang="en">System</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/Task -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/Task">
        <rdfs:comment xml:lang="it">Un EventType che classifica un&apos;Action da eseguire.
Ad esempio, raggiungere una destinazione è un task che può essere eseguito compiendo certe azioni, ad es. guidare un&apos;automobile, comprare un biglietto del treno, ecc.
Le azioni per eseguire un task possono anche essere organizzate secondo un Plan diverso da quello che definisce il task (se esiste).
Ad esempio, raggiungere una destinazione potrebbe essere definito da un piano per andare in vacanza, mentre il piano per eseguire il task può consistere nel mettere in sequenza alcuni viaggi.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/isTaskOf"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/hacid/onto/top-level/Role"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/hasPart"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/hacid/onto/top-level/Task"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/isExecutedIn"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/hacid/onto/top-level/Action"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/isTaskDefinedIn"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/hacid/onto/top-level/Description"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/EventType"/>
        <rdfs:comment xml:lang="en">An EventType that classifies an Action to be executed. 
For example, reaching a destination is a task that can be executed by performing certain actions, e.g. driving a car, buying a train ticket, etc. 
The actions to execute a task can also be organized according to a Plan that is not the same as the one that defines the task (if any). 
For example, reaching a destination could be defined by a plan to get on holidays, while the plan to execute the task can consist of putting some travels into a sequence.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">Task</rdfs:label>
        <rdfs:label xml:lang="it">Task</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/TemporalEntity -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/TemporalEntity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Entity"/>
        <rdfs:comment xml:lang="it">Questa classe rappresenta qualsiasi tipo di entità temporale, ad es. intervalli di tempo, mesi, giorni, ecc...</rdfs:comment>
        <rdfs:comment xml:lang="en">This class represents a temporal entity. Its literal representation is given with the property time (or its sub-properties startTime, endTime), as an xsd:dateTime value.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">Entità temporale</rdfs:label>
        <rdfs:label xml:lang="en">Temporal entity</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/TimeInterval -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/TimeInterval">
        <rdfs:comment xml:lang="it">Qualsiasi Region in uno spazio dimensionale che intende rappresentare il tempo.</rdfs:comment>
        <rdfs:comment xml:lang="en">Any Region in a dimensional space that aims at representing time.</rdfs:comment>
        <skos:scopeNote xml:lang="en">In the top-level, TimeInterval is a subclass of Interval: an interval in the linear dimensional space of time, whose lower boundary is its start and whose upper boundary is its end. It is also a TemporalEntity, whose start and end can be given as literals with startTime and endTime, which specialise lowerBoundaryValue and upperBoundaryValue.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Nel top-level, TimeInterval è una sottoclasse di Interval: un intervallo nello spazio dimensionale lineare del tempo, il cui estremo inferiore è il suo inizio e il cui estremo superiore è la sua fine. È anche una TemporalEntity, il cui inizio e la cui fine possono essere indicati come letterali con startTime e endTime, che specializzano lowerBoundaryValue e upperBoundaryValue.</skos:scopeNote>
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Interval"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/TemporalEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/endTime"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/startTime"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:scopeNote xml:lang="it">La classe per rappresentare gli intervalli temporali, delimitati da un tempo di inizio (estremo inferiore) e da un tempo di fine (estremo superiore).</skos:scopeNote>
        <skos:scopeNote xml:lang="en">The class for representing time intervals, delimited by a start time (lower boundary) and an end time (upper boundary).</skos:scopeNote>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">Intervallo di tempo</rdfs:label>
        <rdfs:label xml:lang="en">Time interval</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/UnitOfMeasure -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/UnitOfMeasure">
        <rdfs:comment xml:lang="it">Le unità di misura sono qui concettualizzate come parametri sulle regioni, che possono essere valorizzati come valori di un datatype.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/parametrises"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/hacid/onto/top-level/Region"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Units of measure are conceptualized here as parameters on regions, which can be valued as datatype values.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Parameter"/>
        <skos:scopeNote xml:lang="it">Questa classe viene utilizzata per modellare un&apos;unità di misura, ad es. metro, chilometro, grammo, ecc...</skos:scopeNote>
        <skos:scopeNote xml:lang="en">This class is used to model a measurement unit, e.g. meter, kilometer, gram, etc.</skos:scopeNote>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">Unit of measure</rdfs:label>
        <rdfs:label xml:lang="it">Unità di misura</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/Value -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/Value">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Characteristic"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/hasUnitOfMeasure"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/hacid/onto/top-level/UnitOfMeasure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/value"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:hasKey rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/hacid/onto/top-level/hasUnitOfMeasure"/>
            <rdf:Description rdf:about="https://w3id.org/hacid/onto/top-level/value"/>
        </owl:hasKey>
        <rdfs:comment xml:lang="it">La classe che modella generici valori che tipicamente hanno un&apos;unità di misura e il valore stesso.</rdfs:comment>
        <rdfs:comment xml:lang="en">The generic class for the values that typically have the unit of measure and the value itself.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">Valore</rdfs:label>
        <rdfs:label xml:lang="en">Value</rdfs:label>
        <owl:versionInfo xml:lang="it">stabile</owl:versionInfo>
        <owl:versionInfo xml:lang="en">stable</owl:versionInfo>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/Workflow -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/Workflow">
        <rdfs:comment xml:lang="it">Un Plan che definisce Role, Task e una struttura specifica per i task da eseguire, di solito a supporto del lavoro di un&apos;Organization.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/definesTask"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/hacid/onto/top-level/Task"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/definesRole"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/hacid/onto/top-level/Role"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A Plan that defines Role(s), Task(s), and a specific structure for tasks to be executed, usually supporting the work of an Organization</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Plan"/>
        <skos:scopeNote xml:lang="en">A workflow with tasks.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Un flusso di lavoro composto da attività.</skos:scopeNote>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">Flusso di lavoro</rdfs:label>
        <rdfs:label xml:lang="en">Workflow</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/WorkflowExecution -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/WorkflowExecution">
        <rdfs:comment xml:lang="it">L&apos;esecuzione di un workflow, cioè una situazione che soddisfa un workflow.</rdfs:comment>
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/hacid/onto/top-level/satisfies"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/hacid/onto/top-level/Workflow"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Situation"/>
        <rdfs:comment xml:lang="en">The execution of a workflow, i.e. a situation that satisfies a workflow.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">Esecuzione di workflow</rdfs:label>
        <rdfs:label xml:lang="en">Workflow execution</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/WorkflowRole -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/WorkflowRole">
        <rdfs:comment xml:lang="en">Constraints not expressible in OWL 2 DL (stated here, not axiomatised): every workflow role is also a property (an instance of rdf:Property) whose rdfs:domain is WorkflowExecution, so that the assignment of an object to the role in a workflow execution can be stated as the triple (execution, role, object). To use a role in this way, declare its IRI also as an owl:ObjectProperty with rdfs:domain WorkflowExecution (OWL 2 punning).</rdfs:comment>
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/Role"/>
        <rdfs:comment xml:lang="en">A role of a workflow, also a property with WorkflowExecution as domain, to enable the concise representation of objects assigned to the role.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="en">Workflow role</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hacid/onto/top-level/Year -->

    <owl:Class rdf:about="https://w3id.org/hacid/onto/top-level/Year">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hacid/onto/top-level/TemporalEntity"/>
        <rdfs:comment xml:lang="it">La classe per rappresentare un anno.</rdfs:comment>
        <rdfs:comment xml:lang="en">The class for representing a year.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/hacid/onto/top-level"/>
        <rdfs:label xml:lang="it">Anno</rdfs:label>
        <rdfs:label xml:lang="en">Year</rdfs:label>
    </owl:Class>
