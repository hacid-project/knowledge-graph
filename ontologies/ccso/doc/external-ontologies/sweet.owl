    <!-- http://sweetontology.net/phenSolid/Spintery -->

    <owl:Class rdf:about="http://sweetontology.net/phenSolid/Spintery">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenSolid/Fracture"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophso:Spintery</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Splintery is a fracture type that occurs in fibrous or finely acicular minerals and in minerals that have a relatively stronger structure in one direction than the other two.</rdfs:comment>
        <rdfs:label xml:lang="en">spintery</rdfs:label>
    </owl:Class>
    


