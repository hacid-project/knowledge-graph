    <!-- http://sweetontology.net/humanEnvirControl/PrimaryTreatment -->

    <owl:Class rdf:about="http://sweetontology.net/humanEnvirControl/PrimaryTreatment">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/humanEnvirControl/WaterTreatmentProcess"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sohueccont:PrimaryTreatment</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">In wastewater treatment, a combination of step processes, usually physical in nature, that are designed to remove floating and settleable solids. Examples of process steps are screening and sedimentation.</rdfs:comment>
        <rdfs:label xml:lang="en">primary treatment</rdfs:label>
    </owl:Class>
    


