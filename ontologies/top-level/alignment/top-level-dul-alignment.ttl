@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix top:  <https://w3id.org/hacid/onto/top-level/> .
@prefix dul:  <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .

# Alignment between the HACID top-level ontology and DOLCE+DnS Ultralite (DUL).
#
# Every top-level term that replicates a DUL term is declared equivalent to it
# (owl:equivalentClass for classes, owl:equivalentProperty for properties), so that,
# when this file is used together with both ontologies, the DUL axioms also apply to
# the top-level terms and vice versa. Replicas whose definition diverges from DUL carry
# an axiom annotation (rdfs:comment) describing the divergence.
#
# The union of top-level, DUL and this file is in OWL 2 DL, consistent and coherent
# (checked with HermiT).
#
# See ../doc/dul-consistency-review.md for the full analysis and
# ../doc/novel-terms.md for the top-level terms that have no DUL counterpart.

dcterms:source a owl:AnnotationProperty .

<https://w3id.org/hacid/onto/top-level/alignment/dul>
    a owl:Ontology ;
    rdfs:label "HACID top-level / DUL alignment"@en ;
    rdfs:comment "Equivalence axioms between the terms of the HACID top-level ontology and the DOLCE+DnS Ultralite (DUL) terms they replicate."@en ;
    dcterms:source <https://w3id.org/hacid/onto/top-level> , <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> .


# ----------------------------------------------------------------------
