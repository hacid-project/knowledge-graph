    <!-- http://sweetontology.net/matrOrganicCompound/Organochloride -->

    <owl:Class rdf:about="http://sweetontology.net/matrOrganicCompound/Organochloride">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrOrganicCompound/OrganicCompound"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaChemical/hasChemical"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/matrElement/Cl"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somaoc:Organochloride</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">An organochloride, organochlorine, or chlorocarbon, is an organic compound containing at least one covalently bonded chlorine atom. Their wide structural variety and divergent chemical properties lead to a broad range of uses.</rdfs:comment>
        <rdfs:label xml:lang="en">organochloride</rdfs:label>
    </owl:Class>
    


