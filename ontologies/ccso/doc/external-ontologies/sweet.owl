        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophw:AcousticGravityWave</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A wave disturbance with restoring forces that include buoyancy and the elastic compressibility of the fluid medium.</rdfs:comment>
        <rdfs:label xml:lang="en">acoustic gravity wave</rdfs:label>
    </owl:Class>
    


