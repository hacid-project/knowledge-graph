    <!-- http://sweetontology.net/propDimensionlessRatio/PecletNumber -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/propDimensionlessRatio/PecletNumber">
        <rdf:type rdf:resource="http://sweetontology.net/propDimensionlessRatio/DimensionlessRatio"/>
        <rdfs:comment xml:lang="en">A relationship between the advective and diffusive components of solute transport expressed as the ratio of the product of the average interstitial velocity, times the characteristic length, divided by the coefficient of molecular diffusion; small values indicate diffusion dominance, large values indicate advection dominance.</rdfs:comment>
        <rdfs:label xml:lang="en">peclet number</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/propDimensionlessRatio/PlasmaParameter -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/propDimensionlessRatio/PlasmaParameter">
        <rdf:type rdf:resource="http://sweetontology.net/propDimensionlessRatio/DimensionlessRatio"/>
        <rdf:type rdf:resource="http://sweetontology.net/propQuantity/ElectromagneticQuantity"/>
        <rdfs:label xml:lang="en">plasma parameter</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/propDimensionlessRatio/RefractiveIndex -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/propDimensionlessRatio/RefractiveIndex">
        <rdf:type rdf:resource="http://sweetontology.net/propDimensionlessRatio/DimensionlessRatio"/>
        <rdf:type rdf:resource="http://sweetontology.net/propQuantity/ElectromagneticQuantity"/>
        <rdfs:label xml:lang="en">refractive index</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/propDimensionlessRatio/RelativePermeability -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/propDimensionlessRatio/RelativePermeability">
        <rdf:type rdf:resource="http://sweetontology.net/propDimensionlessRatio/DimensionlessRatio"/>
        <rdfs:comment xml:lang="en"> The ratio of the effective permeability for a given flow phase to the intrinsic permeability of the porous medium (WMO, 1974). The ratio of the effective and specific permeabilities.</rdfs:comment>
        <rdfs:label xml:lang="en">relative permeability</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/propDimensionlessRatio/RetardationFactor -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/propDimensionlessRatio/RetardationFactor">
        <rdf:type rdf:resource="http://sweetontology.net/prop/HydrogeologicalProperty"/>
        <rdf:type rdf:resource="http://sweetontology.net/propDimensionlessRatio/DimensionlessRatio"/>
        <rdfs:comment xml:lang="en">The ratio of the average linear velocity of groundwater to the velocity of the retarded constituent at C/Co=0.5.</rdfs:comment>
        <rdfs:label xml:lang="en">retardation factor</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/propDimensionlessRatio/ReynoldsNumber -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/propDimensionlessRatio/ReynoldsNumber">
        <rdf:type rdf:resource="http://sweetontology.net/prop/FluidProperty"/>
        <rdf:type rdf:resource="http://sweetontology.net/propDimensionlessRatio/DimensionlessRatio"/>
        <rdfs:comment xml:lang="en">The dimensionless ratio of the inertial force (∼U2/L) to the viscous force (∼ νU/L2) in the Navier–Stokes equations, where U is a characteristic velocity, L is a characteristic length, and ν is the kinematic viscosity of the fluid; thus, Re=ULv. The Reynolds number is of great importance in the theory of hydrodynamic stability and the origin of turbulence. The inertia force generates vortex stretching and nonlinear interactions and hence creates randomness. Turbulence occurs when the inertia term dominates the viscous term, that is, when the Reynolds number is large. For many engineering flows, turbulence occurs when Re &gt; Rec, where the critical Reynolds number is roughly Rec = 2100.</rdfs:comment>
        <rdfs:label xml:lang="en">reynolds number</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/propDimensionlessRatio/RichardsonNumber -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/propDimensionlessRatio/RichardsonNumber">
        <rdf:type rdf:resource="http://sweetontology.net/propDimensionlessRatio/DimensionlessRatio"/>
        <rdfs:label xml:lang="en">richardson number</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/propDimensionlessRatio/RossbyNumber -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/propDimensionlessRatio/RossbyNumber">
        <rdf:type rdf:resource="http://sweetontology.net/propDimensionlessRatio/DimensionlessRatio"/>
        <rdfs:comment xml:lang="en">A dimensionless number relating the ratio of inertial to Coriolis forces for a given flow of a rotating fluid.</rdfs:comment>
        <rdfs:label xml:lang="en">rossby number</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/propDimensionlessRatio/RouseNumber -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/propDimensionlessRatio/RouseNumber">
        <rdf:type rdf:resource="http://sweetontology.net/propDimensionlessRatio/DimensionlessRatio"/>
        <rdfs:label xml:lang="en">rouse number</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/propDimensionlessRatio/SignalToNoiseRatio -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/propDimensionlessRatio/SignalToNoiseRatio">
        <rdf:type rdf:resource="http://sweetontology.net/propDimensionlessRatio/DimensionlessRatio"/>
        <rdfs:label xml:lang="en">signal to noise ratio</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/propDimensionlessRatio/SonicMachNumber -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/propDimensionlessRatio/SonicMachNumber">
        <rdf:type rdf:resource="http://sweetontology.net/prop/MotionProperty"/>
        <rdf:type rdf:resource="http://sweetontology.net/propDimensionlessRatio/DimensionlessRatio"/>
        <rdfs:label xml:lang="en">sonic mach number</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/propDimensionlessRatio/SpecificRetention -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/propDimensionlessRatio/SpecificRetention">
        <rdf:type rdf:resource="http://sweetontology.net/propDimensionlessRatio/DimensionlessRatio"/>
        <rdfs:comment xml:lang="en">The ratio of the Volume of water which the porous medium, after being saturated, will retain against the pull of gravity to the volume of the porous medium.</rdfs:comment>
        <rdfs:label xml:lang="en">specific retention</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/propDimensionlessRatio/SpecificStorage -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/propDimensionlessRatio/SpecificStorage">
        <rdf:type rdf:resource="http://sweetontology.net/propDimensionlessRatio/DimensionlessRatio"/>
        <rdfs:comment xml:lang="en">The volume of water released from or taken into storage per unit volume of the porous medium per unit change in head.</rdfs:comment>
        <rdfs:label xml:lang="en">specific storage</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/propDimensionlessRatio/SpecificYield -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/propDimensionlessRatio/SpecificYield">
        <rdf:type rdf:resource="http://sweetontology.net/propDimensionlessRatio/DimensionlessRatio"/>
        <rdfs:comment xml:lang="en">The ratio of the volume of water which the porous medium after being saturated, will yield by gravity to the volume of the porous medium.</rdfs:comment>
        <rdfs:label xml:lang="en">specific yield</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/propDimensionlessRatio/VoidRatio -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/propDimensionlessRatio/VoidRatio">
        <rdf:type rdf:resource="http://sweetontology.net/propDimensionlessRatio/DimensionlessRatio"/>
        <rdf:type rdf:resource="http://sweetontology.net/propMass/ConsistenceProperty"/>
        <rdfs:label xml:lang="en">void ratio</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/propDimensionlessRatio/VonKarmanConstant -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/propDimensionlessRatio/VonKarmanConstant">
        <rdf:type rdf:resource="http://sweetontology.net/propDimensionlessRatio/DimensionlessRatio"/>
        <rdf:type rdf:resource="http://sweetontology.net/propQuantity/PhysicalConstant"/>
        <rdfs:label xml:lang="en">von karman constant</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/propDimensionlessRatio/WaterCirculationCoefficient -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/propDimensionlessRatio/WaterCirculationCoefficient">
        <rdf:type rdf:resource="http://sweetontology.net/propDimensionlessRatio/DimensionlessRatio"/>
        <rdfs:comment xml:lang="en">The ratio of a region&apos;s total precipitation to its external precipitation originating as evaporation from the oceans as opposed to evapotranspiration from the land.</rdfs:comment>
        <rdfs:label xml:lang="en">water circulation coefficient</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/propEnergyFlux/SolarConstant -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/propEnergyFlux/SolarConstant">
        <rdf:type rdf:resource="http://sweetontology.net/propEnergyFlux/RadiativeFlux"/>
        <rdf:type rdf:resource="http://sweetontology.net/propQuantity/PhysicalConstant"/>
        <relaSci:hasSource rdf:resource="http://sweetontology.net/phenStar/Sun"/>
        <rdfs:label xml:lang="en">solar constant</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/propSpaceThickness/AnnualHalfPotentialEvapotranspiration -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/propSpaceThickness/AnnualHalfPotentialEvapotranspiration">
        <rdf:type rdf:resource="http://sweetontology.net/propSpaceThickness/HalfPotentialEvapotranspiration"/>
        <rdfs:label xml:lang="en">annual half potential evapotranspiration</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/propSpaceThickness/AnnualPotentialEvapotranspiration -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/propSpaceThickness/AnnualPotentialEvapotranspiration">
        <rdf:type rdf:resource="http://sweetontology.net/propSpaceThickness/PotentialEvapotranspiration"/>
        <rdfs:label xml:lang="en">annual potential evapotranspiration</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/propTemperatureGradient/NegativeSlope -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/propTemperatureGradient/NegativeSlope">
        <rdf:type rdf:resource="http://sweetontology.net/propTemperatureGradient/TemperatureGradientRange"/>
        <rdfs:label xml:lang="en">negative slope</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/propTemperatureGradient/PositiveSlope -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/propTemperatureGradient/PositiveSlope">
        <rdf:type rdf:resource="http://sweetontology.net/propTemperatureGradient/TemperatureGradientRange"/>
        <rdfs:label xml:lang="en">positive slope</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/realm/Earth -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/realm/Earth">
        <rdf:type rdf:resource="http://sweetontology.net/realmAstroBody/Planet"/>
        <rdfs:label xml:lang="en">earth</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/realmClimateZone/Af -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/realmClimateZone/Af">
        <rdf:type rdf:resource="http://sweetontology.net/realmClimateZone/A"/>
        <owl:sameAs rdf:resource="http://sweetontology.net/realmClimateZone/TropicalRainForestClimate"/>
        <rdfs:comment xml:lang="en">The Af climate classification, also known as the tropical rain forest climate classification, is characterized by monthly precipitation in excess of 6 cm all months out of year.</rdfs:comment>
        <rdfs:label xml:lang="en">af</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/realmClimateZone/Am -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/realmClimateZone/Am">
        <rdf:type rdf:resource="http://sweetontology.net/realmClimateZone/A"/>
        <owl:sameAs rdf:resource="http://sweetontology.net/realmClimateZone/TropicalMonsoonClimate"/>
        <rdfs:comment xml:lang="en">The Am climate classification, also known as Tropical Monsoon Climate, is characterized by a short marked dry season with 1 or more months receiving less than 6 cm of precipitation, an otherwise excessively wet rainy season, and ITCZ dominance for 6 - 12 months out of the year.</rdfs:comment>
        <rdfs:label xml:lang="en">am</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/realmClimateZone/Arid -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/realmClimateZone/Arid">
        <rdf:type rdf:resource="http://sweetontology.net/realmClimateZone/B"/>
        <owl:sameAs rdf:resource="http://sweetontology.net/realmClimateZone/BW"/>
        <rdfs:label xml:lang="en">arid</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/realmClimateZone/AridClimate -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/realmClimateZone/AridClimate">
        <rdf:type rdf:resource="http://sweetontology.net/realmClimateZone/B"/>
        <owl:sameAs rdf:resource="http://sweetontology.net/realmClimateZone/BW"/>
        <rdfs:label xml:lang="en">arid climate</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/realmClimateZone/Aw -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/realmClimateZone/Aw">
        <rdf:type rdf:resource="http://sweetontology.net/realmClimateZone/A"/>
        <rdf:type rdf:resource="http://sweetontology.net/realmClimateZone/WetSummerDryWinterClimate"/>
        <owl:sameAs rdf:resource="http://sweetontology.net/realmClimateZone/TropicalSavannaClimate"/>
        <rdfs:comment xml:lang="en">The Aw climate classification, also known as Tropical Savanna climate classification, is characterized by a summer wet season, winter dry season, and ITCZ dominance for 6 months or less.</rdfs:comment>
        <rdfs:label xml:lang="en">aw</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/realmClimateZone/BS -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/realmClimateZone/BS">
        <rdf:type rdf:resource="http://sweetontology.net/realmClimateZone/B"/>
        <owl:sameAs rdf:resource="http://sweetontology.net/realmClimateZone/SemiAridClimate"/>
        <rdfs:comment xml:lang="en">The BS climate classification, also known as semiarid climate classification, is characterized by having precipitation amounts greater than 1/2 potential evapotranspiration (POTET), but not equal to it.</rdfs:comment>
        <rdfs:label xml:lang="en">bs</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/realmClimateZone/BSh -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/realmClimateZone/BSh">
        <rdf:type rdf:resource="http://sweetontology.net/realmClimateZone/B"/>
        <owl:sameAs rdf:resource="http://sweetontology.net/realmClimateZone/HotLowLatitudeSteppeClimate"/>
        <rdfs:comment xml:lang="en">The BSh climate classification, also known as the hot low-latitude steppe, is characterized by having mean annual temperatures greater than 18 degree C.</rdfs:comment>
        <rdfs:label xml:lang="en">bsh</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/realmClimateZone/BSk -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/realmClimateZone/BSk">
        <rdf:type rdf:resource="http://sweetontology.net/realmClimateZone/B"/>
        <owl:sameAs rdf:resource="http://sweetontology.net/realmClimateZone/ColdMidlatitudeSteppeClimate"/>
        <rdfs:comment xml:lang="en">The BSk climate classification, also known as cold midlatitude steppe climate classification, is characterized by having mean annual temperatures less than 18 degree C.</rdfs:comment>
        <rdfs:label xml:lang="en">bsk</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/realmClimateZone/BW -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/realmClimateZone/BW">
        <rdf:type rdf:resource="http://sweetontology.net/realmClimateZone/B"/>
        <rdfs:comment xml:lang="en">The BW climate classification, also known as the arid climate classification, is characterized by having precipitation amounts less than 1/2 potential evapotranspiration (POTET).</rdfs:comment>
        <rdfs:label xml:lang="en">bw</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/realmClimateZone/BWh -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/realmClimateZone/BWh">
        <rdf:type rdf:resource="http://sweetontology.net/realmClimateZone/B"/>
        <owl:sameAs rdf:resource="http://sweetontology.net/realmClimateZone/HotLowLatitudeDesertClimate"/>
        <rdfs:comment xml:lang="en">the BWh climate classification, also known as the hot low-latitude desert, is characterized by having mean annual temperatures greater than 18 degree C.</rdfs:comment>
        <rdfs:label xml:lang="en">bwh</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/realmClimateZone/BWk -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/realmClimateZone/BWk">
        <rdf:type rdf:resource="http://sweetontology.net/realmClimateZone/B"/>
        <owl:sameAs rdf:resource="http://sweetontology.net/realmClimateZone/ColdMidlatitudeDesertClimate"/>
        <rdfs:comment xml:lang="en">The BWk climate classification, also known as the cold midlatitude desert, is characterized by having mean annual temperatures less than 18 degree C.</rdfs:comment>
        <rdfs:label xml:lang="en">bwk</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/realmClimateZone/Cfa -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/realmClimateZone/Cfa">
        <rdf:type rdf:resource="http://sweetontology.net/realmClimateZone/C"/>
        <rdfs:comment xml:lang="en">The Cfa climate classification is characterized by year-round precipitation, hot summers, and having the warmest month above 22 degree C.</rdfs:comment>
        <rdfs:label xml:lang="en">cfa</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/realmClimateZone/Cfb -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/realmClimateZone/Cfb">
        <rdf:type rdf:resource="http://sweetontology.net/realmClimateZone/C"/>
        <rdfs:comment xml:lang="en">The Cfb climate classfication receives year-round precipitation, its warmest month is below 22 degree C and has 4 months above 10 degree C.</rdfs:comment>
        <rdfs:label xml:lang="en">cfb</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/realmClimateZone/Cfc -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/realmClimateZone/Cfc">
        <rdf:type rdf:resource="http://sweetontology.net/realmClimateZone/C"/>
        <rdfs:comment xml:lang="en">The Cfc climate classification is charactericized by year-round precipitation and having 1 - 3 months with temperatures above 10 degree C.</rdfs:comment>
        <rdfs:label xml:lang="en">cfc</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/realmClimateZone/ColdMidlatitudeDesertClimate -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/realmClimateZone/ColdMidlatitudeDesertClimate">
        <rdf:type rdf:resource="http://sweetontology.net/realmClimateZone/B"/>
        <rdfs:label xml:lang="en">cold midlatitude desert climate</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/realmClimateZone/ColdMidlatitudeSteppeClimate -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/realmClimateZone/ColdMidlatitudeSteppeClimate">
        <rdf:type rdf:resource="http://sweetontology.net/realmClimateZone/B"/>
        <rdfs:label xml:lang="en">cold midlatitude steppe climate</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/realmClimateZone/Csa -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/realmClimateZone/Csa">
        <rdf:type rdf:resource="http://sweetontology.net/realmClimateZone/C"/>
        <rdfs:comment xml:lang="en">The Csa climate classification is characterized by pronounced summer droughts with 70% of precipitation in the winter and hot summers with its warmest month above 22 degree C.</rdfs:comment>
        <rdfs:label xml:lang="en">csa</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/realmClimateZone/Csb -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/realmClimateZone/Csb">
        <rdf:type rdf:resource="http://sweetontology.net/realmClimateZone/C"/>
        <rdf:type rdf:resource="http://sweetontology.net/realmClimateZone/WetSummerDryWinterClimate"/>
        <rdfs:label xml:lang="en">csb</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/realmClimateZone/Cwa -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/realmClimateZone/Cwa">
        <rdf:type rdf:resource="http://sweetontology.net/realmClimateZone/C"/>
        <rdf:type rdf:resource="http://sweetontology.net/realmClimateZone/WetSummerDryWinterClimate"/>
        <rdfs:comment xml:lang="en">the Cwa climate classification is characterized by winter drought, summer&apos;s wettest month getting 10 times more precipitation than driest winter month, and the warmest month being above 22 degree C.</rdfs:comment>
        <rdfs:label xml:lang="en">cwa</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/realmClimateZone/Dfa -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/realmClimateZone/Dfa">
        <rdf:type rdf:resource="http://sweetontology.net/realmClimateZone/D"/>
        <rdfs:comment xml:lang="en">The Dfa climate classification is characterized by having year-round precipitation and warmest month temperatures above 22 degree C.</rdfs:comment>
        <rdfs:label xml:lang="en">dfa</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/realmClimateZone/Dfb -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/realmClimateZone/Dfb">
        <rdf:type rdf:resource="http://sweetontology.net/realmClimateZone/D"/>
        <rdfs:comment xml:lang="en">The Dfb climate classifcation is characterized by having year-round precipitation and warmest month temperatures below 22 degree C.</rdfs:comment>
        <rdfs:label xml:lang="en">dfb</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/realmClimateZone/Dfc -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/realmClimateZone/Dfc">
        <rdf:type rdf:resource="http://sweetontology.net/realmClimateZone/D"/>
        <rdfs:comment xml:lang="en">The Dfc climate classification is characterized by having year-round precipitation and having 1 - 4 months above 10 degree C.</rdfs:comment>
        <rdfs:label xml:lang="en">dfc</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/realmClimateZone/Dwa -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/realmClimateZone/Dwa">
        <rdf:type rdf:resource="http://sweetontology.net/realmClimateZone/D"/>
        <rdf:type rdf:resource="http://sweetontology.net/realmClimateZone/DryWinterClimate"/>
        <rdfs:comment xml:lang="en">The Dwa climate classification is characterized by winter drought and warmest month temperatures above 22 degree C.</rdfs:comment>
        <rdfs:label xml:lang="en">dwa</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/realmClimateZone/Dwb -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/realmClimateZone/Dwb">
        <rdf:type rdf:resource="http://sweetontology.net/realmClimateZone/D"/>
        <rdf:type rdf:resource="http://sweetontology.net/realmClimateZone/DryWinterClimate"/>
        <rdfs:comment xml:lang="en">The Dwb climate classification is characterized by winter drought and warmest month temperatures below 22 degree C.</rdfs:comment>
        <rdfs:label xml:lang="en">dwb</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/realmClimateZone/Dwc -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/realmClimateZone/Dwc">
        <rdf:type rdf:resource="http://sweetontology.net/realmClimateZone/D"/>
        <rdf:type rdf:resource="http://sweetontology.net/realmClimateZone/DryWinterClimate"/>
        <rdfs:comment xml:lang="en">The Dwc climate classification is characterized by winter drought and haviong 1 - 4 months with temperatures above 10 degrees C.</rdfs:comment>
        <rdfs:label xml:lang="en">dwc</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/realmClimateZone/Dwd -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/realmClimateZone/Dwd">
        <rdf:type rdf:resource="http://sweetontology.net/realmClimateZone/D"/>
        <rdf:type rdf:resource="http://sweetontology.net/realmClimateZone/DryWinterClimate"/>
        <rdfs:comment xml:lang="en">The Dwd climate classification is characterized by winter drought and having coldest month temperatures below -38 degree C (in Siberia only).</rdfs:comment>
        <rdfs:label xml:lang="en">dwd</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/realmClimateZone/EF -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/realmClimateZone/EF">
        <rdf:type rdf:resource="http://sweetontology.net/realmClimateZone/E"/>
        <owl:sameAs rdf:resource="http://sweetontology.net/realmClimateZone/IceCapClimate"/>
        <rdfs:comment xml:lang="en">The EF climate classification, also known as the Ice Cap climate classification, is characterized by having warmest month temperatures below 0 degrees C and having precipitation exceeding very small potential evapotranspiration (POTET).</rdfs:comment>
        <rdfs:label xml:lang="en">ef</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/realmClimateZone/EM -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/realmClimateZone/EM">
        <rdf:type rdf:resource="http://sweetontology.net/realmClimateZone/E"/>
        <owl:sameAs rdf:resource="http://sweetontology.net/realmClimateZone/PolarMarineClimate"/>
        <rdfs:comment xml:lang="en">The EM climate classification, also known as the polar marine climate classification, is characterized by all months having temperatures above -7 degree C, warmest month above 0 degree C, and annual temperatures less than 17 degree C.</rdfs:comment>
        <rdfs:label xml:lang="en">em</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/realmClimateZone/ET -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/realmClimateZone/ET">
        <rdf:type rdf:resource="http://sweetontology.net/realmClimateZone/E"/>
        <owl:sameAs rdf:resource="http://sweetontology.net/realmClimateZone/TundraClimate"/>
        <rdfs:comment xml:lang="en">The ET climate classification, also known as the tundra climate classification, is characterizex by warmest month temperatures between 0 - 10 degree C, precipitation exceeds small potential evapotranspiration demand, and has snow cover 8 - 10 months out of the year.</rdfs:comment>
        <rdfs:label xml:lang="en">et</rdfs:label>
    </owl:NamedIndividual>
    


