        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sohukd:Science</metadata:prefixIRI>
        <rdfs:label xml:lang="en">science</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/humanKnowledgeDomain/Seismology -->

    <owl:Class rdf:about="http://sweetontology.net/humanKnowledgeDomain/Seismology">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/humanKnowledgeDomain/Geology"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sohukd:Seismology</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Seismology (from the Greek seismos = earthquake and λόγος,logos = knowledge ) is the scientific study of earthquakes and the propagation of elastic waves through the Earth. The field also includes studies of earthquake effects, such as tsunamis as well as diverse seismic sources such as volcanic, tectonic, oceanic, atmospheric, and artificial processes (such as explosions).</rdfs:comment>
        <rdfs:label xml:lang="en">seismology</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/humanKnowledgeDomain/Sociology -->

    <owl:Class rdf:about="http://sweetontology.net/humanKnowledgeDomain/Sociology">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/humanKnowledgeDomain/BehavioralScience"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sohukd:Sociology</metadata:prefixIRI>
        <rdfs:label xml:lang="en">sociology</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/humanKnowledgeDomain/Stratigraphy -->

    <owl:Class rdf:about="http://sweetontology.net/humanKnowledgeDomain/Stratigraphy">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/humanKnowledgeDomain/Petrology"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sohukd:Stratigraphy</metadata:prefixIRI>
        <rdfs:label xml:lang="en">stratigraphy</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/humanKnowledgeDomain/Tectonics -->

    <owl:Class rdf:about="http://sweetontology.net/humanKnowledgeDomain/Tectonics">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/humanKnowledgeDomain/Geology"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sohukd:Tectonics</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Tectonics is a field of study within geology concerned generally with the structures within the crust of the Earth (or other planets) and particularly with the forces and movements that have operated in a region to create these structures. Tectonics is concerned with the orogenies and tectonic development of cratons and tectonic terranes as well as the earthquake and volcanic belts which directly affect much of the global population. Tectonic studies are also important for understanding erosion patterns in geomorphology and as guides for the economic geologist searching for petroleum and metallic ores. A subfield of tectonics that deals with tectonic phenomena in the geologically recent period is called neotectonics.</rdfs:comment>
        <rdfs:label xml:lang="en">tectonics</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/humanKnowledgeDomain/Thermodynamics -->

    <owl:Class rdf:about="http://sweetontology.net/humanKnowledgeDomain/Thermodynamics">
