    <owl:Class rdf:about="http://sweetontology.net/realmLandCoastal/Shoreline">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandCoastal/Coastal"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandCoastal/CoastalRegion"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/Land"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/LandRegion"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/LandSurface"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/SurfaceRegion"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealc:Shoreline</metadata:prefixIRI>
