            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropef:Illuminance</metadata:prefixIRI>
        <rdfs:label xml:lang="en">illuminance</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergyFlux/Insolation -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergyFlux/Insolation">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergyFlux/SolarRadiation"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropef:Insolation</metadata:prefixIRI>
        <rdfs:label xml:lang="en">insolation</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergyFlux/Intensity -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergyFlux/Intensity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/Flux"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropef:Intensity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">intensity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergyFlux/Irradiance -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergyFlux/Irradiance">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergyFlux/FluxDensity"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergyFlux/Intensity"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/ElectromagneticRadiationQuantity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropef:Irradiance</metadata:prefixIRI>
        <rdfs:label xml:lang="en">irradiance</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergyFlux/Luminance -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergyFlux/Luminance">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/ElectromagneticRadiationQuantity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/candelaPerMeterSquared"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropef:Luminance</metadata:prefixIRI>
        <rdfs:label xml:lang="en">luminance</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergyFlux/LuminousFlux -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergyFlux/LuminousFlux">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergyFlux/EnergyFlux"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/lumen"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropef:LuminousFlux</metadata:prefixIRI>
        <rdfs:label xml:lang="en">luminous flux</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergyFlux/LuminousIntensity -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergyFlux/LuminousIntensity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/ElectromagneticRadiationQuantity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/candela"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropef:LuminousIntensity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">luminous intensity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergyFlux/Opacity -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergyFlux/Opacity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/RadiationMediumInteractionQuantity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/meterSquaredPerKilogram"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropef:Opacity</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The extinction coefficient for a particular substance is a measure of how well it scatters and absorbs electromagnetic radiation (EM waves). If the EM wave can pass through very easily, the material has a low extinction coefficient. Conversely, if the radiation hardly penetrates the material, but rather quickly becomes extinct within it, the extinction coefficient is high.</rdfs:comment>
        <rdfs:label xml:lang="en">opacity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergyFlux/PoyntingVector -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergyFlux/PoyntingVector">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergyFlux/FluxDensity"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergyFlux/Intensity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropef:PoyntingVector</metadata:prefixIRI>
        <rdfs:label xml:lang="en">poynting vector</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergyFlux/Radiance -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergyFlux/Radiance">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/ElectromagneticRadiationQuantity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/wattPerMeterSquaredPerSteradian"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropef:Radiance</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A radiometric term for the rate at which radiant energy in a set of directions confined to a unit solid angle around a particular direction is transferred across unit area of a surface (real or imaginary) projected onto this direction.</rdfs:comment>
        <rdfs:label xml:lang="en">radiance</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergyFlux/RadiantFlux -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergyFlux/RadiantFlux">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergyFlux/FluxDensity"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergyFlux/Intensity"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergyFlux/RadiativeForcing"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropef:RadiantFlux</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Radiant energy per unit time passing some specified area from one side.</rdfs:comment>
        <rdfs:label xml:lang="en">radiant flux</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergyFlux/RadiativeFlux -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergyFlux/RadiativeFlux">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergyFlux/EnergyFlux"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergyFlux/RadiantFlux"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergyFlux/RadiativeForcing"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropef:RadiativeFlux</metadata:prefixIRI>
        <rdfs:label xml:lang="en">radiative flux</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergyFlux/RadiativeForcing -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergyFlux/RadiativeForcing">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergyFlux/FluxDensity"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergyFlux/Intensity"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergyFlux/RadiantFlux"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropef:RadiativeForcing</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">In radiation, the net flux of radiation into or out of a system.  As a consequence of radiative forcing there must be some change to the nonradiative energy states of the system.</rdfs:comment>
        <rdfs:label xml:lang="en">radiative forcing</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergyFlux/RichterScale -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergyFlux/RichterScale">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergyFlux/EarthquakeScale"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropef:RichterScale</metadata:prefixIRI>
        <rdfs:label xml:lang="en">richter scale</rdfs:label>
    </owl:Class>
    


