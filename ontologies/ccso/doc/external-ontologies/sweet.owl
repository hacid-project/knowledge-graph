    </owl:Class>
    


    <!-- http://sweetontology.net/realmAstroHelio/Plasmasphere -->

    <owl:Class rdf:about="http://sweetontology.net/realmAstroHelio/Plasmasphere">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/GlobalPlanetaryLayer"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetaryLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRealm"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/realmAstroHelio/LowerHeliosphere"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/hasUpperBoundary"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmAstroHelio/Plasmapause"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasState"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/Plasma"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaah:Plasmasphere</metadata:prefixIRI>
        <rdfs:label xml:lang="en">plasmasphere</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAstroHelio/RadiationBelt -->

    <owl:Class rdf:about="http://sweetontology.net/realmAstroHelio/RadiationBelt">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmAstroHelio/VanAllenBelt"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/GlobalPlanetaryLayer"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetaryLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRealm"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmAstroHelio/Heliosphere"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaah:RadiationBelt</metadata:prefixIRI>
        <rdfs:label xml:lang="en">radiation belt</rdfs:label>
    </owl:Class>
    


