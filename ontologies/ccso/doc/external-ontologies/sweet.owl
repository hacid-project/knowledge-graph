    <!-- http://sweetontology.net/matrParticle/GammaRay -->

    <owl:Class rdf:about="http://sweetontology.net/matrParticle/GammaRay">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrParticle/Photon"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somapa:GammaRay</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Gamma rays are a form of electromagnetic radiation or light emission of frequencies produced by sub-atomic particle interactions, such as electron-positron annihilation or radioactive decay. Gamma rays are generally characterized as electromagnetic radiation having the highest frequency and energy, and also the shortest wavelength, within the electromagnetic spectrum, i.e. high energy photons. Due to their high energy content, they can cause serious damage when absorbed by living cells.</rdfs:comment>
        <rdfs:label xml:lang="en">gamma ray</rdfs:label>
    </owl:Class>
    


