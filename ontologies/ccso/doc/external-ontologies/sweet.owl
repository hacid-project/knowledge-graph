    </owl:Class>
    


    <!-- http://sweetontology.net/procPhysical/ViscousForce -->

    <owl:Class rdf:about="http://sweetontology.net/procPhysical/ViscousForce">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procPhysical/Friction"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprocp:ViscousForce</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The transport of mass motion momentum solely by the random motions of individual molecules not moving together in coherent groups.</rdfs:comment>
        <rdfs:label xml:lang="en">viscous force</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/procPhysical/Washing -->

    <owl:Class rdf:about="http://sweetontology.net/procPhysical/Washing">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/proc/Force"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprocp:Washing</metadata:prefixIRI>
        <rdfs:label xml:lang="en">washing</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/procStateChange/Boiling -->

    <owl:Class rdf:about="http://sweetontology.net/procStateChange/Boiling">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procStateChange/Vaporization"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprocsc:Boiling</metadata:prefixIRI>
        <rdfs:label xml:lang="en">boiling</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/procStateChange/Condensation -->

    <owl:Class rdf:about="http://sweetontology.net/procStateChange/Condensation">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procStateChange/PhaseTransition"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procStateChange/StateChange"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/from"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/Gas"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/to"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/Liquid"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprocsc:Condensation</metadata:prefixIRI>
        <rdfs:label xml:lang="en">condensation</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/procStateChange/Deionization -->

    <owl:Class rdf:about="http://sweetontology.net/procStateChange/Deionization">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procStateChange/PhaseTransition"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procStateChange/StateChange"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/from"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/IonizedState"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/to"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/NeutralState"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprocsc:Deionization</metadata:prefixIRI>
        <rdfs:label xml:lang="en">deionization</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/procStateChange/Deposition -->

    <owl:Class rdf:about="http://sweetontology.net/procStateChange/Deposition">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procStateChange/PhaseTransition"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procStateChange/StateChange"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/from"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/Gas"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/to"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/Solid"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprocsc:Deposition</metadata:prefixIRI>
        <rdfs:label xml:lang="en">deposition</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/procStateChange/Evaporation -->

    <owl:Class rdf:about="http://sweetontology.net/procStateChange/Evaporation">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procStateChange/Vaporization"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprocsc:Evaporation</metadata:prefixIRI>
        <rdfs:label xml:lang="en">evaporation</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/procStateChange/Freezing -->

    <owl:Class rdf:about="http://sweetontology.net/procStateChange/Freezing">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procStateChange/PhaseTransition"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procStateChange/StateChange"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/from"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/Liquid"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/to"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/Solid"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprocsc:Freezing</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The phase transition of a substance passing from the liquid to the solid state; solidification; the opposite of fusion.</rdfs:comment>
        <rdfs:label xml:lang="en">freezing</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/procStateChange/Gasification -->

    <owl:Class rdf:about="http://sweetontology.net/procStateChange/Gasification">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procStateChange/PhaseTransition"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procStateChange/StateChange"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/to"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/Gas"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprocsc:Gasification</metadata:prefixIRI>
        <rdfs:label xml:lang="en">gasification</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/procStateChange/Ionization -->

    <owl:Class rdf:about="http://sweetontology.net/procStateChange/Ionization">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procStateChange/PhaseTransition"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procStateChange/StateChange"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/to"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/IonizedState"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprocsc:Ionization</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Ionization is the physical process of converting an atom or molecule into an ion by changing the difference between the number of protons and electrons. This process works slightly differently depending on whether an ion with a positive or a negative electric charge is being produced. A positive electric charge is produced when an electron bond to an atom or molecule absorbs enough energy from an external source to escape from the electric potential barrier that originally confined it, where the amount of energy required is called the Ionization potential. A negative electric charge is produced when a free electron collides with an atom and is subsequently caught inside the electric potential barrier, releasing any excess energy.</rdfs:comment>
        <rdfs:label xml:lang="en">ionization</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/procStateChange/Liquiefaction -->

    <owl:Class rdf:about="http://sweetontology.net/procStateChange/Liquiefaction">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procStateChange/PhaseTransition"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procStateChange/StateChange"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/to"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/Liquid"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprocsc:Liquiefaction</metadata:prefixIRI>
        <rdfs:label xml:lang="en">liquiefaction</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/procStateChange/Melting -->

    <owl:Class rdf:about="http://sweetontology.net/procStateChange/Melting">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procStateChange/PhaseTransition"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procStateChange/StateChange"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/from"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/Solid"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/to"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/Liquid"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprocsc:Melting</metadata:prefixIRI>
        <rdfs:label xml:lang="en">melting</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/procStateChange/PhaseTransition -->

    <owl:Class rdf:about="http://sweetontology.net/procStateChange/PhaseTransition">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/procStateChange/StateChange"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procPhysical/PhysicalProcess"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprocsc:PhaseTransition</metadata:prefixIRI>
        <rdfs:label xml:lang="en">phase transition</rdfs:label>
    </owl:Class>
    


