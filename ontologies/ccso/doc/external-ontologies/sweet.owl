    <!-- http://sweetontology.net/propCount/NeutralNumberDensity -->

    <owl:Class rdf:about="http://sweetontology.net/propCount/NeutralNumberDensity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propCount/NumberDensity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropcou:NeutralNumberDensity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">neutral number density</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propCount/NumberDensity -->

    <owl:Class rdf:about="http://sweetontology.net/propCount/NumberDensity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/QuantitativeProperty"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/Quantity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/perMeterCubed"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropcou:NumberDensity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">number density</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propCount/Population -->

    <owl:Class rdf:about="http://sweetontology.net/propCount/Population">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propCount/Count"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropcou:Population</metadata:prefixIRI>
        <rdfs:label xml:lang="en">population</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propCount/SunspotNumber -->

    <owl:Class rdf:about="http://sweetontology.net/propCount/SunspotNumber">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propCount/Count"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/measureOf"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenStar/SolarActivity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropcou:SunspotNumber</metadata:prefixIRI>
        <rdfs:label xml:lang="en">sunspot number</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propCount/TotalElectronContent -->

    <owl:Class rdf:about="http://sweetontology.net/propCount/TotalElectronContent">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propCount/NumberDensity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropcou:TotalElectronContent</metadata:prefixIRI>
        <rdfs:label xml:lang="en">total electron content</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propDifference/Amplitude -->

    <owl:Class rdf:about="http://sweetontology.net/propDifference/Amplitude">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/prop/WaveProperty"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propDifference/Deviation"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropdife:Amplitude</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Often the greatest magnitude at a given point of any spatially and temporally varying physical quantity governed by a wave equation; can also mean the spatial part of a time-harmonic wave function.</rdfs:comment>
        <rdfs:label xml:lang="en">amplitude</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propDifference/Anomaly -->

    <owl:Class rdf:about="http://sweetontology.net/propDifference/Anomaly">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propDifference/Deviation"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropdife:Anomaly</metadata:prefixIRI>
        <rdfs:label xml:lang="en">anomaly</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propDifference/Bias -->

    <owl:Class rdf:about="http://sweetontology.net/propDifference/Bias">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/prop/Error"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propDifference/Deviation"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropdife:Bias</metadata:prefixIRI>
        <rdfs:label xml:lang="en">bias</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propDifference/Deviation -->

    <owl:Class rdf:about="http://sweetontology.net/propDifference/Deviation">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/prop/Error"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propDifference/Difference"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropdife:Deviation</metadata:prefixIRI>
        <rdfs:label xml:lang="en">deviation</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propDifference/Difference -->

    <owl:Class rdf:about="http://sweetontology.net/propDifference/Difference">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprMathOperation/Difference"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprMathOperation/Subtraction"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropdife:Difference</metadata:prefixIRI>
        <rdfs:label xml:lang="en">difference</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propDifference/SaturationDeficit -->

    <owl:Class rdf:about="http://sweetontology.net/propDifference/SaturationDeficit">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propChemical/SaturationProperty"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropdife:SaturationDeficit</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The amount by which the water vapor in the air must be increased to achieve saturation without changing the environmental temperature and pressure.</rdfs:comment>
        <rdfs:label xml:lang="en">saturation deficit</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propDifference/Tolerance -->

    <owl:Class rdf:about="http://sweetontology.net/propDifference/Tolerance">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/prop/Error"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propDifference/Deviation"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropdife:Tolerance</metadata:prefixIRI>
        <rdfs:label xml:lang="en">tolerance</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propDifference/Undulation -->

    <owl:Class rdf:about="http://sweetontology.net/propDifference/Undulation">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprMathOperation/Difference"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprMathOperation/Subtraction"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/hasFirstOperand"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propSpaceHeight/Geoid"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/hasSecondOperand"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/reprSpaceGeometry3D/ReferenceEllipsoid"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropdife:Undulation</metadata:prefixIRI>
        <rdfs:label xml:lang="en">undulation</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propDiffusivity/Confluence -->

    <owl:Class rdf:about="http://sweetontology.net/propDiffusivity/Confluence">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propDiffusivity/DiffusivityQuantity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/propTimeFrequency/Convergence"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropdifu:Confluence</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The rate at which adjacent flow is converging along an axis oriented normal to the flow at the point in question.</rdfs:comment>
        <rdfs:label xml:lang="en">confluence</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propDiffusivity/Diffluence -->

    <owl:Class rdf:about="http://sweetontology.net/propDiffusivity/Diffluence">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propDiffusivity/DiffusivityQuantity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/propTimeFrequency/Divergence"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropdifu:Diffluence</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The rate at which adjacent flow diverges along an axis oriented normal to the flow at the point in question; the opposite of confluence.</rdfs:comment>
        <rdfs:label xml:lang="en">diffluence</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propDiffusivity/Diffusivity -->

    <owl:Class rdf:about="http://sweetontology.net/propDiffusivity/Diffusivity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propDiffusivity/DiffusivityQuantity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropdifu:Diffusivity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">diffusivity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propDiffusivity/DiffusivityQuantity -->

    <owl:Class rdf:about="http://sweetontology.net/propDiffusivity/DiffusivityQuantity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/PhysicalQuantity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/meterSquaredPerSecond"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropdifu:DiffusivityQuantity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">diffusivity quantity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propDiffusivity/EddyDiffusivity -->

    <owl:Class rdf:about="http://sweetontology.net/propDiffusivity/EddyDiffusivity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propDiffusivity/Diffusivity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/phenFluidDynamics/Eddy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropdifu:EddyDiffusivity</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The exchange coefficient for the diffusion of a conservative property by eddies in a turbulent flow.</rdfs:comment>
        <rdfs:label xml:lang="en">eddy diffusivity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propDiffusivity/KinematicViscosity -->

    <owl:Class rdf:about="http://sweetontology.net/propDiffusivity/KinematicViscosity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propDiffusivity/DiffusivityQuantity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/measureOf"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/procPhysical/ViscousForce"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropdifu:KinematicViscosity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">kinematic viscosity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propDiffusivity/MeridionalOvertuningStreamfunction -->

    <owl:Class rdf:about="http://sweetontology.net/propDiffusivity/MeridionalOvertuningStreamfunction">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propDiffusivity/Streamfunction"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropdifu:MeridionalOvertuningStreamfunction</metadata:prefixIRI>
        <rdfs:label xml:lang="en">meridional overtuning streamfunction</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propDiffusivity/Streamfunction -->

    <owl:Class rdf:about="http://sweetontology.net/propDiffusivity/Streamfunction">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprMathFunction/VectorQuantity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/meterCubedPerSecond"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropdifu:Streamfunction</metadata:prefixIRI>
        <rdfs:label xml:lang="en">streamfunction</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propDiffusivity/ThermalDiffusivity -->

    <owl:Class rdf:about="http://sweetontology.net/propDiffusivity/ThermalDiffusivity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propDiffusivity/Diffusivity"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/ThermodynamicQuantity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropdifu:ThermalDiffusivity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">thermal diffusivity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propDiffusivity/Transmissivity -->

    <owl:Class rdf:about="http://sweetontology.net/propDiffusivity/Transmissivity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propDiffusivity/DiffusivityQuantity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropdifu:Transmissivity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">transmissivity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propDiffusivity/VelocityPotential -->

    <owl:Class rdf:about="http://sweetontology.net/propDiffusivity/VelocityPotential">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propDiffusivity/DiffusivityQuantity"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprMathFunction/VectorQuantity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropdifu:VelocityPotential</metadata:prefixIRI>
        <rdfs:label xml:lang="en">velocity potential</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propDimensionlessRatio/BowenRatio -->

    <owl:Class rdf:about="http://sweetontology.net/propDimensionlessRatio/BowenRatio">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprMathOperation/Ratio"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/hasFirstOperand"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propEnergy/SensibleHeat"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/hasSecondOperand"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propEnergy/LatentHeat"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropdr:BowenRatio</metadata:prefixIRI>
        <rdfs:label xml:lang="en">bowen ratio</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propDimensionlessRatio/ChiSquareValue -->

    <owl:Class rdf:about="http://sweetontology.net/propDimensionlessRatio/ChiSquareValue">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propDimensionlessRatio/StatisticalScore"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropdr:ChiSquareValue</metadata:prefixIRI>
        <rdfs:label xml:lang="en">chi square value</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propDimensionlessRatio/DimensionlessRatio -->

    <owl:Class rdf:about="http://sweetontology.net/propDimensionlessRatio/DimensionlessRatio">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprMathOperation/Ratio"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/dimensionlessUnit"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropdr:DimensionlessRatio</metadata:prefixIRI>
        <rdfs:label xml:lang="en">dimensionless ratio</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propDimensionlessRatio/ReducedChiSquareValue -->

    <owl:Class rdf:about="http://sweetontology.net/propDimensionlessRatio/ReducedChiSquareValue">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propDimensionlessRatio/ChiSquareValue"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropdr:ReducedChiSquareValue</metadata:prefixIRI>
        <rdfs:label xml:lang="en">reduced chi square value</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propDimensionlessRatio/StatisticalScore -->

    <owl:Class rdf:about="http://sweetontology.net/propDimensionlessRatio/StatisticalScore">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/prop/StatisticalSummary"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropdr:StatisticalScore</metadata:prefixIRI>
        <rdfs:label xml:lang="en">statistical score</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propDimensionlessRatio/ZScore -->

    <owl:Class rdf:about="http://sweetontology.net/propDimensionlessRatio/ZScore">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propDimensionlessRatio/StatisticalScore"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/hasTest"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/reprMathStatistics/ZTest"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropdr:ZScore</metadata:prefixIRI>
        <rdfs:label xml:lang="en">z score</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propDimensionlessRatio/tScore -->

    <owl:Class rdf:about="http://sweetontology.net/propDimensionlessRatio/tScore">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propDimensionlessRatio/StatisticalScore"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/hasTest"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/reprMathStatistics/tTest"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropdr:tScore</metadata:prefixIRI>
        <rdfs:label xml:lang="en">t score</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergy/AvailablePotentialEnergy -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergy/AvailablePotentialEnergy">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergy/PotentialEnergy"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprope:AvailablePotentialEnergy</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">That portion of the total potential energy that may be converted to kinetic energy in an adiabatically enclosed system.</rdfs:comment>
        <rdfs:label xml:lang="en">available potential energy</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergy/BindingEnergy -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergy/BindingEnergy">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergy/ChemicalEnergy"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergy/PotentialEnergy"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprope:BindingEnergy</metadata:prefixIRI>
        <rdfs:label xml:lang="en">binding energy</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergy/ChemicalEnergy -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergy/ChemicalEnergy">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/prop/ChemicalProperty"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergy/Energy"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprope:ChemicalEnergy</metadata:prefixIRI>
        <rdfs:label xml:lang="en">chemical energy</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergy/ConvectiveInhibition -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergy/ConvectiveInhibition">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergy/Energy"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprope:ConvectiveInhibition</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The energy needed to lift an air parcel vertically and pseudoadiabatically from its originating level to its level of free convection (LFC).</rdfs:comment>
        <rdfs:label xml:lang="en">convective inhibition</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergy/Energy -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergy/Energy">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/ExtensiveProperty"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/joule"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprope:Energy</metadata:prefixIRI>
        <rdfs:label xml:lang="en">energy</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergy/EnergyBudget -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergy/EnergyBudget">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/BalanceEquation"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/Budget"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/BudgetEquation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasProperty"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propEnergy/Energy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprope:EnergyBudget</metadata:prefixIRI>
        <rdfs:label xml:lang="en">energy budget</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergy/EnergyDensity -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergy/EnergyDensity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/IntensiveProperty"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprMathOperation/Ratio"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/hasFirstOperand"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propEnergy/Energy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/hasSecondOperand"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propSpaceMultidimensional/Area"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/joulePerMeterSquared"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprope:EnergyDensity</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Energy per unit area.</rdfs:comment>
        <rdfs:label xml:lang="en">energy density</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergy/Enthalpy -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergy/Enthalpy">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergy/ChemicalEnergy"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprope:Enthalpy</metadata:prefixIRI>
        <rdfs:label xml:lang="en">enthalpy</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergy/Entropy -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergy/Entropy">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergy/Energy"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprope:Entropy</metadata:prefixIRI>
        <rdfs:label xml:lang="en">entropy</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergy/EvaporativeAvailablePotentialEnergy -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergy/EvaporativeAvailablePotentialEnergy">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergy/AvailablePotentialEnergy"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/hasStateChange"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/procStateChange/Evaporation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprope:EvaporativeAvailablePotentialEnergy</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Analogous to convective available potential energy, except that it is related to the negative buoyancy associated with evaporative cooling of liquid water within a sinking cloudy air parcel.</rdfs:comment>
        <rdfs:label xml:lang="en">evaporative available potential energy</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergy/Geopotential -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergy/Geopotential">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergy/GravitationalPotential"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprope:Geopotential</metadata:prefixIRI>
        <rdfs:label xml:lang="en">geopotential</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergy/GibbsFreeEnergy -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergy/GibbsFreeEnergy">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergy/ChemicalEnergy"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprope:GibbsFreeEnergy</metadata:prefixIRI>
        <rdfs:label xml:lang="en">gibbs free energy</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergy/GravitationalPotential -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergy/GravitationalPotential">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/ScalarPotential"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasProcess"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/procPhysical/Gravity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/meterSquaredPerSecondSquared"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprope:GravitationalPotential</metadata:prefixIRI>
        <rdfs:label xml:lang="en">gravitational potential</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergy/Hamiltonian -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergy/Hamiltonian">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergy/Energy"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprope:Hamiltonian</metadata:prefixIRI>
        <rdfs:label xml:lang="en">hamiltonian</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergy/Heat -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergy/Heat">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/propEnergy/HeatEnergy"/>
        <owl:equivalentClass rdf:resource="http://sweetontology.net/propEnergy/ThermalEnergy"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergy/Energy"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/ThermodynamicQuantity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprope:Heat</metadata:prefixIRI>
        <rdfs:label xml:lang="en">heat</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergy/HeatBudget -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergy/HeatBudget">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergy/EnergyBudget"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasProperty"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propEnergy/Heat"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprope:HeatBudget</metadata:prefixIRI>
        <rdfs:label xml:lang="en">heat budget</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergy/HeatEnergy -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergy/HeatEnergy">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergy/Energy"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/ThermodynamicQuantity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprope:HeatEnergy</metadata:prefixIRI>
        <rdfs:label xml:lang="en">heat energy</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergy/InternalEnergy -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergy/InternalEnergy">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergy/Energy"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprope:InternalEnergy</metadata:prefixIRI>
        <rdfs:label xml:lang="en">internal energy</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergy/IonizationEnergy -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergy/IonizationEnergy">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/propEnergy/IonizationPotential"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergy/ChemicalEnergy"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergy/PotentialEnergy"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprope:IonizationEnergy</metadata:prefixIRI>
        <rdfs:label xml:lang="en">ionization energy</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergy/IonizationPotential -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergy/IonizationPotential">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergy/ChemicalEnergy"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergy/PotentialEnergy"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprope:IonizationPotential</metadata:prefixIRI>
        <rdfs:label xml:lang="en">ionization potential</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergy/KineticEnergy -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergy/KineticEnergy">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/prop/MotionProperty"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergy/Energy"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprope:KineticEnergy</metadata:prefixIRI>
        <rdfs:label xml:lang="en">kinetic energy</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergy/Lagrangian -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergy/Lagrangian">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergy/Energy"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprope:Lagrangian</metadata:prefixIRI>
        <rdfs:label xml:lang="en">lagrangian</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergy/LatentHeat -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergy/LatentHeat">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergy/Heat"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergy/HeatEnergy"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergy/ThermalEnergy"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprope:LatentHeat</metadata:prefixIRI>
        <rdfs:label xml:lang="en">latent heat</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergy/Luminosity -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergy/Luminosity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergy/Power"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/ElectromagneticRadiationQuantity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprope:Luminosity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">luminosity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergy/MatricPotential -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergy/MatricPotential">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergy/Energy"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMass/ConsistenceProperty"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprope:MatricPotential</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The energy required to extract water from a porous medium to overcome the capillary and adsorptive forces.</rdfs:comment>
        <rdfs:label xml:lang="en">matric potential</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergy/PotentialEnergy -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergy/PotentialEnergy">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergy/Energy"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprope:PotentialEnergy</metadata:prefixIRI>
        <rdfs:label xml:lang="en">potential energy</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergy/Power -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergy/Power">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/ExtensiveProperty"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprMathOperation/Ratio"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/hasFirstOperand"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propEnergy/Energy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/hasSecondOperand"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/reprTime/Time"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/watt"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprope:Power</metadata:prefixIRI>
        <rdfs:label xml:lang="en">power</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergy/RadiantEnergy -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergy/RadiantEnergy">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergy/Energy"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasProcess"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/procPhysical/Radiation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprope:RadiantEnergy</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Infrequently, any energy propagated by a physical quantity governed by a wave equation.</rdfs:comment>
        <rdfs:label xml:lang="en">radiant energy</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergy/SensibleHeat -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergy/SensibleHeat">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergy/Heat"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergy/HeatEnergy"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergy/ThermalEnergy"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprope:SensibleHeat</metadata:prefixIRI>
        <rdfs:label xml:lang="en">sensible heat</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergy/SpecificEnergy -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergy/SpecificEnergy">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/IntensiveProperty"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprMathOperation/Ratio"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/hasFirstOperand"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propEnergy/Energy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/hasSecondOperand"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propMass/Mass"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/joulePerKilogram"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprope:SpecificEnergy</metadata:prefixIRI>
        <rdfs:label xml:lang="en">specific energy</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergy/SpecificPotentialEnergy -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergy/SpecificPotentialEnergy">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergy/SpecificEnergy"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/hasFirstOperand"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propEnergy/PotentialEnergy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprope:SpecificPotentialEnergy</metadata:prefixIRI>
        <rdfs:label xml:lang="en">specific potential energy</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergy/ThermalEnergy -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergy/ThermalEnergy">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergy/Energy"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/ThermodynamicQuantity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprope:ThermalEnergy</metadata:prefixIRI>
        <rdfs:label xml:lang="en">thermal energy</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergy/ThermochemicalEnergy -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergy/ThermochemicalEnergy">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergy/ChemicalEnergy"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprope:ThermochemicalEnergy</metadata:prefixIRI>
        <rdfs:label xml:lang="en">thermochemical energy</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergy/TotalSoilWaterPotential -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergy/TotalSoilWaterPotential">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/prop/HydrogeologicalProperty"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprope:TotalSoilWaterPotential</metadata:prefixIRI>
        <rdfs:comment xml:lang="en"> The sum of the energy-related components of a soil-water system; i.e., the sum of the gravitational, matric, and osmotic components.</rdfs:comment>
        <rdfs:label xml:lang="en">total soil water potential</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergy/Work -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergy/Work">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergy/Energy"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprope:Work</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A form of energy arising from the motion of a system against a force, existing only in the process of energy conversion.</rdfs:comment>
        <rdfs:label xml:lang="en">work</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergyFlux/AbsorbedSolarRadiation -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergyFlux/AbsorbedSolarRadiation">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergyFlux/SolarRadiation"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropef:AbsorbedSolarRadiation</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Solar radiation absorbed by the atmosphere&apos;s constituent gases, suspended material, clouds, or by the earth&apos;s surface.</rdfs:comment>
        <rdfs:label xml:lang="en">absorbed solar radiation</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergyFlux/AbsorptionCoefficient -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergyFlux/AbsorptionCoefficient">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/propEnergyFlux/Opacity"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/RadiationMediumInteractionQuantity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropef:AbsorptionCoefficient</metadata:prefixIRI>
        <rdfs:label xml:lang="en">absorption coefficient</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergyFlux/Brightness -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergyFlux/Brightness">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/propEnergyFlux/SpecificIntensity"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergyFlux/Luminance"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/wattPerMeterSquaredPerSteradianPerWavelength"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropef:Brightness</metadata:prefixIRI>
        <rdfs:label xml:lang="en">brightness</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergyFlux/BulkHeatFlux -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergyFlux/BulkHeatFlux">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergyFlux/HeatFlow"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergyFlux/HeatFlux"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergyFlux/ThermalFlux"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropef:BulkHeatFlux</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">&gt;Heat flux averaged over a layer of air, such as the boundary layer; heat-flux divergence or difference between the top and bottom of a layer.</rdfs:comment>
        <rdfs:label xml:lang="en">bulk heat flux</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergyFlux/CloudForcing -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergyFlux/CloudForcing">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergyFlux/RadiantFlux"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergyFlux/RadiativeForcing"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropef:CloudForcing</metadata:prefixIRI>
        <rdfs:label xml:lang="en">cloud forcing</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergyFlux/EarthquakeScale -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergyFlux/EarthquakeScale">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/repr/LogarithmicScale"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenGeolSeismicity/Earthquake"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/db"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropef:EarthquakeScale</metadata:prefixIRI>
        <rdfs:label xml:lang="en">earthquake scale</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergyFlux/EnergyFlux -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergyFlux/EnergyFlux">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/Flux"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/transportOf"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/propEnergy/Energy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropef:EnergyFlux</metadata:prefixIRI>
        <rdfs:label xml:lang="en">energy flux</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergyFlux/EnergyFlux_Wm2 -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergyFlux/EnergyFlux_Wm2">
