        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTime/DurationDescription"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTime/TimeInterval"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropti:TimeStep</metadata:prefixIRI>
        <rdfs:label xml:lang="en">time step</rdfs:label>
    </owl:Class>
    


