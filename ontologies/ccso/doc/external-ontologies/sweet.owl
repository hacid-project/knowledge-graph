        <rdfs:label xml:lang="en">anthracite</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrNaturalResource/Bituminous -->

    <owl:Class rdf:about="http://sweetontology.net/matrNaturalResource/Bituminous">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrNaturalResource/Coal"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somanr:Bituminous</metadata:prefixIRI>
        <rdfs:label xml:lang="en">bituminous</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrNaturalResource/Coal -->

    <owl:Class rdf:about="http://sweetontology.net/matrNaturalResource/Coal">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrNaturalResource/FossilFuel"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somanr:Coal</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Coal is a readily combustible black or brownish-black sedimentary rock. The harder forms, such as anthracite coal, can be regarded as metamorphic rock because of later exposure to elevated temperature and pressure. It is composed primarily of carbon along with variable quantities of other elements, chiefly sulfur, hydrogen, oxygen and nitrogen. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">coal</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrNaturalResource/CoralDeposit -->

    <owl:Class rdf:about="http://sweetontology.net/matrNaturalResource/CoralDeposit">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrNaturalResource/Deposit"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrNaturalResource/NaturalResource"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somanr:CoralDeposit</metadata:prefixIRI>
        <rdfs:label xml:lang="en">coral deposit</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrNaturalResource/CrudeOil -->

    <owl:Class rdf:about="http://sweetontology.net/matrNaturalResource/CrudeOil">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/matrNaturalResource/Petroleum"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrNaturalResource/Oil"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somanr:CrudeOil</metadata:prefixIRI>
        <rdfs:label xml:lang="en">crude oil</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrNaturalResource/Deposit -->

    <owl:Class rdf:about="http://sweetontology.net/matrNaturalResource/Deposit">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/statePhysical/SubstanceForm"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somanr:Deposit</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Deposition is the geological process by which material is added to a landform or land mass. Fluids such as wind and water, as well as sediment gravity flows, transport previously eroded sediment, which, at the loss of enough kinetic energy in the fluid, is deposited, building up layers of sediment. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">deposit</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrNaturalResource/FiniteResource -->

    <owl:Class rdf:about="http://sweetontology.net/matrNaturalResource/FiniteResource">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrNaturalResource/NaturalResource"/>
        <owl:disjointWith rdf:resource="http://sweetontology.net/matrNaturalResource/RenewableResource"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somanr:FiniteResource</metadata:prefixIRI>
        <rdfs:label xml:lang="en">finite resource</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrNaturalResource/FossilFuel -->

    <owl:Class rdf:about="http://sweetontology.net/matrNaturalResource/FossilFuel">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrNaturalResource/NaturalResource"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somanr:FossilFuel</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Fossil fuels or mineral fuels are fuels formed by the natural resources such as anaerobic decomposition of buried dead organisms that lived up to 300 million years ago. These fuels contain high percentage of carbon and hydrocarbons. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">fossil fuel</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrNaturalResource/LandResource -->

    <owl:Class rdf:about="http://sweetontology.net/matrNaturalResource/LandResource">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrNaturalResource/NaturalResource"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRealm"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/realm/Land"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somanr:LandResource</metadata:prefixIRI>
        <rdfs:label xml:lang="en">land resource</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrNaturalResource/Lignite -->

    <owl:Class rdf:about="http://sweetontology.net/matrNaturalResource/Lignite">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrNaturalResource/Coal"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somanr:Lignite</metadata:prefixIRI>
        <rdfs:label xml:lang="en">lignite</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrNaturalResource/NaturalGas -->

    <owl:Class rdf:about="http://sweetontology.net/matrNaturalResource/NaturalGas">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrNaturalResource/FossilFuel"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somanr:NaturalGas</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Natural gas is a gas consisting primarily of methane. It is found associated with fossil fuels, in coal beds, as methane clathrates, and is created by methanogenic organisms in marshes, bogs, and landfills. It is an important fuel source, a major feedstock for fertilizers, and a potent greenhouse gas. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">natural gas</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrNaturalResource/NaturalResource -->

    <owl:Class rdf:about="http://sweetontology.net/matrNaturalResource/NaturalResource">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrCompound/ChemicalCompound"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrCompound/Compound"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somanr:NaturalResource</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Natural resources (economically referred to as land or raw materials) are naturally forming substances that are considered valuable in their relatively unmodified (natural) form.  [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">natural resource</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrNaturalResource/Oil -->

    <owl:Class rdf:about="http://sweetontology.net/matrNaturalResource/Oil">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrNaturalResource/FossilFuel"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somanr:Oil</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">An oil is a substance that is in a viscous liquid statel (‘oily’) at ambient temperatures or slightly warmer, and is both hydrophobic (immiscible with water) and lipophilic (miscible with other oils, literally). This generag definition includes compound classes with otherwise unrelated chemical structures, properties, and uses, including vegetable oils, resochemical oils, and volatile essential oils. Oil is a nonpolar substance. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">oil</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrNaturalResource/OilShale -->

    <owl:Class rdf:about="http://sweetontology.net/matrNaturalResource/OilShale">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrNaturalResource/Oil"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somanr:OilShale</metadata:prefixIRI>
        <rdfs:label xml:lang="en">oil shale</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrNaturalResource/Ore -->

    <owl:Class rdf:about="http://sweetontology.net/matrNaturalResource/Ore">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrNaturalResource/NaturalResource"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somanr:Ore</metadata:prefixIRI>
        <rdfs:label xml:lang="en">ore</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrNaturalResource/Petroleum -->

    <owl:Class rdf:about="http://sweetontology.net/matrNaturalResource/Petroleum">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrNaturalResource/Oil"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somanr:Petroleum</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Petroleum  or crude oil is a naturally occurring, flammable liquid found in rock formations in the Earth consisting of a complex mixture of hydrocarbons of various molecular weights, plus other organic compounds. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">petroleum</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrNaturalResource/RenewableResource -->

    <owl:Class rdf:about="http://sweetontology.net/matrNaturalResource/RenewableResource">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrNaturalResource/NaturalResource"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somanr:RenewableResource</metadata:prefixIRI>
        <rdfs:label xml:lang="en">renewable resource</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrNaturalResource/SubBituminous -->

    <owl:Class rdf:about="http://sweetontology.net/matrNaturalResource/SubBituminous">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrNaturalResource/Coal"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somanr:SubBituminous</metadata:prefixIRI>
        <rdfs:label xml:lang="en">sub bituminous</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrNaturalResource/WaterResource -->

    <owl:Class rdf:about="http://sweetontology.net/matrNaturalResource/WaterResource">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrNaturalResource/NaturalResource"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRealm"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/realmHydroBody/BodyOfWater"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somanr:WaterResource</metadata:prefixIRI>
        <rdfs:label xml:lang="en">water resource</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrOrganicCompound/Alkane -->

    <owl:Class rdf:about="http://sweetontology.net/matrOrganicCompound/Alkane">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrOrganicCompound/HC"/>
