    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceMultidimensional/AngularExtent -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceMultidimensional/AngularExtent">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpace/SpatialMeasure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/radian"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsm:AngularExtent</metadata:prefixIRI>
        <rdfs:label xml:lang="en">angular extent</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceMultidimensional/Area -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceMultidimensional/Area">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpace/SpatialMeasure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/meterSquared"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/hasDimension"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsm:Area</metadata:prefixIRI>
        <rdfs:label xml:lang="en">area</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceMultidimensional/Capacity -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceMultidimensional/Capacity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceMultidimensional/Volume"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsm:Capacity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">capacity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceMultidimensional/CarbonFootprint -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceMultidimensional/CarbonFootprint">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceMultidimensional/Footprint"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsm:CarbonFootprint</metadata:prefixIRI>
        <rdfs:label xml:lang="en">carbon footprint</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceMultidimensional/CrossSection -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceMultidimensional/CrossSection">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/propSpaceMultidimensional/CrossSectionalArea"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceMultidimensional/Area"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsm:CrossSection</metadata:prefixIRI>
        <rdfs:label xml:lang="en">cross section</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceMultidimensional/CrossSectionalArea -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceMultidimensional/CrossSectionalArea">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceMultidimensional/Area"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsm:CrossSectionalArea</metadata:prefixIRI>
        <rdfs:label xml:lang="en">cross sectional area</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceMultidimensional/FieldOfView -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceMultidimensional/FieldOfView">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceMultidimensional/AngularExtent"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsm:FieldOfView</metadata:prefixIRI>
        <rdfs:label xml:lang="en">field of view</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceMultidimensional/Footprint -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceMultidimensional/Footprint">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceMultidimensional/Area"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsm:Footprint</metadata:prefixIRI>
        <rdfs:label xml:lang="en">footprint</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceMultidimensional/RadarCrossSection -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceMultidimensional/RadarCrossSection">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/RadiationMediumInteractionQuantity"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceMultidimensional/CrossSection"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceMultidimensional/CrossSectionalArea"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsm:RadarCrossSection</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Radar cross section (RCS) describes the extent to which an object reflects an incident electromagnetic wave. It is a measure of the strength of the radar signal backscattered from a target object for a given incident wave power..</rdfs:comment>
        <rdfs:label xml:lang="en">radar cross section</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceMultidimensional/Resolution -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceMultidimensional/Resolution">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceMultidimensional/AngularExtent"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsm:Resolution</metadata:prefixIRI>
        <rdfs:label xml:lang="en">resolution</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceMultidimensional/Volume -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceMultidimensional/Volume">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpace/SpatialMeasure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/meterCubed"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/hasDimension"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsm:Volume</metadata:prefixIRI>
        <rdfs:label xml:lang="en">volume</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceThickness/AverageAnnualPrecipitation -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceThickness/AverageAnnualPrecipitation">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propFunction/AnnualAverage"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceThickness/Precipitation"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropst:AverageAnnualPrecipitation</metadata:prefixIRI>
        <rdfs:label xml:lang="en">average annual precipitation</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceThickness/AverageDrySeasonPrecipitation -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceThickness/AverageDrySeasonPrecipitation">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propFunction/AnnualAverage"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceThickness/Precipitation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaTime/hasTime"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/reprTimeSeason/DrySeason"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropst:AverageDrySeasonPrecipitation</metadata:prefixIRI>
        <rdfs:label xml:lang="en">average dry season precipitation</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceThickness/AverageMonthlyPrecipitation -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceThickness/AverageMonthlyPrecipitation">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propFunction/MonthlyAverage"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceThickness/Precipitation"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropst:AverageMonthlyPrecipitation</metadata:prefixIRI>
        <rdfs:label xml:lang="en">average monthly precipitation</rdfs:label>
    </owl:Class>
    


