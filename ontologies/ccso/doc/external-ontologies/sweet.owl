        <owl:equivalentClass rdf:resource="http://sweetontology.net/propPressure/BarometricPressure"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propPressure/Pressure"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropp:AirPressure</metadata:prefixIRI>
        <rdfs:label xml:lang="en">air pressure</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propPressure/AtmosphericPressure -->

    <owl:Class rdf:about="http://sweetontology.net/propPressure/AtmosphericPressure">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/propPressure/BarometricPressure"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propPressure/Pressure"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropp:AtmosphericPressure</metadata:prefixIRI>
        <rdfs:label xml:lang="en">atmospheric pressure</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propPressure/BarometricPressure -->

    <owl:Class rdf:about="http://sweetontology.net/propPressure/BarometricPressure">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propPressure/Pressure"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropp:BarometricPressure</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The pressure exerted by the atmosphere as a consequence of gravitational attraction exerted upon the column of air lying directly above the point in question.</rdfs:comment>
        <rdfs:label xml:lang="en">barometric pressure</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propPressure/BarometricTendency -->

    <owl:Class rdf:about="http://sweetontology.net/propPressure/BarometricTendency">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propPressure/PressureTendency"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropp:BarometricTendency</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The character and amount of atmospheric pressure change during a specified period of time, often a three-hour period preceding an observation.</rdfs:comment>
        <rdfs:label xml:lang="en">barometric tendency</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propPressure/BulkModulus -->

    <owl:Class rdf:about="http://sweetontology.net/propPressure/BulkModulus">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/PhysicalQuantity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropp:BulkModulus</metadata:prefixIRI>
        <rdfs:label xml:lang="en">bulk modulus</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propPressure/Compressibility -->

    <owl:Class rdf:about="http://sweetontology.net/propPressure/Compressibility">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/PhysicalQuantity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/perPascal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropp:Compressibility</metadata:prefixIRI>
        <rdfs:label xml:lang="en">compressibility</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propPressure/CompressiveStrength -->

    <owl:Class rdf:about="http://sweetontology.net/propPressure/CompressiveStrength">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propPressure/Strength"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropp:CompressiveStrength</metadata:prefixIRI>
        <rdfs:label xml:lang="en">compressive strength</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propPressure/DifferentialPressure -->

    <owl:Class rdf:about="http://sweetontology.net/propPressure/DifferentialPressure">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propPressure/Pressure"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropp:DifferentialPressure</metadata:prefixIRI>
        <rdfs:label xml:lang="en">differential pressure</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propPressure/DynamicViscosity -->

    <owl:Class rdf:about="http://sweetontology.net/propPressure/DynamicViscosity">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/propPressure/Viscosity"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/prop/FluidProperty"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/PhysicalQuantity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropp:DynamicViscosity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">dynamic viscosity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propPressure/ExnerFunction -->

    <owl:Class rdf:about="http://sweetontology.net/propPressure/ExnerFunction">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propPressure/Pressure"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropp:ExnerFunction</metadata:prefixIRI>
        <rdfs:label xml:lang="en">exner function</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propPressure/HydrostaticPressure -->

    <owl:Class rdf:about="http://sweetontology.net/propPressure/HydrostaticPressure">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propPressure/Pressure"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropp:HydrostaticPressure</metadata:prefixIRI>
        <rdfs:label xml:lang="en">hydrostatic pressure</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propPressure/ModulusOfElasticity -->

    <owl:Class rdf:about="http://sweetontology.net/propPressure/ModulusOfElasticity">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/propPressure/YoungsModulus"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMass/MaterialProperty"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/PhysicalQuantity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropp:ModulusOfElasticity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">modulus of elasticity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propPressure/MomentumFlux -->

    <owl:Class rdf:about="http://sweetontology.net/propPressure/MomentumFlux">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propPressure/Pressure"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/Flux"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropp:MomentumFlux</metadata:prefixIRI>
        <rdfs:label xml:lang="en">momentum flux</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propPressure/NormalStress -->

    <owl:Class rdf:about="http://sweetontology.net/propPressure/NormalStress">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/propPressure/TensileStress"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propPressure/Stress"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropp:NormalStress</metadata:prefixIRI>
        <rdfs:label xml:lang="en">normal stress</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propPressure/PartialPressure -->

    <owl:Class rdf:about="http://sweetontology.net/propPressure/PartialPressure">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propPressure/Pressure"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropp:PartialPressure</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The pressure that a component of a gaseous mixture would have if it alone occupied the same volume at the same temperature as the mixture.</rdfs:comment>
        <rdfs:label xml:lang="en">partial pressure</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propPressure/Pressure -->

    <owl:Class rdf:about="http://sweetontology.net/propPressure/Pressure">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/IntensiveProperty"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprMathOperation/Ratio"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/hasFirstOperand"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propQuantity/Force"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/hasSecondOperand"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propSpaceMultidimensional/Area"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/pascal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropp:Pressure</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Force per unit area.</rdfs:comment>
        <rdfs:label xml:lang="en">pressure</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propPressure/PressureGradient -->

    <owl:Class rdf:about="http://sweetontology.net/propPressure/PressureGradient">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/PhysicalQuantity"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprMathOperation/Gradient"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/derivativeWithRespectTo"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propSpaceDistance/Distance"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/isDerivativeOf"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propPressure/Pressure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropp:PressureGradient</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The derivative of pressure</rdfs:comment>
        <rdfs:label xml:lang="en">pressure gradient</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propPressure/PressureTendency -->

    <owl:Class rdf:about="http://sweetontology.net/propPressure/PressureTendency">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTimeFrequency/Rate"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTimeFrequency/Tendency"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasProperty"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propPressure/Pressure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropp:PressureTendency</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The character and amount of atmospheric pressure change during a specified period of time, often a three-hour period preceding an observation.</rdfs:comment>
        <rdfs:label xml:lang="en">pressure tendency</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propPressure/SeaLevelPressure -->

    <owl:Class rdf:about="http://sweetontology.net/propPressure/SeaLevelPressure">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propPressure/AirPressure"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propPressure/AtmosphericPressure"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propPressure/BarometricPressure"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropp:SeaLevelPressure</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The atmospheric pressure at mean sea level, either directly measured or, most commonly, empirically determined from the observed station pressure.</rdfs:comment>
        <rdfs:label xml:lang="en">sea level pressure</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propPressure/ShearModulus -->

    <owl:Class rdf:about="http://sweetontology.net/propPressure/ShearModulus">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMass/MaterialProperty"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/PhysicalQuantity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/hasDirection"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSpaceDirection/Shear"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropp:ShearModulus</metadata:prefixIRI>
        <rdfs:label xml:lang="en">shear modulus</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propPressure/ShearStress -->

    <owl:Class rdf:about="http://sweetontology.net/propPressure/ShearStress">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propPressure/Stress"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/hasDirection"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSpaceDirection/Shear"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://sweetontology.net/propPressure/TensileStress"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropp:ShearStress</metadata:prefixIRI>
        <rdfs:label xml:lang="en">shear stress</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propPressure/StaticPressure -->

    <owl:Class rdf:about="http://sweetontology.net/propPressure/StaticPressure">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propPressure/Pressure"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropp:StaticPressure</metadata:prefixIRI>
        <rdfs:label xml:lang="en">static pressure</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propPressure/Stiffness -->

    <owl:Class rdf:about="http://sweetontology.net/propPressure/Stiffness">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMass/StrengthProperty"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/PhysicalQuantity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/newtonPerMeter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropp:Stiffness</metadata:prefixIRI>
        <rdfs:label xml:lang="en">stiffness</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propPressure/Strength -->

    <owl:Class rdf:about="http://sweetontology.net/propPressure/Strength">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMass/StrengthProperty"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropp:Strength</metadata:prefixIRI>
        <rdfs:label xml:lang="en">strength</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propPressure/Stress -->

    <owl:Class rdf:about="http://sweetontology.net/propPressure/Stress">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propPressure/Pressure"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropp:Stress</metadata:prefixIRI>
        <rdfs:label xml:lang="en">stress</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propPressure/Suction -->

    <owl:Class rdf:about="http://sweetontology.net/propPressure/Suction">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propPressure/Pressure"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropp:Suction</metadata:prefixIRI>
        <rdfs:label xml:lang="en">suction</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propPressure/SurfaceTension -->

    <owl:Class rdf:about="http://sweetontology.net/propPressure/SurfaceTension">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procPhysical/Tension"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/prop/FluidProperty"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/PhysicalQuantity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/newtonPerMeter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropp:SurfaceTension</metadata:prefixIRI>
        <rdfs:label xml:lang="en">surface tension</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propPressure/TensileStrength -->

    <owl:Class rdf:about="http://sweetontology.net/propPressure/TensileStrength">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propPressure/Strength"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropp:TensileStrength</metadata:prefixIRI>
        <rdfs:label xml:lang="en">tensile strength</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propPressure/TensileStress -->

    <owl:Class rdf:about="http://sweetontology.net/propPressure/TensileStress">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propPressure/Stress"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/hasDirection"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSpaceDirection/Perpendicular"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropp:TensileStress</metadata:prefixIRI>
        <rdfs:label xml:lang="en">tensile stress</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propPressure/TotalPressure -->

    <owl:Class rdf:about="http://sweetontology.net/propPressure/TotalPressure">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propPressure/Pressure"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropp:TotalPressure</metadata:prefixIRI>
        <rdfs:label xml:lang="en">total pressure</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propPressure/Viscosity -->

    <owl:Class rdf:about="http://sweetontology.net/propPressure/Viscosity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/prop/FluidProperty"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/PhysicalQuantity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/measureOf"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/procPhysical/ViscousForce"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/pascalSecond"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropp:Viscosity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">viscosity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propPressure/YoungsModulus -->

    <owl:Class rdf:about="http://sweetontology.net/propPressure/YoungsModulus">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMass/MaterialProperty"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/PhysicalQuantity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropp:YoungsModulus</metadata:prefixIRI>
        <rdfs:label xml:lang="en">youngs modulus</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propQuantity/BalanceEquation -->

    <owl:Class rdf:about="http://sweetontology.net/propQuantity/BalanceEquation">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/propQuantity/BudgetEquation"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprMath/Equation"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropq:BalanceEquation</metadata:prefixIRI>
        <rdfs:label xml:lang="en">balance equation</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propQuantity/BiologicalQuantity -->

    <owl:Class rdf:about="http://sweetontology.net/propQuantity/BiologicalQuantity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/prop/BiologicalProperty"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/QuantitativeProperty"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/Quantity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropq:BiologicalQuantity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">biological quantity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propQuantity/Budget -->

    <owl:Class rdf:about="http://sweetontology.net/propQuantity/Budget">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/propQuantity/BudgetEquation"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprMath/Equation"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropq:Budget</metadata:prefixIRI>
        <rdfs:label xml:lang="en">budget</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propQuantity/BudgetEquation -->

    <owl:Class rdf:about="http://sweetontology.net/propQuantity/BudgetEquation">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprMath/Equation"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropq:BudgetEquation</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">In general, an equation expressing a balance of quantities in the sense that the local or individual rates of change are zero.</rdfs:comment>
        <rdfs:label xml:lang="en">budget equation</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propQuantity/ChemicalQuantity -->

    <owl:Class rdf:about="http://sweetontology.net/propQuantity/ChemicalQuantity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/prop/ChemicalProperty"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/QuantitativeProperty"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/Quantity"/>
