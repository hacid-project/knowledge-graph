        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropef:SolarFlux</metadata:prefixIRI>
        <rdfs:label xml:lang="en">solar flux</rdfs:label>
    </owl:Class>
    


