            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somains:Thermometer</metadata:prefixIRI>
        <rdfs:label xml:lang="en">thermometer</rdfs:label>
    </owl:Class>
    


