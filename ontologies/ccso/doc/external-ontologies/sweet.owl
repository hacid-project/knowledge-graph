    <owl:Class rdf:about="http://sweetontology.net/procChemical/Reaction">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/proc/Process"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprocc:Reaction</metadata:prefixIRI>
        <rdfs:label xml:lang="en">reaction</rdfs:label>
    </owl:Class>
    


