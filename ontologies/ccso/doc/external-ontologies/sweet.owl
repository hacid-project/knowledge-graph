        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somaio:HeavyIon</metadata:prefixIRI>
        <rdfs:label xml:lang="en">heavy ion</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrIon/Ion -->

