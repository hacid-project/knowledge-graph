    </owl:Class>
    


    <!-- http://sweetontology.net/propFraction/CapacityFactor -->

    <owl:Class rdf:about="http://sweetontology.net/propFraction/CapacityFactor">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propFraction/FractionalQuantity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropfr:CapacityFactor</metadata:prefixIRI>
        <rdfs:label xml:lang="en">capacity factor</rdfs:label>
    </owl:Class>
    


