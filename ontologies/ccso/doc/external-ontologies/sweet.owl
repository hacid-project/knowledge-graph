    <!-- http://sweetontology.net/realmLandFluvial/Alluvial -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandFluvial/Alluvial">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolGeomorphology/SedimentFormation"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealf:Alluvial</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The process of depositing soil or sediments by a river or other running water. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">alluvial</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandFluvial/AlluvialFan -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandFluvial/AlluvialFan">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandFluvial/PiedmontSlope"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealf:AlluvialFan</metadata:prefixIRI>
        <rdfs:label xml:lang="en">alluvial fan</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandFluvial/AlluvialPlain -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandFluvial/AlluvialPlain">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandFluvial/FluvialPlain"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandFluvial/PiedmontSlope"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealf:AlluvialPlain</metadata:prefixIRI>
        <rdfs:label xml:lang="en">alluvial plain</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandFluvial/Bajada -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandFluvial/Bajada">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandFluvial/PiedmontSlope"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealf:Bajada</metadata:prefixIRI>
        <rdfs:label xml:lang="en">bajada</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandFluvial/Bedform -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandFluvial/Bedform">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandFluvial/FluvialLandform"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealf:Bedform</metadata:prefixIRI>
        <rdfs:label xml:lang="en">bedform</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandFluvial/Canyon -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandFluvial/Canyon">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandFluvial/FluvialLandform"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealf:Canyon</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A canyon, or gorge, is a deep valley between cliffs often carved from the landscape by a river. Most canyons were formed by a process of long-time erosion from a plateau level. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">canyon</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandFluvial/Catchment -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandFluvial/Catchment">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandFluvial/DrainageBasin"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandFluvial/Watershed"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealf:Catchment</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A catchment, or drainage basin, is an extent of land where water from precipitation drains into a body of water [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">catchment</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandFluvial/Cave -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandFluvial/Cave">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandFluvial/FluvialLandform"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprSpaceGeometry3D/Cavity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/contains"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/realmLandFluvial/Tunnel"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealf:Cave</metadata:prefixIRI>
        <rdfs:label xml:lang="en">cave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandFluvial/DrainageBasin -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandFluvial/DrainageBasin">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmLandFluvial/Watershed"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/Land"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/LandRegion"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/LandSurface"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/SurfaceRegion"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealf:DrainageBasin</metadata:prefixIRI>
        <rdfs:label xml:lang="en">drainage basin</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandFluvial/DryLake -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandFluvial/DryLake">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmLandFluvial/Playa"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandFluvial/FluvialPlain"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealf:DryLake</metadata:prefixIRI>
        <rdfs:label xml:lang="en">dry lake</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandFluvial/FloodPlain -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandFluvial/FloodPlain">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandFluvial/FluvialPlain"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealf:FloodPlain</metadata:prefixIRI>
        <rdfs:label xml:lang="en">flood plain</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandFluvial/FluvialLandform -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandFluvial/FluvialLandform">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/Landform"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealf:FluvialLandform</metadata:prefixIRI>
        <rdfs:label xml:lang="en">fluvial landform</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandFluvial/FluvialPlain -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandFluvial/FluvialPlain">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/Plain"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealf:FluvialPlain</metadata:prefixIRI>
        <rdfs:label xml:lang="en">fluvial plain</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandFluvial/Gorge -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandFluvial/Gorge">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandFluvial/Canyon"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealf:Gorge</metadata:prefixIRI>
        <rdfs:label xml:lang="en">gorge</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandFluvial/Gulley -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandFluvial/Gulley">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandFluvial/FluvialLandform"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealf:Gulley</metadata:prefixIRI>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-0337-8610"/>
        <rdfs:label xml:lang="en">gulley</rdfs:label>
        <rdfs:label xml:lang="en">gully</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://sweetontology.net/realmLandFluvial/Gully"/>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandFluvial/KarstLandform -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandFluvial/KarstLandform">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/Landform"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/phenGeolGeomorphology/Karst"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealf:KarstLandform</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Karst topography is a landscape shaped by the dissolution of a layer or layers of soluble bedrock, usually carbonate rock such as limestone or dolomite. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">karst landform</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandFluvial/LacustrinePlain -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandFluvial/LacustrinePlain">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandFluvial/FluvialPlain"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealf:LacustrinePlain</metadata:prefixIRI>
        <rdfs:label xml:lang="en">lacustrine plain</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandFluvial/PiedmontSlope -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandFluvial/PiedmontSlope">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandFluvial/FluvialLandform"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealf:PiedmontSlope</metadata:prefixIRI>
        <rdfs:label xml:lang="en">piedmont slope</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandFluvial/Playa -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandFluvial/Playa">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmLandFluvial/SaltLake"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandFluvial/FluvialPlain"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealf:Playa</metadata:prefixIRI>
        <rdfs:label xml:lang="en">playa</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandFluvial/Ripple -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandFluvial/Ripple">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandFluvial/Bedform"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealf:Ripple</metadata:prefixIRI>
        <rdfs:label xml:lang="en">ripple</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandFluvial/RiverBed -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandFluvial/RiverBed">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandFluvial/Bedform"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealf:RiverBed</metadata:prefixIRI>
        <rdfs:label xml:lang="en">river bed</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandFluvial/Sabkha -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandFluvial/Sabkha">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandFluvial/SaltFlat"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealf:Sabkha</metadata:prefixIRI>
        <rdfs:label xml:lang="en">sabkha</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandFluvial/SaltFlat -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandFluvial/SaltFlat">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandFluvial/FluvialLandform"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealf:SaltFlat</metadata:prefixIRI>
        <rdfs:label xml:lang="en">salt flat</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandFluvial/SaltLake -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandFluvial/SaltLake">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandFluvial/FluvialPlain"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealf:SaltLake</metadata:prefixIRI>
        <rdfs:label xml:lang="en">salt lake</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandFluvial/ScrollPlain -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandFluvial/ScrollPlain">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandFluvial/FluvialPlain"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealf:ScrollPlain</metadata:prefixIRI>
        <rdfs:label xml:lang="en">scroll plain</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandFluvial/Trench -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandFluvial/Trench">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandFluvial/Canyon"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealf:Trench</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A trench is a type of excavation or depression in the ground. Trenches are generally defined by being deeper than they are wide (as opposed to a wider gully or ditch), and by being narrow compared to their length (as opposed to a simple hole). Trenches are a natural feature in many landscapes. Some are created by rivers in flow (which may have long since fallen dry), others are features created by geological movement, such as oceanic trenches. The latter form is relatively deep, linear and narrow, and is formed by plate subduction. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">trench</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandFluvial/Tunnel -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandFluvial/Tunnel">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandFluvial/FluvialLandform"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprSpaceGeometry3D/Tube"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealf:Tunnel</metadata:prefixIRI>
        <rdfs:label xml:lang="en">tunnel</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandFluvial/Turbidite -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandFluvial/Turbidite">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandFluvial/FluvialLandform"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealf:Turbidite</metadata:prefixIRI>
        <rdfs:label xml:lang="en">turbidite</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandFluvial/Valley -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandFluvial/Valley">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandFluvial/FluvialLandform"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealf:Valley</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A valley (also called a vale, dale, glen or strath and near or in Appalachia, a draw) is a depression with predominant extent in one direction. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">valley</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandFluvial/Wall -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandFluvial/Wall">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandFluvial/FluvialLandform"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealf:Wall</metadata:prefixIRI>
        <rdfs:label xml:lang="en">wall</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandFluvial/Wash -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandFluvial/Wash">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandFluvial/PiedmontSlope"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealf:Wash</metadata:prefixIRI>
        <rdfs:label xml:lang="en">wash</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandFluvial/Watershed -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandFluvial/Watershed">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/Land"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/LandRegion"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/LandSurface"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/SurfaceRegion"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealf:Watershed</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A watershed refers to a divide that separates one drainage area from another drainage area. However, in the US and Canada, the term is often used to mean a drainage basin or catchment area itself. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">watershed</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandGlacial/Arete -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandGlacial/Arete">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandGlacial/GlacialLandform"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealg:Arete</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A thin, almost knife-like, ridge of rock which is typically formed when two glaciers erode parallel U-shaped valleys.</rdfs:comment>
        <rdfs:label xml:lang="en">arete</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandGlacial/Cirque -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandGlacial/Cirque">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandGlacial/GlacialLandform"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealg:Cirque</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">An amphitheatre-like valley head, formed at the head of a valley glacier by erosion.</rdfs:comment>
        <rdfs:label xml:lang="en">cirque</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandGlacial/Esker -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandGlacial/Esker">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandGlacial/GlacialLandform"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealg:Esker</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A long winding ridge of stratified sand and gravel, examples of which occur in glaciated and formerly glaciated regions.</rdfs:comment>
        <rdfs:label xml:lang="en">esker</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandGlacial/GlacialLandform -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandGlacial/GlacialLandform">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/Landform"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealg:GlacialLandform</metadata:prefixIRI>
        <rdfs:label xml:lang="en">glacial landform</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandGlacial/GlacialMoraine -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandGlacial/GlacialMoraine">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmLandGlacial/Moraine"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandGlacial/GlacialLandform"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealg:GlacialMoraine</metadata:prefixIRI>
        <rdfs:label xml:lang="en">glacial moraine</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandGlacial/GlacialOutwashPlain -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandGlacial/GlacialOutwashPlain">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandGlacial/GlacialPlain"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealg:GlacialOutwashPlain</metadata:prefixIRI>
        <rdfs:label xml:lang="en">glacial outwash plain</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandGlacial/GlacialPlain -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandGlacial/GlacialPlain">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandGlacial/GlacialLandform"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/Plain"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealg:GlacialPlain</metadata:prefixIRI>
        <rdfs:label xml:lang="en">glacial plain</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandGlacial/Kame -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandGlacial/Kame">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandGlacial/GlacialLandform"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealg:Kame</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">An irregularly shaped hill or mound composed of sand, gravel and till that accumulates in a depresson on a retreating glacier, and is then deposited with further melting.[Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">kame</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandGlacial/Moraine -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandGlacial/Moraine">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandGlacial/GlacialLandform"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealg:Moraine</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Any glacially formed accumulation of unconsolidated glacial debris (soil and rock) which can occur in currently glaciated and formerly glaciated regions.</rdfs:comment>
        <rdfs:label xml:lang="en">moraine</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandGlacial/OutwashFan -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandGlacial/OutwashFan">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandGlacial/GlacialLandform"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealg:OutwashFan</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A fan-shaped body of sediments deposited by braided streams from a melting glacier. Sediment locked within the ice of the glacier gets transported by the streams of meltwater and deposits on the outwash plain at the terminus of the glacier.</rdfs:comment>
        <rdfs:label xml:lang="en">outwash fan</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandGlacial/RockGlacier -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandGlacial/RockGlacier">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandGlacial/GlacialLandform"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealg:RockGlacier</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Rock glaciers are distinctive geomorphological landforms of blocky detritus which may extend outward and downslope from talus cones or from glaciers or the terminal moraines of glaciers. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">rock glacier</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandGlacial/Sandur -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandGlacial/Sandur">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandGlacial/GlacialOutwashPlain"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealg:Sandur</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A glacial outwash plain formed of sediments deposited by meltwater at the terminus of a glacier.</rdfs:comment>
        <rdfs:label xml:lang="en">sandur</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandGlacial/Thermokarst -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandGlacial/Thermokarst">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandGlacial/GlacialLandform"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealg:Thermokarst</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A land surface characterised by very irregular surfaces of marshy hollows and small hummocks formed as ice-rich permafrost thaws.</rdfs:comment>
        <rdfs:label xml:lang="en">thermokarst</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandGlacial/Till -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandGlacial/Till">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmLandGlacial/TillPlain"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandGlacial/GlacialPlain"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealg:Till</metadata:prefixIRI>
        <rdfs:label xml:lang="en">till</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandGlacial/TillPlain -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandGlacial/TillPlain">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandGlacial/GlacialPlain"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealg:TillPlain</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">An extensive flat plain of glacial till that forms when a sheet of ice becomes detached from the main body of a glacier and melts in place depositing the sediments it carried.</rdfs:comment>
        <rdfs:label xml:lang="en">till plain</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandGlacial/UShapedValley -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandGlacial/UShapedValley">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandGlacial/GlacialLandform"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealg:UShapedValley</metadata:prefixIRI>
        <rdfs:label xml:lang="en">u shaped valley</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandOrographic/Alpine -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandOrographic/Alpine">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandOrographic/MountainRegion"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealo:Alpine</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Alpine region is one above the tree line. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">alpine</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandOrographic/Bluff -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandOrographic/Bluff">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandOrographic/Hill"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealo:Bluff</metadata:prefixIRI>
        <rdfs:label xml:lang="en">bluff</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandOrographic/Butte -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandOrographic/Butte">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandOrographic/Hill"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealo:Butte</metadata:prefixIRI>
        <rdfs:label xml:lang="en">butte</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandOrographic/Cliff -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandOrographic/Cliff">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandOrographic/Hill"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealo:Cliff</metadata:prefixIRI>
        <rdfs:label xml:lang="en">cliff</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandOrographic/Foothill -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandOrographic/Foothill">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandOrographic/MountainRegion"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealo:Foothill</metadata:prefixIRI>
        <rdfs:label xml:lang="en">foothill</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandOrographic/Hill -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandOrographic/Hill">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/Landform"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealo:Hill</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A hill is a landform that extends above the surrounding terrain, in a limited area. Hills often have a distinct summit, although in areas with scarp/dip topography a hill may refer to a particular section of scarp slope without a well-defined summit (e.g. Box Hill). A hillock is a small hill. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">hill</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandOrographic/Hummock -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandOrographic/Hummock">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/Landform"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealo:Hummock</metadata:prefixIRI>
        <rdfs:label xml:lang="en">hummock</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandOrographic/Mesa -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandOrographic/Mesa">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandOrographic/MountainRegion"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealo:Mesa</metadata:prefixIRI>
        <rdfs:label xml:lang="en">mesa</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandOrographic/Mountain -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandOrographic/Mountain">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmLandOrographic/Orography"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/Landform"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealo:Mountain</metadata:prefixIRI>
