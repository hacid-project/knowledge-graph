        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropm:Structure</metadata:prefixIRI>
        <rdfs:label xml:lang="en">structure</rdfs:label>
    </owl:Class>
    


