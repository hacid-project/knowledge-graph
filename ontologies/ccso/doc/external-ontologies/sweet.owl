                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/wattPerMeterSquared"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropef:EnergyFlux_Wm2</metadata:prefixIRI>
        <rdfs:label xml:lang="en">energy flux wm2</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergyFlux/FluxDensity -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergyFlux/FluxDensity">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/propEnergyFlux/Intensity"/>
