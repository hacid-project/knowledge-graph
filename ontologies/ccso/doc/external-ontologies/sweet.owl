        <rdfs:label xml:lang="en">chemical</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matr/ChemicalSubstance -->

    <owl:Class rdf:about="http://sweetontology.net/matr/ChemicalSubstance">
