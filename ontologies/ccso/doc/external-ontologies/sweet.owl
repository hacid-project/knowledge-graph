    <owl:Class rdf:about="http://sweetontology.net/propEnergyFlux/SolarForcing">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergyFlux/RadiantFlux"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergyFlux/RadiativeForcing"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropef:SolarForcing</metadata:prefixIRI>
        <rdfs:label xml:lang="en">solar forcing</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergyFlux/SolarRadiation -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergyFlux/SolarRadiation">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/ElectromagneticRadiationQuantity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropef:SolarRadiation</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The total electromagnetic radiation emitted by the sun.</rdfs:comment>
        <rdfs:label xml:lang="en">solar radiation</rdfs:label>
    </owl:Class>
    


