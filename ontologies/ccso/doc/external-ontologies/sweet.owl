        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceDistance/Distance"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsdis:Visibility</metadata:prefixIRI>
