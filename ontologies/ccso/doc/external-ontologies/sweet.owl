    <owl:Class rdf:about="http://sweetontology.net/propSpaceThickness/FluidHead">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/prop/FluidProperty"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceThickness/Thickness"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropst:FluidHead</metadata:prefixIRI>
        <rdfs:label xml:lang="en">fluid head</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceThickness/GaugeHeight -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceThickness/GaugeHeight">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceThickness/WaterHeight"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropst:GaugeHeight</metadata:prefixIRI>
        <rdfs:label xml:lang="en">gauge height</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceThickness/HalfPotentialEvapotranspiration -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceThickness/HalfPotentialEvapotranspiration">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceThickness/Evapotranspiration"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropst:HalfPotentialEvapotranspiration</metadata:prefixIRI>
        <rdfs:label xml:lang="en">half potential evapotranspiration</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceThickness/HydraulicHead -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceThickness/HydraulicHead">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceThickness/FluidHead"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasState"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/Liquid"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropst:HydraulicHead</metadata:prefixIRI>
        <rdfs:label xml:lang="en">hydraulic head</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceThickness/LWE -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceThickness/LWE">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/propSpaceThickness/LiquidWaterEquivalent"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceThickness/WaterContent"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropst:LWE</metadata:prefixIRI>
        <rdfs:label xml:lang="en">lwe</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceThickness/LakeStage -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceThickness/LakeStage">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceThickness/StageHeight"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropst:LakeStage</metadata:prefixIRI>
        <rdfs:label xml:lang="en">lake stage</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceThickness/LiquidWaterEquivalent -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceThickness/LiquidWaterEquivalent">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceThickness/WaterContent"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropst:LiquidWaterEquivalent</metadata:prefixIRI>
        <rdfs:label xml:lang="en">liquid water equivalent</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceThickness/OpticalDepth -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceThickness/OpticalDepth">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/propSpaceThickness/OpticalThickness"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/RadiationMediumInteractionQuantity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/dimensionlessUnit"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropst:OpticalDepth</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The optical thickness measured vertically above some given altitude.  Optical depth is dimensionless and may be used to specify many different radiative characteristics of the atmosphere.</rdfs:comment>
        <rdfs:label xml:lang="en">optical depth</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceThickness/OpticalThickness -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceThickness/OpticalThickness">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/RadiationMediumInteractionQuantity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropst:OpticalThickness</metadata:prefixIRI>
        <rdfs:label xml:lang="en">optical thickness</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceThickness/PotentialEvapotranspiration -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceThickness/PotentialEvapotranspiration">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceThickness/Evapotranspiration"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropst:PotentialEvapotranspiration</metadata:prefixIRI>
        <rdfs:label xml:lang="en">potential evapotranspiration</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceThickness/PrecipitableWater -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceThickness/PrecipitableWater">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceThickness/WaterContent"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropst:PrecipitableWater</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The total atmospheric water vapor contained in a vertical column of unit cross-sectional area extending between any two specified levels.</rdfs:comment>
        <rdfs:label xml:lang="en">precipitable water</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceThickness/Precipitation -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceThickness/Precipitation">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceThickness/WaterContent"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropst:Precipitation</metadata:prefixIRI>
        <rdfs:label xml:lang="en">precipitation</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceThickness/PrecipitationRange -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceThickness/PrecipitationRange">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceHeight/HeightRange"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceThickness/Precipitation"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropst:PrecipitationRange</metadata:prefixIRI>
        <rdfs:label xml:lang="en">precipitation range</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceThickness/PrecipitationRange_cm -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceThickness/PrecipitationRange_cm">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceThickness/PrecipitationRange"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/centimeter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropst:PrecipitationRange_cm</metadata:prefixIRI>
        <rdfs:label xml:lang="en">precipitation range cm</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceThickness/PressureThickness -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceThickness/PressureThickness">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceThickness/Thickness"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasProcess"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propPressure/Pressure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropst:PressureThickness</metadata:prefixIRI>
        <rdfs:label xml:lang="en">pressure thickness</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceThickness/SWE -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceThickness/SWE">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/propSpaceThickness/SnowWaterEquivalent"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceThickness/LWE"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceThickness/LiquidWaterEquivalent"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropst:SWE</metadata:prefixIRI>
        <rdfs:label xml:lang="en">swe</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceThickness/SnowCover -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceThickness/SnowCover">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceThickness/Thickness"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaChemical/hasSubstance"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/matrWater/Snow"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropst:SnowCover</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The depth of snow that has fallen.</rdfs:comment>
        <rdfs:label xml:lang="en">snow cover</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceThickness/SnowWaterEquivalent -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceThickness/SnowWaterEquivalent">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceThickness/LWE"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceThickness/LiquidWaterEquivalent"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropst:SnowWaterEquivalent</metadata:prefixIRI>
        <rdfs:label xml:lang="en">snow water equivalent</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceThickness/Snowpack -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceThickness/Snowpack">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceThickness/SnowCover"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropst:Snowpack</metadata:prefixIRI>
        <rdfs:label xml:lang="en">snowpack</rdfs:label>
    </owl:Class>
    


