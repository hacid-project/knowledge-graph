            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealo:MountainRange</metadata:prefixIRI>
        <rdfs:label xml:lang="en">mountain range</rdfs:label>
    </owl:Class>
    


