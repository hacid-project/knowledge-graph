        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somaw:Steam</metadata:prefixIRI>
        <rdfs:label xml:lang="en">steam</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrWater/Wastewater -->

    <owl:Class rdf:about="http://sweetontology.net/matrWater/Wastewater">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrWater/Effluent"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somaw:Wastewater</metadata:prefixIRI>
        <rdfs:label xml:lang="en">wastewater</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrWater/WaterMixture -->

    <owl:Class rdf:about="http://sweetontology.net/matrWater/WaterMixture">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/MixedChemicalSubstance"/>
