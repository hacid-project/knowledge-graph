    <owl:Class rdf:about="http://sweetontology.net/realmLandProtected/StatePark">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandProtected/Park"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandProtected/Parkland"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaHuman/hasJurisdiction"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/humanJurisdiction/State"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealp:StatePark</metadata:prefixIRI>
        <rdfs:label xml:lang="en">state park</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandProtected/WaterReserve -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandProtected/WaterReserve">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/humanJurisdiction/AdministrativeRegion"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrNaturalResource/WaterResource"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealp:WaterReserve</metadata:prefixIRI>
        <rdfs:label xml:lang="en">water reserve</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandProtected/WildlifeRefuge -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandProtected/WildlifeRefuge">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandProtected/LandReserve"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealp:WildlifeRefuge</metadata:prefixIRI>
        <rdfs:label xml:lang="en">wildlife refuge</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandTectonic/AseismicRidge -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandTectonic/AseismicRidge">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandOrographic/Ridge"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealt:AseismicRidge</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Are neighboring ridges on different tectonic plates which have similar seismic characteristics. ‘Based on similar seismic velocity gradients of the lavas of the Carnegie, Cocos and Malpelos Ridges there is evidence that the hotspot activity has been the result of a single long mantle melt rather than multiple periods of activity and dormancy.’ [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">aseismic ridge</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandTectonic/ConvergentBoundary -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandTectonic/ConvergentBoundary">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmLandTectonic/ConvergentMargin"/>
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmLandTectonic/ConvergentPlateBoundary"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandTectonic/PlateBoundary"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/phenGeolTectonic/AsymmetricHeatFlow"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/phenSolid/Subsidence"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasGeologicProvince"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/realmGeolOrogen/Orogen"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealt:ConvergentBoundary</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">In plate tectonics, a convergent boundary or convergent plate boundary, also known as a destructive plate boundary (because of subduction), is an actively deforming region where two (or more) tectonic plates or fragments of lithosphere move toward one another and collide and where crust is being destroyed. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">convergent boundary</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandTectonic/ConvergentMargin -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandTectonic/ConvergentMargin">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandTectonic/PlateBoundary"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealt:ConvergentMargin</metadata:prefixIRI>
        <rdfs:label xml:lang="en">convergent margin</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandTectonic/ConvergentPlateBoundary -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandTectonic/ConvergentPlateBoundary">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandTectonic/PlateBoundary"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealt:ConvergentPlateBoundary</metadata:prefixIRI>
        <rdfs:label xml:lang="en">convergent plate boundary</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandTectonic/Diapir -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandTectonic/Diapir">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicFeature"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealt:Diapir</metadata:prefixIRI>
        <rdfs:label xml:lang="en">diapir</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandTectonic/DivergentBoundary -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandTectonic/DivergentBoundary">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmLandTectonic/DivergentPlateBoundary"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandTectonic/PlateBoundary"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealt:DivergentBoundary</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">In plate tectonics, a divergent boundary or divergent plate boundary (also known as a constructive boundary or an extensional boundary) is a linear feature that exists between two tectonic plates that are moving away from each other and new crust is being formed. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">divergent boundary</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandTectonic/DivergentPlateBoundary -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandTectonic/DivergentPlateBoundary">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandTectonic/PlateBoundary"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealt:DivergentPlateBoundary</metadata:prefixIRI>
        <rdfs:label xml:lang="en">divergent plate boundary</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandTectonic/FaultZone -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandTectonic/FaultZone">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmLandTectonic/FractureZone"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicBoundary"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealt:FaultZone</metadata:prefixIRI>
        <rdfs:label xml:lang="en">fault zone</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandTectonic/FloodBasalt -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandTectonic/FloodBasalt">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/Landform"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealt:FloodBasalt</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A flood basalt or trap basalt is the result of a giant volcanic eruption or series of eruptions that coats large stretches of land or the ocean floor with basalt lava. Flood basalts have occurred on continental scales (large igneous provinces) in prehistory, creating great plateaus and mountain ranges. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">flood basalt</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandTectonic/Footwall -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandTectonic/Footwall">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicFeature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/partOf"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmLandTectonic/FractureZone"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/below"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenSolid/Fault"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://sweetontology.net/realmLandTectonic/HangingWall"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealt:Footwall</metadata:prefixIRI>
        <rdfs:label xml:lang="en">footwall</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandTectonic/FossilPlateBoundary -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandTectonic/FossilPlateBoundary">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandTectonic/PlateBoundary"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealt:FossilPlateBoundary</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Are where similar plant and animal fossils are found around different continent shores, suggesting that they were once joined. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">fossil plate boundary</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandTectonic/FractureZone -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandTectonic/FractureZone">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicBoundary"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenSolid/Fracture"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealt:FractureZone</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A fracture zone is a linear oceanic feature--often hundreds, even thousands of kilometers long--resulting from the action of offset mid-ocean ridge axis segments. They are a consequence of plate tectonics. Lithospheric plates on either side of an active transform fault move in opposite directions; here, strike-slip activity is possible. Fracture zones extend past the transform faults, away from the ridge axis; seismically inactive (because both plate segments are moving in the same direction), they display evidence of past transform fault activity.</rdfs:comment>
        <rdfs:label xml:lang="en">fracture zone</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandTectonic/HangingWall -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandTectonic/HangingWall">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicFeature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/partOf"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmLandTectonic/FractureZone"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/above"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenSolid/Fault"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealt:HangingWall</metadata:prefixIRI>
        <rdfs:label xml:lang="en">hanging wall</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandTectonic/LIP -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandTectonic/LIP">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmLandTectonic/LargeIgneousProvince"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/Land"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/LandRegion"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/LandSurface"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/SurfaceRegion"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRealm"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/realmLandTectonic/FloodBasalt"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealt:LIP</metadata:prefixIRI>
        <rdfs:label xml:lang="en">lip</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandTectonic/LargeIgneousProvince -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandTectonic/LargeIgneousProvince">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/Land"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/LandRegion"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/LandSurface"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/SurfaceRegion"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealt:LargeIgneousProvince</metadata:prefixIRI>
        <rdfs:label xml:lang="en">large igneous province</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandTectonic/Ophiolite -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandTectonic/Ophiolite">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicFeature"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealt:Ophiolite</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">An Ophiolite is a section of the Earth&apos;s oceanic crust and the underlying upper mantle that has been uplifted or emplaced to be exposed within continental crustal rocks. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">ophiolite</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandTectonic/PairedMetamorphicBelt -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandTectonic/PairedMetamorphicBelt">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicFeature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenGeolTectonic/AsymmetricHeatFlow"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealt:PairedMetamorphicBelt</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A location where belts of  high pressure, low temperature metamorphism on the oceanic side are associated with belts of high pressure, high temperature metamorphism on the continent side. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">paired metamorphic belt</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandTectonic/Plate -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandTectonic/Plate">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicProvince"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/partOf"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmGeol/Lithosphere"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealt:Plate</metadata:prefixIRI>
        <rdfs:label xml:lang="en">plate</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandTectonic/PlateBoundary -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandTectonic/PlateBoundary">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicBoundary"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasGeomorphologicalType"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/realmLandTectonic/TectonicLandform"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/hasPlanetaryStructure"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmLandTectonic/TripleJunction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealt:PlateBoundary</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The location where two plates meet is called a plate boundary. it is often a broad zone where the plate interactions are not well understood. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">plate boundary</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandTectonic/Rift -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandTectonic/Rift">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicBoundary"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandTectonic/FaultZone"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandTectonic/FractureZone"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaChemical/hasSubstance"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/matrRockIgneous/AnorogenicIgneousRock"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealt:Rift</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A rift is a place where the Earth&apos;s crust and lithosphere are being pulled apart[1] and is an example of extensional tectonics. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">rift</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandTectonic/RiftValley -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandTectonic/RiftValley">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicFeature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasGeomorphologicalType"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmLandTectonic/TectonicLandform"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/hasOuterBoundary"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmGeolContinental/ContinentalRift"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealt:RiftValley</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A rift valley is a linear-shaped lowland between highlands or mountain ranges created by the action of a geologic rift or fault. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">rift valley</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandTectonic/StressRegime -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandTectonic/StressRegime">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicBoundary"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealt:StressRegime</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Stress regimes are shear zones. A shear zone or shear is a wide zone of distributed shearing in rock. Typically this is a type of fault but it may be difficult to place a distinct fault plane into the shear zone. Shear zones may form zones of much more intense foliation, deformation, and folding. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">stress regime</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandTectonic/SubductionZone -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandTectonic/SubductionZone">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicProvince"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealt:SubductionZone</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A subduction zone is an area on Earth where two tectonic plates move towards one another and subduction occurs.  [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">subduction zone</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandTectonic/SupraSubductionZoneComplex -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandTectonic/SupraSubductionZoneComplex">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicProvince"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealt:SupraSubductionZoneComplex</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">There is increasing evidence that most ophiolites are generated when subduction begins and thus represent fragments of fore-arc lithosphere. This led to introduction of the term ‘supra-subduction zone’ (SSZ) ophiolite in the 1980s to acknowledge that some ophiolites are more closely related to island arcs than ocean ridges. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">supra subduction zone complex</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandTectonic/Suture -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandTectonic/Suture">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandTectonic/FaultZone"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandTectonic/FossilPlateBoundary"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandTectonic/FractureZone"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealt:Suture</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A suture is where a fragment of crustal material is accreted to crust lying on another plate. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">suture</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandTectonic/TectonicLandform -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandTectonic/TectonicLandform">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/Landform"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealt:TectonicLandform</metadata:prefixIRI>
        <rdfs:label xml:lang="en">tectonic landform</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandTectonic/ThrustSystem -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandTectonic/ThrustSystem">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandTectonic/FaultZone"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandTectonic/FractureZone"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealt:ThrustSystem</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A thrust fault system is one in which the higher side of the fault moves upward. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">thrust system</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandTectonic/TransformBoundary -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandTectonic/TransformBoundary">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmLandTectonic/TransformMargin"/>
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmLandTectonic/TransformPlateBoundary"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandTectonic/PlateBoundary"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasBasin"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/realmGeolBasin/TranspressionalBasin"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealt:TransformBoundary</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A transform plate boundary is where two lithospheric plates slide past each other and where crust is neither produced or destroyed. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">transform boundary</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandTectonic/TransformFault -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandTectonic/TransformFault">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenSolid/Fault"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenSolid/FaultLine"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealt:TransformFault</metadata:prefixIRI>
        <rdfs:label xml:lang="en">transform fault</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandTectonic/TransformMargin -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandTectonic/TransformMargin">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandTectonic/PlateBoundary"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealt:TransformMargin</metadata:prefixIRI>
        <rdfs:label xml:lang="en">transform margin</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandTectonic/TransformPlateBoundary -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandTectonic/TransformPlateBoundary">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandTectonic/PlateBoundary"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealt:TransformPlateBoundary</metadata:prefixIRI>
        <rdfs:label xml:lang="en">transform plate boundary</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandTectonic/TranspressionalStressRegime -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandTectonic/TranspressionalStressRegime">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandTectonic/StressRegime"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaChemical/hasSubstance"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/matrRock/Melange"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealt:TranspressionalStressRegime</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Transpression regimes are formed during oblique collision of tectonic plates and during non-orthogonal subduction. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">transpressional stress regime</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandTectonic/TranstensionalStressRegime -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandTectonic/TranstensionalStressRegime">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandTectonic/StressRegime"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealt:TranstensionalStressRegime</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Transtension regimes are oblique tensional environments where stretching takes place. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">transtensional stress regime</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandTectonic/TripleJunction -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandTectonic/TripleJunction">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicBoundary"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealt:TripleJunction</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The Galapagos Triple Junction is a geological area in the eastern Pacific Ocean several hundred miles west of the Galapagos Islands where three tectonic plates - the Cocos Plate, the Nazca Plate and the Pacific Plate - meet. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">triple junction</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandVolcanic/Caldera -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandVolcanic/Caldera">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicFeature"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealv:Caldera</metadata:prefixIRI>
        <rdfs:label xml:lang="en">caldera</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandVolcanic/CentralVolcano -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandVolcanic/CentralVolcano">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandVolcanic/Volcano"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealv:CentralVolcano</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A volcano constructed by the ejection of debris and lava flows from a central point, forming a more or less symmetrical volcano.</rdfs:comment>
        <rdfs:label xml:lang="en">central volcano</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandVolcanic/CompositeVolcano -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandVolcanic/CompositeVolcano">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmLandVolcanic/CompoundVolcano"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandVolcanic/Volcano"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealv:CompositeVolcano</metadata:prefixIRI>
        <rdfs:label xml:lang="en">composite volcano</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandVolcanic/CompoundVolcano -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandVolcanic/CompoundVolcano">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandVolcanic/Volcano"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealv:CompoundVolcano</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A volcano that consists of a complex of two or more vents, or a volcano that has an associated volcanic dome, either in its crater or on its flanks.</rdfs:comment>
        <rdfs:label xml:lang="en">compound volcano</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandVolcanic/Fumarole -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandVolcanic/Fumarole">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandVolcanic/Vent"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealv:Fumarole</metadata:prefixIRI>
        <rdfs:label xml:lang="en">fumarole</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandVolcanic/Geothermal -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandVolcanic/Geothermal">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergy/Heat"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergy/HeatEnergy"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergy/ThermalEnergy"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicFeature"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealv:Geothermal</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">In geology, geothermal refers to heat sources within the planet. Strictly speaking, geo-thermal necessarily refers to the Earth but the concept may be applied to other planets. Geothermal is technically an adjective (e.g., geothermal energy) but in U.S. English the word has attained frequent use as a noun (otherwise expressed as g. heat, g. source, or geotherm). The planet&apos;s internal heat was originally generated during its accretion, due to gravitational binding energy, and since then additional heat has continued to be generated by the radioactive decay of elements such as uranium, thorium, and potassium. The heat flow from the interior to the surface is only 1/20,000 as great as the energy received from the Sun.</rdfs:comment>
        <rdfs:label xml:lang="en">geothermal</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandVolcanic/Geyser -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandVolcanic/Geyser">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandVolcanic/Vent"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealv:Geyser</metadata:prefixIRI>
        <rdfs:label xml:lang="en">geyser</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandVolcanic/HotSpot -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandVolcanic/HotSpot">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicFeature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRealm"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmLandVolcanic/LinearVolcanicChain"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaChemical/hasSubstance"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/matrRockIgneous/AnorogenicIgneousRock"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealv:HotSpot</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">In geology, a hotspot is a location on the Earth&apos;s surface that has experienced active volcanism for a long period of time. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">hot spot</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandVolcanic/LavaPlain -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandVolcanic/LavaPlain">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicFeature"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealv:LavaPlain</metadata:prefixIRI>
        <rdfs:label xml:lang="en">lava plain</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandVolcanic/LinearVolcanicChain -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandVolcanic/LinearVolcanicChain">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandVolcanic/VolcanicArc"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandVolcanic/VolcanicChain"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealv:LinearVolcanicChain</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Where this association of flood basalts with continental rifting is observed, it is not uncommon to find linear chains of volcanic islands  [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">linear volcanic chain</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandVolcanic/Monogenetic -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandVolcanic/Monogenetic">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandVolcanic/Volcano"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealv:Monogenetic</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A volcano built by a single eruption.</rdfs:comment>
        <rdfs:label xml:lang="en">monogenetic</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandVolcanic/ShieldVolcano -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandVolcanic/ShieldVolcano">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandVolcanic/Volcano"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealv:ShieldVolcano</metadata:prefixIRI>
        <rdfs:label xml:lang="en">shield volcano</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandVolcanic/Stratovolcano -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandVolcanic/Stratovolcano">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandVolcanic/Volcano"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealv:Stratovolcano</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A volcano composed of both lava flows and pyroclastic material.</rdfs:comment>
        <rdfs:label xml:lang="en">stratovolcano</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandVolcanic/SubaqueousVolcano -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandVolcanic/SubaqueousVolcano">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmLandVolcanic/SubmarineVolcano"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandVolcanic/Volcano"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRealm"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realm/Ocean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealv:SubaqueousVolcano</metadata:prefixIRI>
        <rdfs:label xml:lang="en">subaqueous volcano</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandVolcanic/SubmarineVolcano -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandVolcanic/SubmarineVolcano">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandVolcanic/Volcano"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealv:SubmarineVolcano</metadata:prefixIRI>
        <rdfs:label xml:lang="en">submarine volcano</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandVolcanic/Tumulus -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandVolcanic/Tumulus">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/Landform"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealv:Tumulus</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A doming or small mound on the crest of a lava flow caused by pressure due to the difference in the rate of flow between the cooler crust and the more fluid lava below.</rdfs:comment>
        <rdfs:label xml:lang="en">tumulus</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandVolcanic/Vent -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandVolcanic/Vent">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenSolid/Crack"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicFeature"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealv:Vent</metadata:prefixIRI>
        <rdfs:label xml:lang="en">vent</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandVolcanic/VolcanicArc -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandVolcanic/VolcanicArc">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmLandVolcanic/VolcanicChain"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicProvince"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealv:VolcanicArc</metadata:prefixIRI>
        <rdfs:label xml:lang="en">volcanic arc</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandVolcanic/VolcanicChain -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandVolcanic/VolcanicChain">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicProvince"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealv:VolcanicChain</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Island arcs that develop along the edges of a continent (for example, large parts of the Andes/ Central American/ Canadian mountain chain) may be known as a volcanic arc or volcanic chain. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">volcanic chain</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandVolcanic/VolcanicField -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandVolcanic/VolcanicField">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicProvince"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealv:VolcanicField</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A volcanic field is a spot of the earth&apos;s crust that is prone to localized volcanic activity. They usually contain 10 to 100 volcanoes, such as cinder cones and are usually in clusters. Lava flows may also occur. They may occur as a monogenetic volcanic field or a polygenetic volcanic field. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">volcanic field</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandVolcanic/VolcanicSystem -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandVolcanic/VolcanicSystem">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicFeature"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealv:VolcanicSystem</metadata:prefixIRI>
        <rdfs:label xml:lang="en">volcanic system</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandVolcanic/Volcano -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandVolcanic/Volcano">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandVolcanic/VolcanicField"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaChemical/hasPrimarySubstance"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/matrRockIgneous/Magma"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealv:Volcano</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A volcano is an opening, or rupture, in a planet&apos;s surface or crust, which allows hot, molten rock, ash, and gases to escape from below the surface. Volcanic activity involving the extrusion of rock tends to form mountains or features like mountains over a period of time. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">volcano</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandform/CentralCreekCrater -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandform/CentralCreekCrater">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/Crater"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreal:CentralCreekCrater</metadata:prefixIRI>
        <rdfs:label xml:lang="en">central creek crater</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandform/ComplexCrater -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandform/ComplexCrater">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/Crater"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreal:ComplexCrater</metadata:prefixIRI>
        <rdfs:label xml:lang="en">complex crater</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandform/Continent -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandform/Continent">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/Land"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/LandRegion"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/LandSurface"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/SurfaceRegion"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreal:Continent</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A continent is one of several large landmasses. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">continent</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandform/Crater -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandform/Crater">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/Landform"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprSpaceGeometry3D/Cavity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreal:Crater</metadata:prefixIRI>
        <rdfs:label xml:lang="en">crater</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandform/DebrisBasin -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandform/DebrisBasin">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/Land"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/LandRegion"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/LandSurface"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/SurfaceRegion"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreal:DebrisBasin</metadata:prefixIRI>
        <rdfs:label xml:lang="en">debris basin</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandform/DeflationZone -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandform/DeflationZone">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/Land"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/LandRegion"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/LandSurface"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/SurfaceRegion"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreal:DeflationZone</metadata:prefixIRI>
        <rdfs:label xml:lang="en">deflation zone</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandform/Dryland -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandform/Dryland">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/Land"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/LandRegion"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/LandSurface"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/SurfaceRegion"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreal:Dryland</metadata:prefixIRI>
        <rdfs:label xml:lang="en">dryland</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandform/Field -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandform/Field">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/Landform"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreal:Field</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Field (agriculture), an area of land used to cultivate crops, or to keep livestock [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">field</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandform/Highland -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandform/Highland">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/Landform"/>
        <owl:disjointWith rdf:resource="http://sweetontology.net/realmLandform/Lowland"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreal:Highland</metadata:prefixIRI>
        <rdfs:label xml:lang="en">highland</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandform/ImpactBasin -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandform/ImpactBasin">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/Landform"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreal:ImpactBasin</metadata:prefixIRI>
        <rdfs:label xml:lang="en">impact basin</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandform/ImpactCrater -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandform/ImpactCrater">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/Crater"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreal:ImpactCrater</metadata:prefixIRI>
        <rdfs:label xml:lang="en">impact crater</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandform/Lamination -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandform/Lamination">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/Landform"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreal:Lamination</metadata:prefixIRI>
        <rdfs:label xml:lang="en">lamination</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandform/Land -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandform/Land">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmLandform/LandRegion"/>
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmLandform/LandSurface"/>
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmLandform/SurfaceRegion"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprSpaceGeometry/Region"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreal:Land</metadata:prefixIRI>
        <rdfs:label xml:lang="en">land</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandform/LandCover -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandform/LandCover">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/Landform"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreal:LandCover</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Land cover is the physical material at the surface of the earth. Land covers include grass, asphalt, trees, bare ground, water, etc. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">land cover</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandform/LandRegion -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandform/LandRegion">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprSpaceGeometry/Region"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreal:LandRegion</metadata:prefixIRI>
        <rdfs:label xml:lang="en">land region</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandform/LandSurface -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandform/LandSurface">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprSpaceGeometry/Region"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreal:LandSurface</metadata:prefixIRI>
        <rdfs:label xml:lang="en">land surface</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandform/Landform -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandform/Landform">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/Land"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/LandRegion"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/LandSurface"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/SurfaceRegion"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreal:Landform</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A landform comprises a geomorphological unit, and is largely defined by its surface form and location in the landscape, as part of the terrain, and as such, is typically an element of topography. Landforms are categorised by features such as elevation, slope, orientation, stratification, rock exposure, and soil type. They include berms, mounds, hills, cliffs, valleys, rivers and numerous other elements.</rdfs:comment>
        <rdfs:label xml:lang="en">landform</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandform/Landscape -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandform/Landscape">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/Landform"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreal:Landscape</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A landscape comprises the visible features of an area of land, including physical elements such as landforms, living elements of flora and fauna, abstract elements such as lighting and weather conditions, and human elements, for instance human activity or the built environment. Landscape may also signify the objects around one in a building.</rdfs:comment>
        <rdfs:label xml:lang="en">landscape</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandform/Lowland -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandform/Lowland">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/Landform"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreal:Lowland</metadata:prefixIRI>
        <rdfs:label xml:lang="en">lowland</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandform/Mare -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandform/Mare">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/Plain"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/hasVisibility"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/stateVisibility/Dark"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreal:Mare</metadata:prefixIRI>
        <rdfs:label xml:lang="en">mare</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandform/PedestalCrater -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandform/PedestalCrater">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/Crater"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreal:PedestalCrater</metadata:prefixIRI>
        <rdfs:label xml:lang="en">pedestal crater</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandform/PitCrater -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandform/PitCrater">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/Crater"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreal:PitCrater</metadata:prefixIRI>
        <rdfs:label xml:lang="en">pit crater</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandform/Plain -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandform/Plain">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/Landform"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/hasSpatialConfiguration"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/stateSpaceConfiguration/Flat"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreal:Plain</metadata:prefixIRI>
        <rdfs:label xml:lang="en">plain</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandform/Prarie -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandform/Prarie">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/Plain"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreal:Prarie</metadata:prefixIRI>
        <rdfs:label xml:lang="en">prarie</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandform/RockyPitFloorCrater -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandform/RockyPitFloorCrater">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/PitCrater"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreal:RockyPitFloorCrater</metadata:prefixIRI>
        <rdfs:label xml:lang="en">rocky pit floor crater</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandform/ShatterCone -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandform/ShatterCone">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/Landform"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreal:ShatterCone</metadata:prefixIRI>
        <rdfs:label xml:lang="en">shatter cone</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandform/Spall -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandform/Spall">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/Landform"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreal:Spall</metadata:prefixIRI>
        <rdfs:label xml:lang="en">spall</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandform/SurfaceRegion -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandform/SurfaceRegion">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprSpaceGeometry/Region"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreal:SurfaceRegion</metadata:prefixIRI>
        <rdfs:label xml:lang="en">surface region</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOcean/Abyss -->

    <owl:Class rdf:about="http://sweetontology.net/realmOcean/Abyss">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmOcean/Abyssal"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOcean/WaterBodyLayer"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreao:Abyss</metadata:prefixIRI>
        <rdfs:label xml:lang="en">abyss</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOcean/Abyssal -->

    <owl:Class rdf:about="http://sweetontology.net/realmOcean/Abyssal">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOcean/WaterBodyLayer"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreao:Abyssal</metadata:prefixIRI>
        <rdfs:label xml:lang="en">abyssal</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOcean/AbyssopelagicZone -->

    <owl:Class rdf:about="http://sweetontology.net/realmOcean/AbyssopelagicZone">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOcean/WaterBodyLayer"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreao:AbyssopelagicZone</metadata:prefixIRI>
        <rdfs:label xml:lang="en">abyssopelagic zone</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOcean/AphoticZone -->

    <owl:Class rdf:about="http://sweetontology.net/realmOcean/AphoticZone">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOcean/WaterBodyLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasQuantity"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propIndex/Turbidity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/below"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmOcean/PhoticZone"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreao:AphoticZone</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The aphotic zone is the portion of a lake or ocean where there is little or no sunlight. It is formally defined as the depths beyond which less than 1% of sunlight penetrates. Consequently, bioluminescence is essentially the only light found in this zone. Most food comes from dead organisms sinking to the bottom of the lake or ocean from other zones. The depth of the aphotic zone can be greatly affected by such things as turbidity and the season of the year. The aphotic zone underlies the photic zone, which is that portion of the ocean directly affected by sunlight.</rdfs:comment>
        <rdfs:label xml:lang="en">aphotic zone</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOcean/BarrierLayer -->

    <owl:Class rdf:about="http://sweetontology.net/realmOcean/BarrierLayer">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOcean/WaterBodyLayer"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreao:BarrierLayer</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The depth range, where it exists, between the bottom of the oceanic surface mixed layer and the thermocline, usually at a depth between 30 and 80 m.</rdfs:comment>
        <rdfs:label xml:lang="en">barrier layer</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOcean/Bathyal -->

    <owl:Class rdf:about="http://sweetontology.net/realmOcean/Bathyal">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOcean/WaterBodyLayer"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreao:Bathyal</metadata:prefixIRI>
        <rdfs:label xml:lang="en">bathyal</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOcean/BathypelagicZone -->

    <owl:Class rdf:about="http://sweetontology.net/realmOcean/BathypelagicZone">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOcean/WaterBodyLayer"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreao:BathypelagicZone</metadata:prefixIRI>
        <rdfs:label xml:lang="en">bathypelagic zone</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOcean/BenthicZone -->

    <owl:Class rdf:about="http://sweetontology.net/realmOcean/BenthicZone">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOcean/WaterBodyLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/below"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmOcean/DemersalZone"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreao:BenthicZone</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Benthic means anything associated with or happening on the bottom of a body of water. The Benthic Zone of the ocean is the bottom ocean zone ranging from the deepest parts of the ocean to the tidal affected areas. The most productive region of the benthic zone is the area over the continental margin, which is unaffected by the tides.</rdfs:comment>
        <rdfs:label xml:lang="en">benthic zone</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOcean/DemersalZone -->

    <owl:Class rdf:about="http://sweetontology.net/realmOcean/DemersalZone">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOcean/WaterBodyLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRealm"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmOcean/ProfundalZone"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/above"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmOcean/BenthicZone"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreao:DemersalZone</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The demersal zone is the part of the sea or ocean (or deep lake) comprising the water column that is near to (and is significantly affected by) the seabed and the benthos. The demersal zone is just above the benthic zone and forms a layer of the larger profundal zone.</rdfs:comment>
        <rdfs:label xml:lang="en">demersal zone</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOcean/EuphoticZone -->

    <owl:Class rdf:about="http://sweetontology.net/realmOcean/EuphoticZone">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmOcean/PhoticZone"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOcean/WaterBodyLayer"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreao:EuphoticZone</metadata:prefixIRI>
        <rdfs:label xml:lang="en">euphotic zone</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOcean/Hadal -->

    <owl:Class rdf:about="http://sweetontology.net/realmOcean/Hadal">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOcean/WaterBodyLayer"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreao:Hadal</metadata:prefixIRI>
        <rdfs:label xml:lang="en">hadal</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOcean/Halocline -->

    <owl:Class rdf:about="http://sweetontology.net/realmOcean/Halocline">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOcean/WaterBodyLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/hasGradient"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propChemical/Salinity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreao:Halocline</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">In oceanography, a Halocline is a strong, vertical salinity gradient. Because salinity (in concert with temperature) affects the density of seawater, it can play a role in its vertical stratification.</rdfs:comment>
        <rdfs:label xml:lang="en">halocline</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOcean/LimneticZone -->

    <owl:Class rdf:about="http://sweetontology.net/realmOcean/LimneticZone">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOcean/WaterBodyLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/above"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmOcean/ProfundalZone"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreao:LimneticZone</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The limnetic zone is the well-lit, open surface waters farther from shore in a lake. It is surrounded by the littoral zone and above the profundal zone</rdfs:comment>
        <rdfs:label xml:lang="en">limnetic zone</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOcean/MesopelagicZone -->

    <owl:Class rdf:about="http://sweetontology.net/realmOcean/MesopelagicZone">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOcean/WaterBodyLayer"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreao:MesopelagicZone</metadata:prefixIRI>
        <rdfs:label xml:lang="en">mesopelagic zone</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOcean/MixedLayer -->

    <owl:Class rdf:about="http://sweetontology.net/realmOcean/MixedLayer">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOcean/WaterBodyLayer"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreao:MixedLayer</metadata:prefixIRI>
        <rdfs:label xml:lang="en">mixed layer</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOcean/NeriticZone -->

    <owl:Class rdf:about="http://sweetontology.net/realmOcean/NeriticZone">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOcean/WaterBodyLayer"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreao:NeriticZone</metadata:prefixIRI>
        <rdfs:label xml:lang="en">neritic zone</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOcean/OceanRegion -->

    <owl:Class rdf:about="http://sweetontology.net/realmOcean/OceanRegion">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetaryRealm"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRealm"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realm/Ocean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreao:OceanRegion</metadata:prefixIRI>
        <rdfs:label xml:lang="en">ocean region</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOcean/OpenOcean -->

    <owl:Class rdf:about="http://sweetontology.net/realmOcean/OpenOcean">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOcean/OceanRegion"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreao:OpenOcean</metadata:prefixIRI>
        <rdfs:label xml:lang="en">open ocean</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOcean/PelagicSubZone -->

    <owl:Class rdf:about="http://sweetontology.net/realmOcean/PelagicSubZone">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOcean/OceanRegion"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/partOf"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmOcean/PelagicZone"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreao:PelagicSubZone</metadata:prefixIRI>
        <rdfs:label xml:lang="en">pelagic sub zone</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOcean/PelagicZone -->

    <owl:Class rdf:about="http://sweetontology.net/realmOcean/PelagicZone">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOcean/OceanRegion"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreao:PelagicZone</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The pelagic zone is the part of the open sea or ocean that is not near the coast.</rdfs:comment>
        <rdfs:label xml:lang="en">pelagic zone</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOcean/PhoticZone -->

    <owl:Class rdf:about="http://sweetontology.net/realmOcean/PhoticZone">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOcean/WaterBodyLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenBiol/Photosynthesis"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasQuantity"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propIndex/Turbidity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/above"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmOcean/AphoticZone"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreao:PhoticZone</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The photic zone or euphotic zone is the depth of the water whether in a lake or an ocean, that is exposed to sufficient sunlight for photosynthesis to occur. The depth of the euphotic zone can be greatly affected by seasonal turbidity.</rdfs:comment>
        <rdfs:label xml:lang="en">photic zone</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOcean/Polynya -->

    <owl:Class rdf:about="http://sweetontology.net/realmOcean/Polynya">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOcean/OceanRegion"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/surroundedBy"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmCryo/SeaIce"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreao:Polynya</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A polynya is any non-linear area of open water surrounded by sea ice. It is now used as geographical term for areas of sea in Arctic or Antarctic regions which remain unfrozen for much of the year.</rdfs:comment>
        <rdfs:label xml:lang="en">polynya</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOcean/ProfundalZone -->

    <owl:Class rdf:about="http://sweetontology.net/realmOcean/ProfundalZone">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOcean/WaterBodyLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRealm"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmOcean/AphoticZone"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreao:ProfundalZone</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The profundal zone is a deep zone of a body of water, such as an ocean or a lake, located below the range of effective light penetration. This is typically below the thermocline, the vertical zone in the water through which temperature drops rapidly. The lack of light in the profundal zone determines the type of biological community that can live in this region, which is distinctly different from the community in the overlying waters. The profundal zone is part of the aphotic zone.</rdfs:comment>
        <rdfs:label xml:lang="en">profundal zone</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOcean/Pycnocline -->

    <owl:Class rdf:about="http://sweetontology.net/realmOcean/Pycnocline">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOcean/WaterBodyLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/hasGradient"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propChemical/Salinity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreao:Pycnocline</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A pycnocline is a layer across which there is a rapid change in water density with depth. In freshwater environments such as lakes this density change is primarily caused by water temperature, while in seawater environments such as oceans the density change may be caused by changes in water temperature and/or salinity</rdfs:comment>
        <rdfs:label xml:lang="en">pycnocline</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOcean/Thermocline -->

    <owl:Class rdf:about="http://sweetontology.net/realmOcean/Thermocline">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOcean/WaterBodyLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasQuantity"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propTemperatureGradient/TemperatureGradient"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreao:Thermocline</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The thermocline (sometimes metalimnion) is a layer within a body of water or air where the temperature changes rapidly with depth.</rdfs:comment>
        <rdfs:label xml:lang="en">thermocline</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOcean/WaterBodyLayer -->

    <owl:Class rdf:about="http://sweetontology.net/realmOcean/WaterBodyLayer">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/GlobalPlanetaryLayer"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetaryLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRealm"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realm/Ocean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreao:WaterBodyLayer</metadata:prefixIRI>
        <rdfs:label xml:lang="en">water body layer</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOceanFeature/EarthEasternBoundaryCurrent -->

    <owl:Class rdf:about="http://sweetontology.net/realmOceanFeature/EarthEasternBoundaryCurrent">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOceanDynamics/EasternBoundaryCurrent"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOceanFeature/EarthOceanCurrent"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaofe:EarthEasternBoundaryCurrent</metadata:prefixIRI>
        <rdfs:label xml:lang="en">earth eastern boundary current</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOceanFeature/EarthOcean -->

    <owl:Class rdf:about="http://sweetontology.net/realmOceanFeature/EarthOcean">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/Ocean"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/hasAstronomicalBody"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/realm/Earth"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaofe:EarthOcean</metadata:prefixIRI>
        <rdfs:label xml:lang="en">earth ocean</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOceanFeature/EarthOceanCurrent -->

    <owl:Class rdf:about="http://sweetontology.net/realmOceanFeature/EarthOceanCurrent">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOceanDynamics/OceanCurrent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/hasAstronomicalBody"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/realm/Earth"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaofe:EarthOceanCurrent</metadata:prefixIRI>
        <rdfs:label xml:lang="en">earth ocean current</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOceanFeature/EarthWesternBoundaryCurrent -->

    <owl:Class rdf:about="http://sweetontology.net/realmOceanFeature/EarthWesternBoundaryCurrent">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOceanDynamics/WesternBoundaryCurrent"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOceanFeature/EarthOceanCurrent"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaofe:EarthWesternBoundaryCurrent</metadata:prefixIRI>
        <rdfs:label xml:lang="en">earth western boundary current</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOceanFeature/KamchatkaCurrent -->

    <owl:Class rdf:about="http://sweetontology.net/realmOceanFeature/KamchatkaCurrent">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOceanDynamics/OceanCurrent"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaofe:KamchatkaCurrent</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The western part of the subpolar gyre in the deep (western) part of the Bering Sea.</rdfs:comment>
        <rdfs:label xml:lang="en">kamchatka current</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOceanFeature/OceanArea -->

    <owl:Class rdf:about="http://sweetontology.net/realmOceanFeature/OceanArea">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceMultidimensional/Area"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/million_km2"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaofe:OceanArea</metadata:prefixIRI>
        <rdfs:label xml:lang="en">ocean area</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOceanFeature/OceanDepth -->

    <owl:Class rdf:about="http://sweetontology.net/realmOceanFeature/OceanDepth">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceHeight/Depth"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/meter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaofe:OceanDepth</metadata:prefixIRI>
        <rdfs:label xml:lang="en">ocean depth</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOceanFeature/OceanVolume -->

    <owl:Class rdf:about="http://sweetontology.net/realmOceanFeature/OceanVolume">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceMultidimensional/Volume"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/million_km3"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaofe:OceanVolume</metadata:prefixIRI>
        <rdfs:label xml:lang="en">ocean volume</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOceanFeature/YellowSeaWarmCurrent -->

    <owl:Class rdf:about="http://sweetontology.net/realmOceanFeature/YellowSeaWarmCurrent">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOceanDynamics/OceanCurrent"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaofe:YellowSeaWarmCurrent</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A surface current flowing northward along the central axis of the Yellow Sea.</rdfs:comment>
        <rdfs:label xml:lang="en">yellow sea warm current</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOceanFloor/AbyssalHill -->

    <owl:Class rdf:about="http://sweetontology.net/realmOceanFloor/AbyssalHill">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandOrographic/Hill"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOceanFloor/OceanFloor"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOceanFloor/SeaFloor"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOceanFloor/Seabed"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaofl:AbyssalHill</metadata:prefixIRI>
        <rdfs:label xml:lang="en">abyssal hill</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOceanFloor/AbyssalPlain -->

    <owl:Class rdf:about="http://sweetontology.net/realmOceanFloor/AbyssalPlain">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandform/Plain"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOceanFloor/OceanFloor"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOceanFloor/SeaFloor"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOceanFloor/Seabed"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaofl:AbyssalPlain</metadata:prefixIRI>
        <rdfs:label xml:lang="en">abyssal plain</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOceanFloor/AbyssalTrench -->

    <owl:Class rdf:about="http://sweetontology.net/realmOceanFloor/AbyssalTrench">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmOceanFloor/DeepSeaTrench"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandFluvial/Trench"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOceanFloor/OceanFloor"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOceanFloor/SeaFloor"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOceanFloor/Seabed"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaofl:AbyssalTrench</metadata:prefixIRI>
        <rdfs:label xml:lang="en">abyssal trench</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOceanFloor/AlgalFlat -->

    <owl:Class rdf:about="http://sweetontology.net/realmOceanFloor/AlgalFlat">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOceanFloor/OceanFloor"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOceanFloor/SeaFloor"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOceanFloor/Seabed"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaofl:AlgalFlat</metadata:prefixIRI>
        <rdfs:label xml:lang="en">algal flat</rdfs:label>
    </owl:Class>
    


