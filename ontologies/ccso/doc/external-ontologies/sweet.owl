        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceDistance/Distance"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsdis:Wavelength</metadata:prefixIRI>
        <rdfs:label xml:lang="en">wavelength</rdfs:label>
    </owl:Class>
    


