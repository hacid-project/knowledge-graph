    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceHeight/SeaState -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceHeight/SeaState">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceHeight/Height"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRealm"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realm/Ocean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsh:SeaState</metadata:prefixIRI>
        <rdfs:label xml:lang="en">sea state</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceHeight/SecchiDepth -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceHeight/SecchiDepth">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/RadiationMediumInteractionQuantity"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceHeight/Depth"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsh:SecchiDepth</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The Secchi disk is a device used to measure water transparency in open waters of lakes, bays, and the ocean. A pattern is drawn or painted onto a card or acrylic, mounted on a pole or line, and lowered slowly in the water. The depth at which the pattern on the disk is no longer visible is taken as a measure of the transparency of the water. This measure is known as the Secchi depth and is related to water turbidity.</rdfs:comment>
        <rdfs:label xml:lang="en">secchi depth</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceHeight/SignificantHeight -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceHeight/SignificantHeight">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceHeight/Height"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsh:SignificantHeight</metadata:prefixIRI>
        <rdfs:label xml:lang="en">significant height</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceHeight/SkinDepth -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceHeight/SkinDepth">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceHeight/Depth"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsh:SkinDepth</metadata:prefixIRI>
        <rdfs:label xml:lang="en">skin depth</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceHeight/TopographicProminence -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceHeight/TopographicProminence">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceHeight/Height"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsh:TopographicProminence</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">In topography, prominence, also known as autonomous height, relative height or shoulder drop (in America) or prime factor (in Europe), is a concept used in the categorization of hills and mountains, also known as peaks. It is a measure of the independent stature of a summit.</rdfs:comment>
        <rdfs:label xml:lang="en">topographic prominence</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceHeight/Topography -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceHeight/Topography">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceHeight/Height"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsh:Topography</metadata:prefixIRI>
        <rdfs:label xml:lang="en">topography</rdfs:label>
