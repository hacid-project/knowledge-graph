    <!-- http://sweetontology.net/matrIon/Anion -->

    <owl:Class rdf:about="http://sweetontology.net/matrIon/Anion">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrIon/Ion"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somaio:Anion</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">An anion is an ion that has more electrons than protons such that the atom or molecule is negatively charged. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">anion</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrIon/Cation -->

    <owl:Class rdf:about="http://sweetontology.net/matrIon/Cation">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrIon/Ion"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somaio:Cation</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">An cation is an ion that has more protons than electrons such that the atom or molecule is positively charged. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">cation</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrIon/HeavyIon -->

