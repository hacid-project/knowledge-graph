        <rdfs:comment xml:lang="en">Chlorinated hydrocarbons consist of simple hydrocarbons in which one or more hydrogen atoms have been replaced with chlorine.</rdfs:comment>
        <rdfs:label xml:lang="en">chlorinated hydrocarbon</rdfs:label>
    </owl:Class>
    


