        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropr:CoriolisParameter</metadata:prefixIRI>
        <rdfs:label xml:lang="en">coriolis parameter</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propRotation/Curl -->

    <owl:Class rdf:about="http://sweetontology.net/propRotation/Curl">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprMathOperation/VectorFieldOperation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/hasOutput"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/reprMathFunction/VectorField"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropr:Curl</metadata:prefixIRI>
        <rdfs:label xml:lang="en">curl</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propRotation/CyclotronFrequency -->

    <owl:Class rdf:about="http://sweetontology.net/propRotation/CyclotronFrequency">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/propRotation/Gyrofrequency"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTimeFrequency/Frequency"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropr:CyclotronFrequency</metadata:prefixIRI>
        <rdfs:label xml:lang="en">cyclotron frequency</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propRotation/Enstrophy -->

    <owl:Class rdf:about="http://sweetontology.net/propRotation/Enstrophy">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/prop/AngularMotionProperty"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/PhysicalQuantity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropr:Enstrophy</metadata:prefixIRI>
        <rdfs:label xml:lang="en">enstrophy</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propRotation/ErtelPotentialVorticity -->

    <owl:Class rdf:about="http://sweetontology.net/propRotation/ErtelPotentialVorticity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propRotation/PotentialVorticity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/perKilogramMeterSquaredPerSecondKelvin"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropr:ErtelPotentialVorticity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">ertel potential vorticity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propRotation/Gyrofrequency -->

    <owl:Class rdf:about="http://sweetontology.net/propRotation/Gyrofrequency">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTimeFrequency/Frequency"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropr:Gyrofrequency</metadata:prefixIRI>
        <rdfs:label xml:lang="en">gyrofrequency</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propRotation/Helicity -->

    <owl:Class rdf:about="http://sweetontology.net/propRotation/Helicity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprMathOperation/VectorFieldOperation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/meterPerSecondSquared"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropr:Helicity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">helicity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propRotation/MomentOfInertia -->

    <owl:Class rdf:about="http://sweetontology.net/propRotation/MomentOfInertia">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/prop/AngularMotionProperty"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/PhysicalQuantity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropr:MomentOfInertia</metadata:prefixIRI>
        <rdfs:label xml:lang="en">moment of inertia</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propRotation/PotentialVorticity -->

    <owl:Class rdf:about="http://sweetontology.net/propRotation/PotentialVorticity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/prop/AngularMotionProperty"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/PhysicalQuantity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropr:PotentialVorticity</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The vertically averaged vorticity of a layer divided by layer thickness.</rdfs:comment>
        <rdfs:label xml:lang="en">potential vorticity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propRotation/RelativeVorticity -->

    <owl:Class rdf:about="http://sweetontology.net/propRotation/RelativeVorticity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propRotation/Vorticity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropr:RelativeVorticity</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The vorticity as measured in a system of coordinates fixed on the earth&apos;s surface.  Usually, only the vertical component of the vorticity is meant.</rdfs:comment>
        <rdfs:label xml:lang="en">relative vorticity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propRotation/Spin -->

    <owl:Class rdf:about="http://sweetontology.net/propRotation/Spin">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/prop/AngularMotionProperty"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropr:Spin</metadata:prefixIRI>
        <rdfs:label xml:lang="en">spin</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propRotation/Torque -->

    <owl:Class rdf:about="http://sweetontology.net/propRotation/Torque">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/prop/AngularMotionProperty"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/VectorQuantity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/newtonMeter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropr:Torque</metadata:prefixIRI>
        <rdfs:label xml:lang="en">torque</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propRotation/Vorticity -->

    <owl:Class rdf:about="http://sweetontology.net/propRotation/Vorticity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprMathOperation/VectorFieldOperation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/perSecond"/>
            </owl:Restriction>
