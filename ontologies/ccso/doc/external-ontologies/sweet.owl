        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaas:Photosphere</metadata:prefixIRI>
        <rdfs:label xml:lang="en">photosphere</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAstroStar/RadiativeZone -->

    <owl:Class rdf:about="http://sweetontology.net/realmAstroStar/RadiativeZone">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAstroStar/StellarInterior"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaas:RadiativeZone</metadata:prefixIRI>
