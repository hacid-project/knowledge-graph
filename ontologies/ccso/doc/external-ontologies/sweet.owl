        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmHydro/Embankment"/>
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmHydro/FloodBank"/>
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmHydro/Levee"/>
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmHydro/RaisedBank"/>
