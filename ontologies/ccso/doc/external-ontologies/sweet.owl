            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/rangeOf"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propSpaceDistance/Wavelength"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsdis:WavelengthBand</metadata:prefixIRI>
        <rdfs:label xml:lang="en">wavelength band</rdfs:label>
    </owl:Class>
    


