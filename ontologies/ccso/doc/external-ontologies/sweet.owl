        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophso:Dislocation</metadata:prefixIRI>
        <rdfs:label xml:lang="en">dislocation</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenSolid/Distortion -->

