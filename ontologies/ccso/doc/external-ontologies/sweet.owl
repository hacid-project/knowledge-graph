        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorept:Time</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">This concept is of time as an independent variable</rdfs:comment>
        <rdfs:label xml:lang="en">time</rdfs:label>
    </owl:Class>
    


