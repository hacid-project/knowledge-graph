    </owl:Class>
    


    <!-- http://sweetontology.net/realmAstroStar/ConvectionZone -->

    <owl:Class rdf:about="http://sweetontology.net/realmAstroStar/ConvectionZone">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAstroStar/StellarInterior"/>
        <owl:disjointWith rdf:resource="http://sweetontology.net/realmAstroStar/StellarCore"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaas:ConvectionZone</metadata:prefixIRI>
        <rdfs:label xml:lang="en">convection zone</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAstroStar/Corona -->

    <owl:Class rdf:about="http://sweetontology.net/realmAstroStar/Corona">
