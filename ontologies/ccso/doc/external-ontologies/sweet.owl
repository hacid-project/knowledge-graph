        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropm:Ductibility</metadata:prefixIRI>
        <rdfs:label xml:lang="en">ductibility</rdfs:label>
    </owl:Class>
    


