        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsdis:DebyeScreeningLength</metadata:prefixIRI>
        <rdfs:label xml:lang="en">debye screening length</rdfs:label>
    </owl:Class>
    


