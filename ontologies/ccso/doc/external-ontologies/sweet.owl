        <rdfs:label xml:lang="en">englacial process</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001622"/>
        <skos:definition>
            <rdf:Description>
                <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2020-04-09T10:12:52-08:00</terms:created>
                <terms:creator rdf:resource="https://orcid.org/0000-0003-4091-6059"/>
                <terms:source rdf:resource="https://orcid.org/0000-0003-4808-4736"/>
                <rdfs:comment xml:lang="en">A positional quality inhering in a bearer by virtue of the bearer being located within a glacier or ice sheet, between their summer surface or bed.</rdfs:comment>
                <prov:wasDerivedFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001622"/>
            </rdf:Description>
        </skos:definition>
    </owl:Class>
    


