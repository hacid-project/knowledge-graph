        <owl:equivalentClass rdf:resource="http://sweetontology.net/phenWave/Acoustics"/>
        <owl:equivalentClass rdf:resource="http://sweetontology.net/phenWave/Sound"/>
        <owl:equivalentClass rdf:resource="http://sweetontology.net/phenWave/SoundWave"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/Wave"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/hasRestoringForce"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/procPhysical/Pressure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophw:AcousticWave</metadata:prefixIRI>
        <rdfs:label xml:lang="en">acoustic wave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenWave/Acoustics -->

    <owl:Class rdf:about="http://sweetontology.net/phenWave/Acoustics">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/Wave"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophw:Acoustics</metadata:prefixIRI>
        <rdfs:label xml:lang="en">acoustics</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenWave/AlfvenWave -->

    <owl:Class rdf:about="http://sweetontology.net/phenWave/AlfvenWave">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/PlasmaWave"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophw:AlfvenWave</metadata:prefixIRI>
        <rdfs:label xml:lang="en">alfven wave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenWave/BodyWave -->

    <owl:Class rdf:about="http://sweetontology.net/phenWave/BodyWave">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/SolidWave"/>
        <owl:disjointWith rdf:resource="http://sweetontology.net/phenWave/SurfaceWave"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophw:BodyWave</metadata:prefixIRI>
        <rdfs:label xml:lang="en">body wave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenWave/CapillaryWave -->

    <owl:Class rdf:about="http://sweetontology.net/phenWave/CapillaryWave">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/Wave"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophw:CapillaryWave</metadata:prefixIRI>
        <rdfs:label xml:lang="en">capillary wave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenWave/CompressionWave -->

    <owl:Class rdf:about="http://sweetontology.net/phenWave/CompressionWave">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/LongitudinalWave"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophw:CompressionWave</metadata:prefixIRI>
        <rdfs:label xml:lang="en">compression wave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenWave/FluidWave -->

    <owl:Class rdf:about="http://sweetontology.net/phenWave/FluidWave">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/Wave"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasState"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/Fluid"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophw:FluidWave</metadata:prefixIRI>
        <rdfs:label xml:lang="en">fluid wave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenWave/GravitationalWave -->

    <owl:Class rdf:about="http://sweetontology.net/phenWave/GravitationalWave">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/phenWave/GravityWave"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/FluidWave"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophw:GravitationalWave</metadata:prefixIRI>
        <rdfs:label xml:lang="en">gravitational wave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenWave/GravityWave -->

    <owl:Class rdf:about="http://sweetontology.net/phenWave/GravityWave">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/FluidWave"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/hasRestoringForce"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/phenFluidTransport/Buoyancy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophw:GravityWave</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A wave disturbance in which buoyancy (or reduced gravity) acts as the restoring force on parcels displaced from hydrostatic equilibrium.</rdfs:comment>
        <rdfs:label xml:lang="en">gravity wave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenWave/HelmholtzWave -->

    <owl:Class rdf:about="http://sweetontology.net/phenWave/HelmholtzWave">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/GravitationalWave"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/GravityWave"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophw:HelmholtzWave</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">An unstable wave in a system of two homogeneous fluids with a velocity discontinuity at the interface.</rdfs:comment>
        <rdfs:label xml:lang="en">helmholtz wave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenWave/InertiaWave -->

    <owl:Class rdf:about="http://sweetontology.net/phenWave/InertiaWave">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/phenWave/InertialWave"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/InternalGravityWave"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/InternalWave"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/hasRestoringForce"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/procPhysical/CoriolisForce"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophw:InertiaWave</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">1. Any wave motion in which no form of energy other than kinetic energy is present. In this general sense, Helmholtz waves, barotropic disturbances, Rossby waves, etc., are inertia waves. 2. More restrictedly, a wave motion in which the source of kinetic energy of the disturbance is the rotation of the fluid about some given axis. In the atmosphere a westerly wind system is such a source, the inertia waves here being, in general, stable. A similar analysis has been applied to smaller vortices, such as the hurricane. See inertial instability</rdfs:comment>
        <rdfs:label xml:lang="en">inertia wave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenWave/InertialWave -->

    <owl:Class rdf:about="http://sweetontology.net/phenWave/InertialWave">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/InternalGravityWave"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/InternalWave"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophw:InertialWave</metadata:prefixIRI>
        <rdfs:label xml:lang="en">inertial wave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenWave/InternalGravityWave -->

    <owl:Class rdf:about="http://sweetontology.net/phenWave/InternalGravityWave">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/phenWave/InternalWave"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/GravitationalWave"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/GravityWave"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/InternalWave"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasState"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/phenFluidInstability/StaticStability"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophw:InternalGravityWave</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A wave that propagates in density-stratified fluid under the influence of buoyancy forces.</rdfs:comment>
        <rdfs:label xml:lang="en">internal gravity wave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenWave/InternalWave -->

    <owl:Class rdf:about="http://sweetontology.net/phenWave/InternalWave">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/GravitationalWave"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/GravityWave"/>
        <owl:disjointWith rdf:resource="http://sweetontology.net/phenWave/SurfaceWave"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophw:InternalWave</metadata:prefixIRI>
        <rdfs:label xml:lang="en">internal wave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenWave/KelvinHelmholtzWave -->

    <owl:Class rdf:about="http://sweetontology.net/phenWave/KelvinHelmholtzWave">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/GravitationalWave"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/GravityWave"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasState"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenFluidInstability/KelvinHelmholtzInstability"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophw:KelvinHelmholtzWave</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A waveform disturbance that arises from Kelvin?Helmholtz instability.</rdfs:comment>
        <rdfs:label xml:lang="en">kelvin helmholtz wave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenWave/KelvinWave -->

    <owl:Class rdf:about="http://sweetontology.net/phenWave/KelvinWave">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/GravitationalWave"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/GravityWave"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophw:KelvinWave</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A type of low-frequency gravity wave trapped to a vertical boundary, or the equator, which propagates anticlockwise (in the Northerm Hemisphere) around a basin.</rdfs:comment>
        <rdfs:label xml:lang="en">kelvin wave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenWave/LongCrestedWave -->

    <owl:Class rdf:about="http://sweetontology.net/phenWave/LongCrestedWave">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/SurfaceWave"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophw:LongCrestedWave</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Ocean surface waves that are nearly two-dimensional, in that the crests appear very long in comparison with the wavelength, and the energy propagation is concentrated in a narrow band around the mean wave direction.</rdfs:comment>
        <rdfs:label xml:lang="en">long crested wave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenWave/LongitudinalWave -->

    <owl:Class rdf:about="http://sweetontology.net/phenWave/LongitudinalWave">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/Wave"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/hasOscillationDirection"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSpaceDirection/Parallel"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophw:LongitudinalWave</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Longitudinal waves are waves that have vibrations along or parallel to their direction of travel. They include waves in which the motion of the medium is in the same direction as the motion of the wave. Mechanical longitudinal waves have been also referred to as compressional waves or pressure waves</rdfs:comment>
        <rdfs:label xml:lang="en">longitudinal wave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenWave/MagnetohydrodynamicWave -->

    <owl:Class rdf:about="http://sweetontology.net/phenWave/MagnetohydrodynamicWave">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/PlasmaWave"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophw:MagnetohydrodynamicWave</metadata:prefixIRI>
        <rdfs:label xml:lang="en">magnetohydrodynamic wave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenWave/PlanetaryWave -->

    <owl:Class rdf:about="http://sweetontology.net/phenWave/PlanetaryWave">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/phenWave/RossbyWave"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/InertiaWave"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/InertialWave"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophw:PlanetaryWave</metadata:prefixIRI>
        <rdfs:label xml:lang="en">planetary wave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenWave/PlasmaWave -->

    <owl:Class rdf:about="http://sweetontology.net/phenWave/PlasmaWave">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/Wave"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasState"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/Plasma"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophw:PlasmaWave</metadata:prefixIRI>
        <rdfs:label xml:lang="en">plasma wave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenWave/RayleighWave -->

    <owl:Class rdf:about="http://sweetontology.net/phenWave/RayleighWave">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/Acoustic"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/AcousticWave"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/Acoustics"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/SolidWave"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/Sound"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/SoundWave"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/SurfaceWave"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophw:RayleighWave</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Rayleigh waves, also called ground roll, are surface waves that travel as ripples similar to those on the surface of water. The existence of these waves was predicted by John William Strutt, Lord Rayleigh, in 1885. They are slower than body waves, roughly 70% of the velocity of S waves, and have been asserted to be visible during an earthquake in an open space like a parking lot where the cars move up and down with the waves. Reports among seismologists suggest that the apparent motion may be due to distortion of the human eye during shaking. Anecdotally, placing people on shake tables causes the room to appear to ripple. In any case, waves of the reported amplitude, wavelength, and velocity of the visible waves have never been recorded instrumentally.</rdfs:comment>
        <rdfs:label xml:lang="en">rayleigh wave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenWave/RossbyWave -->

    <owl:Class rdf:about="http://sweetontology.net/phenWave/RossbyWave">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/InertiaWave"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/InertialWave"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophw:RossbyWave</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Rossby (or planetary) waves are large-scale motions in the ocean or atmosphere whose restoring force is the variation in Coriolis effect with latitude. The waves were first identified in the atmosphere in 1939 by Carl-Gustaf Arvid Rossby who went on to explain their motion. Rossby waves are a subset of inertial waves</rdfs:comment>
        <rdfs:label xml:lang="en">rossby wave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenWave/Seiche -->

    <owl:Class rdf:about="http://sweetontology.net/phenWave/Seiche">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/StandingWave"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophw:Seiche</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A seiche is a standing wave in an enclosed or partially enclosed body of water. Seiches and seiche-related phenomena have been observed on lakes, reservoirs, bays and seas. The key requirement for formation of a seiche is that the body of water be at least partially bounded, allowing natural phenomena to form a standing wave.</rdfs:comment>
        <rdfs:label xml:lang="en">seiche</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenWave/ShallowWaterWave -->

    <owl:Class rdf:about="http://sweetontology.net/phenWave/ShallowWaterWave">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/GravitationalWave"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/GravityWave"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophw:ShallowWaterWave</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">An ocean wave with its length sufficiently large compared to the water depth (i.e., 25 or more times the depth)</rdfs:comment>
        <rdfs:label xml:lang="en">shallow water wave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenWave/ShearWave -->

    <owl:Class rdf:about="http://sweetontology.net/phenWave/ShearWave">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/SolidWave"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/TransverseWave"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/hasRestoringForce"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/phenSolid/Shear"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophw:ShearWave</metadata:prefixIRI>
        <rdfs:label xml:lang="en">shear wave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenWave/ShockWave -->

    <owl:Class rdf:about="http://sweetontology.net/phenWave/ShockWave">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/Wave"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenSystemComplexity/Shock"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophw:ShockWave</metadata:prefixIRI>
        <rdfs:label xml:lang="en">shock wave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenWave/ShortWave -->

    <owl:Class rdf:about="http://sweetontology.net/phenWave/ShortWave">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/Wave"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophw:ShortWave</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">With regard to atmospheric circulation, a progressive wave in the horizontal pattern of air motion with dimensions of cyclonic scale, as distinguished from a long wave.</rdfs:comment>
        <rdfs:label xml:lang="en">short wave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenWave/SolidWave -->

    <owl:Class rdf:about="http://sweetontology.net/phenWave/SolidWave">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/Wave"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasState"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/Solid"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophw:SolidWave</metadata:prefixIRI>
        <rdfs:label xml:lang="en">solid wave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenWave/Sound -->

    <owl:Class rdf:about="http://sweetontology.net/phenWave/Sound">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/Wave"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophw:Sound</metadata:prefixIRI>
        <rdfs:label xml:lang="en">sound</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenWave/SoundWave -->

    <owl:Class rdf:about="http://sweetontology.net/phenWave/SoundWave">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/Wave"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophw:SoundWave</metadata:prefixIRI>
        <rdfs:label xml:lang="en">sound wave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenWave/StandingWave -->

    <owl:Class rdf:about="http://sweetontology.net/phenWave/StandingWave">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/Wave"/>
        <owl:disjointWith rdf:resource="http://sweetontology.net/phenWave/TravelingWave"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophw:StandingWave</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A wave that is stationary with respect to the medium in which it is embedded, for example, two equal gravity waves moving in opposite directions.</rdfs:comment>
        <rdfs:label xml:lang="en">standing wave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenWave/SurfaceWave -->

    <owl:Class rdf:about="http://sweetontology.net/phenWave/SurfaceWave">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/Wave"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophw:SurfaceWave</metadata:prefixIRI>
        <rdfs:label xml:lang="en">surface wave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenWave/TopographicWave -->

    <owl:Class rdf:about="http://sweetontology.net/phenWave/TopographicWave">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/GravitationalWave"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/GravityWave"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophw:TopographicWave</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Waves with a restoring force arising from variations in depth. The stretching or compression of displaced columns of water generates anomalous vorticity tending to drive them back to their original position.</rdfs:comment>
        <rdfs:label xml:lang="en">topographic wave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenWave/TransverseWave -->

    <owl:Class rdf:about="http://sweetontology.net/phenWave/TransverseWave">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/Wave"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/hasOscillationDirection"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSpaceDirection/Perpendicular"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophw:TransverseWave</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A transverse wave is a wave that causes vibration in the medium in a perpendicular direction to its own motion. For example: if a wave moves along the x-axis, its disturbances are in the yz-plane. In other words, it causes medium disturbances across the two-dimensional plane that it is travelling in. Contrary to popular belief, transversal waves do not necessarily move up and down.</rdfs:comment>
        <rdfs:label xml:lang="en">transverse wave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenWave/TravelingWave -->

    <owl:Class rdf:about="http://sweetontology.net/phenWave/TravelingWave">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/Wave"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophw:TravelingWave</metadata:prefixIRI>
        <rdfs:label xml:lang="en">traveling wave</rdfs:label>
    </owl:Class>
    


