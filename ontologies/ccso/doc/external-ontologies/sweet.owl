        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealc:Isthmus</metadata:prefixIRI>
        <rdfs:label xml:lang="en">isthmus</rdfs:label>
    </owl:Class>
    


