    <!-- http://sweetontology.net/matrBiomass/IndicatorSpecies -->

    <owl:Class rdf:about="http://sweetontology.net/matrBiomass/IndicatorSpecies">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrBiomass/Species"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somab:IndicatorSpecies</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">An indicator species is any biological species that defines a trait or characteristic of the environment. For example, a species may delineate an ecoregion or indicate an environmental condition such as a disease outbreak, pollution, species competition or climate change. Indicator species can be among the most sensitive species in a region, acting as an early warning to monitoring biologists.</rdfs:comment>
        <rdfs:label xml:lang="en">indicator species</rdfs:label>
    </owl:Class>
    


