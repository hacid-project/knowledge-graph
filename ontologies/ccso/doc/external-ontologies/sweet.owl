            <rdf:Description>
                <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2020-04-09T10:24:28-08:00</terms:created>
                <terms:creator rdf:resource="https://orcid.org/0000-0003-4091-6059"/>
                <terms:source rdf:resource="https://orcid.org/0000-0003-4808-4736"/>
                <rdfs:comment xml:lang="en">A frost action process which occurs in cold environments which are not part of a glacier.</rdfs:comment>
                <rdfs:comment xml:lang="en">The conditions, processes and landforms associated with cold, nonglacial environments.</rdfs:comment>
            </rdf:Description>
        </skos:definition>
        <skos:note xml:lang="en">Subclass relation changed from Glacial Process to Physical Process because Periglacial involves frost action not associated with glacial processes</skos:note>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenCryo/Periglaciation -->

    <owl:Class rdf:about="http://sweetontology.net/phenCryo/Periglaciation">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procPhysical/PhysicalProcess"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophcr:Periglaciation</metadata:prefixIRI>
        <rdfs:label xml:lang="en">obsolete periglaciation</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://github.com/ESIPFed/sweet/issues/185"/>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001659"/>
        <skos:definition>
            <rdf:Description>
                <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2020-04-09T10:28:56-08:00</terms:created>
                <terms:creator rdf:resource="https://orcid.org/0000-0003-4091-6059"/>
                <terms:source rdf:resource="https://orcid.org/0000-0003-4808-4736"/>
                <rdfs:comment xml:lang="en">Processes associated with cold, nonglacial environments</rdfs:comment>
            </rdf:Description>
        </skos:definition>
        <skos:note xml:lang="en">This is not a term found in any community thesaurus or dictionary i.e. GCMD, etc, or community of practice. Should be depricated in a future version of sweet. We consider it to be synonymous with glaciation in the ENVO crossreference</skos:note>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenCryo/PhysicalProcess -->

    <owl:Class rdf:about="http://sweetontology.net/phenCryo/PhysicalProcess">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophcr:PhysicalProcess</metadata:prefixIRI>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenCryo/Proglacial -->

    <owl:Class rdf:about="http://sweetontology.net/phenCryo/Proglacial">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenCryo/GlacialProcess"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophcr:Proglacial</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Of streams, deposits, and other features, being immediately in front of or just beyond the outer limits of a glacier or ice sheet, and formed by or derived from glacier ice.</rdfs:comment>
        <rdfs:label xml:lang="en">proglacial</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenCryo/Subglacial -->

    <owl:Class rdf:about="http://sweetontology.net/phenCryo/Subglacial">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenCryo/GlacialProcess"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophcr:Subglacial</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Pertaining to the area in or at the bottom of, or immediately beneath, a glacier.</rdfs:comment>
        <rdfs:label xml:lang="en">subglacial</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenCryo/Supraglacial -->

    <owl:Class rdf:about="http://sweetontology.net/phenCryo/Supraglacial">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenCryo/GlacialProcess"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophcr:Supraglacial</metadata:prefixIRI>
        <rdfs:label xml:lang="en">supraglacial</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenCycle/AnnualCycle -->

    <owl:Class rdf:about="http://sweetontology.net/phenCycle/AnnualCycle">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenCycle/GlobalCycle"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaTime/hasFrequency"/>
