                <owl:someValuesFrom rdf:resource="http://sweetontology.net/propSpaceDistance/Distance"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsdis:DistanceRange</metadata:prefixIRI>
        <rdfs:label xml:lang="en">distance range</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceDistance/DistanceRange_km -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceDistance/DistanceRange_km">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceDistance/DistanceRange"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/kilometer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsdis:DistanceRange_km</metadata:prefixIRI>
        <rdfs:label xml:lang="en">distance range km</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceDistance/ExtinctionCoefficient -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceDistance/ExtinctionCoefficient">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceDistance/SpatialFrequency"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsdis:ExtinctionCoefficient</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The extinction coefficient for a particular substance is a measure of how well it scatters and absorbs electromagnetic radiation (EM waves). If the EM wave can pass through very easily, the material has a low extinction coefficient. Conversely, if the radiation hardly penetrates the material, but rather quickly becomes extinct within it, the extinction coefficient is high.</rdfs:comment>
        <rdfs:label xml:lang="en">extinction coefficient</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceDistance/Fetch -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceDistance/Fetch">
