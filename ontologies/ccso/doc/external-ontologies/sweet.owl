        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somains:Piezometer</metadata:prefixIRI>
        <rdfs:comment xml:lang="en"> A devise used to measure groundwater pressure head at a point in the subsurface.</rdfs:comment>
        <rdfs:label xml:lang="en">piezometer</rdfs:label>
    </owl:Class>
    


