        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procChemical/Reaction"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprocc:Transmutation</metadata:prefixIRI>
