    </owl:Class>
    


    <!-- http://sweetontology.net/matr/GreenhouseGas -->

    <owl:Class rdf:about="http://sweetontology.net/matr/GreenhouseGas">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/Chemical"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/ChemicalSubstance"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasState"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/Gas"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soma:GreenhouseGas</metadata:prefixIRI>
        <rdfs:label xml:lang="en">greenhouse gas</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matr/Inorganic -->

    <owl:Class rdf:about="http://sweetontology.net/matr/Inorganic">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/matr/InorganicSubstance"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/Chemical"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/ChemicalSubstance"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soma:Inorganic</metadata:prefixIRI>
        <rdfs:label xml:lang="en">inorganic</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matr/InorganicSubstance -->

    <owl:Class rdf:about="http://sweetontology.net/matr/InorganicSubstance">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/Chemical"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/ChemicalSubstance"/>
        <owl:disjointWith rdf:resource="http://sweetontology.net/matrOrganicCompound/OrganicSubstance"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soma:InorganicSubstance</metadata:prefixIRI>
        <rdfs:label xml:lang="en">inorganic substance</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matr/Medium -->

    <owl:Class rdf:about="http://sweetontology.net/matr/Medium">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/Substance"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soma:Medium</metadata:prefixIRI>
        <rdfs:label xml:lang="en">medium</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matr/MixedChemicalSubstance -->

    <owl:Class rdf:about="http://sweetontology.net/matr/MixedChemicalSubstance">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/matr/Mixture"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/Chemical"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/ChemicalSubstance"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soma:MixedChemicalSubstance</metadata:prefixIRI>
        <rdfs:label xml:lang="en">mixed chemical substance</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matr/Mixture -->

    <owl:Class rdf:about="http://sweetontology.net/matr/Mixture">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/Chemical"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/ChemicalSubstance"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soma:Mixture</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">In chemistry, a mixture is when two or more different substances are mixed together but not combined chemically. The molecules of two or more different substances are mixed in the form of solutions, suspensions, and colloids. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">mixture</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matr/NeutralGas -->

    <owl:Class rdf:about="http://sweetontology.net/matr/NeutralGas">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/Chemical"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/ChemicalSubstance"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasState"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/Gas"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasState"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/Neutral"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soma:NeutralGas</metadata:prefixIRI>
        <rdfs:label xml:lang="en">neutral gas</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matr/OrganicLoading -->

    <owl:Class rdf:about="http://sweetontology.net/matr/OrganicLoading">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/DissolvedSubstance"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soma:OrganicLoading</metadata:prefixIRI>
        <rdfs:label xml:lang="en">organic loading</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matr/SolidSubstance -->

    <owl:Class rdf:about="http://sweetontology.net/matr/SolidSubstance">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/Substance"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasState"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/Solid"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soma:SolidSubstance</metadata:prefixIRI>
        <rdfs:label xml:lang="en">solid substance</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matr/Solution -->

    <owl:Class rdf:about="http://sweetontology.net/matr/Solution">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/MixedChemicalSubstance"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/Mixture"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soma:Solution</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">In chemistry, a solution is a homogeneous mixture composed of two or more substances. In such a mixture, a solute is dissolved in another substance, known as a solvent. All solutions are characterized by interactions between the solvent phase and solute molecules or ions that result in a net decrease in free energy. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">solution</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matr/Substance -->

    <owl:Class rdf:about="http://sweetontology.net/matr/Substance">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soma:Substance</metadata:prefixIRI>
        <rdfs:label xml:lang="en">substance</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matr/SuspendedGas -->

    <owl:Class rdf:about="http://sweetontology.net/matr/SuspendedGas">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/SuspendedSubstance"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasState"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/Gas"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soma:SuspendedGas</metadata:prefixIRI>
        <rdfs:label xml:lang="en">suspended gas</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matr/SuspendedSolid -->

    <owl:Class rdf:about="http://sweetontology.net/matr/SuspendedSolid">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/SolidSubstance"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/SuspendedSubstance"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soma:SuspendedSolid</metadata:prefixIRI>
        <rdfs:label xml:lang="en">suspended solid</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matr/SuspendedSubstance -->

    <owl:Class rdf:about="http://sweetontology.net/matr/SuspendedSubstance">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/Substance"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasState"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/Suspended"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soma:SuspendedSubstance</metadata:prefixIRI>
        <rdfs:label xml:lang="en">suspended substance</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matr/TraceGas -->

    <owl:Class rdf:about="http://sweetontology.net/matr/TraceGas">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/TraceSubstance"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasState"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/Gas"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soma:TraceGas</metadata:prefixIRI>
        <rdfs:label xml:lang="en">trace gas</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matr/TraceSubstance -->

    <owl:Class rdf:about="http://sweetontology.net/matr/TraceSubstance">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/Substance"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRole"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/stateRole/Trace"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soma:TraceSubstance</metadata:prefixIRI>
        <rdfs:label xml:lang="en">trace substance</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrAerosol/Aerosol -->

    <owl:Class rdf:about="http://sweetontology.net/matrAerosol/Aerosol">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/SuspendedSubstance"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somaae:Aerosol</metadata:prefixIRI>
        <rdfs:label xml:lang="en">aerosol</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrAerosol/Ash -->

    <owl:Class rdf:about="http://sweetontology.net/matrAerosol/Ash">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/SolidSubstance"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somaae:Ash</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Fine particles of pulverized rock.</rdfs:comment>
        <rdfs:label xml:lang="en">ash</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrAerosol/BlackCarbon -->

    <owl:Class rdf:about="http://sweetontology.net/matrAerosol/BlackCarbon">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/matrAerosol/Soot"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrAerosol/Particulate"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somaae:BlackCarbon</metadata:prefixIRI>
        <rdfs:label xml:lang="en">black carbon</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrAerosol/CCN -->

    <owl:Class rdf:about="http://sweetontology.net/matrAerosol/CCN">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/matrAerosol/CloudCondensationNuclei"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrAerosol/CondensationNuclei"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somaae:CCN</metadata:prefixIRI>
        <rdfs:label xml:lang="en">ccn</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrAerosol/CloudCondensationNuclei -->

    <owl:Class rdf:about="http://sweetontology.net/matrAerosol/CloudCondensationNuclei">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrAerosol/CondensationNuclei"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somaae:CloudCondensationNuclei</metadata:prefixIRI>
        <rdfs:label xml:lang="en">cloud condensation nuclei</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrAerosol/CondensationNuclei -->

    <owl:Class rdf:about="http://sweetontology.net/matrAerosol/CondensationNuclei">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/SolidSubstance"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRole"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenSolid/Coalescence"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somaae:CondensationNuclei</metadata:prefixIRI>
        <rdfs:label xml:lang="en">condensation nuclei</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrAerosol/ContinentalAerosol -->

    <owl:Class rdf:about="http://sweetontology.net/matrAerosol/ContinentalAerosol">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrAerosol/Aerosol"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRealm"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmLandform/Land"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somaae:ContinentalAerosol</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Aerosol having its origin over the continents with industrial, urban, agricultural, forest, and desert sources, with potential for high concentrations of hygroscopic aerosol.</rdfs:comment>
        <rdfs:label xml:lang="en">continental aerosol</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrAerosol/Dust -->

    <owl:Class rdf:about="http://sweetontology.net/matrAerosol/Dust">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/SolidSubstance"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somaae:Dust</metadata:prefixIRI>
        <rdfs:label xml:lang="en">dust</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrAerosol/FugitiveDust -->

    <owl:Class rdf:about="http://sweetontology.net/matrAerosol/FugitiveDust">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrAerosol/Dust"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somaae:FugitiveDust</metadata:prefixIRI>
        <rdfs:label xml:lang="en">fugitive dust</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrAerosol/Grain -->

    <owl:Class rdf:about="http://sweetontology.net/matrAerosol/Grain">
