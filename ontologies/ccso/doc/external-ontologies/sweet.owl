    </owl:Class>
    


    <!-- http://sweetontology.net/phenEnvirImpact/Upconing -->

    <owl:Class rdf:about="http://sweetontology.net/phenEnvirImpact/Upconing">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenEnvirImpact/SaltWaterIntrusion"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophei:Upconing</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Process by which saline water underlying freshwater in an aquifer rises upward into the freshwater zone as a result of pumping water from the freshwater zone.</rdfs:comment>
        <rdfs:label xml:lang="en">upconing</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenEnvirImpact/WaterPollution -->

    <owl:Class rdf:about="http://sweetontology.net/phenEnvirImpact/WaterPollution">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenEnvirImpact/Pollution"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasImpactOn"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/realm/Hydrosphere"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophei:WaterPollution</metadata:prefixIRI>
        <rdfs:label xml:lang="en">water pollution</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenEnvirImpact/WaterQuality -->

    <owl:Class rdf:about="http://sweetontology.net/phenEnvirImpact/WaterQuality">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenEnvirImpact/WaterPollution"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophei:WaterQuality</metadata:prefixIRI>
        <rdfs:label xml:lang="en">water quality</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidDynamics/Anticyclone -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidDynamics/Anticyclone">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidDynamics/Cell"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasState"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/phenFluidDynamics/HighPressure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfd:Anticyclone</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">An atmospheric anticyclonic circulation, a closed circulation. The wind in an anticyclone is in the clockwise direction in the Northern Hemisphere and counterclockwise in the Southern Hemisphere.</rdfs:comment>
        <rdfs:label xml:lang="en">anticyclone</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidDynamics/BoundaryLayer -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidDynamics/BoundaryLayer">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprSpaceGeometry/Region"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfd:BoundaryLayer</metadata:prefixIRI>
        <rdfs:label xml:lang="en">boundary layer</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidDynamics/Capillary -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidDynamics/Capillary">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/phenFluidDynamics/CapillaryAction"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidDynamics/FluidPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfd:Capillary</metadata:prefixIRI>
        <rdfs:label xml:lang="en">capillary</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidDynamics/CapillaryAction -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidDynamics/CapillaryAction">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidDynamics/FluidPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfd:CapillaryAction</metadata:prefixIRI>
        <rdfs:label xml:lang="en">capillary action</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidDynamics/Cell -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidDynamics/Cell">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phen/Phenomena"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasProcess"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/procPhysical/Rotation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfd:Cell</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">In radar usage, a local maximum in radar reflectivity that undergoes a life cycle of growth and decay. The rising portion of the reflectivity maximum is indicative of updraft, and the later descending portion is indicative of a precipitation downdraft. Cells in ordinary convective storms last from 20 to 30 min, but often form longer-lasting multicell convective storms. Cells in supercell storms are more steady and last considerably longer. See also thunderstorm cell.</rdfs:comment>
        <rdfs:label xml:lang="en">cell</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidDynamics/CellCluster -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidDynamics/CellCluster">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprSpaceGeometry/Cluster"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprSpaceGeometry/Family"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprSpaceGeometry/Swarm"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/clusterOf"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenFluidDynamics/Cell"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfd:CellCluster</metadata:prefixIRI>
        <rdfs:label xml:lang="en">cell cluster</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidDynamics/Circulation -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidDynamics/Circulation">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidDynamics/Flow"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfd:Circulation</metadata:prefixIRI>
        <rdfs:label xml:lang="en">circulation</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidDynamics/Cyclone -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidDynamics/Cyclone">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidDynamics/LowPressure"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfd:Cyclone</metadata:prefixIRI>
        <rdfs:label xml:lang="en">cyclone</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidDynamics/Depression -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidDynamics/Depression">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidDynamics/LowPressure"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprSpaceGeometry/Depression"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfd:Depression</metadata:prefixIRI>
        <rdfs:label xml:lang="en">depression</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidDynamics/Eddy -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidDynamics/Eddy">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidDynamics/FluidPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfd:Eddy</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">In fluid dynamics, an eddy is the swirling of a fluid and the reverse current created when the fluid flows past an obstacle. The moving fluid creates a space devoid of downstream-flowing water on the downstream side of the object. Fluid behind the obstacle flows into the void creating a swirl of fluid on each edge of the obstacle, followed by a short reverse flow of fluid behind the obstacle flowing upstream, toward the back of the obstacle. This phenomenon is most visible behind large emergent rocks in swift-flowing rivers.</rdfs:comment>
        <rdfs:label xml:lang="en">eddy</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidDynamics/Flow -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidDynamics/Flow">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidDynamics/FluidPhenomena"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procPhysical/Motion"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfd:Flow</metadata:prefixIRI>
        <rdfs:label xml:lang="en">flow</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidDynamics/FluidPhenomena -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidDynamics/FluidPhenomena">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phen/Phenomena"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasState"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/Fluid"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfd:FluidPhenomena</metadata:prefixIRI>
        <rdfs:label xml:lang="en">fluid phenomena</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidDynamics/Gyre -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidDynamics/Gyre">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidDynamics/Cell"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfd:Gyre</metadata:prefixIRI>
        <rdfs:label xml:lang="en">gyre</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidDynamics/HighPressure -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidDynamics/HighPressure">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/phenFluidDynamics/Ridge"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propPressure/Pressure"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprSpaceGeometry/Ridge"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfd:HighPressure</metadata:prefixIRI>
        <rdfs:label xml:lang="en">high pressure</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidDynamics/Jet -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidDynamics/Jet">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidDynamics/Flow"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasQuantity"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propPressure/Pressure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfd:Jet</metadata:prefixIRI>
        <rdfs:label xml:lang="en">jet</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidDynamics/LaminarBoundaryLayer -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidDynamics/LaminarBoundaryLayer">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidDynamics/BoundaryLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenFluidDynamics/LaminarFlow"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfd:LaminarBoundaryLayer</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">An interfacial region in which flow is smooth and nonturbulent. Above a surface, a laminar layer will develop and fluid velocity will increase with distance from the surface, but not indefinitely. At some point, flow will become turbulent, with the laminar sublayer separating the turbulent layer from the surface. In the real world, most laminar boundary layers are extremely thin (order of 1 mm), but can be of biological importance, for example, next to plant leaves or as invertebrate refuges in streams.</rdfs:comment>
        <rdfs:label xml:lang="en">laminar boundary layer</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidDynamics/LaminarFlow -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidDynamics/LaminarFlow">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidDynamics/Flow"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfd:LaminarFlow</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">(Also called sheet flow, streamline flow.) A flow regime in which fluid motion is smooth and orderly, and in which adjacent layers or laminas slip past each other with little mixing between them. Exchange of material across laminar layers occurs by molecular diffusion, a process about 106 times less effective than turbulence. Laminar flow can be easily predicted as velocity increases at a steady rate from a boundary. This contrasts with the chaotic and random nature of turbulent flow. Laminar flow is not a common occurrence in the statically neutral and unstable atmosphere and is confined to a very thin layer (1 mm) adjacent to very smooth surfaces such as snow and ice. However, in strongly statically stable regions such as the the nocturnal boundary layer, the Richardson number can be large enough that turbulence is suppressed, and the flow is laminar over a layer many tens of meters thick.</rdfs:comment>
        <rdfs:label xml:lang="en">laminar flow</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidDynamics/LaminarSublayer -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidDynamics/LaminarSublayer">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidDynamics/LaminarBoundaryLayer"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfd:LaminarSublayer</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A layer in which the fluid undergoes smooth, nonturbulent flow. It is found between any surface and a turbulent layer above. See laminar boundary layer, laminar flow.</rdfs:comment>
        <rdfs:label xml:lang="en">laminar sublayer</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidDynamics/LowPressure -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidDynamics/LowPressure">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propPressure/Pressure"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfd:LowPressure</metadata:prefixIRI>
        <rdfs:label xml:lang="en">low pressure</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidDynamics/Overturning -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidDynamics/Overturning">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidDynamics/Circulation"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfd:Overturning</metadata:prefixIRI>
        <rdfs:label xml:lang="en">overturning</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidDynamics/PointVortex -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidDynamics/PointVortex">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidDynamics/Vortex"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfd:PointVortex</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A straight line vortex, the flow of which can be modeled in two dimensions, with a point concentration of vorticity surrounded by irrotational flow.</rdfs:comment>
        <rdfs:label xml:lang="en">point vortex</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidDynamics/Recirculation -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidDynamics/Recirculation">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidDynamics/Circulation"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfd:Recirculation</metadata:prefixIRI>
        <rdfs:label xml:lang="en">recirculation</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidDynamics/Ridge -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidDynamics/Ridge">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propPressure/Pressure"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprSpaceGeometry/Ridge"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasState"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/phenFluidDynamics/HighPressure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfd:Ridge</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">In meteorology, an elongated area of relatively low atmospheric pressure; the opposite of a ridge.</rdfs:comment>
        <rdfs:label xml:lang="en">ridge</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidDynamics/StationaryEddy -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidDynamics/StationaryEddy">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidDynamics/Eddy"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfd:StationaryEddy</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">In studies of the general circulation, the eddies are the departures of a field from the zonal mean of that field; the stationary eddies are the time-averaged, or time-invariant, component of the eddy field.</rdfs:comment>
        <rdfs:label xml:lang="en">stationary eddy</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidDynamics/Trough -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidDynamics/Trough">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprSpaceGeometry/Trough"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasState"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/phenFluidDynamics/LowPressure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfd:Trough</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">In meteorology, an elongated area of relatively low atmospheric pressure; the opposite of a ridge.</rdfs:comment>
        <rdfs:label xml:lang="en">trough</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidDynamics/ViscousFlow -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidDynamics/ViscousFlow">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidDynamics/Flow"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfd:ViscousFlow</metadata:prefixIRI>
        <rdfs:label xml:lang="en">viscous flow</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidDynamics/Vortex -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidDynamics/Vortex">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidDynamics/Flow"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasProcess"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/procPhysical/Rotation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfd:Vortex</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">More often the term refers to a flow with closed streamlines or to the idealized case in which all vorticity is concentrated in a vortex filament.</rdfs:comment>
        <rdfs:label xml:lang="en">vortex</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidInstability/AbsoluteInstability -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidInstability/AbsoluteInstability">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidInstability/FluidInstability"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasState"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/stateThermodynamic/Superadiabatic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfi:AbsoluteInstability</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">state of a layer of atmosphere when it has superadiabatic lapse rate of temperature</rdfs:comment>
        <rdfs:label xml:lang="en">absolute instability</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidInstability/ConditionalInstability -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidInstability/ConditionalInstability">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidInstability/FluidInstability"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfi:ConditionalInstability</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The state of a layer of unsaturated air when its lapse rate of temperature is less than the dry-adiabatic lapse rate but greater than the moist-adiabatic lapse rate.</rdfs:comment>
        <rdfs:label xml:lang="en">conditional instability</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidInstability/ConvectiveInstability -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidInstability/ConvectiveInstability">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidInstability/FluidInstability"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfi:ConvectiveInstability</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">An instability due to the buoyancy force of heavy fluid over light fluid overcoming the stabilizing influence of viscous forces.</rdfs:comment>
        <rdfs:label xml:lang="en">convective instability</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidInstability/FluidInstability -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidInstability/FluidInstability">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidDynamics/FluidPhenomena"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/stateSystem/Instability"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/stateSystem/Unstable"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfi:FluidInstability</metadata:prefixIRI>
        <rdfs:label xml:lang="en">fluid instability</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidInstability/FreeInstability -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidInstability/FreeInstability">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidInstability/FluidInstability"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfi:FreeInstability</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The state of a layer of unsaturated air when its lapse rate of temperature is less than the dry-adiabatic lapse rate but greater than the moist-adiabatic lapse rate.</rdfs:comment>
        <rdfs:label xml:lang="en">free instability</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidInstability/FrontalInversion -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidInstability/FrontalInversion">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidInstability/Inversion"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenAtmoFront/Front"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfi:FrontalInversion</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A temperature inversion (temperature rising with height) in the atmosphere, encountered upon vertical ascent through a sloping front (or frontal zone).</rdfs:comment>
        <rdfs:label xml:lang="en">frontal inversion</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidInstability/Inversion -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidInstability/Inversion">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidDynamics/FluidPhenomena"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasQuantity"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propTemperatureGradient/TemperatureGradient"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfi:Inversion</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">In meteorology, a departure from the usual decrease or increase with altitude of the value of an atmospheric quantity; also, the layer through which this departure occurs (the inversion layer), or the lowest altitude at which the departure is found (the base of the inversion).</rdfs:comment>
        <rdfs:label xml:lang="en">inversion</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidInstability/KelvinHelmholtzInstability -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidInstability/KelvinHelmholtzInstability">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidInstability/FluidInstability"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfi:KelvinHelmholtzInstability</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">An instability of the basic flow of an incompressible inviscid fluid in two parallel infinite streams of different velocities and densities.</rdfs:comment>
        <rdfs:label xml:lang="en">kelvin helmholtz instability</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidInstability/LargeReynoldsNumberFlow -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidInstability/LargeReynoldsNumberFlow">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidDynamics/Flow"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfi:LargeReynoldsNumberFlow</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The behavior of a fluid with a Reynolds number typically greater than 1E4 to 1E6, which usually occurs within the atmosphere. The main property of such flows is a constant friction stress within the surface layer that depends only on relative roughness but not on the Reynolds number itself. Thus, molecular viscosity and qualities occurring in flow descriptions that are dependent on the Reynolds number may be totally ignored.</rdfs:comment>
        <rdfs:label xml:lang="en">large reynolds number flow</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidInstability/Lift -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidInstability/Lift">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/phenFluidInstability/Lifting"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidDynamics/FluidPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfi:Lift</metadata:prefixIRI>
        <rdfs:label xml:lang="en">lift</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidInstability/Lifting -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidInstability/Lifting">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidDynamics/FluidPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfi:Lifting</metadata:prefixIRI>
        <rdfs:label xml:lang="en">lifting</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidInstability/MechanicalTurbulence -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidInstability/MechanicalTurbulence">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidInstability/Turbulence"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfi:MechanicalTurbulence</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Turbulence produced by shear flow.</rdfs:comment>
        <rdfs:label xml:lang="en">mechanical turbulence</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidInstability/RayleighTaylorInstability -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidInstability/RayleighTaylorInstability">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidInstability/FluidInstability"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfi:RayleighTaylorInstability</metadata:prefixIRI>
        <rdfs:label xml:lang="en">rayleigh taylor instability</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidInstability/StaticStability -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidInstability/StaticStability">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidInstability/FluidInstability"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfi:StaticStability</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The ability of a fluid at rest to become turbulent or laminar due to the effects of buoyancy.</rdfs:comment>
        <rdfs:label xml:lang="en">static stability</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidInstability/TearingMode -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidInstability/TearingMode">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/stateSystem/Instability"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/stateSystem/Unstable"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasState"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/Plasma"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfi:TearingMode</metadata:prefixIRI>
        <rdfs:label xml:lang="en">tearing mode</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidInstability/Turbulence -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidInstability/Turbulence">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidDynamics/FluidPhenomena"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenSystemComplexity/Fluctuation"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfi:Turbulence</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Irregular fluctuations occurring in fluid motions.</rdfs:comment>
        <rdfs:label xml:lang="en">turbulence</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidInstability/Wake -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidInstability/Wake">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidInstability/Turbulence"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfi:Wake</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The region of turbulence immediately to the rear of a solid body in motion relative to a fluid</rdfs:comment>
        <rdfs:label xml:lang="en">wake</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidInstability/ZombieTurbulence -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidInstability/ZombieTurbulence">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidInstability/Turbulence"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenSystem/Perturbation"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophfi:ZombieTurbulence</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The turbulent perturbations of temperature remaining in a stable boundary layer after all turbulent motions have died out.</rdfs:comment>
        <rdfs:label xml:lang="en">zombie turbulence</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidTransport/Advection -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidTransport/Advection">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phen/Phenomena"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenFluidTransport/Transport"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasState"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/Fluid"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophft:Advection</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The process of transport solely by the mass motion (velocity field); also, the rate of change of the value of the advected property at a given point.</rdfs:comment>
        <rdfs:label xml:lang="en">advection</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidTransport/BolusAdvection -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidTransport/BolusAdvection">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidTransport/Advection"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophft:BolusAdvection</metadata:prefixIRI>
        <rdfs:label xml:lang="en">bolus advection</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidTransport/Buoyancy -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidTransport/Buoyancy">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phen/Phenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophft:Buoyancy</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">That property of an object that enables it to float on the surface of a liquid, or ascend through and remain freely suspended in a compressible fluid such as the atmosphere.</rdfs:comment>
        <rdfs:label xml:lang="en">buoyancy</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidTransport/Coning -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidTransport/Coning">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidTransport/Plume"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophft:Coning</metadata:prefixIRI>
        <rdfs:label xml:lang="en">coning</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidTransport/Convection -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidTransport/Convection">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phen/Phenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophft:Convection</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">In general, mass motions within a fluid resulting in transport and mixing of the properties of that fluid.  Convection, along with conduction and radiation, is a principal means of energy transfer.</rdfs:comment>
        <rdfs:label xml:lang="en">convection</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidTransport/ConvectivePlume -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidTransport/ConvectivePlume">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidTransport/Plume"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenFluidTransport/Convection"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophft:ConvectivePlume</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A buoyant jet stream in which the buoyancy is supplied steadily from a point source; the buoyant region is continuous.</rdfs:comment>
        <rdfs:label xml:lang="en">convective plume</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidTransport/CounterGradientFlux -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidTransport/CounterGradientFlux">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/Flux"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophft:CounterGradientFlux</metadata:prefixIRI>
        <rdfs:label xml:lang="en">counter gradient flux</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidTransport/Deposition -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidTransport/Deposition">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phen/Phenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophft:Deposition</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Phenomena by which traces gases or particles are transferred from atmosphere to a surface.</rdfs:comment>
        <rdfs:label xml:lang="en">deposition</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidTransport/Fanning -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidTransport/Fanning">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidTransport/Plume"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophft:Fanning</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A pattern of smokestack plume dispersion in a statically stable atmosphere, in which the plume spreads out in the horizontal like an oriental fan and meanders about at a fixed height with little vertical spread.</rdfs:comment>
        <rdfs:label xml:lang="en">fanning</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidTransport/HTAP -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidTransport/HTAP">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/phenFluidTransport/HemisphericTransportOfAirPollutants"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidTransport/Transport"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophft:HTAP</metadata:prefixIRI>
        <rdfs:label xml:lang="en">htap</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidTransport/HemisphericTransportOfAirPollutants -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidTransport/HemisphericTransportOfAirPollutants">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidTransport/Transport"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/phenEnvirImpact/AirPollution"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophft:HemisphericTransportOfAirPollutants</metadata:prefixIRI>
        <rdfs:label xml:lang="en">hemispheric transport of air pollutants</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidTransport/Lofting -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidTransport/Lofting">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidTransport/Convection"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophft:Lofting</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The phenomenon where the upper part of a smoke plume diffuses more rapidly upward than the bottom part diffuses downward. This generally occurs when the boundary layer near the ground is more stable than it is aloft. Compare coning, fanning, looping.</rdfs:comment>
        <rdfs:label xml:lang="en">lofting</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidTransport/LongRangeTransport -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidTransport/LongRangeTransport">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidTransport/Transport"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophft:LongRangeTransport</metadata:prefixIRI>
        <rdfs:label xml:lang="en">long range transport</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidTransport/Plume -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidTransport/Plume">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/SuspendedSubstance"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasState"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/Fluid"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophft:Plume</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Buoyant jet in which the buoyancy is supplied from a point source; the buoyant region is continuous. 2. A mostly horizontal (sometimes initially vertical) stream of pollutant that is being blown downwind from a smokestack.</rdfs:comment>
        <rdfs:label xml:lang="en">plume</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidTransport/Puff -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidTransport/Puff">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidTransport/Plume"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophft:Puff</metadata:prefixIRI>
        <rdfs:label xml:lang="en">puff</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidTransport/SlantWiseConvection -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidTransport/SlantWiseConvection">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidTransport/Convection"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophft:SlantWiseConvection</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A form of convection driven by a combination of gravitational and centrifugal forces.</rdfs:comment>
        <rdfs:label xml:lang="en">slant wise convection</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidTransport/StackEffect -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidTransport/StackEffect">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidTransport/Convection"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophft:StackEffect</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">An effect due to heat sources within a local exhaust enclosure (stack) producing convective air currents with vertical velocities proportional to the rate of heat transferred to the surrounding air and to the height of rise of the heated air.</rdfs:comment>
        <rdfs:label xml:lang="en">stack effect</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidTransport/Surge -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidTransport/Surge">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/Flux"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophft:Surge</metadata:prefixIRI>
        <rdfs:label xml:lang="en">surge</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidTransport/Transport -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidTransport/Transport">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phen/Phenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophft:Transport</metadata:prefixIRI>
        <rdfs:label xml:lang="en">transport</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidTransport/Uptake -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidTransport/Uptake">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidTransport/Transport"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophft:Uptake</metadata:prefixIRI>
        <rdfs:label xml:lang="en">uptake</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidTransport/VorticityAdvection -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidTransport/VorticityAdvection">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidTransport/Advection"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophft:VorticityAdvection</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Advection of vorticity by the total wind or force.</rdfs:comment>
        <rdfs:label xml:lang="en">vorticity advection</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenFluidTransport/WestEastTransport -->

    <owl:Class rdf:about="http://sweetontology.net/phenFluidTransport/WestEastTransport">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidTransport/Transport"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophft:WestEastTransport</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The eastward flux of mass, momentum, heat, moisture or any other property of a fluid by mean motion or by correlation with the eastward component of motion, that is, eddy flux.</rdfs:comment>
        <rdfs:label xml:lang="en">west east transport</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeol/CompositeProcess -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeol/CompositeProcess">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprSciProvenance/Genesis"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophg:CompositeProcess</metadata:prefixIRI>
        <rdfs:label xml:lang="en">composite process</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeol/Differentiation -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeol/Differentiation">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeol/GeologicalPhenomena"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeol/GeospherePhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophg:Differentiation</metadata:prefixIRI>
        <rdfs:label xml:lang="en">differentiation</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeol/Fluvial -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeol/Fluvial">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeol/GeologicalPhenomena"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeol/GeospherePhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophg:Fluvial</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Fluvial is used in geography and earth science to refer to the processes associated with rivers and streams and the deposits and landforms created by them [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">fluvial</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeol/GeologicalPhenomena -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeol/GeologicalPhenomena">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/phenGeol/GeospherePhenomena"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phen/PlanetaryPhenomena"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRealm"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmGeol/SolidEarth"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophg:GeologicalPhenomena</metadata:prefixIRI>
        <rdfs:label xml:lang="en">geological phenomena</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeol/GeospherePhenomena -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeol/GeospherePhenomena">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phen/PlanetaryPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophg:GeospherePhenomena</metadata:prefixIRI>
        <rdfs:label xml:lang="en">geosphere phenomena</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeol/Igneous -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeol/Igneous">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeol/RockCycle"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeol/RockCycleProcess"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophg:Igneous</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">One of 3 processes in the Rock Cycle. Igneous refers to the process whereby hot material from the mantle is squeezed upward toward the earth&apos;s surface. If it has not reached the surface then the material is described as an intrusive structure and the rocks it creates are called Intrusive Rock. If it extrudes from the surface the material is described as a volcano and the rock it creates is known as Extrusive Rock. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">igneous</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeol/IntraplateProcess -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeol/IntraplateProcess">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolTectonic/TectonicPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophg:IntraplateProcess</metadata:prefixIRI>
        <rdfs:label xml:lang="en">intraplate process</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeol/Metamorphic -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeol/Metamorphic">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeol/RockCycle"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeol/RockCycleProcess"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophg:Metamorphic</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">One of 3 processes in the Rock Cycle. When sedimentary (and/or) igneous layers are folded, bent or twisted by heat and pressure due to motions of tectonic plates or intrusions by magma, the rocky material is transformed into other rock called metamorphic rock. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">metamorphic</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeol/Orogenesis -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeol/Orogenesis">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeol/GeologicalPhenomena"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeol/GeospherePhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophg:Orogenesis</metadata:prefixIRI>
        <rdfs:label xml:lang="en">orogenesis</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeol/OrogenicCollapse -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeol/OrogenicCollapse">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolTectonic/TectonicPhenomena"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRealm"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmGeolOrogen/Orogen"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaChemical/hasSubstance"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/matrRockIgneous/AnorogenicIgneousRock"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/hasPlanetaryStructure"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmGeolBasin/SuccessorBasin"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophg:OrogenicCollapse</metadata:prefixIRI>
        <rdfs:comment xml:lang="en"> The process in which mountains begin to collapse under their own weight and spread out laterally.</rdfs:comment>
        <rdfs:label xml:lang="en">orogenic collapse</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeol/Orogeny -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeol/Orogeny">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolTectonic/TectonicPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophg:Orogeny</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Orogeny refers to natural mountain building, and may be studied as (a) a tectonic structural event, (b) as a geographical event, and (c) a chronological event. Orogenic events (a) cause distinctive structural phenomena and related tectonic activity, (b) affect certain regions of rocks and crust, and (c) happen within a specific period of time. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">orogeny</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeol/Paleomagnetism -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeol/Paleomagnetism">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeol/GeologicalPhenomena"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeol/GeospherePhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophg:Paleomagnetism</metadata:prefixIRI>
        <rdfs:label xml:lang="en">paleomagnetism</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeol/Pedogenesis -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeol/Pedogenesis">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprSciProvenance/Genesis"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophg:Pedogenesis</metadata:prefixIRI>
        <rdfs:label xml:lang="en">pedogenesis</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeol/RockCycle -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeol/RockCycle">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/phenGeol/RockCycleProcess"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeol/GeologicalPhenomena"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeol/GeospherePhenomena"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprMathGraph/Circuit"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprMathGraph/Cycle"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophg:RockCycle</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The rock cycle is a fundamental concept that describes the dynamic transitions through geologic time among the three main rock types: sedimentary, metamorphic, and igneous. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">rock cycle</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeol/RockCycleProcess -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeol/RockCycleProcess">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeol/GeologicalPhenomena"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeol/GeospherePhenomena"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprMathGraph/Circuit"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprMathGraph/Cycle"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophg:RockCycleProcess</metadata:prefixIRI>
        <rdfs:label xml:lang="en">rock cycle process</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeol/Sedimentary -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeol/Sedimentary">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeol/RockCycle"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeol/RockCycleProcess"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophg:Sedimentary</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">One of 3 processes in the Rock Cycle. When wind or water deposit fine grained material on the surface, it creates sheets. Over thousands of years, the composition can change subtly or distinctly and the result is differing compositions of layered deposits. As the overlying layers compact the soil underneath the soil is converted to rock by the process of lithification. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">sedimentary</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeol/StratigraphicSequence -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeol/StratigraphicSequence">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprSciProvenance/History"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophg:StratigraphicSequence</metadata:prefixIRI>
        <rdfs:label xml:lang="en">stratigraphic sequence</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeol/Unconformity -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeol/Unconformity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprSciProvenance/History"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophg:Unconformity</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A substantial break or gap in the geologic record where a rock unit is overlain by another that is not next in stratigraphic sucession, such as an interruption in continuity of a depositional sequence of sedimentary rocks or a break between eroded igneous rocks and younger sedimentary strata. It results from a change that caused deposition to cease for a considerable time, and it normally implies uplift and erosion with loss of the previous formed record.</rdfs:comment>
        <rdfs:label xml:lang="en">unconformity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeol/WilsonCycle -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeol/WilsonCycle">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeol/RockCycle"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeol/RockCycleProcess"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophg:WilsonCycle</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The Wilson cycle (a plate tectonics based rock cycle) was developed by J. Tuzo Wilson during the 1960s and 1970s. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">wilson cycle</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolFault/Detachment -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolFault/Detachment">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolFault/Normal"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgf:Detachment</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A regional-scale low-angle normal fault.</rdfs:comment>
        <rdfs:label xml:lang="en">detachment</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolFault/Dextral -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolFault/Dextral">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolTectonic/TectonicForce"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolTectonic/TectonicProcess"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgf:Dextral</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Right-lateral separation sense; in plan view, the side opposite the observer appears displaced to the right.</rdfs:comment>
        <rdfs:label xml:lang="en">dextral</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolFault/DipSeparationSense -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolFault/DipSeparationSense">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolFault/Slip"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgf:DipSeparationSense</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A fault along which there is some separation parallel to the dip of the fault.</rdfs:comment>
        <rdfs:label xml:lang="en">dip separation sense</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolFault/DipSlip -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolFault/DipSlip">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolFault/DipSeparationSense"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgf:DipSlip</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The net slip of the fault lies in the dip direction of the fault</rdfs:comment>
        <rdfs:label xml:lang="en">dip slip</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolFault/Extraction -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolFault/Extraction">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolFault/Slip"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgf:Extraction</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A fault whose two sides have approached each other substantially in the direction perpendicular to the fault.</rdfs:comment>
        <rdfs:label xml:lang="en">extraction</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolFault/GenericDecollement -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolFault/GenericDecollement">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolTectonic/TectonicForce"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolTectonic/TectonicProcess"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgf:GenericDecollement</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A large-displacement (kilometers or tens of kilometers) shallowly dipping to subhorizontal fault or shear zone.</rdfs:comment>
        <rdfs:label xml:lang="en">generic decollement</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolFault/Heave -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolFault/Heave">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenSystem/Displacement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/hasDirection"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenGeolFault/Horizontal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgf:Heave</metadata:prefixIRI>
        <rdfs:label xml:lang="en">heave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolFault/Horizontal -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolFault/Horizontal">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolFault/Slip"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgf:Horizontal</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The fault is horizontal</rdfs:comment>
        <rdfs:label xml:lang="en">horizontal</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolFault/MixedExtraction -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolFault/MixedExtraction">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolFault/Extraction"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgf:MixedExtraction</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">An extraction fault with some displacement within the fault plane.</rdfs:comment>
        <rdfs:label xml:lang="en">mixed extraction</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolFault/NoMovementSense -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolFault/NoMovementSense">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolTectonic/TectonicForce"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolTectonic/TectonicProcess"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgf:NoMovementSense</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The fault-parallel displacement is effectively zero, as in an extraction fault.</rdfs:comment>
        <rdfs:label xml:lang="en">no movement sense</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolFault/Normal -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolFault/Normal">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolTectonic/TectonicForce"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolTectonic/TectonicProcess"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgf:Normal</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The hanging wall appears to have moved down relative to the footwall; dip of fault usually 45-90 degrees.</rdfs:comment>
        <rdfs:label xml:lang="en">normal</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolFault/ObliqueSlip -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolFault/ObliqueSlip">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolFault/Slip"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/hasDirection"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSpaceDirection/Oblique"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgf:ObliqueSlip</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The net slip of the fault lies between the strike and dip directions of the fault; the slip vector rakes between 10 and 80 degrees in the plane of the fault.</rdfs:comment>
        <rdfs:label xml:lang="en">oblique slip</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolFault/PureExtraction -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolFault/PureExtraction">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolFault/Extraction"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgf:PureExtraction</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">An extraction fault with no discernible displacement within the fault plane.</rdfs:comment>
        <rdfs:label xml:lang="en">pure extraction</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolFault/Reverse -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolFault/Reverse">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolTectonic/TectonicForce"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolTectonic/TectonicProcess"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgf:Reverse</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The hanging wall appears to have moved down relative to the footwall; dip of fault usually greater than 45 degrees.</rdfs:comment>
        <rdfs:label xml:lang="en">reverse</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolFault/Scissor -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolFault/Scissor">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolFault/Slip"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgf:Scissor</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A fault on which there is increasing offset or separation along the strike from an initial point of no offset, with reverse offset in the opposite direction.</rdfs:comment>
        <rdfs:label xml:lang="en">scissor</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolFault/Sense -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolFault/Sense">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceDirection/Bearing"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceDirection/Direction"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceDirection/Inclination"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgf:Sense</metadata:prefixIRI>
        <rdfs:label xml:lang="en">sense</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolFault/Sinistral -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolFault/Sinistral">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolTectonic/TectonicForce"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolTectonic/TectonicProcess"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgf:Sinistral</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Left-lateral separation sense; in plan view, the side opposite the observer appears displaced to the right.</rdfs:comment>
        <rdfs:label xml:lang="en">sinistral</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolFault/Slip -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolFault/Slip">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procPhysical/Motion"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgf:Slip</metadata:prefixIRI>
        <rdfs:label xml:lang="en">slip</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolFault/StrikeSeparationSense -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolFault/StrikeSeparationSense">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolFault/Slip"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgf:StrikeSeparationSense</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A fault along which there is some separation parallel to the strike of the fault.</rdfs:comment>
        <rdfs:label xml:lang="en">strike separation sense</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolFault/StrikeSlip -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolFault/StrikeSlip">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolFault/StrikeSeparationSense"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgf:StrikeSlip</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The net slip of the fault (slip vector) is parallel to the strike of the fault.</rdfs:comment>
        <rdfs:label xml:lang="en">strike slip</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolFault/Throw -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolFault/Throw">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenSystem/Displacement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/hasDirection"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSpaceDirection/Vertical"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgf:Throw</metadata:prefixIRI>
        <rdfs:label xml:lang="en">throw</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolFault/Thrust -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolFault/Thrust">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolTectonic/TectonicForce"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolTectonic/TectonicProcess"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgf:Thrust</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Reverse fault with dip typically less than 45 degrees; horizontal compression, rather than vertical displacement is characteristic.</rdfs:comment>
        <rdfs:label xml:lang="en">thrust</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolFault/ThrustDecollement -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolFault/ThrustDecollement">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolFault/Thrust"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgf:ThrustDecollement</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A regional-scale low-angle thrust fault.</rdfs:comment>
        <rdfs:label xml:lang="en">thrust decollement</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolFault/Transcurrent -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolFault/Transcurrent">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolFault/StrikeSlip"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgf:Transcurrent</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A large scale strike-slip fault in which the fault surface is steeply inclined.</rdfs:comment>
        <rdfs:label xml:lang="en">transcurrent</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolFault/Transform -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolFault/Transform">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolFault/StrikeSlip"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgf:Transform</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A variety of strike-slip fault along which the displacement suddenly stops or changes form; typically associated with mid-ocean ridges.</rdfs:comment>
        <rdfs:label xml:lang="en">transform</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolFault/Transpressional -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolFault/Transpressional">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolFault/ObliqueSlip"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgf:Transpressional</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A fault along which strike-slip deformation is accompanied by a component of shortening transverse to the fault.</rdfs:comment>
        <rdfs:label xml:lang="en">transpressional</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolFault/Transtensional -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolFault/Transtensional">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolFault/ObliqueSlip"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgf:Transtensional</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A fault along which strike-slip deformation is accompanied by a component of extension transverse to the fault.</rdfs:comment>
        <rdfs:label xml:lang="en">transtensional</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolFault/Wrench -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolFault/Wrench">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolFault/StrikeSlip"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgf:Wrench</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A strike slip fault in which the faut plane is more or less vertical.</rdfs:comment>
        <rdfs:label xml:lang="en">wrench</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolGeomorphology/Abrasion -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolGeomorphology/Abrasion">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolGeomorphology/MaterialDisplacement"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgg:Abrasion</metadata:prefixIRI>
        <rdfs:label xml:lang="en">abrasion</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolGeomorphology/Avalanche -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolGeomorphology/Avalanche">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolGeomorphology/Slide"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenSystemComplexity/Collapse"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgg:Avalanche</metadata:prefixIRI>
        <rdfs:comment xml:lang="en"> A mass of snow, ice or rocks moving rapidly down a steep mountain slope. Avalanches may be characterized as loose and turbulent, or slab; either type may be dry or wet according to the nature of the snow forming it, although dry snow usually forms loose avalanches and wet snow forms slabs. A large avalanche sweeps a current of air along with and in front of it as an avalanche wind, which supplements its already tremendous destructive force.</rdfs:comment>
        <rdfs:label xml:lang="en">avalanche</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolGeomorphology/Compaction -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolGeomorphology/Compaction">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolGeomorphology/SedimentFormation"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgg:Compaction</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Compaction, part of the process of lithification involving mechanical dewatering of a sediment by progressive loading under several km of geomaterial [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">compaction</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolGeomorphology/Creep -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolGeomorphology/Creep">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/phenGeolGeomorphology/Reptation"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolGeomorphology/MaterialDisplacement"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgg:Creep</metadata:prefixIRI>
        <rdfs:label xml:lang="en">creep</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolGeomorphology/Denundation -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolGeomorphology/Denundation">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolGeomorphology/MaterialDisplacement"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgg:Denundation</metadata:prefixIRI>
        <rdfs:label xml:lang="en">denundation</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolGeomorphology/Diagenesis -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolGeomorphology/Diagenesis">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolGeomorphology/SedimentFormation"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgg:Diagenesis</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">In geology and oceanography, diagenesis is any chemical, physical, or biological change undergone by a sediment after its initial deposition and during and after its lithification, exclusive of surface alteration (weathering) and metamorphism. These changes happen at relatively low temperatures and pressures and result in changes to the rock&apos;s original mineralogy and texture. The boundary between diagenesis and metamorphism, which occurs under conditions of higher temperature and pressure, is gradational. After deposition, sediments are compacted as they are buried beneath successive layers of sediment and cemented by minerals that precipitate from solution. Grains of sediment, rock fragments and fossils can be replaced by other minerals during diagenesis. Porosity usually decreases during diagenesis, except in rare cases such as dissolution of minerals and dolomitization.</rdfs:comment>
        <rdfs:label xml:lang="en">diagenesis</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolGeomorphology/Exfoliation -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolGeomorphology/Exfoliation">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolGeomorphology/Weathering"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgg:Exfoliation</metadata:prefixIRI>
        <rdfs:label xml:lang="en">exfoliation</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolGeomorphology/Haloclasty -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolGeomorphology/Haloclasty">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolGeomorphology/Weathering"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/matrCompound/Salt"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgg:Haloclasty</metadata:prefixIRI>
        <rdfs:label xml:lang="en">haloclasty</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolGeomorphology/Karst -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolGeomorphology/Karst">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeol/GeologicalPhenomena"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeol/GeospherePhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgg:Karst</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Karst topography is a landscape shaped by the dissolution of a layer or layers of soluble bedrock, usually carbonate rock such as limestone or dolomite. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">karst</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolGeomorphology/Landslide -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolGeomorphology/Landslide">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolGeomorphology/Slide"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRealm"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realm/Land"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgg:Landslide</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A landslide (or landslip) is a geological phenomenon which includes a wide range of ground movement, such as rock falls, deep solidure of slopes and shallow debris flows, which can occur in offshore, coastal and onshore environments. [Wikpedia]</rdfs:comment>
        <rdfs:label xml:lang="en">landslide</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolGeomorphology/MassWasting -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolGeomorphology/MassWasting">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolGeomorphology/MaterialDisplacement"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgg:MassWasting</metadata:prefixIRI>
        <rdfs:label xml:lang="en">mass wasting</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolGeomorphology/MaterialDisplacement -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolGeomorphology/MaterialDisplacement">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phen/PlanetaryPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgg:MaterialDisplacement</metadata:prefixIRI>
        <rdfs:label xml:lang="en">material displacement</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolGeomorphology/Mudslide -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolGeomorphology/Mudslide">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolGeomorphology/Slide"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgg:Mudslide</metadata:prefixIRI>
        <rdfs:label xml:lang="en">mudslide</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolGeomorphology/Reptation -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolGeomorphology/Reptation">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolGeomorphology/MaterialDisplacement"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgg:Reptation</metadata:prefixIRI>
        <rdfs:label xml:lang="en">reptation</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolGeomorphology/RockSlopeFailure -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolGeomorphology/RockSlopeFailure">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolGeomorphology/MaterialDisplacement"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgg:RockSlopeFailure</metadata:prefixIRI>
        <rdfs:label xml:lang="en">rock slope failure</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolGeomorphology/Saltation -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolGeomorphology/Saltation">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolGeomorphology/MaterialDisplacement"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgg:Saltation</metadata:prefixIRI>
        <rdfs:label xml:lang="en">saltation</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolGeomorphology/SedimentFormation -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolGeomorphology/SedimentFormation">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolGeomorphology/MaterialDisplacement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaChemical/hasSubstance"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/matrSediment/Sediment"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgg:SedimentFormation</metadata:prefixIRI>
        <rdfs:label xml:lang="en">sediment formation</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolGeomorphology/Sedimentation -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolGeomorphology/Sedimentation">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeol/GeologicalPhenomena"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeol/GeospherePhenomena"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenFluidTransport/Deposition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgg:Sedimentation</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The process of depositing material by water, wind, or glaciers.</rdfs:comment>
        <rdfs:label xml:lang="en">sedimentation</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolGeomorphology/Slide -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolGeomorphology/Slide">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phen/Phenomena"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolGeomorphology/MaterialDisplacement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasImpact"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/stateRoleImpact/Hazard"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgg:Slide</metadata:prefixIRI>
        <rdfs:label xml:lang="en">slide</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolGeomorphology/Slump -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolGeomorphology/Slump">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolGeomorphology/MaterialDisplacement"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgg:Slump</metadata:prefixIRI>
        <rdfs:label xml:lang="en">slump</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolGeomorphology/Solifluction -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolGeomorphology/Solifluction">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolGeomorphology/MaterialDisplacement"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgg:Solifluction</metadata:prefixIRI>
        <rdfs:label xml:lang="en">solifluction</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolGeomorphology/Subsidence -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolGeomorphology/Subsidence">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolGeomorphology/MaterialDisplacement"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgg:Subsidence</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Subsidence is the motion of a surface (usually, the Earth&apos;s surface) as it shifts downward relative to a datum such as sea-level. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">subsidence</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolGeomorphology/Weathering -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolGeomorphology/Weathering">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolGeomorphology/MaterialDisplacement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaChemical/hasSubstance"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/matrRock/Rock"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://sweetontology.net/phenSolid/Erosion"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgg:Weathering</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Weathering is the decomposition of rocks, soils and their minerals through direct contact with the Earth&apos;s atmosphere. Weathering occurs in situ, or with no movement, and thus should not to be confused with erosion, which involves the movement and disintegration of rocks and minerals by agents such as water, ice, wind and gravity.</rdfs:comment>
        <rdfs:label xml:lang="en">weathering</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolSeismicity/Aftershock -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolSeismicity/Aftershock">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolSeismicity/Earthquake"/>
        <owl:disjointWith rdf:resource="http://sweetontology.net/phenGeolSeismicity/Foreshock"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgs:Aftershock</metadata:prefixIRI>
        <rdfs:label xml:lang="en">aftershock</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolSeismicity/DeepFocusEarthquake -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolSeismicity/DeepFocusEarthquake">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolSeismicity/Earthquake"/>
        <owl:disjointWith rdf:resource="http://sweetontology.net/phenGeolSeismicity/ShallowFocusEarthquake"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgs:DeepFocusEarthquake</metadata:prefixIRI>
        <rdfs:label xml:lang="en">deep focus earthquake</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolSeismicity/Earthquake -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolSeismicity/Earthquake">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolSeismicity/SeismicPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgs:Earthquake</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Earthquakes are caused by energy release during rapid slippage along a fault. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">earthquake</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolSeismicity/Foreshock -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolSeismicity/Foreshock">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolSeismicity/Earthquake"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgs:Foreshock</metadata:prefixIRI>
        <rdfs:label xml:lang="en">foreshock</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolSeismicity/LoveWave -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolSeismicity/LoveWave">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/phenGeolSeismicity/Lwave"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/SurfaceWave"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgs:LoveWave</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A type of seismic surface wave having a horizontal motion that is shear or transverse to the direction of propagation. Its velocity depends only on density and rigidity modulus, and not on bulk modulus. It is named after A. E. H. Love, the English mathematician who discovered it.</rdfs:comment>
        <rdfs:label xml:lang="en">love wave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolSeismicity/Lwave -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolSeismicity/Lwave">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/SurfaceWave"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgs:Lwave</metadata:prefixIRI>
        <rdfs:label xml:lang="en">lwave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolSeismicity/MegathrustEarthquake -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolSeismicity/MegathrustEarthquake">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolSeismicity/Earthquake"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgs:MegathrustEarthquake</metadata:prefixIRI>
        <rdfs:label xml:lang="en">megathrust earthquake</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolSeismicity/PWave -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolSeismicity/PWave">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/phenGeolSeismicity/PrimaryWave"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolSeismicity/SeismicBodyWave"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/LongitudinalWave"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgs:PWave</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">P waves are longitudinal or compressional waves, which means that the ground is alternately compressed and dilated in the direction of propagation. In solids these waves generally travel slightly less than twice as fast as S waves and can travel through any type of material. In air, these pressure waves take the form of sound waves, hence they travel at the speed of sound. Typical speeds are 330 m/s in air, 1450 m/s in water and about 5000 m/s in granite. P waves are sometimes called primary waves. When generated by an earthquake they are less destructive than the S waves and surface waves that follow them, due to their lesser amplitudes.</rdfs:comment>
        <rdfs:label xml:lang="en">p wave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolSeismicity/PrimaryWave -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolSeismicity/PrimaryWave">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolSeismicity/SeismicBodyWave"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/LongitudinalWave"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgs:PrimaryWave</metadata:prefixIRI>
        <rdfs:label xml:lang="en">primary wave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolSeismicity/SWave -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolSeismicity/SWave">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/phenGeolSeismicity/SecondaryWave"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolSeismicity/SeismicBodyWave"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/ShearWave"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgs:SWave</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">S waves are transverse or shear waves, which means that the ground is displaced perpendicularly to the direction of propagation. In the case of horizontally polarized S waves, the ground moves alternately to one side and then the other. S waves can travel only through solids, as fluids (liquids and gases) do not support shear stresses. Their speed is about 60% of that of P waves in a given material. S waves are sometimes called secondary waves, and are several times larger in amplitude than P waves for earthquake sources.</rdfs:comment>
        <rdfs:label xml:lang="en">s wave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolSeismicity/SecondaryWave -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolSeismicity/SecondaryWave">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolSeismicity/SeismicBodyWave"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/ShearWave"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgs:SecondaryWave</metadata:prefixIRI>
        <rdfs:label xml:lang="en">secondary wave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolSeismicity/SeismicBodyWave -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolSeismicity/SeismicBodyWave">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolSeismicity/SeismicWave"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/BodyWave"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgs:SeismicBodyWave</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Body waves are seismic waves that travel through the lithosphere. Two kinds of body waves exist: P-waves and S-waves.</rdfs:comment>
        <rdfs:label xml:lang="en">seismic body wave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolSeismicity/SeismicPhenomena -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolSeismicity/SeismicPhenomena">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeol/GeologicalPhenomena"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeol/GeospherePhenomena"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenGeolSeismicity/SeismicWave"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasImpact"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/stateRoleImpact/Hazard"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgs:SeismicPhenomena</metadata:prefixIRI>
        <rdfs:label xml:lang="en">seismic phenomena</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolSeismicity/SeismicSurfaceWave -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolSeismicity/SeismicSurfaceWave">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolSeismicity/SeismicWave"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/SurfaceWave"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgs:SeismicSurfaceWave</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Surface waves are analogous to water waves and travel just under the Earth&apos;s surface. They travel more slowly than body waves. Because of their low frequency, long duration, and large amplitude, they can be the most destructive type of seismic wave. There are two types of surface waves: Rayleigh waves and Love waves. Theoretically, surface waves can be understood as systems of interacting P and/or S waves.</rdfs:comment>
        <rdfs:label xml:lang="en">seismic surface wave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolSeismicity/SeismicWave -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolSeismicity/SeismicWave">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/Wave"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenGeolSeismicity/SeismicPhenomena"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgs:SeismicWave</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Seismic waves are phenomena that travel through the Earth or other elastic body, for example as the result of an earthquake, explosion, or some other process that imparts forces to the body. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">seismic wave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolSeismicity/ShallowFocusEarthquake -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolSeismicity/ShallowFocusEarthquake">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolSeismicity/Earthquake"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgs:ShallowFocusEarthquake</metadata:prefixIRI>
        <rdfs:label xml:lang="en">shallow focus earthquake</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolSeismicity/Tremor -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolSeismicity/Tremor">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolSeismicity/Earthquake"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgs:Tremor</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Low amplitude, continuous earthquake activity often associated with magma movement.</rdfs:comment>
        <rdfs:label xml:lang="en">tremor</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolTectonic/AsymmetricHeatFlow -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolTectonic/AsymmetricHeatFlow">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidDynamics/Flow"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgt:AsymmetricHeatFlow</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Asymmetric heat flow in geology is an observation that the heat from upwelling mantle does not spread symmetrically away from the hot spot or rift due to differences in crust composition.</rdfs:comment>
        <rdfs:label xml:lang="en">asymmetric heat flow</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolTectonic/CompositeProcess -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolTectonic/CompositeProcess">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolTectonic/TectonicPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgt:CompositeProcess</metadata:prefixIRI>
        <rdfs:label xml:lang="en">composite process</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolTectonic/ContinenetalDrift -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolTectonic/ContinenetalDrift">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolTectonic/TectonicPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgt:ContinenetalDrift</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Continental drift is the movement of the Earth&apos;s continents relative to each other. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">continenetal drift</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolTectonic/ContinentalBreakup -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolTectonic/ContinentalBreakup">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolTectonic/TectonicPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgt:ContinentalBreakup</metadata:prefixIRI>
        <rdfs:label xml:lang="en">continental breakup</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolTectonic/ContinentalCollision -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolTectonic/ContinentalCollision">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolTectonic/TectonicPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgt:ContinentalCollision</metadata:prefixIRI>
        <rdfs:label xml:lang="en">continental collision</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolTectonic/Creep -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolTectonic/Creep">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolTectonic/TectonicPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgt:Creep</metadata:prefixIRI>
        <rdfs:label xml:lang="en">creep</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolTectonic/ExtensionEvent -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolTectonic/ExtensionEvent">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolTectonic/TectonicPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgt:ExtensionEvent</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">An extension event occurs when a seismic event causes an extension in the crust.   [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">extension event</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolTectonic/IsostaticAdjustment -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolTectonic/IsostaticAdjustment">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/phenGeolTectonic/IsostaticRebound"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolTectonic/TectonicPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgt:IsostaticAdjustment</metadata:prefixIRI>
        <rdfs:label xml:lang="en">isostatic adjustment</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolTectonic/IsostaticRebound -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolTectonic/IsostaticRebound">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolTectonic/TectonicPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgt:IsostaticRebound</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Post-glacial rebound (sometimes called continental rebound, isostatic rebound, isostatic adjustment or post-ice-age isostatic recovery) is the rise of land masses that were depressed by the huge weight of ice sheets during the last glacial period, through a process known as isostatic depression. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">isostatic rebound</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolTectonic/PlateConvergence -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolTectonic/PlateConvergence">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolTectonic/TectonicPhenomena"/>
        <owl:disjointWith rdf:resource="http://sweetontology.net/phenGeolTectonic/PlateDivergence"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgt:PlateConvergence</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Plate convergence is the phenomena of two plates moving toward one another. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">plate convergence</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolTectonic/PlateDivergence -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolTectonic/PlateDivergence">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolTectonic/TectonicPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgt:PlateDivergence</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Plate divergence is the phenomena of plates drifting apart [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">plate divergence</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolTectonic/Spreading -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolTectonic/Spreading">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolTectonic/TectonicPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgt:Spreading</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A spreading event occurs whenever plates drift apart (Plate Divergence). [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">spreading</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolTectonic/Subduction -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolTectonic/Subduction">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolTectonic/TectonicPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgt:Subduction</metadata:prefixIRI>
        <rdfs:label xml:lang="en">subduction</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolTectonic/TectonicAssemblage -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolTectonic/TectonicAssemblage">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicFeature"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgt:TectonicAssemblage</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A tectonic ssemblage is a geological term for an accreted terrane of heterogeneous rocks. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">tectonic assemblage</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolTectonic/TectonicForce -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolTectonic/TectonicForce">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/phenGeolTectonic/TectonicProcess"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/proc/Force"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenGeolTectonic/TectonicPhenomena"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgt:TectonicForce</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The tectonic force is the force created by one tectonic plate pushing against another due to upwellings of the mantle, [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">tectonic force</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolTectonic/TectonicPhenomena -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolTectonic/TectonicPhenomena">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeol/GeologicalPhenomena"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeol/GeospherePhenomena"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenSolid/Deformation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRealm"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmGeol/Crust"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgt:TectonicPhenomena</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The tectonic phenomena is the observable motions of the tectonic plates in the Earth&apos;s Lithosphere. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">tectonic phenomena</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolTectonic/TectonicProcess -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolTectonic/TectonicProcess">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/proc/Force"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgt:TectonicProcess</metadata:prefixIRI>
        <rdfs:label xml:lang="en">tectonic process</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolTectonic/TectonicUplift -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolTectonic/TectonicUplift">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolTectonic/TectonicPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgt:TectonicUplift</metadata:prefixIRI>
        <rdfs:label xml:lang="en">tectonic uplift</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolTectonic/Terrane -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolTectonic/Terrane">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolTectonic/TectonicAssemblage"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgt:Terrane</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A terrane in geology is a fragment of crustal material formed on, or broken off from, one tectonic plate and accreted — ‘sutured’ — to crust lying on another plate.  [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">terrane</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolTectonic/TransformFaulting -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolTectonic/TransformFaulting">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolTectonic/TectonicPhenomena"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRealm"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmLandTectonic/TransformFault"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgt:TransformFaulting</metadata:prefixIRI>
        <rdfs:label xml:lang="en">transform faulting</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolVolcano/EruptionCloud -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolVolcano/EruptionCloud">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrSediment/Ejecta"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolVolcano/VolcanicActivity"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolVolcano/VolcanicPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgv:EruptionCloud</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The column of gases, ash, and larger rock fragments rising from a crater or other vent. If it is of sufficient volume and velocity, this gaseous column may reach many miles into the stratosphere, where high winds will carry it long distances.</rdfs:comment>
        <rdfs:label xml:lang="en">eruption cloud</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolVolcano/FlankEruption -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolVolcano/FlankEruption">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolVolcano/VolcanicEruption"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgv:FlankEruption</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">An eruption from the side of a volcano (in contrast to a summit eruption.)</rdfs:comment>
        <rdfs:label xml:lang="en">flank eruption</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolVolcano/LavaOfTephra -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolVolcano/LavaOfTephra">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/Lava"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgv:LavaOfTephra</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Tephra is air-fall material (of any size) produced by a volcanic eruption regardless of composition or fragment size. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">lava of tephra</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolVolcano/MagmaMotion -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolVolcano/MagmaMotion">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolVolcano/VolcanicActivity"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolVolcano/VolcanicPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgv:MagmaMotion</metadata:prefixIRI>
        <rdfs:label xml:lang="en">magma motion</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolVolcano/Magmatic -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolVolcano/Magmatic">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolVolcano/VolcanicEruption"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgv:Magmatic</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Eruption Type 1 - produce juvenile clasts during explosive decompression from gas release. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">magmatic</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolVolcano/MantlePlume -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolVolcano/MantlePlume">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/phenGeolVolcano/MantleThermalPlume"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolVolcano/VolcanicPlume"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRealm"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmGeol/Mantle"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgv:MantlePlume</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A mantle plume is an upwelling of abnormally hot rock within the Earth&apos;s mantle. As the heads of mantle plumes can partly melt when they reach shallow depths, they are thought to be the cause of volcanic centers known as hotspots and probably also to have caused flood basalts. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">mantle plume</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolVolcano/MantleThermalPlume -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolVolcano/MantleThermalPlume">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolVolcano/VolcanicPlume"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgv:MantleThermalPlume</metadata:prefixIRI>
        <rdfs:label xml:lang="en">mantle thermal plume</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolVolcano/NueeArdenteEruption -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolVolcano/NueeArdenteEruption">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/phenGeolVolcano/PeleeanEruption"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolVolcano/VolcanicEruption"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgv:NueeArdenteEruption</metadata:prefixIRI>
        <rdfs:label xml:lang="en">nuee ardente eruption</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolVolcano/PeleeanEruption -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolVolcano/PeleeanEruption">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolVolcano/VolcanicEruption"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgv:PeleeanEruption</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">In a Peléan eruption or nuée ardente (glowing cloud) eruptions a large amount of gas, dust, ash, and lava fragments are blown out of a central crater, fall back, and form avalanches that move downslope at speeds as great as 160 km per hour. These eruptions are usually associated with silicic magmas. A name for some pyroclastic flows is nuée ardente (French for ‘glowing cloud’); this was first used to describe the disastrous 1902 eruption of Mount Pelée on Martinique.[3] These pyroclastic flows glowed red in the dark. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">peleean eruption</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolVolcano/PhreaticEruption -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolVolcano/PhreaticEruption">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/phenGeolVolcano/SteamBlastEruption"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolVolcano/VolcanicEruption"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgv:PhreaticEruption</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Phreatic eruption is an explosion that follows the transformation of groundwater into steam. No incandescent or juvenile material is erupted.</rdfs:comment>
        <rdfs:label xml:lang="en">phreatic eruption</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolVolcano/PhreatomagmaticEruption -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolVolcano/PhreatomagmaticEruption">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolVolcano/VolcanicEruption"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgv:PhreatomagmaticEruption</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Eruption Type 2 - Ejection of entrained particles during steam eruptions. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">phreatomagmatic eruption</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolVolcano/PlinianEruption -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolVolcano/PlinianEruption">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolVolcano/VolcanicEruption"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgv:PlinianEruption</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Plinian eruptions are characterized by paroxysmal ejection of large volume of ash and pumice as a well-defined eruption column or ‘jet;’ often precedes caldera collapse. The resulting tephra fallout covers an area of more than 500 square kilometers.</rdfs:comment>
        <rdfs:label xml:lang="en">plinian eruption</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolVolcano/SteamBlastEruption -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolVolcano/SteamBlastEruption">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolVolcano/VolcanicEruption"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgv:SteamBlastEruption</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A series of hundreds of steam explosions preceding an eruption of the volcano A less intense geothermal event may result in a mud volcano. In 1949, Thomas Jaggar described this kind of activity as steam-blast eruptions. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">steam blast eruption</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolVolcano/StrombolianEruption -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolVolcano/StrombolianEruption">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolVolcano/VolcanicEruption"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgv:StrombolianEruption</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Strombolian Eruptions are characterised by huge clots of molten lava bursting from the summit crater to form luminous arcs through the sky. Collecting on the flanks of the cone, lava clots combine to stream down the slopes in molten rivulets. The explosions are driven by bursts of gas slugs that rise faster than surrounding magma</rdfs:comment>
        <rdfs:label xml:lang="en">strombolian eruption</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolVolcano/SummitEruption -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolVolcano/SummitEruption">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolVolcano/VolcanicEruption"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgv:SummitEruption</metadata:prefixIRI>
        <rdfs:label xml:lang="en">summit eruption</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolVolcano/Surge -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolVolcano/Surge">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolVolcano/VolcanicPlume"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgv:Surge</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A ring-shaped cloud of gas and suspended solid debris that moves radially outward at high velocity as a density flow from the base of a vertical eruption column accompanying a volcanic eruption or crater formation.</rdfs:comment>
        <rdfs:label xml:lang="en">surge</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolVolcano/VolcanicActivity -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolVolcano/VolcanicActivity">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/phenGeolVolcano/VolcanicPhenomena"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeol/GeologicalPhenomena"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeol/GeospherePhenomena"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolVolcano/VolcanicActivity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/phenGeolVolcano/Volcanism"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgv:VolcanicActivity</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A geophysical phenomena involving the extrusion of rock that tends to form mountains or features like mountains over a period of time. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">volcanic activity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolVolcano/VolcanicEruption -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolVolcano/VolcanicEruption">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolVolcano/VolcanicActivity"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolVolcano/VolcanicPhenomena"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenReaction/Eruption"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/hasTransport"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/propEnergy/Heat"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/hasTransport"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/propMass/Mass"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgv:VolcanicEruption</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Moderate to violent ejection of solid or very viscous hot fragments of new lava in short-lived, cannon-like bursts. Ash and fine ash are emitted with gases and ascend to form a cauliflower-like eruption cloud.</rdfs:comment>
        <rdfs:label xml:lang="en">volcanic eruption</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolVolcano/VolcanicPhenomena -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolVolcano/VolcanicPhenomena">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeol/GeologicalPhenomena"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeol/GeospherePhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgv:VolcanicPhenomena</metadata:prefixIRI>
        <rdfs:label xml:lang="en">volcanic phenomena</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolVolcano/VolcanicPlume -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolVolcano/VolcanicPlume">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidTransport/Plume"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolVolcano/VolcanicActivity"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolVolcano/VolcanicPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgv:VolcanicPlume</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">An eruption column of hot volcanic ash and gas emitted into the atmosphere during an explosive volcanic eruption. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">volcanic plume</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolVolcano/Volcanism -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolVolcano/Volcanism">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/phenGeolVolcano/Vulcanism"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeol/GeologicalPhenomena"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeol/GeospherePhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgv:Volcanism</metadata:prefixIRI>
        <rdfs:label xml:lang="en">volcanism</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenGeolVolcano/Vulcanism -->

    <owl:Class rdf:about="http://sweetontology.net/phenGeolVolcano/Vulcanism">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeol/GeologicalPhenomena"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeol/GeospherePhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophgv:Vulcanism</metadata:prefixIRI>
        <rdfs:label xml:lang="en">vulcanism</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenHelio/Airglow -->

    <owl:Class rdf:about="http://sweetontology.net/phenHelio/Airglow">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenHelio/AtmosphericLightEmission"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophhe:Airglow</metadata:prefixIRI>
        <rdfs:label xml:lang="en">airglow</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenHelio/AtmosphericLightEmission -->

    <owl:Class rdf:about="http://sweetontology.net/phenHelio/AtmosphericLightEmission">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenHelio/HeliosphericPhenomena"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/procWave/Emission"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophhe:AtmosphericLightEmission</metadata:prefixIRI>
        <rdfs:label xml:lang="en">atmospheric light emission</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenHelio/Aurora -->

    <owl:Class rdf:about="http://sweetontology.net/phenHelio/Aurora">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenHelio/AtmosphericLightEmission"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophhe:Aurora</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The sporadic radiant emission from the upper atmosphere over the middle and high latitudes.</rdfs:comment>
        <rdfs:label xml:lang="en">aurora</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenHelio/AuroralSubstorm -->

    <owl:Class rdf:about="http://sweetontology.net/phenHelio/AuroralSubstorm">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/phenHelio/MagneticSubstorm"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenHelio/AtmosphericLightEmission"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophhe:AuroralSubstorm</metadata:prefixIRI>
        <rdfs:label xml:lang="en">auroral substorm</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenHelio/BowShock -->

    <owl:Class rdf:about="http://sweetontology.net/phenHelio/BowShock">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenHelio/BowShockCrossing"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophhe:BowShock</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The bow shock is a discontinuity that forms in the solar wind when the supersonic solar wind encounters the magnetic field of a planet, very similar to the shock wave that forms upstream of an aircraft moving at a supersonic speed.</rdfs:comment>
        <rdfs:label xml:lang="en">bow shock</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenHelio/BowShockCrossing -->

    <owl:Class rdf:about="http://sweetontology.net/phenHelio/BowShockCrossing">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenHelio/HeliosphericPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophhe:BowShockCrossing</metadata:prefixIRI>
        <rdfs:label xml:lang="en">bow shock crossing</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenHelio/GeomagneticStorm -->

    <owl:Class rdf:about="http://sweetontology.net/phenHelio/GeomagneticStorm">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/phenHelio/MagneticStorm"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phen/Event"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phen/Occurrence"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenHelio/InterplanetaryPhenomena"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenSystem/Disturbance"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenHelio/SpaceWeather"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophhe:GeomagneticStorm</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A geomagnetic storm is a temporary disturbance of the Earths magnetosphere caused by a disturbance in space weather. Associated with solar coronal mass ejections (CME), coronal holes, or solar flares, a geomagnetic storm is caused by a solar wind shock wave which typically strikes the Earths magnetic field 24 to 36 hours after the event. This only happens if the shock wave travels in a direction toward Earth. The solar wind pressure on the magnetosphere will increase or decrease depending on the Sun&apos;s activity. These solar wind pressure changes modify the electric currents in the ionosphere.</rdfs:comment>
        <rdfs:label xml:lang="en">geomagnetic storm</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenHelio/Geomagnetism -->

    <owl:Class rdf:about="http://sweetontology.net/phenHelio/Geomagnetism">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procPhysical/Magnetism"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophhe:Geomagnetism</metadata:prefixIRI>
        <rdfs:label xml:lang="en">geomagnetism</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenHelio/Heliosheath -->

    <owl:Class rdf:about="http://sweetontology.net/phenHelio/Heliosheath">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenHelio/HeliosphericPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophhe:Heliosheath</metadata:prefixIRI>
        <rdfs:label xml:lang="en">heliosheath</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenHelio/HeliosphericPhenomena -->

    <owl:Class rdf:about="http://sweetontology.net/phenHelio/HeliosphericPhenomena">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phen/Phenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophhe:HeliosphericPhenomena</metadata:prefixIRI>
        <rdfs:label xml:lang="en">heliospheric phenomena</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenHelio/InterplanetaryPhenomena -->

    <owl:Class rdf:about="http://sweetontology.net/phenHelio/InterplanetaryPhenomena">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phen/Phenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophhe:InterplanetaryPhenomena</metadata:prefixIRI>
        <rdfs:label xml:lang="en">interplanetary phenomena</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenHelio/InterplanetaryShock -->

    <owl:Class rdf:about="http://sweetontology.net/phenHelio/InterplanetaryShock">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenHelio/InterplanetaryPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophhe:InterplanetaryShock</metadata:prefixIRI>
        <rdfs:label xml:lang="en">interplanetary shock</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenHelio/MagneticStorm -->

    <owl:Class rdf:about="http://sweetontology.net/phenHelio/MagneticStorm">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phen/Event"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phen/Occurrence"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenHelio/InterplanetaryPhenomena"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenSystem/Disturbance"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophhe:MagneticStorm</metadata:prefixIRI>
        <rdfs:label xml:lang="en">magnetic storm</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenHelio/MagneticSubstorm -->

    <owl:Class rdf:about="http://sweetontology.net/phenHelio/MagneticSubstorm">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenHelio/AtmosphericLightEmission"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophhe:MagneticSubstorm</metadata:prefixIRI>
        <rdfs:label xml:lang="en">magnetic substorm</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenHelio/MagnetopauseCrossing -->

    <owl:Class rdf:about="http://sweetontology.net/phenHelio/MagnetopauseCrossing">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenHelio/HeliosphericPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophhe:MagnetopauseCrossing</metadata:prefixIRI>
        <rdfs:label xml:lang="en">magnetopause crossing</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenHelio/Magnetosheath -->

    <owl:Class rdf:about="http://sweetontology.net/phenHelio/Magnetosheath">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenHelio/HeliosphericPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophhe:Magnetosheath</metadata:prefixIRI>
        <rdfs:label xml:lang="en">magnetosheath</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenHelio/Magnetotail -->

    <owl:Class rdf:about="http://sweetontology.net/phenHelio/Magnetotail">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenHelio/HeliosphericPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophhe:Magnetotail</metadata:prefixIRI>
        <rdfs:label xml:lang="en">magnetotail</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenHelio/ProtonPrecipitation -->

    <owl:Class rdf:about="http://sweetontology.net/phenHelio/ProtonPrecipitation">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phen/Precipitation"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenHelio/GeomagneticStorm"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenHelio/MagneticStorm"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophhe:ProtonPrecipitation</metadata:prefixIRI>
        <rdfs:label xml:lang="en">proton precipitation</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenHelio/SchumannResonance -->

    <owl:Class rdf:about="http://sweetontology.net/phenHelio/SchumannResonance">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenHelio/HeliosphericPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophhe:SchumannResonance</metadata:prefixIRI>
        <rdfs:label xml:lang="en">schumann resonance</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenHelio/SolarParticleEvent -->

    <owl:Class rdf:about="http://sweetontology.net/phenHelio/SolarParticleEvent">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenHelio/GeomagneticStorm"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenHelio/MagneticStorm"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophhe:SolarParticleEvent</metadata:prefixIRI>
        <rdfs:label xml:lang="en">solar particle event</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenHelio/SolarWind -->

    <owl:Class rdf:about="http://sweetontology.net/phenHelio/SolarWind">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenStar/StellarWind"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/hasAstronomicalBody"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/phenStar/Sun"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophhe:SolarWind</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The solar wind is a stream of charged particles (i.e., a plasma) which are ejected from the upper atmosphere of the sun. It consists mostly of high-energy electrons and protons (about 1 keV) that are able to escape the sun&apos;s gravity in part because of the high temperature of the corona and the high kinetic energy particles gain through a process that is not well understood at this time.</rdfs:comment>
        <rdfs:label xml:lang="en">solar wind</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenHelio/SolarWindExtreme -->

    <owl:Class rdf:about="http://sweetontology.net/phenHelio/SolarWindExtreme">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenHelio/InterplanetaryPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophhe:SolarWindExtreme</metadata:prefixIRI>
        <rdfs:label xml:lang="en">solar wind extreme</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenHelio/SpaceWeather -->

    <owl:Class rdf:about="http://sweetontology.net/phenHelio/SpaceWeather">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenHelio/HeliosphericPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophhe:SpaceWeather</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Space weather is the concept of changing environmental conditions in outer space. It is distinct from the concept of weather within a planetary atmosphere, and generally deals with the interactions of ambient radiation and matter within interplanetary, and occasionally interstellar space. Space weather describes the conditions in space that affect Earth and its technological systems. Our space weather is a consequence of the behavior of the sun, the nature of Earth&apos;s magnetic field, and our location in the solar system.</rdfs:comment>
        <rdfs:label xml:lang="en">space weather</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenHelio/Substorm -->

    <owl:Class rdf:about="http://sweetontology.net/phenHelio/Substorm">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenHelio/InterplanetaryPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophhe:Substorm</metadata:prefixIRI>
        <rdfs:label xml:lang="en">substorm</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenHelio/SunEarthInteraction -->

