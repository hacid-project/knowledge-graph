    </owl:Class>
    


    <!-- http://sweetontology.net/propMassFlux/EffectivePermeability -->

    <owl:Class rdf:about="http://sweetontology.net/propMassFlux/EffectivePermeability">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMassFlux/Permeability"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropmf:EffectivePermeability</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The observed permeability of a porous medium to one fluid phase under conditions of physical interaction between this phase and other fluid phases present.</rdfs:comment>
        <rdfs:label xml:lang="en">effective permeability</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propMassFlux/GPP -->

    <owl:Class rdf:about="http://sweetontology.net/propMassFlux/GPP">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/propMassFlux/GrossPrimaryProductivity"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMassFlux/PrimaryProductivity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropmf:GPP</metadata:prefixIRI>
        <rdfs:label xml:lang="en">gpp</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propMassFlux/GrossPrimaryProductivity -->

    <owl:Class rdf:about="http://sweetontology.net/propMassFlux/GrossPrimaryProductivity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMassFlux/PrimaryProductivity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropmf:GrossPrimaryProductivity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">gross primary productivity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propMassFlux/IntrinsicPermeability -->

    <owl:Class rdf:about="http://sweetontology.net/propMassFlux/IntrinsicPermeability">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMassFlux/Permeability"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropmf:IntrinsicPermeability</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A measure of the relative ease with which a porous medium can transmit a fluid under a potential gradient and is a property of the medium alone (after Lohman and others, 1972). The property of a porous medium itself that expresses the ease with which gases, liquids, or other substances can pass through it.</rdfs:comment>
        <rdfs:label xml:lang="en">intrinsic permeability</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propMassFlux/MassFlux -->

    <owl:Class rdf:about="http://sweetontology.net/propMassFlux/MassFlux">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/Flux"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaChemical/hasSubstance"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propMass/Mass"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropmf:MassFlux</metadata:prefixIRI>
        <rdfs:label xml:lang="en">mass flux</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propMassFlux/NPP -->

    <owl:Class rdf:about="http://sweetontology.net/propMassFlux/NPP">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/propMassFlux/NetPrimaryProductivity"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMassFlux/PrimaryProductivity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropmf:NPP</metadata:prefixIRI>
        <rdfs:label xml:lang="en">npp</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propMassFlux/NetPrimaryProductivity -->

    <owl:Class rdf:about="http://sweetontology.net/propMassFlux/NetPrimaryProductivity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMassFlux/PrimaryProductivity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropmf:NetPrimaryProductivity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">net primary productivity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propMassFlux/Permeability -->

    <owl:Class rdf:about="http://sweetontology.net/propMassFlux/Permeability">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMassFlux/MassFlux"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropmf:Permeability</metadata:prefixIRI>
        <rdfs:label xml:lang="en">permeability</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propMassFlux/PermeabilityCoefficent -->

    <owl:Class rdf:about="http://sweetontology.net/propMassFlux/PermeabilityCoefficent">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMassFlux/Permeability"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropmf:PermeabilityCoefficent</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The rate of flow of water through a unit cross-sectional area under a unit hydraulic gradient at the prevailing temperature (field permeability coefficient) or adjusted to a temperature of 150C (60-F).</rdfs:comment>
        <rdfs:label xml:lang="en">permeability coefficent</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propMassFlux/PrimaryProductivity -->

    <owl:Class rdf:about="http://sweetontology.net/propMassFlux/PrimaryProductivity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMassFlux/Productivity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropmf:PrimaryProductivity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">primary productivity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propMassFlux/Productivity -->

    <owl:Class rdf:about="http://sweetontology.net/propMassFlux/Productivity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMassFlux/MassFlux"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropmf:Productivity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">productivity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propMassFlux/SpecificCapacity -->

    <owl:Class rdf:about="http://sweetontology.net/propMassFlux/SpecificCapacity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMassFlux/MassFlux"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropmf:SpecificCapacity</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The rate of discharge of water from the well divided by the drawdown of the water level within the well.</rdfs:comment>
        <rdfs:label xml:lang="en">specific capacity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propMassFlux/SpecificDischarge -->

    <owl:Class rdf:about="http://sweetontology.net/propMassFlux/SpecificDischarge">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMassFlux/MassFlux"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropmf:SpecificDischarge</metadata:prefixIRI>
        <rdfs:comment xml:lang="en"> The rate of discharge of groundwater per unit area of a porous medium measured at right angle to the direction of flow.</rdfs:comment>
        <rdfs:label xml:lang="en">specific discharge</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propMassFlux/SpecificPermeability -->

    <owl:Class rdf:about="http://sweetontology.net/propMassFlux/SpecificPermeability">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMassFlux/Permeability"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropmf:SpecificPermeability</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The permeability measured when the rock contains only one fluid.</rdfs:comment>
        <rdfs:label xml:lang="en">specific permeability</rdfs:label>
    </owl:Class>
    


