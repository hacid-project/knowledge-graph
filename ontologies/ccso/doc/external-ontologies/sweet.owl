    <owl:Class rdf:about="http://sweetontology.net/matrWater/Rainwater">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrWater/LiquidWater"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaProvenance/hasSource"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenAtmoPrecipitation/Rainfall"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somaw:Rainwater</metadata:prefixIRI>
        <rdfs:label xml:lang="en">rainwater</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrWater/Rime -->

