    <owl:Class rdf:about="http://sweetontology.net/propEnergyFlux/SpectralRadiance">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergyFlux/Radiance"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropef:SpectralRadiance</metadata:prefixIRI>
