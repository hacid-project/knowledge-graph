        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrWater/Ice"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somaw:Rime</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A white or milky and opaque granular deposit of ice formed by the rapid freezing of supercooled water drops as they impinge upon an exposed object.</rdfs:comment>
        <rdfs:label xml:lang="en">rime</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrWater/SalineWater -->

    <owl:Class rdf:about="http://sweetontology.net/matrWater/SalineWater">
