        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somaw:SaltWater</metadata:prefixIRI>
        <rdfs:label xml:lang="en">salt water</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrWater/SeaWater -->

