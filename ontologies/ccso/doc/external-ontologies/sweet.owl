    <!-- http://sweetontology.net/matrInstrument/Sensor -->

    <owl:Class rdf:about="http://sweetontology.net/matrInstrument/Sensor">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrInstrument/Device"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrInstrument/Instrument"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somains:Sensor</metadata:prefixIRI>
        <rdfs:label xml:lang="en">sensor</rdfs:label>
    </owl:Class>
    


