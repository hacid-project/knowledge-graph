    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceDistance/ScatteringCoefficient -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceDistance/ScatteringCoefficient">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceDistance/SpatialFrequency"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasProcess"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/procWave/Scattering"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsdis:ScatteringCoefficient</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A measure of the extinction due to scattering of monochromatic radiation as it traverses a medium containing scattering particles.</rdfs:comment>
