        <owl:disjointWith rdf:resource="http://sweetontology.net/reprMathFunction/Discontinuous"/>
        <owl:disjointWith rdf:resource="http://sweetontology.net/reprMathFunction/Discrete"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorepmf:Continuous</metadata:prefixIRI>
