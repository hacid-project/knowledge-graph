        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropfr:BivariateStatisticalSummary</metadata:prefixIRI>
        <rdfs:label xml:lang="en">bivariate statistical summary</rdfs:label>
    </owl:Class>
    


