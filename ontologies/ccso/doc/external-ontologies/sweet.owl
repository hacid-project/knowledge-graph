        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophm:Mixing</metadata:prefixIRI>
        <rdfs:label xml:lang="en">mixing</rdfs:label>
    </owl:Class>
    


