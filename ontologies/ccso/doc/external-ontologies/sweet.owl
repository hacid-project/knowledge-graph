        <rdfs:label xml:lang="en">antarctic oscillation</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenCycle/ArcticOscillation -->

    <owl:Class rdf:about="http://sweetontology.net/phenCycle/ArcticOscillation">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenCycle/EarthOscillation"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophcy:ArcticOscillation</metadata:prefixIRI>
        <rdfs:label xml:lang="en">arctic oscillation</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenCycle/BodyTide -->

    <owl:Class rdf:about="http://sweetontology.net/phenCycle/BodyTide">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenCycle/Tide"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophcy:BodyTide</metadata:prefixIRI>
        <rdfs:label xml:lang="en">body tide</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenCycle/ChandlerWobble -->

    <owl:Class rdf:about="http://sweetontology.net/phenCycle/ChandlerWobble">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenCycle/EarthOscillation"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophcy:ChandlerWobble</metadata:prefixIRI>
        <rdfs:label xml:lang="en">chandler wobble</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenCycle/DiurnalCycle -->

    <owl:Class rdf:about="http://sweetontology.net/phenCycle/DiurnalCycle">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenCycle/GlobalCycle"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaTime/hasFrequency"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/stateTimeFrequency/Daily"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophcy:DiurnalCycle</metadata:prefixIRI>
        <rdfs:label xml:lang="en">diurnal cycle</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenCycle/ENSO -->

    <owl:Class rdf:about="http://sweetontology.net/phenCycle/ENSO">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/phenCycle/ElNinoSouthernOscillation"/>
        <owl:equivalentClass rdf:resource="http://sweetontology.net/phenCycle/SouthernOscillation"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenCycle/EarthOscillation"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophcy:ENSO</metadata:prefixIRI>
        <rdfs:label xml:lang="en">enso</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenCycle/EarthOscillation -->

    <owl:Class rdf:about="http://sweetontology.net/phenCycle/EarthOscillation">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenCycle/PlanetaryOscillation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/hasAstronomicalBody"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/realm/Earth"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophcy:EarthOscillation</metadata:prefixIRI>
        <rdfs:label xml:lang="en">earth oscillation</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenCycle/ElNinoSouthernOscillation -->

    <owl:Class rdf:about="http://sweetontology.net/phenCycle/ElNinoSouthernOscillation">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenCycle/EarthOscillation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRealm"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realm/Ocean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophcy:ElNinoSouthernOscillation</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A significant increase in sea surface temperature over the eastern and central equatorial Pacific that occurs at irregular intervals, generally ranging between two and seven years.</rdfs:comment>
        <rdfs:label xml:lang="en">el nino southern oscillation</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenCycle/GlobalCycle -->

    <owl:Class rdf:about="http://sweetontology.net/phenCycle/GlobalCycle">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenSystem/Oscillation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/hasSpatialScale"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/stateSpaceScale/Global"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophcy:GlobalCycle</metadata:prefixIRI>
        <rdfs:label xml:lang="en">global cycle</rdfs:label>
    </owl:Class>
    


