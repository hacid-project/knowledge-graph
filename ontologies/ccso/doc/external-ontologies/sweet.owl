        <rdf:type rdf:resource="http://sweetontology.net/propOrdinal/SpectralBand"/>
        <relaSpace:hasWavelength>
            <rdf:Description>
                <rdf:type rdf:resource="http://sweetontology.net/propSpaceDistance/WavelengthBand_nm"/>
                <relaMath:hasLowerBound rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</relaMath:hasLowerBound>
