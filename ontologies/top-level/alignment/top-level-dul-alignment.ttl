# ----------------------------------------------------------------------
# Divergences of the replicas from DUL (axiom annotations)
# ----------------------------------------------------------------------

[] a owl:Axiom ;
    owl:annotatedSource top:Collection ;
    owl:annotatedProperty owl:equivalentClass ;
    owl:annotatedTarget dul:Collection ;
    rdfs:comment "top-level adds the restriction 'hasMember some Entity' (no empty collections)."@en .

[] a owl:Axiom ;
    owl:annotatedSource top:Concept ;
    owl:annotatedProperty owl:equivalentClass ;
    owl:annotatedTarget dul:Concept ;
    rdfs:comment "DUL's existential restrictions 'isDefinedIn some Description' are not replicated: combined, they make the reasoner build chains of anonymous individuals and slowed down reasoning about five times on the HACID modules. DUL's disjointness with InformationObject is not replicated (InformationObject is not replicated)."@en .

[] a owl:Axiom ;
    owl:annotatedSource top:Event ;
    owl:annotatedProperty owl:equivalentClass ;
    owl:annotatedTarget dul:Event ;
    rdfs:comment "DUL's existential restrictions 'hasParticipant some Object, hasTimeInterval some TimeInterval' are not replicated: combined, they make the reasoner build chains of anonymous individuals and slowed down reasoning about five times on the HACID modules."@en .

[] a owl:Axiom ;
    owl:annotatedSource top:Location ;
    owl:annotatedProperty owl:equivalentClass ;
    owl:annotatedTarget dul:Place ;
    rdfs:comment "Renamed: top:Location replicates dul:Place (same labels 'Place'@en / 'Luogo'@it, same superclass SocialObject)."@en .

[] a owl:Axiom ;
    owl:annotatedSource top:Object ;
    owl:annotatedProperty owl:equivalentClass ;
    owl:annotatedTarget dul:Object ;
    rdfs:comment "DUL's existential restrictions 'isParticipantIn some Event, hasLocation some Entity' are not replicated: combined, they make the reasoner build chains of anonymous individuals and slowed down reasoning about five times on the HACID modules. DUL's 'isClassifiedBy only Role' is not replicated either: HACID modules classify objects with concepts that are not roles (e.g. specialties, scenarios), and objects can be parametrised."@en .

[] a owl:Axiom ;
    owl:annotatedSource top:Organization ;
    owl:annotatedProperty owl:equivalentClass ;
    owl:annotatedTarget dul:Organization ;
    rdfs:comment "top-level adds disjointness with Person."@en .

[] a owl:Axiom ;
    owl:annotatedSource top:Parameter ;
    owl:annotatedProperty owl:equivalentClass ;
    owl:annotatedTarget dul:Parameter ;
    rdfs:comment "top-level adds Characteristic as superclass. DUL's 'classifies only Region' is not replicated, consistently with the widened range of parametrises."@en .

[] a owl:Axiom ;
    owl:annotatedSource top:Region ;
    owl:annotatedProperty owl:equivalentClass ;
    owl:annotatedTarget dul:Region ;
    rdfs:comment "top-level also places Region under FormalEntity. DUL's restriction 'overlaps only Region' is not replicated (overlaps is not replicated)."@en .

[] a owl:Axiom ;
    owl:annotatedSource top:Role ;
    owl:annotatedProperty owl:equivalentClass ;
    owl:annotatedTarget dul:Role ;
    rdfs:comment "DUL's 'classifies only Object' is not replicated, consistently with the widened domain of hasRole (roles are also assigned to non-objects, e.g. reified agent-role situations)."@en .

[] a owl:Axiom ;
    owl:annotatedSource top:SocialAgent ;
    owl:annotatedProperty owl:equivalentClass ;
    owl:annotatedTarget dul:SocialAgent ;
    rdfs:comment "DUL's restriction 'actsThrough some PhysicalAgent' is not replicated (actsThrough and PhysicalAgent are not replicated)."@en .

[] a owl:Axiom ;
    owl:annotatedSource top:SocialObject ;
    owl:annotatedProperty owl:equivalentClass ;
    owl:annotatedTarget dul:SocialObject ;
    rdfs:comment "DUL's restriction 'isExpressedBy some InformationObject' is not replicated (isExpressedBy and InformationObject are not replicated)."@en .

[] a owl:Axiom ;
    owl:annotatedSource top:TimeInterval ;
    owl:annotatedProperty owl:equivalentClass ;
    owl:annotatedTarget dul:TimeInterval ;
    rdfs:comment "top-level places TimeInterval under the novel class Interval (a Region delimited by a lower and an upper boundary; startTime/endTime specialise its boundary values lowerBoundaryValue/upperBoundaryValue) and under the novel class TemporalEntity, and adds startTime/endTime restrictions."@en .

[] a owl:Axiom ;
    owl:annotatedSource top:hasMember ;
    owl:annotatedProperty owl:equivalentProperty ;
    owl:annotatedTarget dul:hasMember ;
    rdfs:comment "top-level adds the super-property top:isCollectionOf."@en .

[] a owl:Axiom ;
    owl:annotatedSource top:hasRole ;
    owl:annotatedProperty owl:equivalentProperty ;
    owl:annotatedTarget dul:hasRole ;
    rdfs:comment "top-level widens the domain from Object to Entity."@en .

[] a owl:Axiom ;
    owl:annotatedSource top:includesEvent ;
    owl:annotatedProperty owl:equivalentProperty ;
    owl:annotatedTarget dul:includesEvent ;
    rdfs:comment "top-level does not replicate the inverse property dul:isEventIncludedIn."@en .

[] a owl:Axiom ;
    owl:annotatedSource top:includesObject ;
    owl:annotatedProperty owl:equivalentProperty ;
    owl:annotatedTarget dul:includesObject ;
    rdfs:comment "top-level does not replicate the inverse property dul:isObjectIncludedIn."@en .

[] a owl:Axiom ;
    owl:annotatedSource top:isMemberOf ;
    owl:annotatedProperty owl:equivalentProperty ;
    owl:annotatedTarget dul:isMemberOf ;
    rdfs:comment "top-level adds the super-property top:hasCollection."@en .

[] a owl:Axiom ;
    owl:annotatedSource top:isParametrisedBy ;
    owl:annotatedProperty owl:equivalentProperty ;
    owl:annotatedTarget dul:isParametrizedBy ;
    rdfs:comment "Renamed (British spelling of dul:isParametrizedBy). top-level widens the domain from Region to Entity, so that any entity can be parametrised."@en .

[] a owl:Axiom ;
    owl:annotatedSource top:isProperPartOf ;
    owl:annotatedProperty owl:equivalentProperty ;
    owl:annotatedTarget dul:isPropertPartOf ;
    rdfs:comment "Renamed: DUL's IRI carries a typo (isPropertPartOf)."@en .

[] a owl:Axiom ;
    owl:annotatedSource top:isRoleOf ;
    owl:annotatedProperty owl:equivalentProperty ;
    owl:annotatedTarget dul:isRoleOf ;
    rdfs:comment "top-level widens the range from Object to Entity."@en .

[] a owl:Axiom ;
    owl:annotatedSource top:isSpecializedBy ;
    owl:annotatedProperty owl:equivalentProperty ;
    owl:annotatedTarget dul:isSpecializedBy ;
    rdfs:comment "top-level adds the super-property top:isSpecialisedBy (same relation with domain and range widened to Entity)."@en .

[] a owl:Axiom ;
    owl:annotatedSource top:parametrises ;
    owl:annotatedProperty owl:equivalentProperty ;
    owl:annotatedTarget dul:parametrizes ;
    rdfs:comment "Renamed (British spelling of dul:parametrizes). top-level widens the range from Region to Entity, so that any entity can be parametrised."@en .

[] a owl:Axiom ;
    owl:annotatedSource top:specializes ;
    owl:annotatedProperty owl:equivalentProperty ;
    owl:annotatedTarget dul:specializes ;
    rdfs:comment "top-level adds the super-property top:specialises (same relation with domain and range widened to Entity)."@en .
