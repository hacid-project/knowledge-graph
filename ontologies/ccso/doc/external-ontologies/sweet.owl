        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropfr:Bioavailability</metadata:prefixIRI>
        <rdfs:label xml:lang="en">bioavailability</rdfs:label>
    </owl:Class>
    


