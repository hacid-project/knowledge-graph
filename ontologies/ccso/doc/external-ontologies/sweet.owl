    </owl:Class>
    


    <!-- http://sweetontology.net/realmOceanFloor/DeepSeaTrench -->

    <owl:Class rdf:about="http://sweetontology.net/realmOceanFloor/DeepSeaTrench">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandFluvial/Trench"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOceanFloor/OceanFloor"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOceanFloor/SeaFloor"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOceanFloor/Seabed"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaofl:DeepSeaTrench</metadata:prefixIRI>
        <rdfs:label xml:lang="en">deep sea trench</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOceanFloor/Guyot -->

    <owl:Class rdf:about="http://sweetontology.net/realmOceanFloor/Guyot">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOceanFloor/Seamount"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaofl:Guyot</metadata:prefixIRI>
        <rdfs:label xml:lang="en">guyot</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOceanFloor/HydrothermalVent -->

    <owl:Class rdf:about="http://sweetontology.net/realmOceanFloor/HydrothermalVent">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandVolcanic/Geyser"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOceanFloor/OceanFloor"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOceanFloor/SeaFloor"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOceanFloor/Seabed"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaofl:HydrothermalVent</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A hydrothermal vent is a fissure in a planet&apos;s surface from which geothermally heated water issues. Hydrothermal vents are commonly found near volcanically active places, areas where tectonic plates are moving apart, ocean basins, and hotspots.</rdfs:comment>
        <rdfs:label xml:lang="en">hydrothermal vent</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOceanFloor/MidOceanRidge -->

    <owl:Class rdf:about="http://sweetontology.net/realmOceanFloor/MidOceanRidge">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOceanFloor/OceanRidge"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaofl:MidOceanRidge</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A mid-ocean ridge or mid-oceanic ridge is an underwater mountain range, formed by plate tectonics. This uplifting of the ocean floor occurs when convection currents rise in the mantle beneath the oceanic crust and create magma where two tectonic plates meet at a divergent boundary. The mid-ocean ridges of the world are connected and form a single global mid-oceanic ridge system that is part of every ocean, making the mid-oceanic ridge system the longest mountain range in the world.</rdfs:comment>
        <rdfs:label xml:lang="en">mid ocean ridge</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOceanFloor/OceanFloor -->

    <owl:Class rdf:about="http://sweetontology.net/realmOceanFloor/OceanFloor">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmOceanFloor/SeaFloor"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmHydroBody/CarbonateCompensationLevel"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmHydroBody/WaterBodyBoundary"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaofl:OceanFloor</metadata:prefixIRI>
        <rdfs:label xml:lang="en">ocean floor</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOceanFloor/OceanRidge -->

    <owl:Class rdf:about="http://sweetontology.net/realmOceanFloor/OceanRidge">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandOrographic/Ridge"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOceanFloor/OceanFloor"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOceanFloor/SeaFloor"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOceanFloor/Seabed"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaofl:OceanRidge</metadata:prefixIRI>
        <rdfs:label xml:lang="en">ocean ridge</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOceanFloor/OceanicPlateau -->

    <owl:Class rdf:about="http://sweetontology.net/realmOceanFloor/OceanicPlateau">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOceanFloor/OceanRidge"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaofl:OceanicPlateau</metadata:prefixIRI>
        <rdfs:label xml:lang="en">oceanic plateau</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOceanFloor/Reef -->

    <owl:Class rdf:about="http://sweetontology.net/realmOceanFloor/Reef">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOceanFloor/OceanRidge"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaofl:Reef</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">In nautical terminology, a reef is a rock, sandbar, or other feature lying beneath the surface of the water yet shallow enough to be a hazard to ships. Many reefs result from abiotic processes—deposition of sand, wave erosion planning down rock outcrops, and other natural processes—but the best-known reefs are the coral reefs of tropical waters developed through biotic processes dominated by corals and calcareous algae</rdfs:comment>
        <rdfs:label xml:lang="en">reef</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOceanFloor/SeaFloor -->

    <owl:Class rdf:about="http://sweetontology.net/realmOceanFloor/SeaFloor">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmOceanFloor/Seabed"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmHydroBody/CarbonateCompensationLevel"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmHydroBody/WaterBodyBoundary"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaofl:SeaFloor</metadata:prefixIRI>
        <rdfs:label xml:lang="en">sea floor</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOceanFloor/Seabed -->

    <owl:Class rdf:about="http://sweetontology.net/realmOceanFloor/Seabed">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmHydroBody/CarbonateCompensationLevel"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmHydroBody/WaterBodyBoundary"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaofl:Seabed</metadata:prefixIRI>
        <rdfs:label xml:lang="en">seabed</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOceanFloor/Seamount -->

    <owl:Class rdf:about="http://sweetontology.net/realmOceanFloor/Seamount">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandOrographic/Mountain"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandOrographic/Orographic"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandOrographic/Orography"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRealm"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmOceanFloor/SeaFloor"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaofl:Seamount</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A seamount is a mountain rising from the ocean seafloor that does not reach to the water&apos;s surface (sea level), and thus is not an island. These are typically formed from extinct volcanoes, that rise abruptly and are usually found rising from a seafloor of 1,000 - 4,000 meters depth. They are defined by oceanographers as independent features that rise to at least 1,000 meters above the seafloor. The peaks are often found hundreds to thousands of meters below the surface, and are therefore considered to be within the deep sea.[1] An estimated 30,000 seamounts occur across the globe, with only a few having been studied. However, some seamounts are also unusual.</rdfs:comment>
        <rdfs:label xml:lang="en">seamount</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOceanFloor/SubmarineCanyon -->

    <owl:Class rdf:about="http://sweetontology.net/realmOceanFloor/SubmarineCanyon">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandFluvial/Canyon"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRealm"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmOceanFloor/SeaFloor"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaofl:SubmarineCanyon</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A submarine canyon is a steep-sided valley on the sea floor of the continental slope. Many submarine canyons are found as extensions to large rivers; however there are many that have no such association. Canyons cutting the continental slopes have been found at depths greater than 2 km below sea level. They are formed by powerful turbidity currents, volcanic and earthquake activity. Many submarine canyons continue as submarine channels across continental rise areas and may extend for hundreds of kilometers.</rdfs:comment>
        <rdfs:label xml:lang="en">submarine canyon</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmRegion/Austral -->

    <owl:Class rdf:about="http://sweetontology.net/realmRegion/Austral">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmRegion/SouthLatitudeBand"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorear:Austral</metadata:prefixIRI>
        <rdfs:label xml:lang="en">austral</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmRegion/Borealis -->

    <owl:Class rdf:about="http://sweetontology.net/realmRegion/Borealis">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmRegion/NorthLatitudeBand"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorear:Borealis</metadata:prefixIRI>
        <rdfs:label xml:lang="en">borealis</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmRegion/LatitudeBand -->

    <owl:Class rdf:about="http://sweetontology.net/realmRegion/LatitudeBand">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/PhysicalQuantity"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprSpaceGeometry/Region"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/degrees"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorear:LatitudeBand</metadata:prefixIRI>
        <rdfs:label xml:lang="en">latitude band</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmRegion/LatitudeLine -->

    <owl:Class rdf:about="http://sweetontology.net/realmRegion/LatitudeLine">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/PhysicalQuantity"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprSpaceGeometry/Region"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/degrees"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorear:LatitudeLine</metadata:prefixIRI>
        <rdfs:label xml:lang="en">latitude line</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmRegion/NorthLatitudeBand -->

    <owl:Class rdf:about="http://sweetontology.net/realmRegion/NorthLatitudeBand">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmRegion/LatitudeBand"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/hasLowerBound"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorear:NorthLatitudeBand</metadata:prefixIRI>
        <rdfs:label xml:lang="en">north latitude band</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmRegion/NorthLatitudeLine -->

    <owl:Class rdf:about="http://sweetontology.net/realmRegion/NorthLatitudeLine">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmRegion/LatitudeLine"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorear:NorthLatitudeLine</metadata:prefixIRI>
        <rdfs:label xml:lang="en">north latitude line</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmRegion/NorthernHemisphere -->

    <owl:Class rdf:about="http://sweetontology.net/realmRegion/NorthernHemisphere">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmRegion/NorthLatitudeBand"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/hasUpperBound"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">90</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorear:NorthernHemisphere</metadata:prefixIRI>
        <rdfs:label xml:lang="en">northern hemisphere</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmRegion/SouthLatitudeBand -->

    <owl:Class rdf:about="http://sweetontology.net/realmRegion/SouthLatitudeBand">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmRegion/LatitudeBand"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/hasUpperBound"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorear:SouthLatitudeBand</metadata:prefixIRI>
        <rdfs:label xml:lang="en">south latitude band</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmRegion/SouthLatitudeLine -->

    <owl:Class rdf:about="http://sweetontology.net/realmRegion/SouthLatitudeLine">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmRegion/LatitudeLine"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorear:SouthLatitudeLine</metadata:prefixIRI>
        <rdfs:label xml:lang="en">south latitude line</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmRegion/SouthernHemisphere -->

    <owl:Class rdf:about="http://sweetontology.net/realmRegion/SouthernHemisphere">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmRegion/SouthLatitudeBand"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/hasLowerBound"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-90</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorear:SouthernHemisphere</metadata:prefixIRI>
        <rdfs:label xml:lang="en">southern hemisphere</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmSoil/A_Horizon -->

    <owl:Class rdf:about="http://sweetontology.net/realmSoil/A_Horizon">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmSoil/Topsoil"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmSoil/SoilLayer"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreas:A_Horizon</metadata:prefixIRI>
        <rdfs:label xml:lang="en">a horizon</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmSoil/ActiveLayer -->

    <owl:Class rdf:about="http://sweetontology.net/realmSoil/ActiveLayer">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmSoil/SoilLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/partOf"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/realmSoil/Permafrost"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreas:ActiveLayer</metadata:prefixIRI>
        <rdfs:label xml:lang="en">active layer</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmSoil/Alfisol -->

    <owl:Class rdf:about="http://sweetontology.net/realmSoil/Alfisol">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmSoil/SoilOrder"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreas:Alfisol</metadata:prefixIRI>
        <rdfs:label xml:lang="en">alfisol</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmSoil/Andisol -->

    <owl:Class rdf:about="http://sweetontology.net/realmSoil/Andisol">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmSoil/SoilOrder"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreas:Andisol</metadata:prefixIRI>
        <rdfs:label xml:lang="en">andisol</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmSoil/Aridisol -->

    <owl:Class rdf:about="http://sweetontology.net/realmSoil/Aridisol">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmSoil/SoilOrder"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreas:Aridisol</metadata:prefixIRI>
        <rdfs:label xml:lang="en">aridisol</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmSoil/B_Horizon -->

    <owl:Class rdf:about="http://sweetontology.net/realmSoil/B_Horizon">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmSoil/Subsoil"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmSoil/SoilLayer"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreas:B_Horizon</metadata:prefixIRI>
        <rdfs:label xml:lang="en">b horizon</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmSoil/C_Horizon -->

    <owl:Class rdf:about="http://sweetontology.net/realmSoil/C_Horizon">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmSoil/ParentRock"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmSoil/SoilLayer"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreas:C_Horizon</metadata:prefixIRI>
        <rdfs:label xml:lang="en">c horizon</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmSoil/Cryosol -->

    <owl:Class rdf:about="http://sweetontology.net/realmSoil/Cryosol">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmSoil/Gelisol"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmSoil/SoilOrder"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreas:Cryosol</metadata:prefixIRI>
        <rdfs:label xml:lang="en">cryosol</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmSoil/Entisol -->

    <owl:Class rdf:about="http://sweetontology.net/realmSoil/Entisol">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmSoil/SoilOrder"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreas:Entisol</metadata:prefixIRI>
        <rdfs:label xml:lang="en">entisol</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmSoil/Gelisol -->

    <owl:Class rdf:about="http://sweetontology.net/realmSoil/Gelisol">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmSoil/SoilOrder"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasProcess"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenMixing/Cryoturbation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreas:Gelisol</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Gelisols are soils of very cold climates which are defined as containing permafrost within two metres of the soil surface. The word Gelisol comes from the Latin gelare meaning to freeze, a reference to the process of cryoturbation that occurs from the alternating thawing and freezing characteristic of Gelisols.</rdfs:comment>
        <rdfs:label xml:lang="en">gelisol</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmSoil/Ground -->

    <owl:Class rdf:about="http://sweetontology.net/realmSoil/Ground">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmSoil/SoilLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasState"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/Solid"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreas:Ground</metadata:prefixIRI>
        <rdfs:label xml:lang="en">ground</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmSoil/Histisol -->

    <owl:Class rdf:about="http://sweetontology.net/realmSoil/Histisol">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmSoil/SoilOrder"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreas:Histisol</metadata:prefixIRI>
        <rdfs:label xml:lang="en">histisol</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmSoil/Inceptisol -->

    <owl:Class rdf:about="http://sweetontology.net/realmSoil/Inceptisol">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmSoil/SoilOrder"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreas:Inceptisol</metadata:prefixIRI>
        <rdfs:label xml:lang="en">inceptisol</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmSoil/Mollisol -->

    <owl:Class rdf:about="http://sweetontology.net/realmSoil/Mollisol">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmSoil/SoilOrder"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreas:Mollisol</metadata:prefixIRI>
        <rdfs:label xml:lang="en">mollisol</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmSoil/O_Horizon -->

    <owl:Class rdf:about="http://sweetontology.net/realmSoil/O_Horizon">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmSoil/OrganicMatter"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmSoil/SoilLayer"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreas:O_Horizon</metadata:prefixIRI>
        <rdfs:label xml:lang="en">o horizon</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmSoil/OrganicMatter -->

    <owl:Class rdf:about="http://sweetontology.net/realmSoil/OrganicMatter">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmSoil/SoilLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/above"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/realmSoil/P_Horizon"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/above"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/realmSoil/Topsoil"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreas:OrganicMatter</metadata:prefixIRI>
        <rdfs:label xml:lang="en">organic matter</rdfs:label>
    </owl:Class>
    


