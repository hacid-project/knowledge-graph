    <!-- http://sweetontology.net/matrParticle/Nucleon -->

    <owl:Class rdf:about="http://sweetontology.net/matrParticle/Nucleon">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://sweetontology.net/matrParticle/Neutron"/>
                    <rdf:Description rdf:about="http://sweetontology.net/matrParticle/Proton"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somapa:Nucleon</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A collective name for the two baryons: neutron and the proton.</rdfs:comment>
        <rdfs:label xml:lang="en">nucleon</rdfs:label>
    </owl:Class>
    


