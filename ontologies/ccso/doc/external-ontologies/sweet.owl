    </owl:Class>
    


    <!-- http://sweetontology.net/phenSolid/Earthy -->

    <owl:Class rdf:about="http://sweetontology.net/phenSolid/Earthy">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenSolid/Fracture"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophso:Earthy</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">a fracture that produces a texture similar to broken children&apos;s clay. It is found in minerals that are generally massive and loosely consolidated.</rdfs:comment>
        <rdfs:label xml:lang="en">earthy</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenSolid/Elongate -->

    <owl:Class rdf:about="http://sweetontology.net/phenSolid/Elongate">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/phenSolid/Stretch"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenSolid/SolidPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophso:Elongate</metadata:prefixIRI>
        <rdfs:label xml:lang="en">elongate</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenSolid/Elongation -->

    <owl:Class rdf:about="http://sweetontology.net/phenSolid/Elongation">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/phenSolid/Stretch"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenSolid/SolidPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophso:Elongation</metadata:prefixIRI>
        <rdfs:label xml:lang="en">elongation</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenSolid/Erode -->

    <owl:Class rdf:about="http://sweetontology.net/phenSolid/Erode">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/phenSolid/Erosion"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenSolid/SolidPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophso:Erode</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Erosion is displacement of solids (soil, mud, rock and other particles) usually by the agents of currents such as, wind, water, or ice by downward or down-slope movement in response to gravity or by living organisms (in the case of bioerosion).</rdfs:comment>
        <rdfs:label xml:lang="en">erode</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenSolid/Erosion -->

    <owl:Class rdf:about="http://sweetontology.net/phenSolid/Erosion">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenSolid/SolidPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophso:Erosion</metadata:prefixIRI>
        <rdfs:label xml:lang="en">erosion</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenSolid/Extension -->

    <owl:Class rdf:about="http://sweetontology.net/phenSolid/Extension">
