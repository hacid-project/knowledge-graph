    <!-- http://sweetontology.net/humanEnvirControl/SecondaryTreatment -->

    <owl:Class rdf:about="http://sweetontology.net/humanEnvirControl/SecondaryTreatment">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/humanEnvirControl/WaterTreatmentProcess"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sohueccont:SecondaryTreatment</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">In wastewater treatment, a combination of step processes, usually biochemical in nature, that are designed to remove primarily organic material. Examples of process steps are aeration and trickling filters.</rdfs:comment>
        <rdfs:label xml:lang="en">secondary treatment</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/humanEnvirControl/Sequester -->

    <owl:Class rdf:about="http://sweetontology.net/humanEnvirControl/Sequester">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/humanEnvirControl/EnvironmentalControlStrategy"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sohueccont:Sequester</metadata:prefixIRI>
        <rdfs:label xml:lang="en">sequester</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/humanEnvirControl/StateImplementationPlan -->

    <owl:Class rdf:about="http://sweetontology.net/humanEnvirControl/StateImplementationPlan">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/humanEnvirControl/EnvironmentalControlStrategy"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sohueccont:StateImplementationPlan</metadata:prefixIRI>
        <rdfs:label xml:lang="en">state implementation plan</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/humanEnvirControl/TertiaryTreatment -->

    <owl:Class rdf:about="http://sweetontology.net/humanEnvirControl/TertiaryTreatment">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/humanEnvirControl/WaterTreatmentProcess"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sohueccont:TertiaryTreatment</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Post-secondary treatment of wastewater designed to improve the quality of the water to the point where it can be put to a particular beneficial use. Generally, tertiary treatment steps remove nutrients (e.g., nitrogen and phosphorus) which are poorly removed by secondary treatment. Commonly used steps include coagulation and clarification.</rdfs:comment>
        <rdfs:label xml:lang="en">tertiary treatment</rdfs:label>
    </owl:Class>
    


