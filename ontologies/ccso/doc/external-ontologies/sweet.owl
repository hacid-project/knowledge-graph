    <!-- http://sweetontology.net/repr/D -->

    <owl:Class rdf:about="http://sweetontology.net/repr/D">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/repr/Representation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/hasDimension"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/hasDimension"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/hasDimension"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorep:D</metadata:prefixIRI>
    </owl:Class>
    


    <!-- http://sweetontology.net/repr/DependentVariable -->

    <owl:Class rdf:about="http://sweetontology.net/repr/DependentVariable">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprMath/Variable"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorep:DependentVariable</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Any variable considered as a function of other variables, the latter being called independent.</rdfs:comment>
        <rdfs:label xml:lang="en">dependent variable</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/repr/Dimension -->

    <owl:Class rdf:about="http://sweetontology.net/repr/Dimension">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/repr/Representation"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorep:Dimension</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">In common usage, a dimension is a parameter or measurement used to describe some relevant characteristic of an object. The most commonly used dimensions are the parameters describing the size of an object: length, width, and height, but dimensions can also be other physical parameters such as the mass and electric charge of an object, or even, in a context where cost is relevant, an economic parameter such as its price.</rdfs:comment>
        <rdfs:label xml:lang="en">dimension</rdfs:label>
    </owl:Class>
    


