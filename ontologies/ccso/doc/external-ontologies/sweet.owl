        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrWater/SaltWater"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somaw:SeaWater</metadata:prefixIRI>
        <rdfs:label xml:lang="en">sea water</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrWater/Sewage -->

    <owl:Class rdf:about="http://sweetontology.net/matrWater/Sewage">
