        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreah:PotentiometricSurface</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">An imaginary surface representing the static head of groundwater and defined by the level to which water will rise in a tightly cased well.</rdfs:comment>
        <rdfs:label xml:lang="en">potentiometric surface</rdfs:label>
    </owl:Class>
    


