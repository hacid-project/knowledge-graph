        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropti:TimeInterval</metadata:prefixIRI>
        <rdfs:label xml:lang="en">time interval</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTime/TimePeriod -->

    <owl:Class rdf:about="http://sweetontology.net/propTime/TimePeriod">
