        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropm:Dosage</metadata:prefixIRI>
        <rdfs:label xml:lang="en">dosage</rdfs:label>
    </owl:Class>
    


