        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/Potential"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/VectorQuantity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropq:VectorPotential</metadata:prefixIRI>
        <rdfs:label xml:lang="en">vector potential</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propQuantity/VectorQuantity -->

    <owl:Class rdf:about="http://sweetontology.net/propQuantity/VectorQuantity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/ScientificQuantity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropq:VectorQuantity</metadata:prefixIRI>
