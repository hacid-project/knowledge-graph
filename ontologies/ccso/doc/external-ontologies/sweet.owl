        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOceanFloor/SeaFloor"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOceanFloor/Seabed"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaofl:ContinentalRise</metadata:prefixIRI>
        <rdfs:label xml:lang="en">continental rise</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOceanFloor/ContinentalShelf -->

    <owl:Class rdf:about="http://sweetontology.net/realmOceanFloor/ContinentalShelf">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOceanFloor/OceanFloor"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOceanFloor/SeaFloor"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOceanFloor/Seabed"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaofl:ContinentalShelf</metadata:prefixIRI>
        <rdfs:label xml:lang="en">continental shelf</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOceanFloor/ContinentalSlope -->

    <owl:Class rdf:about="http://sweetontology.net/realmOceanFloor/ContinentalSlope">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOceanFloor/OceanFloor"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOceanFloor/SeaFloor"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOceanFloor/Seabed"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaofl:ContinentalSlope</metadata:prefixIRI>
        <rdfs:label xml:lang="en">continental slope</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOceanFloor/DeepOceanBasin -->

    <owl:Class rdf:about="http://sweetontology.net/realmOceanFloor/DeepOceanBasin">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOceanFloor/OceanFloor"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOceanFloor/SeaFloor"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmOceanFloor/Seabed"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaofl:DeepOceanBasin</metadata:prefixIRI>
