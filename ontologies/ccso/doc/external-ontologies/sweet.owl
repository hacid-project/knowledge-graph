        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropfr:AirSpaceRatio</metadata:prefixIRI>
        <rdfs:label xml:lang="en">air space ratio</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propFraction/Albedo -->

    <owl:Class rdf:about="http://sweetontology.net/propFraction/Albedo">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propFraction/FractionalQuantity"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/RadiationMediumInteractionQuantity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropfr:Albedo</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The ratio of reflected flux density to incident flux density, referenced to some surface.</rdfs:comment>
