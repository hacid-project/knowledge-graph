        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procChemical/Reaction"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprocc:Reduction</metadata:prefixIRI>
        <rdfs:label xml:lang="en">reduction</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/procChemical/Solvation -->

    <owl:Class rdf:about="http://sweetontology.net/procChemical/Solvation">
