        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophm:Separation</metadata:prefixIRI>
        <rdfs:label xml:lang="en">separation</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenMixing/Settling -->

