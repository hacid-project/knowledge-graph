        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprSciLaw/EmpiricalLaw"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorepsl:HookesLaw</metadata:prefixIRI>
