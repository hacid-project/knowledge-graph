        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/Substance"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasState"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/Ionized"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somaio:Ion</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">An ion is an atom or molecule where the total number of electrons is not equal to the total number of protons, giving it a net positive or negative electrical charge. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">ion</rdfs:label>
    </owl:Class>
    


