        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sostst:FujitaPearsonScale</metadata:prefixIRI>
        <rdfs:label xml:lang="en">fujita pearson scale</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/stateStorm/HurricaneScale -->

    <owl:Class rdf:about="http://sweetontology.net/stateStorm/HurricaneScale">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/stateStorm/WindScale"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenAtmoPrecipitation/Hurricane"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sostst:HurricaneScale</metadata:prefixIRI>
        <rdfs:label xml:lang="en">hurricane scale</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/stateStorm/SaffirSimpsonScale -->

    <owl:Class rdf:about="http://sweetontology.net/stateStorm/SaffirSimpsonScale">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/stateStorm/HurricaneScale"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sostst:SaffirSimpsonScale</metadata:prefixIRI>
        <rdfs:label xml:lang="en">saffir simpson scale</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/stateStorm/TornadoScale -->

    <owl:Class rdf:about="http://sweetontology.net/stateStorm/TornadoScale">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/stateStorm/WindScale"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenAtmoPrecipitation/Tornado"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sostst:TornadoScale</metadata:prefixIRI>
        <rdfs:label xml:lang="en">tornado scale</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/stateStorm/WindScale -->

    <owl:Class rdf:about="http://sweetontology.net/stateStorm/WindScale">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/repr/OrdinalScale"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/measureOf"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenAtmoWind/Wind"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sostst:WindScale</metadata:prefixIRI>
        <rdfs:label xml:lang="en">wind scale</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/stateSystem/Coherent -->

    <owl:Class rdf:about="http://sweetontology.net/stateSystem/Coherent">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/stateSystem/SystemState"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sostsy:Coherent</metadata:prefixIRI>
        <rdfs:label xml:lang="en">coherent</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/stateSystem/Complex -->

    <owl:Class rdf:about="http://sweetontology.net/stateSystem/Complex">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/stateSystem/SystemState"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sostsy:Complex</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A complex system is a system composed of interconnected parts that as a whole exhibit one or more properties (behavior among the possible properties) not obvious from the properties</rdfs:comment>
        <rdfs:label xml:lang="en">complex</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/stateSystem/Deficit -->

    <owl:Class rdf:about="http://sweetontology.net/stateSystem/Deficit">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/stateSystem/SystemState"/>
        <owl:disjointWith rdf:resource="http://sweetontology.net/stateSystem/Excess"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sostsy:Deficit</metadata:prefixIRI>
        <rdfs:label xml:lang="en">deficit</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/stateSystem/EquilibriumState -->

    <owl:Class rdf:about="http://sweetontology.net/stateSystem/EquilibriumState">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/stateSystem/SystemState"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasState"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/stateSystem/Equilibrium"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sostsy:EquilibriumState</metadata:prefixIRI>
        <rdfs:label xml:lang="en">equilibrium state</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/stateSystem/Excess -->

    <owl:Class rdf:about="http://sweetontology.net/stateSystem/Excess">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/stateSystem/SystemState"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sostsy:Excess</metadata:prefixIRI>
        <rdfs:label xml:lang="en">excess</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/stateSystem/Homeostasis -->

    <owl:Class rdf:about="http://sweetontology.net/stateSystem/Homeostasis">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/stateSystem/SystemState"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sostsy:Homeostasis</metadata:prefixIRI>
        <rdfs:label xml:lang="en">homeostasis</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/stateSystem/Instability -->

    <owl:Class rdf:about="http://sweetontology.net/stateSystem/Instability">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/stateSystem/Unstable"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/stateSystem/SystemState"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sostsy:Instability</metadata:prefixIRI>
        <rdfs:label xml:lang="en">instability</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/stateSystem/Overflow -->

    <owl:Class rdf:about="http://sweetontology.net/stateSystem/Overflow">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/stateSystem/SystemState"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sostsy:Overflow</metadata:prefixIRI>
        <rdfs:label xml:lang="en">overflow</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/stateSystem/Resilient -->

    <owl:Class rdf:about="http://sweetontology.net/stateSystem/Resilient">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/stateSystem/SystemState"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sostsy:Resilient</metadata:prefixIRI>
        <rdfs:label xml:lang="en">resilient</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/stateSystem/Stability -->

    <owl:Class rdf:about="http://sweetontology.net/stateSystem/Stability">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/stateSystem/Stable"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/stateSystem/SystemState"/>
        <owl:disjointWith rdf:resource="http://sweetontology.net/stateSystem/Unstable"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sostsy:Stability</metadata:prefixIRI>
        <rdfs:label xml:lang="en">stability</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/stateSystem/Stable -->

    <owl:Class rdf:about="http://sweetontology.net/stateSystem/Stable">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/stateSystem/SystemState"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sostsy:Stable</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The characteristic of a system if sufficiently small disturbances have only small effects, either decreasing in amplitude or oscillating periodically; it is asymptotically stable if the effect of small disturbances vanishes for long time periods.</rdfs:comment>
        <rdfs:label xml:lang="en">stable</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/stateSystem/SystemState -->

    <owl:Class rdf:about="http://sweetontology.net/stateSystem/SystemState">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/state/State"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sostsy:SystemState</metadata:prefixIRI>
        <rdfs:label xml:lang="en">system state</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/stateSystem/Unstable -->

    <owl:Class rdf:about="http://sweetontology.net/stateSystem/Unstable">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/stateSystem/SystemState"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sostsy:Unstable</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">property describing unstable conditions, such as in the atmosphere</rdfs:comment>
        <rdfs:label xml:lang="en">unstable</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/stateThermodynamic/ThermodynamicState -->

    <owl:Class rdf:about="http://sweetontology.net/stateThermodynamic/ThermodynamicState">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/statePhysical/PhysicalState"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sostth:ThermodynamicState</metadata:prefixIRI>
        <rdfs:label xml:lang="en">thermodynamic state</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/stateTime/Age -->

    <owl:Class rdf:about="http://sweetontology.net/stateTime/Age">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/stateTime/GeologicTimeUnit"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaTime/temporalPartOf"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/stateTime/Epoch"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sostti:Age</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Epochs are divided into ages [millions of years] [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">age</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/stateTime/Eon -->

    <owl:Class rdf:about="http://sweetontology.net/stateTime/Eon">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/stateTime/GeologicTimeUnit"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaTime/temporalPartOf"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/stateTime/Supereon"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sostti:Eon</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Supereons are divided into eons.  [billions of years] [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">eon</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/stateTime/Epoch -->

    <owl:Class rdf:about="http://sweetontology.net/stateTime/Epoch">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/stateTime/GeologicTimeUnit"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaTime/temporalPartOf"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/stateTime/Period"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sostti:Epoch</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Periods are divided into epochs [tens of millions of years] [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">epoch</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/stateTime/Era -->

    <owl:Class rdf:about="http://sweetontology.net/stateTime/Era">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/stateTime/GeologicTimeUnit"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaTime/temporalPartOf"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/stateTime/Eon"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sostti:Era</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Eons are divided into eras [several hundred million years] [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">era</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/stateTime/GeologicTimeUnit -->

    <owl:Class rdf:about="http://sweetontology.net/stateTime/GeologicTimeUnit">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTime/Duration"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTime/DurationDescription"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTime/TimeInterval"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sostti:GeologicTimeUnit</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The subdivisions of geologic time. The table of geologic time spans are dates and nomenclature defined by the International Commission on Stratigraphy. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">geologic time unit</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/stateTime/NeotectonicPeriod -->

    <owl:Class rdf:about="http://sweetontology.net/stateTime/NeotectonicPeriod">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprTime/TemporalReference"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprTime/TimeReference"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sostti:NeotectonicPeriod</metadata:prefixIRI>
        <rdfs:label xml:lang="en">neotectonic period</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/stateTime/Period -->

    <owl:Class rdf:about="http://sweetontology.net/stateTime/Period">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/stateTime/GeologicTimeUnit"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaTime/temporalPartOf"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/stateTime/Era"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sostti:Period</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Eras are divided into periods. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">period</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/stateTime/Supereon -->

    <owl:Class rdf:about="http://sweetontology.net/stateTime/Supereon">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/stateTime/GeologicTimeUnit"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sostti:Supereon</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The largest defined unit of time is the supereon, composed of eons.] [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">supereon</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/stateTimeCycle/ElNino -->

    <owl:Class rdf:about="http://sweetontology.net/stateTimeCycle/ElNino">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/stateTimeCycle/OscillationState"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/maximumOf"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/phenCycle/ENSO"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sosttc:ElNino</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A significant increase in sea surface temperature over the eastern and central equatorial Pacific that occurs at irregular intervals, generally ranging between two and seven years.</rdfs:comment>
        <rdfs:label xml:lang="en">el nino</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/stateTimeCycle/HighTide -->

    <owl:Class rdf:about="http://sweetontology.net/stateTimeCycle/HighTide">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/stateTimeCycle/OscillationState"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/maximumOf"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/phenCycle/Tide"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sosttc:HighTide</metadata:prefixIRI>
        <rdfs:label xml:lang="en">high tide</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/stateTimeCycle/IceAge -->

    <owl:Class rdf:about="http://sweetontology.net/stateTimeCycle/IceAge">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/stateTimeCycle/OscillationState"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/maximumOf"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/phenCycle/IceAgeCycle"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sosttc:IceAge</metadata:prefixIRI>
        <rdfs:label xml:lang="en">ice age</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/stateTimeCycle/Interglacial -->

    <owl:Class rdf:about="http://sweetontology.net/stateTimeCycle/Interglacial">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/stateTimeCycle/OscillationState"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/minimumOf"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/phenCycle/IceAgeCycle"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sosttc:Interglacial</metadata:prefixIRI>
        <rdfs:label xml:lang="en">interglacial</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/stateTimeCycle/LaNina -->

    <owl:Class rdf:about="http://sweetontology.net/stateTimeCycle/LaNina">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/stateTimeCycle/OscillationState"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/minimumOf"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/phenCycle/ENSO"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sosttc:LaNina</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The most common of several names given toa significant decrease in sea surface temperature (‘cold events’) in the central and eastern equatorial Pacific.  La Nina is the counterpart to the El Nino ‘warm event,’ and its spatial and temporal evolution in the equatorial Pacific is, to a considerable extent, the mirror image of El Nino, although La Nina events tend to be somewhat less regular in their behavior and duration.</rdfs:comment>
        <rdfs:label xml:lang="en">la nina</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/stateTimeCycle/LowTide -->

    <owl:Class rdf:about="http://sweetontology.net/stateTimeCycle/LowTide">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/stateTimeCycle/OscillationState"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/minimumOf"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/phenCycle/Tide"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sosttc:LowTide</metadata:prefixIRI>
        <rdfs:label xml:lang="en">low tide</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/stateTimeCycle/MaunderMinimum -->

    <owl:Class rdf:about="http://sweetontology.net/stateTimeCycle/MaunderMinimum">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/stateTimeCycle/SolarMinimum"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sosttc:MaunderMinimum</metadata:prefixIRI>
        <rdfs:label xml:lang="en">maunder minimum</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/stateTimeCycle/NeapTide -->

    <owl:Class rdf:about="http://sweetontology.net/stateTimeCycle/NeapTide">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/stateTimeCycle/OscillationState"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/maximumOf"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/stateTimeCycle/LowTide"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/minimumOf"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/stateTimeCycle/HighTide"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sosttc:NeapTide</metadata:prefixIRI>
        <rdfs:label xml:lang="en">neap tide</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/stateTimeCycle/OscillationState -->

    <owl:Class rdf:about="http://sweetontology.net/stateTimeCycle/OscillationState">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/statePhysical/PhysicalState"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sosttc:OscillationState</metadata:prefixIRI>
        <rdfs:label xml:lang="en">oscillation state</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/stateTimeCycle/SolarMaximum -->

    <owl:Class rdf:about="http://sweetontology.net/stateTimeCycle/SolarMaximum">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/stateTimeCycle/OscillationState"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/maximumOf"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/phenCycle/SolarCycle"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sosttc:SolarMaximum</metadata:prefixIRI>
        <rdfs:label xml:lang="en">solar maximum</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/stateTimeCycle/SolarMinimum -->

    <owl:Class rdf:about="http://sweetontology.net/stateTimeCycle/SolarMinimum">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/stateTimeCycle/OscillationState"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/minimumOf"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/phenCycle/SolarCycle"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sosttc:SolarMinimum</metadata:prefixIRI>
        <rdfs:label xml:lang="en">solar minimum</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/stateTimeCycle/SpringTide -->

