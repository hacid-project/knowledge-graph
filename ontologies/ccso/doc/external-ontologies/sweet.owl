        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propFraction/FractionalQuantity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropfr:Refractivity</metadata:prefixIRI>
