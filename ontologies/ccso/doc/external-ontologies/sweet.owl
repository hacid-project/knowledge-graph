        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropfr:AvailableWaterCapacity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">available water capacity</rdfs:label>
    </owl:Class>
    


