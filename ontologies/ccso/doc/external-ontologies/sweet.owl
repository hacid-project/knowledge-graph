            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/hasDimension"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsdis:Length</metadata:prefixIRI>
        <rdfs:label xml:lang="en">length</rdfs:label>
    </owl:Class>
    


