    </owl:Class>
    


    <!-- http://sweetontology.net/realmHydro/SeepageFace -->

    <owl:Class rdf:about="http://sweetontology.net/realmHydro/SeepageFace">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/stateRoleGeographic/Boundary"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/stateRoleGeographic/Edge"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/stateRoleGeographic/Face"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreah:SeepageFace</metadata:prefixIRI>
        <rdfs:comment xml:lang="en"> A boundary between the saturated flow field and the atmosphere along which groundwater discharges, either by evaporation or movement ‘downhill’ along the land surface or in a well as a thin film in response to the force of gravity.</rdfs:comment>
        <rdfs:label xml:lang="en">seepage face</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmHydro/SurfaceWater -->

    <owl:Class rdf:about="http://sweetontology.net/realmHydro/SurfaceWater">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmHydro/HydrosphereFeature"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreah:SurfaceWater</metadata:prefixIRI>
        <rdfs:label xml:lang="en">surface water</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmHydro/UnconfinedAquifer -->

    <owl:Class rdf:about="http://sweetontology.net/realmHydro/UnconfinedAquifer">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmHydro/WaterTableAquifer"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmHydro/Aquifer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/hasSpatialConfiguration"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/stateSpaceConfiguration/Unconfined"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreah:UnconfinedAquifer</metadata:prefixIRI>
        <rdfs:label xml:lang="en">unconfined aquifer</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmHydro/UndergroundWater -->

    <owl:Class rdf:about="http://sweetontology.net/realmHydro/UndergroundWater">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrWater/Groundwater"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/inside"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmHydro/VadoseZone"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreah:UndergroundWater</metadata:prefixIRI>
        <rdfs:label xml:lang="en">underground water</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmHydro/UnsaturatedZone -->

    <owl:Class rdf:about="http://sweetontology.net/realmHydro/UnsaturatedZone">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmHydro/VadoseZone"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmHydro/HydrosphereFeature"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreah:UnsaturatedZone</metadata:prefixIRI>
        <rdfs:label xml:lang="en">unsaturated zone</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmHydro/VadoseZone -->

    <owl:Class rdf:about="http://sweetontology.net/realmHydro/VadoseZone">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmHydro/HydrosphereFeature"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreah:VadoseZone</metadata:prefixIRI>
        <rdfs:label xml:lang="en">vadose zone</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmHydro/WarmPool -->

    <owl:Class rdf:about="http://sweetontology.net/realmHydro/WarmPool">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmHydro/HydrosphereFeature"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreah:WarmPool</metadata:prefixIRI>
        <rdfs:label xml:lang="en">warm pool</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmHydro/WaterColumn -->

    <owl:Class rdf:about="http://sweetontology.net/realmHydro/WaterColumn">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmHydro/HydrosphereFeature"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreah:WaterColumn</metadata:prefixIRI>
        <rdfs:label xml:lang="en">water column</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmHydro/WaterTable -->

    <owl:Class rdf:about="http://sweetontology.net/realmHydro/WaterTable">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmHydro/HydrosphereFeature"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreah:WaterTable</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The water table or phreatic surface is the surface where the water pressure is equal to atmospheric pressure. A sustainable amount of water within a unit of sediment or rock, below the water table, in the phreatic zone is called an aquifer. The ability of the aquifer to store groundwater is dependent on the primary and secondary porosity and permeability</rdfs:comment>
        <rdfs:label xml:lang="en">water table</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmHydro/WaterTableAquifer -->

    <owl:Class rdf:about="http://sweetontology.net/realmHydro/WaterTableAquifer">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmHydro/Aquifer"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreah:WaterTableAquifer</metadata:prefixIRI>
        <rdfs:label xml:lang="en">water table aquifer</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmHydroBody/Aqueduct -->

    <owl:Class rdf:about="http://sweetontology.net/realmHydroBody/Aqueduct">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmHydroBody/Channel"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreahb:Aqueduct</metadata:prefixIRI>
        <rdfs:label xml:lang="en">aqueduct</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmHydroBody/Arroyo -->

    <owl:Class rdf:about="http://sweetontology.net/realmHydroBody/Arroyo">
