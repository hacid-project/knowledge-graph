    <!-- http://sweetontology.net/matrEquipment/Aircraft -->

    <owl:Class rdf:about="http://sweetontology.net/matrEquipment/Aircraft">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrEquipment/Equipment"/>
        <rdfs:subClassOf>
