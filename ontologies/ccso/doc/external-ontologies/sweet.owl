    <owl:Class rdf:about="http://sweetontology.net/realmLandCoastal/Key">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandCoastal/Island"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealc:Key</metadata:prefixIRI>
        <rdfs:label xml:lang="en">key</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmLandCoastal/Littoral -->

    <owl:Class rdf:about="http://sweetontology.net/realmLandCoastal/Littoral">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandCoastal/Coastal"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandCoastal/CoastalRegion"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorealc:Littoral</metadata:prefixIRI>
