        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreas:Permafrost</metadata:prefixIRI>
        <rdfs:label xml:lang="en">permafrost</rdfs:label>
    </owl:Class>
    


