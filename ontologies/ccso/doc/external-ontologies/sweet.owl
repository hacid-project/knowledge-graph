    </owl:Class>
    


    <!-- http://sweetontology.net/reprSciFunction/Isotherm -->

    <owl:Class rdf:about="http://sweetontology.net/reprSciFunction/Isotherm">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprSciFunction/Isopleth"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/hasConstantQuantity"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propTemperature/Temperature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorepsf:Isotherm</metadata:prefixIRI>
        <rdfs:label xml:lang="en">isotherm</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/reprSciFunction/ThicknessLine -->

    <owl:Class rdf:about="http://sweetontology.net/reprSciFunction/ThicknessLine">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprSciFunction/Isopleth"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/hasConstantQuantity"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propSpaceThickness/Thickness"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorepsf:ThicknessLine</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A line drawn through all geographic points at which the thickness of a given atmospheric layer is the same; an isopleth of thickness.</rdfs:comment>
        <rdfs:label xml:lang="en">thickness line</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/reprSciLaw/BernoulliTheorem -->

    <owl:Class rdf:about="http://sweetontology.net/reprSciLaw/BernoulliTheorem">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprSciLaw/PhysicalLaw"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasProperty"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/propSpeed/Velocity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorepsl:BernoulliTheorem</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">As originally formulated, a statement of the conservation of energy (per unit mass) for an inviscid fluid in steady motion.</rdfs:comment>
        <rdfs:label xml:lang="en">bernoulli theorem</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/reprSciLaw/BouguerLaw -->

    <owl:Class rdf:about="http://sweetontology.net/reprSciLaw/BouguerLaw">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprSciLaw/EmpiricalLaw"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasProcess"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/procWave/Attenuation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorepsl:BouguerLaw</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Attenuation of a beam of light by an optically homogeneous (transparent) medium.</rdfs:comment>
        <rdfs:label xml:lang="en">bouguer law</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/reprSciLaw/BuysBallotLaw -->

    <owl:Class rdf:about="http://sweetontology.net/reprSciLaw/BuysBallotLaw">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprSciLaw/EmpiricalLaw"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasProperty"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/propPressure/Pressure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenAtmoWind/Wind"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorepsl:BuysBallotLaw</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A law describing the relationship of the horizontal wind direction in the atmosphere to the pressure distribution.</rdfs:comment>
        <rdfs:label xml:lang="en">buys ballot law</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/reprSciLaw/DarcysLaw -->

    <owl:Class rdf:about="http://sweetontology.net/reprSciLaw/DarcysLaw">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprSciLaw/EmpiricalLaw"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorepsl:DarcysLaw</metadata:prefixIRI>
        <rdfs:label xml:lang="en">darcys law</rdfs:label>
    </owl:Class>
    


