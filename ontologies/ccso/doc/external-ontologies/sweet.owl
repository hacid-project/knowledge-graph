        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMass/ConsistenceProperty"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropm:Texture</metadata:prefixIRI>
        <rdfs:label xml:lang="en">texture</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propMassFlux/DarcyFlux -->

    <owl:Class rdf:about="http://sweetontology.net/propMassFlux/DarcyFlux">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMassFlux/MassFlux"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropmf:DarcyFlux</metadata:prefixIRI>
        <rdfs:label xml:lang="en">darcy flux</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propMassFlux/DifferentialFlux -->

    <owl:Class rdf:about="http://sweetontology.net/propMassFlux/DifferentialFlux">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMassFlux/MassFlux"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropmf:DifferentialFlux</metadata:prefixIRI>
