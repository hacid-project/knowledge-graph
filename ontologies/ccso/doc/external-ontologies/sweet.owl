        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsdis:WaveNumber</metadata:prefixIRI>
        <rdfs:label xml:lang="en">wave number</rdfs:label>
    </owl:Class>
    


