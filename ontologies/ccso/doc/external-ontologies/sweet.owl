        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasImpactOn"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/realm/Land"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophei:LandEnvironmentalImpact</metadata:prefixIRI>
        <rdfs:label xml:lang="en">land environmental impact</rdfs:label>
    </owl:Class>
    


