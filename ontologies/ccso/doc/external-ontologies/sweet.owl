        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/rise"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propSpaceHeight/SeaLevel"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophei:SeaLevelRise</metadata:prefixIRI>
        <rdfs:label xml:lang="en">sea level rise</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenEnvirImpact/SoilLoss -->

    <owl:Class rdf:about="http://sweetontology.net/phenEnvirImpact/SoilLoss">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenEnvirImpact/LandEnvironmentalImpact"/>
