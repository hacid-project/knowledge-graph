    <!-- http://sweetontology.net/matrRock/Breccia -->

    <owl:Class rdf:about="http://sweetontology.net/matrRock/Breccia">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRock/Rock"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarock:Breccia</metadata:prefixIRI>
        <rdfs:label xml:lang="en">breccia</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRock/Chondrite -->

    <owl:Class rdf:about="http://sweetontology.net/matrRock/Chondrite">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRock/Meteorite"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarock:Chondrite</metadata:prefixIRI>
        <rdfs:label xml:lang="en">chondrite</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRock/Fossil -->

    <owl:Class rdf:about="http://sweetontology.net/matrRock/Fossil">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/statePhysical/SubstanceForm"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarock:Fossil</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Fossils  are the preserved remains or traces of animals, plants, and other organisms from the remote past. Fossils vary in size from microscopic, such as single bacterial cells [2] only one micrometer in diameter, to gigantic (macroscopic), such as dinosaurs and trees many meters long and weighing many tons. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">fossil</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRock/HeterogenousRock -->

    <owl:Class rdf:about="http://sweetontology.net/matrRock/HeterogenousRock">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRock/SedimentaryRock"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarock:HeterogenousRock</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A heterogeneous or conglomerate is a rock consisting of individual stones that have become cemented together. Conglomerates are sedimentary rocks consisting of rounded fragments and are thus differentiated from breccias, which consist of angular clasts.[1] Both conglomerates and breccias are characterized by clasts larger than sand (&gt;2 mm). [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">heterogenous rock</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRock/Macrofossil -->

    <owl:Class rdf:about="http://sweetontology.net/matrRock/Macrofossil">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRock/Fossil"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarock:Macrofossil</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Macrofossils are preserved organic remains large enough to be visible without a microscope. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">macrofossil</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRock/Melange -->

    <owl:Class rdf:about="http://sweetontology.net/matrRock/Melange">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRock/Rock"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarock:Melange</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A mélange is a large scale breccia, a mappable body of rock characterized by a lack of continuous bedding and the inclusion of fragments of rock of all sizes, contained in a fine-grained deformed matrix. The mélange typically consists of a jumble of large blocks of varied lithologies of altered oceanic crustal material and blocks of continental slope sediments in a sheared mudstone matrix. Some larger blocks of rock may be as much as 1 km across. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">melange</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRock/MetamorphicRock -->

    <owl:Class rdf:about="http://sweetontology.net/matrRock/MetamorphicRock">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRock/Rock"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaProvenance/hasGenesis"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenGeol/Metamorphic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarock:MetamorphicRock</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">One of the major groups of rock that makes up the crust of the Earth; consists of pre-existing rock mass in which new minerals or textures are formed at higher temperatures and greater pressures than those present on the Earth&apos;s surface [wicktionary]</rdfs:comment>
        <rdfs:label xml:lang="en">metamorphic rock</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRock/Meteor -->

    <owl:Class rdf:about="http://sweetontology.net/matrRock/Meteor">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRock/Rock"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarock:Meteor</metadata:prefixIRI>
        <rdfs:label xml:lang="en">meteor</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRock/Meteorite -->

    <owl:Class rdf:about="http://sweetontology.net/matrRock/Meteorite">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRock/Meteor"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarock:Meteorite</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Meteoric substances are rocks that have composition significantly different from earth rocks. Meteorites have traditionally been divided into three broad categories: stony meteorites are rocks, mainly composed of silicate minerals; iron meteorites are largely composed of metallic iron-nickel; and, stony-iron meteorites contain large amounts of both metallic and rocky material. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">meteorite</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRock/Microfossil -->

    <owl:Class rdf:about="http://sweetontology.net/matrRock/Microfossil">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRock/Fossil"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarock:Microfossil</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Fossils which are of microscopic size such as bacteria. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">microfossil</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRock/Molasse -->

    <owl:Class rdf:about="http://sweetontology.net/matrRock/Molasse">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeol/Sedimentary"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarock:Molasse</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Molasse refers to the sandstones, shales and conglomerates formed as terrestrial or shallow marine deposits in front of rising mountain chains deposited in a foreland basin, especially on top of flysch, for example that left from the rising Alps, or erosion in the Himalaya. These deposits are typically the non-marine alluvial and fluvial sediments of lowlands, as compared to deep-water flysch sediments. Sedimentation stops once the orogeny stops, or once the mountains have eroded flat. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">molasse</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRock/Regolith -->

    <owl:Class rdf:about="http://sweetontology.net/matrRock/Regolith">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/MixedChemicalSubstance"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/Mixture"/>
        <owl:disjointWith rdf:resource="http://sweetontology.net/matrRock/Rock"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarock:Regolith</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Regolith (Greek: ‘blanket rock’) is a layer of loose, heterogeneous material covering solid rock (bedrock). It includes dust, soil, broken rock, and other related materials  [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">regolith</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRock/Rock -->

    <owl:Class rdf:about="http://sweetontology.net/matrRock/Rock">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/MixedChemicalSubstance"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/Mixture"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/SolidSubstance"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarock:Rock</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Rock is a naturally occurring solid aggregate of minerals and/or mineraloids.  In general rocks are of three types, namely, igneous, sedimentary, and metamorphic. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">rock</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRock/RockBody -->

    <owl:Class rdf:about="http://sweetontology.net/matrRock/RockBody">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/MixedChemicalSubstance"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/Mixture"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/SolidSubstance"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaChemical/hasSubstance"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/matrRock/Rock"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarock:RockBody</metadata:prefixIRI>
        <rdfs:label xml:lang="en">rock body</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRock/SedimentaryRock -->

    <owl:Class rdf:about="http://sweetontology.net/matrRock/SedimentaryRock">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRock/Rock"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaProvenance/hasGenesis"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenGeol/Sedimentary"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarock:SedimentaryRock</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">One of the major groups of rock that makes up the crust of the Earth; formed by the deposition of either the weathered remains of other rocks, the results of biological activity, or precipitation from solution [wicktionary]</rdfs:comment>
        <rdfs:label xml:lang="en">sedimentary rock</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRock/Serpentinite -->

    <owl:Class rdf:about="http://sweetontology.net/matrRock/Serpentinite">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRock/MetamorphicRock"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaProvenance/hasGenesis"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/matrRock/Serpentinization"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarock:Serpentinite</metadata:prefixIRI>
        <rdfs:label xml:lang="en">serpentinite</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRock/Serpentinization -->

    <owl:Class rdf:about="http://sweetontology.net/matrRock/Serpentinization">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeol/Metamorphic"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarock:Serpentinization</metadata:prefixIRI>
        <rdfs:label xml:lang="en">serpentinization</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRockIgneous/Aa -->

    <owl:Class rdf:about="http://sweetontology.net/matrRockIgneous/Aa">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/ExtrusiveRock"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/Lava"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarocki:Aa</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">One of three basic types of flow lava. Aa is basaltic lava characterized by a rough or rubbly surface composed of broken lava blocks called clinker. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">aa</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRockIgneous/Andesite -->

    <owl:Class rdf:about="http://sweetontology.net/matrRockIgneous/Andesite">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/VolcanicRock"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarocki:Andesite</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Volcanic rock (or lava) characteristically medium dark in color and containing 54 to 62 percent silica and moderate amounts of iron and magnesium.</rdfs:comment>
        <rdfs:label xml:lang="en">andesite</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRockIgneous/AnorogenicIgneousRock -->

    <owl:Class rdf:about="http://sweetontology.net/matrRockIgneous/AnorogenicIgneousRock">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/IntrusiveRock"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarocki:AnorogenicIgneousRock</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Anorogenic granites are formed above volcanic ‘hot spot’ activity and have peculiar mineralogy and geochemistry. These granites are formed by melting of the lower crust under conditions that are usually extremely dry. The rhyolites of the Yellowstone caldera are examples of volcanic equivalents of A-type granite. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">anorogenic igneous rock</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRockIgneous/Anorthosite -->

    <owl:Class rdf:about="http://sweetontology.net/matrRockIgneous/Anorthosite">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/IgneousRock"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarocki:Anorthosite</metadata:prefixIRI>
        <rdfs:label xml:lang="en">anorthosite</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRockIgneous/Aphanite -->

    <owl:Class rdf:about="http://sweetontology.net/matrRockIgneous/Aphanite">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/IgneousRock"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarocki:Aphanite</metadata:prefixIRI>
        <rdfs:label xml:lang="en">aphanite</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRockIgneous/Basalt -->

    <owl:Class rdf:about="http://sweetontology.net/matrRockIgneous/Basalt">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/ExtrusiveRock"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarocki:Basalt</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Basalt is the most common extrusive volcanic rock. It is usually grey to black and fine-grained due to rapid cooling of lava at the surface of a planet. It may be porphyritic containing larger crystals in a fine matrix, or vesicular, or frothy scoria. Unweathered basalt is black or grey. On Earth, most basalt magmas have formed by decompression melting of the mantle. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">basalt</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRockIgneous/CinderCone -->

    <owl:Class rdf:about="http://sweetontology.net/matrRockIgneous/CinderCone">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/VolcanicCone"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarocki:CinderCone</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A volcanic cone built entirely of loose fragmented material (pyroclastics.)</rdfs:comment>
        <rdfs:label xml:lang="en">cinder cone</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRockIgneous/CompositeCone -->

    <owl:Class rdf:about="http://sweetontology.net/matrRockIgneous/CompositeCone">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/VolcanicCone"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarocki:CompositeCone</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A steep volcanic cone built by both lava flows and pyroclastic eruptions</rdfs:comment>
        <rdfs:label xml:lang="en">composite cone</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRockIgneous/Dacite -->

    <owl:Class rdf:about="http://sweetontology.net/matrRockIgneous/Dacite">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/VolcanicRock"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarocki:Dacite</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Volcanic rock (or lava) that characteristically is light in color and contains 62% to 69% silica and moderate a mounts of sodium and potassium.</rdfs:comment>
        <rdfs:label xml:lang="en">dacite</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRockIgneous/ExtrusiveRock -->

    <owl:Class rdf:about="http://sweetontology.net/matrRockIgneous/ExtrusiveRock">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/IgneousRock"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarocki:ExtrusiveRock</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Magma that has erupted onto the surface of the earth and cooled suffciently to form solid rock.  [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">extrusive rock</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRockIgneous/Felsic -->

    <owl:Class rdf:about="http://sweetontology.net/matrRockIgneous/Felsic">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/IgneousRock"/>
        <owl:disjointWith rdf:resource="http://sweetontology.net/matrRockIgneous/Mafic"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">matrRockIgneous:Felsic</metadata:prefixIRI>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarocki:Felsic</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Felsic refers to silicate minerals, magma, and rocks which are enriched in the lighter elements such as silicon, oxygen, aluminium, sodium, and potassium. The term combines the words ‘feldspar’ and ‘silica.’ Felsic minerals are usually light in color and have specific gravities less than 3. Common felsic minerals include quartz, muscovite, orthoclase, and the sodium-rich plagioclase feldspars. The most common felsic rock is granite. On the opposite side of the rock spectrum are the iron and magnesium-rich mafic and ultramafic minerals and rocks. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">felsic</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRockIgneous/Hypabyssal -->

    <owl:Class rdf:about="http://sweetontology.net/matrRockIgneous/Hypabyssal">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/IgneousRock"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarocki:Hypabyssal</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Hypabyssal are igneous rocks formed at a depth in between the plutonic and volcanic rocks. They are characterized by their porphyritic nature (porphyry). They consist of phenocrysts embedded in a fine-grained groundmass. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">hypabyssal</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRockIgneous/IgneousRock -->

    <owl:Class rdf:about="http://sweetontology.net/matrRockIgneous/IgneousRock">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRock/Rock"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaProvenance/hasGenesis"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenGeol/Igneous"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarocki:IgneousRock</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">By definition, all igneous rock is formed from magma [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">igneous rock</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRockIgneous/IntrusiveRock -->

    <owl:Class rdf:about="http://sweetontology.net/matrRockIgneous/IntrusiveRock">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/IgneousRock"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarocki:IntrusiveRock</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Beneath the surface magma tends to cool slowly which allows for the growth of large crystals within the rock. Rocks formed in this way are intrusive or plutonic rocks. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">intrusive rock</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRockIgneous/Kimberlite -->

    <owl:Class rdf:about="http://sweetontology.net/matrRockIgneous/Kimberlite">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/IgneousRock"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">matrRockIgneous:Kimberlite</metadata:prefixIRI>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarocki:Kimberlite</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Kimberlite is a type of potassic volcanic rock best known for sometimes containing diamonds. The general consensus reached on kimberlites is that they are formed deep within the mantle, at between 150 and 450 kilometres depth, from anomalously enriched exotic mantle compositions, and are erupted rapidly and violently, often with considerable carbon dioxide and other volatile components.  [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">kimberlite</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRockIgneous/Lava -->

    <owl:Class rdf:about="http://sweetontology.net/matrRockIgneous/Lava">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/ExtrusiveRock"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/VolcanicRock"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarocki:Lava</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Magma that extrudes onto the surface of earth is called lava.  [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">lava</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRockIgneous/Mafic -->

    <owl:Class rdf:about="http://sweetontology.net/matrRockIgneous/Mafic">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/IgneousRock"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarocki:Mafic</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Mafic is an adjective describing a silicate mineral or rock that is rich in magnesium and iron; the term was derived by contracting ‘magnesium’ and ‘ferric’. Most mafic minerals are dark in color and the specific gravity is greater than 3. Common rock-forming mafic minerals include olivine, pyroxene, amphibole, and biotite. Common mafic rocks include basalt and gabbro. In terms of chemistry, mafic rocks are on the other side of the rock spectrum from the felsic rocks. The term roughly corresponds to the older basic rock class.Mafic lava, before cooling, has a low viscosity, in comparison to felsic lava, due to the lower silica content in mafic magma. Water and other volatiles can more easily and gradually escape from mafic lava, so eruptions of volcanoes made of mafic lavas are less explosively violent than felsic lava eruptions. Most mafic lava volcanoes are oceanic volcanoes, like Hawaii. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">mafic</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRockIgneous/Magma -->

    <owl:Class rdf:about="http://sweetontology.net/matrRockIgneous/Magma">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/VolcanicRock"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarocki:Magma</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Magma is molten rock that is found beneath the surface of the Earth.Magma is a complex high-temperature fluid substance in 3 phases; a system of silicate liquid, solid minerals, and perhaps a vapor phase. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">magma</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRockIgneous/Obsidian -->

    <owl:Class rdf:about="http://sweetontology.net/matrRockIgneous/Obsidian">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/ExtrusiveRock"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/Lava"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarocki:Obsidian</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Obsidian, a type of quenched lava, is a silicic black volcanic glass [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">obsidian</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRockIgneous/Pahoehoe -->

    <owl:Class rdf:about="http://sweetontology.net/matrRockIgneous/Pahoehoe">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/ExtrusiveRock"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/Lava"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarocki:Pahoehoe</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Pahoehoe is basaltic lava that has a smooth, billowy, undulating, or ropy surface. These surface features are due to the movement of very fluid lava under a congealing surface crust. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">pahoehoe</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRockIgneous/Peridotite -->

    <owl:Class rdf:about="http://sweetontology.net/matrRockIgneous/Peridotite">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/IgneousRock"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarocki:Peridotite</metadata:prefixIRI>
        <rdfs:label xml:lang="en">peridotite</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRockIgneous/PillowLava -->

    <owl:Class rdf:about="http://sweetontology.net/matrRockIgneous/PillowLava">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/ExtrusiveRock"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/Lava"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarocki:PillowLava</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Pillow lava is the lava structure typically formed when lava emerges from an underwater volcanic vent or subglacial volcano or a lava flow enters the ocean. However, pillow lava can also form when lava is erupted beneath thick glacial ice. The viscous lava gains a solid crust on contact with the water, and this crust cracks and oozes additional large blobs or ‘pillows’ as more lava emerges from the advancing flow. Since water covers the majority of Earth&apos;s surface and most volcanoes are situated near or under bodies of water, pillow lava is very common. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">pillow lava</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRockIgneous/Pluton -->

    <owl:Class rdf:about="http://sweetontology.net/matrRockIgneous/Pluton">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/matrRockIgneous/PlutonicRock"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/IntrusiveRock"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarocki:Pluton</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A pluton is an intrusive igneous rock body that crystallized from a magma slowly cooling below the surface of the Earth. Plutons include batholiths, dikes, sills, laccoliths, lopoliths, and other igneous bodies. In practice, ‘pluton’ usually refers to a distinctive mass of igneous rock, typically kilometers in dimension, without a tabular shape like those of dikes and sills. Batholiths commonly are aggregations of plutons. The most common rock types in plutons are granite, granodiorite, tonalite, and quartz diorite. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">pluton</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRockIgneous/PlutonicRock -->

    <owl:Class rdf:about="http://sweetontology.net/matrRockIgneous/PlutonicRock">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/IntrusiveRock"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarocki:PlutonicRock</metadata:prefixIRI>
        <rdfs:label xml:lang="en">plutonic rock</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRockIgneous/Pumice -->

    <owl:Class rdf:about="http://sweetontology.net/matrRockIgneous/Pumice">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/VolcanicRock"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarocki:Pumice</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Light-colored, frothy volcanic rock, usually of dacite or rhyolite composition, formed by the expansion of gas in erupting lava. Commonly seen as lumps or fragments of pea-size and larger, but can also occur abundantly as ash-sized particles.</rdfs:comment>
        <rdfs:label xml:lang="en">pumice</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRockIgneous/Pyroclastic -->

    <owl:Class rdf:about="http://sweetontology.net/matrRockIgneous/Pyroclastic">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/ExtrusiveRock"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/VolcanicRock"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarocki:Pyroclastic</metadata:prefixIRI>
        <rdfs:comment xml:lang="en"> A descriptive term, usually for rock, which results from explosive magma ejection [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">pyroclastic</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRockIgneous/Rhyolite -->

    <owl:Class rdf:about="http://sweetontology.net/matrRockIgneous/Rhyolite">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/VolcanicRock"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarocki:Rhyolite</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Volcanic rock (or lava) that characteristically is light in color, contains 69% silica or more, and is rich in potassium and sodium.</rdfs:comment>
        <rdfs:label xml:lang="en">rhyolite</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRockIgneous/SpatterCone -->

    <owl:Class rdf:about="http://sweetontology.net/matrRockIgneous/SpatterCone">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/VolcanicRock"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarocki:SpatterCone</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A low, steep-sided cone of spatter built up on a fissure or vent. It is usually of basaltic material.</rdfs:comment>
        <rdfs:label xml:lang="en">spatter cone</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRockIgneous/Tephra -->

    <owl:Class rdf:about="http://sweetontology.net/matrRockIgneous/Tephra">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/ExtrusiveRock"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/VolcanicRock"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarocki:Tephra</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Tephra is a collective term (generally plural) used for all material -- regardless of size-- ejected during an explosive volcanic eruption.</rdfs:comment>
        <rdfs:label xml:lang="en">tephra</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRockIgneous/Trachyandesite -->

    <owl:Class rdf:about="http://sweetontology.net/matrRockIgneous/Trachyandesite">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/VolcanicRock"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarocki:Trachyandesite</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">An extrusive rock intermediate in composition between trachyte and andesite.</rdfs:comment>
        <rdfs:label xml:lang="en">trachyandesite</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRockIgneous/Trachybasalt -->

    <owl:Class rdf:about="http://sweetontology.net/matrRockIgneous/Trachybasalt">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/VolcanicRock"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarocki:Trachybasalt</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">An extrusive rock intermediate in composition between trachyte and basalt.</rdfs:comment>
        <rdfs:label xml:lang="en">trachybasalt</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRockIgneous/Trachyte -->

    <owl:Class rdf:about="http://sweetontology.net/matrRockIgneous/Trachyte">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/VolcanicRock"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarocki:Trachyte</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A group of fine-grained, generally porphyritic, extrusive igneous rocks having alkali feldspar and minor mafic minerals as the main components, and possibly a small amount of sodic plagioclase.</rdfs:comment>
        <rdfs:label xml:lang="en">trachyte</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRockIgneous/Tuff -->

    <owl:Class rdf:about="http://sweetontology.net/matrRockIgneous/Tuff">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/Pyroclastic"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarocki:Tuff</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Rock formed of pyroclastic material.</rdfs:comment>
        <rdfs:label xml:lang="en">tuff</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRockIgneous/TuffCone -->

    <owl:Class rdf:about="http://sweetontology.net/matrRockIgneous/TuffCone">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/VolcanicCone"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarocki:TuffCone</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A type of volcanic cone formed by the interaction of basaltic magma and water. Smaller and steeper than a tuff ring.</rdfs:comment>
        <rdfs:label xml:lang="en">tuff cone</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRockIgneous/TuffRing -->

    <owl:Class rdf:about="http://sweetontology.net/matrRockIgneous/TuffRing">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/VolcanicRock"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarocki:TuffRing</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A wide, low-rimmed, well-bedded accumulation of hyalo-clastic debris built around a volcanic vent located in a lake, coastal zone, marsh, or area of abundant ground water.</rdfs:comment>
        <rdfs:label xml:lang="en">tuff ring</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRockIgneous/Ultramaphic -->

    <owl:Class rdf:about="http://sweetontology.net/matrRockIgneous/Ultramaphic">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/ExtrusiveRock"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/VolcanicRock"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarocki:Ultramaphic</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The mantle is composed mostly of Ultramafic rocks (or see Igneous Primer) such as peridotite and dunite and their metamorphic equivalents (e.g. ecologite). [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">ultramaphic</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRockIgneous/VolcanicCone -->

    <owl:Class rdf:about="http://sweetontology.net/matrRockIgneous/VolcanicCone">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/VolcanicRock"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarocki:VolcanicCone</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A mound of loose material that was ejected ballistically.</rdfs:comment>
        <rdfs:label xml:lang="en">volcanic cone</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRockIgneous/VolcanicNeck -->

    <owl:Class rdf:about="http://sweetontology.net/matrRockIgneous/VolcanicNeck">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/VolcanicRock"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarocki:VolcanicNeck</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A massive pillar of rock more resistant to erosion than the lavas and pyroclastic rocks of a volcanic cone.</rdfs:comment>
        <rdfs:label xml:lang="en">volcanic neck</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRockIgneous/VolcanicRock -->

    <owl:Class rdf:about="http://sweetontology.net/matrRockIgneous/VolcanicRock">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRockIgneous/ExtrusiveRock"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarocki:VolcanicRock</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Volcanic rock is an igneous rock produced by extrusion from a volcano. It has various subtypes based on chemical composition and whether the extrusion was violent (pyroclastic) or slow (laval). [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">volcanic rock</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRockIgneous/Xenocryst -->

    <owl:Class rdf:about="http://sweetontology.net/matrRockIgneous/Xenocryst">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/MixedChemicalSubstance"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/Mixture"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasState"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/stateSolid/Crystal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarocki:Xenocryst</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A xenocryst is an individual foreign crystal included within an igneous body. Examples of xenocrysts are quartz crystals in a silica-deficient lava and diamonds within kimberlite diatremes. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">xenocryst</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrRockIgneous/Xenolith -->

    <owl:Class rdf:about="http://sweetontology.net/matrRockIgneous/Xenolith">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrRock/Rock"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somarocki:Xenolith</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A xenolith is a rock fragment which becomes enveloped in a larger rock during the latter&apos;s development and hardening. The term xenolith is almost exclusively used to describe inclusions in igneous rock during magma emplacement and eruption [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">xenolith</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrSediment/Alluvium -->

    <owl:Class rdf:about="http://sweetontology.net/matrSediment/Alluvium">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrSediment/Sediment"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somas:Alluvium</metadata:prefixIRI>
        <rdfs:label xml:lang="en">alluvium</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrSediment/AshFlow -->

    <owl:Class rdf:about="http://sweetontology.net/matrSediment/AshFlow">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrSediment/DebrisFlow"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somas:AshFlow</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A turbulent mixture of gas and rock fragments, most of which are ash-sized particles, ejected violently from a crater or fissure. The mass of pyroclastics is normally of very high temperature and moves rapidly down the slopes or even along a level surface.</rdfs:comment>
        <rdfs:label xml:lang="en">ash flow</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrSediment/Ashfall -->

    <owl:Class rdf:about="http://sweetontology.net/matrSediment/Ashfall">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrSediment/Ejecta"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somas:Ashfall</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Volcanic ash that has fallen through the air from an eruption cloud. A deposit so formed is usually well sorted and layered.</rdfs:comment>
        <rdfs:label xml:lang="en">ashfall</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrSediment/Bentonite -->

    <owl:Class rdf:about="http://sweetontology.net/matrSediment/Bentonite">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrSediment/Clay"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somas:Bentonite</metadata:prefixIRI>
        <rdfs:label xml:lang="en">bentonite</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrSediment/Block -->

    <owl:Class rdf:about="http://sweetontology.net/matrSediment/Block">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrSediment/Ejecta"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somas:Block</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Angular chunk of solid rock ejected during an eruption.</rdfs:comment>
        <rdfs:label xml:lang="en">block</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrSediment/Bomb -->

    <owl:Class rdf:about="http://sweetontology.net/matrSediment/Bomb">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrSediment/Ejecta"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somas:Bomb</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Fragment of molten or semi-molten rock, 2 1/2 inches to many feet in diameter, which is blown out during an eruption. Because of their plastic condition, bombs are often modified in shape during their flight or upon impact.</rdfs:comment>
        <rdfs:label xml:lang="en">bomb</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrSediment/Boulder -->

    <owl:Class rdf:about="http://sweetontology.net/matrSediment/Boulder">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrSediment/Sediment"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somas:Boulder</metadata:prefixIRI>
        <rdfs:label xml:lang="en">boulder</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrSediment/Clast -->

    <owl:Class rdf:about="http://sweetontology.net/matrSediment/Clast">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrSediment/Sediment"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somas:Clast</metadata:prefixIRI>
        <rdfs:label xml:lang="en">clast</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrSediment/Clay -->

    <owl:Class rdf:about="http://sweetontology.net/matrSediment/Clay">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrSediment/Sediment"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somas:Clay</metadata:prefixIRI>
        <rdfs:label xml:lang="en">clay</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrSediment/Cobble -->

    <owl:Class rdf:about="http://sweetontology.net/matrSediment/Cobble">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrSediment/Sediment"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somas:Cobble</metadata:prefixIRI>
        <rdfs:label xml:lang="en">cobble</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrSediment/Colluvium -->

    <owl:Class rdf:about="http://sweetontology.net/matrSediment/Colluvium">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrSediment/Sediment"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somas:Colluvium</metadata:prefixIRI>
        <rdfs:label xml:lang="en">colluvium</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrSediment/Debris -->

    <owl:Class rdf:about="http://sweetontology.net/matrSediment/Debris">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrSediment/Sediment"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somas:Debris</metadata:prefixIRI>
        <rdfs:label xml:lang="en">debris</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrSediment/DebrisAvalanche -->

    <owl:Class rdf:about="http://sweetontology.net/matrSediment/DebrisAvalanche">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrSediment/DebrisFlow"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somas:DebrisAvalanche</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A rapid and unusually sudden sliding or flowage of unsorted masses of rock and other material. As applied to the major avalanche involved in the eruption of Mount St. Helens, a rapid mass movement that included fragmented cold and hot volcanic rock, water, snow, glacier ice, trees, and some hot pyroclastic material. Most of the May 18, 1980 deposits in the upper valley of the North Fork Toutle River and in the vicinity of Spirit Lake are from the debris avalanche.</rdfs:comment>
        <rdfs:label xml:lang="en">debris avalanche</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrSediment/DebrisFlow -->

    <owl:Class rdf:about="http://sweetontology.net/matrSediment/DebrisFlow">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/MixedChemicalSubstance"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/Mixture"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somas:DebrisFlow</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A mixture of water-saturated rock debris that flows downslope under the force of gravity (also called lahar or mudflow).</rdfs:comment>
        <rdfs:label xml:lang="en">debris flow</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrSediment/DrillingMud -->

    <owl:Class rdf:about="http://sweetontology.net/matrSediment/DrillingMud">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrSediment/Mud"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somas:DrillingMud</metadata:prefixIRI>
        <rdfs:label xml:lang="en">drilling mud</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrSediment/Ejecta -->

    <owl:Class rdf:about="http://sweetontology.net/matrSediment/Ejecta">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/MixedChemicalSubstance"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/Mixture"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somas:Ejecta</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">In volcanology, particles that came out of a volcanic vent, traveled through the air or under water, and fell back on the ground surface or on the ocean floor. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">ejecta</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrSediment/Gibber -->

    <owl:Class rdf:about="http://sweetontology.net/matrSediment/Gibber">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrSediment/Sediment"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somas:Gibber</metadata:prefixIRI>
        <rdfs:label xml:lang="en">gibber</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrSediment/Granule -->

    <owl:Class rdf:about="http://sweetontology.net/matrSediment/Granule">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrSediment/Gravel"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somas:Granule</metadata:prefixIRI>
        <rdfs:label xml:lang="en">granule</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrSediment/Gravel -->

    <owl:Class rdf:about="http://sweetontology.net/matrSediment/Gravel">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrSediment/Sediment"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somas:Gravel</metadata:prefixIRI>
        <rdfs:label xml:lang="en">gravel</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrSediment/HydrogenousSediment -->

    <owl:Class rdf:about="http://sweetontology.net/matrSediment/HydrogenousSediment">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrSediment/Sediment"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somas:HydrogenousSediment</metadata:prefixIRI>
        <rdfs:label xml:lang="en">hydrogenous sediment</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrSediment/Hypoclastite -->

    <owl:Class rdf:about="http://sweetontology.net/matrSediment/Hypoclastite">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrSediment/VolcanicDeposit"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somas:Hypoclastite</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A deposit formed by the flowing or intrusion of lava or magma into water, ice, or water-saturated sediment and its consequent granulation or shattering into small angular fragments.</rdfs:comment>
        <rdfs:label xml:lang="en">hypoclastite</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrSediment/Lahar -->

    <owl:Class rdf:about="http://sweetontology.net/matrSediment/Lahar">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrSediment/Mudflow"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somas:Lahar</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A torrential flow of water-saturated volcanic debris down the slope of a volcano in response to gravity. A type of mudflow.</rdfs:comment>
        <rdfs:label xml:lang="en">lahar</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrSediment/Loam -->

    <owl:Class rdf:about="http://sweetontology.net/matrSediment/Loam">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrSediment/Sediment"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somas:Loam</metadata:prefixIRI>
        <rdfs:label xml:lang="en">loam</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrSediment/Loess -->

    <owl:Class rdf:about="http://sweetontology.net/matrSediment/Loess">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrSediment/Sediment"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somas:Loess</metadata:prefixIRI>
        <rdfs:label xml:lang="en">loess</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrSediment/MarineSediment -->

    <owl:Class rdf:about="http://sweetontology.net/matrSediment/MarineSediment">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrSediment/Sediment"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somas:MarineSediment</metadata:prefixIRI>
        <rdfs:label xml:lang="en">marine sediment</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrSediment/Mud -->

    <owl:Class rdf:about="http://sweetontology.net/matrSediment/Mud">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrSediment/Sediment"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somas:Mud</metadata:prefixIRI>
        <rdfs:label xml:lang="en">mud</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrSediment/Mudflow -->

    <owl:Class rdf:about="http://sweetontology.net/matrSediment/Mudflow">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrSediment/DebrisFlow"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somas:Mudflow</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A flowage of water-saturated earth material possessing a high degree of fluidity during movement. A less-saturated flowing mass is often called a debris flow. A mudflow originating on the flank of a volcano is properly called a lahar.</rdfs:comment>
        <rdfs:label xml:lang="en">mudflow</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrSediment/Peat -->

    <owl:Class rdf:about="http://sweetontology.net/matrSediment/Peat">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrSediment/Sediment"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somas:Peat</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Peat is an accumulation of partially decayed vegetation matter. Peat forms in wetlands or peatlands.</rdfs:comment>
        <rdfs:label xml:lang="en">peat</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrSediment/Pebble -->

    <owl:Class rdf:about="http://sweetontology.net/matrSediment/Pebble">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrSediment/Gravel"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somas:Pebble</metadata:prefixIRI>
        <rdfs:label xml:lang="en">pebble</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrSediment/Sand -->

    <owl:Class rdf:about="http://sweetontology.net/matrSediment/Sand">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrSediment/Sediment"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somas:Sand</metadata:prefixIRI>
        <rdfs:label xml:lang="en">sand</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrSediment/Sediment -->

    <owl:Class rdf:about="http://sweetontology.net/matrSediment/Sediment">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/MixedChemicalSubstance"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/Mixture"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somas:Sediment</metadata:prefixIRI>
        <rdfs:label xml:lang="en">sediment</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrSediment/Silt -->

    <owl:Class rdf:about="http://sweetontology.net/matrSediment/Silt">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrSediment/Sediment"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somas:Silt</metadata:prefixIRI>
        <rdfs:label xml:lang="en">silt</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrSediment/Soil -->

    <owl:Class rdf:about="http://sweetontology.net/matrSediment/Soil">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrSediment/Sediment"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somas:Soil</metadata:prefixIRI>
        <rdfs:label xml:lang="en">soil</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrSediment/TerrigenousSediment -->

    <owl:Class rdf:about="http://sweetontology.net/matrSediment/TerrigenousSediment">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrSediment/Sediment"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaProvenance/hasGenesis"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenSolid/Erosion"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somas:TerrigenousSediment</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">In oceanography, terrigenous sediments are those derived from the erosion of rocks on land; that is, that are derived from terrestrial environments. Consisting of sand, mud, and silt carried to sea by rivers, their composition is usually related to their source rocks; deposition of these sediments is largely limited to the continental shelf.</rdfs:comment>
        <rdfs:label xml:lang="en">terrigenous sediment</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrSediment/Varve -->

    <owl:Class rdf:about="http://sweetontology.net/matrSediment/Varve">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrSediment/Sediment"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somas:Varve</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A varve is an annual layer of sediment or sedimentary rock.</rdfs:comment>
        <rdfs:label xml:lang="en">varve</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrSediment/VolcanicDeposit -->

    <owl:Class rdf:about="http://sweetontology.net/matrSediment/VolcanicDeposit">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/Substance"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somas:VolcanicDeposit</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Volcanic deposits are molten rock (lava), solid rocks and ash which surround a volcano crater. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">volcanic deposit</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrWater/BlackWater -->

    <owl:Class rdf:about="http://sweetontology.net/matrWater/BlackWater">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrWater/WaterMixture"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somaw:BlackWater</metadata:prefixIRI>
        <rdfs:label xml:lang="en">black water</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrWater/BrackishWater -->

    <owl:Class rdf:about="http://sweetontology.net/matrWater/BrackishWater">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrWater/SaltWater"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasState"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/stateChemical/Brackish"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somaw:BrackishWater</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Brackish water is water that has more salinity than fresh water, but not as much as seawater. It may result from mixing of seawater with fresh water, as in estuaries, or it may occur in brackish fossil aquifers.</rdfs:comment>
        <rdfs:label xml:lang="en">brackish water</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrWater/Brine -->

    <owl:Class rdf:about="http://sweetontology.net/matrWater/Brine">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrWater/SaltWater"/>
        <owl:disjointWith rdf:resource="http://sweetontology.net/matrWater/SalineWater"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somaw:Brine</metadata:prefixIRI>
        <rdfs:label xml:lang="en">brine</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrWater/CloudDrop -->

    <owl:Class rdf:about="http://sweetontology.net/matrWater/CloudDrop">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrWater/Drop"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/diameter"/>
                <owl:hasValue>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://sweetontology.net/propSpaceDistance/SizeRange_micron"/>
                    </rdf:Description>
                </owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somaw:CloudDrop</metadata:prefixIRI>
        <rdfs:label xml:lang="en">cloud drop</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrWater/DepthHoar -->

    <owl:Class rdf:about="http://sweetontology.net/matrWater/DepthHoar">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrWater/IceCrystal"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrWater/IceParticle"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somaw:DepthHoar</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Depth hoares are large crystals occurring at the base of a snowpack that form due to the fact that a snow crystal can grow over time as moisture freezes onto the crystal from vapor that is rising in the snowpack.</rdfs:comment>
        <rdfs:label xml:lang="en">depth hoar</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrWater/Dew -->

    <owl:Class rdf:about="http://sweetontology.net/matrWater/Dew">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrWater/LiquidWater"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somaw:Dew</metadata:prefixIRI>
        <rdfs:label xml:lang="en">dew</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrWater/DrinkingWater -->

    <owl:Class rdf:about="http://sweetontology.net/matrWater/DrinkingWater">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/human/HumanNeed"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrWater/WaterMixture"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somaw:DrinkingWater</metadata:prefixIRI>
        <rdfs:label xml:lang="en">drinking water</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrWater/DrizzleDrop -->

    <owl:Class rdf:about="http://sweetontology.net/matrWater/DrizzleDrop">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrWater/Drop"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/diameter"/>
                <owl:hasValue>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://sweetontology.net/propSpaceDistance/SizeRange_micron"/>
                    </rdf:Description>
                </owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somaw:DrizzleDrop</metadata:prefixIRI>
        <rdfs:label xml:lang="en">drizzle drop</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrWater/Drop -->

    <owl:Class rdf:about="http://sweetontology.net/matrWater/Drop">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrWater/LiquidWater"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somaw:Drop</metadata:prefixIRI>
        <rdfs:label xml:lang="en">drop</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrWater/Effluent -->

    <owl:Class rdf:about="http://sweetontology.net/matrWater/Effluent">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrWater/WaterMixture"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somaw:Effluent</metadata:prefixIRI>
        <rdfs:label xml:lang="en">effluent</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrWater/Firn -->

    <owl:Class rdf:about="http://sweetontology.net/matrWater/Firn">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrWater/IceCrystal"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrWater/IceParticle"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somaw:Firn</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Firn is partially-compacted névé, a type of snow that has been left over from past seasons and has been recrystallized into a substance denser than névé. It is ice that is at an intermediate stage between snow and glacial ice. Firn has the appearance of wet sugar, but has a hardness that makes it extremely resistant to shovelling. It generally has a density greater than 550 kg/m³ and is often found underneath the snow that accumulates at the head of a glacier.</rdfs:comment>
        <rdfs:label xml:lang="en">firn</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrWater/FreshWater -->

    <owl:Class rdf:about="http://sweetontology.net/matrWater/FreshWater">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrWater/WaterSubstance"/>
        <owl:disjointWith rdf:resource="http://sweetontology.net/matrWater/SaltWater"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somaw:FreshWater</metadata:prefixIRI>
        <rdfs:label xml:lang="en">fresh water</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrWater/Frost -->

    <owl:Class rdf:about="http://sweetontology.net/matrWater/Frost">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrWater/WaterSubstance"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasState"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/Frozen"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somaw:Frost</metadata:prefixIRI>
        <rdfs:label xml:lang="en">frost</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrWater/GranularIce -->

    <owl:Class rdf:about="http://sweetontology.net/matrWater/GranularIce">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrWater/Ice"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somaw:GranularIce</metadata:prefixIRI>
        <rdfs:label xml:lang="en">granular ice</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrWater/GrayWater -->

    <owl:Class rdf:about="http://sweetontology.net/matrWater/GrayWater">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrWater/WaterMixture"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somaw:GrayWater</metadata:prefixIRI>
        <rdfs:label xml:lang="en">gray water</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrWater/Groundwater -->

    <owl:Class rdf:about="http://sweetontology.net/matrWater/Groundwater">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrWater/LiquidWater"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/below"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realm/PlanetarySurface"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somaw:Groundwater</metadata:prefixIRI>
