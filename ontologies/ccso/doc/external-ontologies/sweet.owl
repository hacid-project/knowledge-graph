        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropfr:RelativeHumidity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">relative humidity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propFraction/SaturationMixingRatio -->

    <owl:Class rdf:about="http://sweetontology.net/propFraction/SaturationMixingRatio">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propChemical/SaturationProperty"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propFraction/MixingRatio"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropfr:SaturationMixingRatio</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A thermodynamic function of state; the value of the mixing ratio of saturated air at the given temperature and pressure.</rdfs:comment>
        <rdfs:label xml:lang="en">saturation mixing ratio</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propFraction/SpecificHumidity -->

    <owl:Class rdf:about="http://sweetontology.net/propFraction/SpecificHumidity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propFraction/Humidity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropfr:SpecificHumidity</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">In a system of moist air, the (dimensionless) ratio of the mass of water vapor to the total mass of the system.</rdfs:comment>
        <rdfs:label xml:lang="en">specific humidity</rdfs:label>
    </owl:Class>
    


