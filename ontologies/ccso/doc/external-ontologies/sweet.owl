        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaas:ActiveRegion</metadata:prefixIRI>
        <rdfs:label xml:lang="en">active region</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAstroStar/Chromosphere -->

    <owl:Class rdf:about="http://sweetontology.net/realmAstroStar/Chromosphere">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAstroStar/StellarAtmosphere"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasState"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/Plasma"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaas:Chromosphere</metadata:prefixIRI>
