    <owl:Class rdf:about="http://sweetontology.net/phenMixing/TurbulentDiffusion">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenMixing/Diffuse"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenMixing/Diffusion"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophm:TurbulentDiffusion</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Diffusion or dispersion due to the effects of turbulent motions.</rdfs:comment>
        <rdfs:label xml:lang="en">turbulent diffusion</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOcean/OceanPhenomena -->

    <owl:Class rdf:about="http://sweetontology.net/phenOcean/OceanPhenomena">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phen/PlanetaryPhenomena"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRealm"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realm/Ocean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopho:OceanPhenomena</metadata:prefixIRI>
        <rdfs:label xml:lang="en">ocean phenomena</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOceanCoastal/Attrition -->

    <owl:Class rdf:about="http://sweetontology.net/phenOceanCoastal/Attrition">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOceanCoastal/CoastalPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophoc:Attrition</metadata:prefixIRI>
        <rdfs:label xml:lang="en">attrition</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOceanCoastal/Backwash -->

    <owl:Class rdf:about="http://sweetontology.net/phenOceanCoastal/Backwash">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOceanCoastal/CoastalPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophoc:Backwash</metadata:prefixIRI>
        <rdfs:label xml:lang="en">backwash</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOceanCoastal/BeachDepletion -->

    <owl:Class rdf:about="http://sweetontology.net/phenOceanCoastal/BeachDepletion">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOceanCoastal/CoastalPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophoc:BeachDepletion</metadata:prefixIRI>
        <rdfs:label xml:lang="en">beach depletion</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOceanCoastal/Breaker -->

    <owl:Class rdf:about="http://sweetontology.net/phenOceanCoastal/Breaker">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOceanCoastal/BreakingWave"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophoc:Breaker</metadata:prefixIRI>
        <rdfs:label xml:lang="en">breaker</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOceanCoastal/BreakingWave -->

    <owl:Class rdf:about="http://sweetontology.net/phenOceanCoastal/BreakingWave">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOceanCoastal/CoastalPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophoc:BreakingWave</metadata:prefixIRI>
        <rdfs:label xml:lang="en">breaking wave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOceanCoastal/CoastalPhenomena -->

    <owl:Class rdf:about="http://sweetontology.net/phenOceanCoastal/CoastalPhenomena">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOcean/OceanPhenomena"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRealm"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmLandCoastal/CoastalRegion"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophoc:CoastalPhenomena</metadata:prefixIRI>
        <rdfs:label xml:lang="en">coastal phenomena</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOceanCoastal/LittoralDrift -->

    <owl:Class rdf:about="http://sweetontology.net/phenOceanCoastal/LittoralDrift">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/phenOceanCoastal/LongshoreDrift"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOceanCoastal/CoastalPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophoc:LittoralDrift</metadata:prefixIRI>
        <rdfs:label xml:lang="en">littoral drift</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOceanCoastal/LongshoreDrift -->

    <owl:Class rdf:about="http://sweetontology.net/phenOceanCoastal/LongshoreDrift">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOceanCoastal/CoastalPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophoc:LongshoreDrift</metadata:prefixIRI>
        <rdfs:label xml:lang="en">longshore drift</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOceanCoastal/OceanTide -->

    <owl:Class rdf:about="http://sweetontology.net/phenOceanCoastal/OceanTide">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenCycle/Tide"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOceanCoastal/CoastalPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophoc:OceanTide</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The periodic rising and falling of the earth&apos;s oceans and atmosphere. It results from the tide-producing forces of the moon and sun acting upon the rotating earth. This disturbance actually propagates as a wave through the atmosphere and along the surface of the waters of the earth. Atmospheric tides are always so designated, whereas the term “tide“ alone commonly implies the oceanic variety. Sometimes, the consequent horizontal movement of water along the coastlines is also called “tide,” but it is preferable to designate the latter as tidal current, reserving the name tide for the vertical wavelike movement.</rdfs:comment>
        <rdfs:label xml:lang="en">ocean tide</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOceanCoastal/PlungingBreaker -->

    <owl:Class rdf:about="http://sweetontology.net/phenOceanCoastal/PlungingBreaker">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOceanCoastal/Breaker"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophoc:PlungingBreaker</metadata:prefixIRI>
        <rdfs:label xml:lang="en">plunging breaker</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOceanCoastal/SpillingBreaker -->

    <owl:Class rdf:about="http://sweetontology.net/phenOceanCoastal/SpillingBreaker">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOceanCoastal/Breaker"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophoc:SpillingBreaker</metadata:prefixIRI>
        <rdfs:label xml:lang="en">spilling breaker</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOceanCoastal/StormSurge -->

    <owl:Class rdf:about="http://sweetontology.net/phenOceanCoastal/StormSurge">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOceanCoastal/CoastalPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophoc:StormSurge</metadata:prefixIRI>
        <rdfs:label xml:lang="en">storm surge</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOceanCoastal/SurfBeat -->

    <owl:Class rdf:about="http://sweetontology.net/phenOceanCoastal/SurfBeat">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOceanCoastal/CoastalPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophoc:SurfBeat</metadata:prefixIRI>
        <rdfs:label xml:lang="en">surf beat</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOceanCoastal/SurgingBreaker -->

    <owl:Class rdf:about="http://sweetontology.net/phenOceanCoastal/SurgingBreaker">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOceanCoastal/Breaker"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophoc:SurgingBreaker</metadata:prefixIRI>
        <rdfs:label xml:lang="en">surging breaker</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOceanCoastal/Swell -->

    <owl:Class rdf:about="http://sweetontology.net/phenOceanCoastal/Swell">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOceanCoastal/CoastalPhenomena"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/GravitationalWave"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/GravityWave"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophoc:Swell</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Surface gravity waves on the ocean that are not growing or being sustained any longer by the wind.</rdfs:comment>
        <rdfs:label xml:lang="en">swell</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOceanDynamics/BoundaryCurrent -->

    <owl:Class rdf:about="http://sweetontology.net/phenOceanDynamics/BoundaryCurrent">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOceanDynamics/OceanCurrent"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophod:BoundaryCurrent</metadata:prefixIRI>
        <rdfs:label xml:lang="en">boundary current</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOceanDynamics/CircumpolarCurrent -->

    <owl:Class rdf:about="http://sweetontology.net/phenOceanDynamics/CircumpolarCurrent">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOceanDynamics/OceanCurrent"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophod:CircumpolarCurrent</metadata:prefixIRI>
        <rdfs:label xml:lang="en">circumpolar current</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOceanDynamics/ColdCoreCell -->

    <owl:Class rdf:about="http://sweetontology.net/phenOceanDynamics/ColdCoreCell">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOceanDynamics/OceanGyre"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/hasTemperatureRange"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/stateThermodynamic/Cool"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophod:ColdCoreCell</metadata:prefixIRI>
        <rdfs:label xml:lang="en">cold core cell</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOceanDynamics/Downwelling -->

    <owl:Class rdf:about="http://sweetontology.net/phenOceanDynamics/Downwelling">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOceanDynamics/OceanCirculation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/hasDirection"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSpaceDirection/Down"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophod:Downwelling</metadata:prefixIRI>
        <rdfs:label xml:lang="en">downwelling</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOceanDynamics/EasternBoundaryCurrent -->

    <owl:Class rdf:about="http://sweetontology.net/phenOceanDynamics/EasternBoundaryCurrent">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOceanDynamics/BoundaryCurrent"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophod:EasternBoundaryCurrent</metadata:prefixIRI>
        <rdfs:label xml:lang="en">eastern boundary current</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOceanDynamics/LangmuirCirculation -->

    <owl:Class rdf:about="http://sweetontology.net/phenOceanDynamics/LangmuirCirculation">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOceanDynamics/OceanCirculation"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophod:LangmuirCirculation</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Roll circulations approximately aligned with the surface stress vector that frequently occur in the upper boundary layer of oceans or lakes. Although similar in form to atmospheric longitudinal roll vortices, Langmuir circulations are thought to be driven by nonlinear interactions between the surface gravity wave field and the larger-scale turbulent motions within the mixed layer. They are sometimes called windrows because they form lines of surface debris or bubbles in their surface convergence zones. Their spatial scale is related to the depth of the mixed layer and their characteristic velocity is on the order of 8u*, where u* is the friction velocity in water. As a result of this scaling, Langmuir circulations generally require surface winds of at least 8 m s-1 in order to form. See coherent structures, longitudinal rolls.</rdfs:comment>
        <rdfs:label xml:lang="en">langmuir circulation</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOceanDynamics/LittoralCurrent -->

    <owl:Class rdf:about="http://sweetontology.net/phenOceanDynamics/LittoralCurrent">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/phenOceanDynamics/LongshoreCurrent"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOceanDynamics/OceanCurrent"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophod:LittoralCurrent</metadata:prefixIRI>
        <rdfs:label xml:lang="en">littoral current</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOceanDynamics/LongshoreCurrent -->

    <owl:Class rdf:about="http://sweetontology.net/phenOceanDynamics/LongshoreCurrent">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOceanDynamics/OceanCurrent"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophod:LongshoreCurrent</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">(Also called littoral current.) The resultant current produced by waves being deflected at an angle by the shore. In this case the current runs roughly parallel to the shoreline. The longshore current is capable of carrying a certain amount of material as long as its velocity remains fairly constant; however, any obstruction, such as a submarine rock ridge or a land point cutting across the path of the current, will cause loss of velocity and consequent loss of carrying power.</rdfs:comment>
        <rdfs:label xml:lang="en">longshore current</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOceanDynamics/LoopCurrent -->

    <owl:Class rdf:about="http://sweetontology.net/phenOceanDynamics/LoopCurrent">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOceanDynamics/OceanCurrent"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophod:LoopCurrent</metadata:prefixIRI>
        <rdfs:label xml:lang="en">loop current</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOceanDynamics/MesoscaleEddy -->

    <owl:Class rdf:about="http://sweetontology.net/phenOceanDynamics/MesoscaleEddy">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/phenOceanDynamics/ModeEddy"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidDynamics/Eddy"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/hasSpatialScale"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/stateSpaceScale/Mesoscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophod:MesoscaleEddy</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">In oceanography, densely packed, irregularly oval- shaped high and low pressure centers roughly 400 km (240 miles) in diameter in which current intensities are typically tenfold greater than the local means.</rdfs:comment>
        <rdfs:label xml:lang="en">mesoscale eddy</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOceanDynamics/ModeEddy -->

    <owl:Class rdf:about="http://sweetontology.net/phenOceanDynamics/ModeEddy">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidDynamics/Eddy"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophod:ModeEddy</metadata:prefixIRI>
        <rdfs:label xml:lang="en">mode eddy</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOceanDynamics/OceanCirculation -->

    <owl:Class rdf:about="http://sweetontology.net/phenOceanDynamics/OceanCirculation">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidDynamics/Circulation"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOcean/OceanPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophod:OceanCirculation</metadata:prefixIRI>
        <rdfs:label xml:lang="en">ocean circulation</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOceanDynamics/OceanConveyorBelt -->

    <owl:Class rdf:about="http://sweetontology.net/phenOceanDynamics/OceanConveyorBelt">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOceanDynamics/OceanCirculation"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophod:OceanConveyorBelt</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The global recirculation of water masses that determines today&apos;s climate.</rdfs:comment>
        <rdfs:label xml:lang="en">ocean conveyor belt</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOceanDynamics/OceanCurrent -->

    <owl:Class rdf:about="http://sweetontology.net/phenOceanDynamics/OceanCurrent">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOceanDynamics/OceanCirculation"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophod:OceanCurrent</metadata:prefixIRI>
        <rdfs:label xml:lang="en">ocean current</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOceanDynamics/OceanGyre -->

    <owl:Class rdf:about="http://sweetontology.net/phenOceanDynamics/OceanGyre">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenFluidDynamics/Gyre"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOcean/OceanPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophod:OceanGyre</metadata:prefixIRI>
        <rdfs:label xml:lang="en">ocean gyre</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOceanDynamics/OceanMixing -->

    <owl:Class rdf:about="http://sweetontology.net/phenOceanDynamics/OceanMixing">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenMixing/Mix"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenMixing/Mixing"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOcean/OceanPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophod:OceanMixing</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Any process or series of processes by which parcels of ocean water with different properties are brought into intimate small-scale contact, so that molecular diffusion erases the differences between them.</rdfs:comment>
        <rdfs:label xml:lang="en">ocean mixing</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOceanDynamics/SecondaryCirculation -->

    <owl:Class rdf:about="http://sweetontology.net/phenOceanDynamics/SecondaryCirculation">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOceanDynamics/OceanCirculation"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophod:SecondaryCirculation</metadata:prefixIRI>
        <rdfs:label xml:lang="en">secondary circulation</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOceanDynamics/ThermohalineCirculation -->

    <owl:Class rdf:about="http://sweetontology.net/phenOceanDynamics/ThermohalineCirculation">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOceanDynamics/OceanCirculation"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophod:ThermohalineCirculation</metadata:prefixIRI>
        <rdfs:label xml:lang="en">thermohaline circulation</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOceanDynamics/TidalCurrent -->

    <owl:Class rdf:about="http://sweetontology.net/phenOceanDynamics/TidalCurrent">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOceanDynamics/OceanCurrent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenOceanCoastal/OceanTide"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophod:TidalCurrent</metadata:prefixIRI>
        <rdfs:label xml:lang="en">tidal current</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOceanDynamics/TidalWave -->

    <owl:Class rdf:about="http://sweetontology.net/phenOceanDynamics/TidalWave">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/phenOceanDynamics/Tsunami"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolSeismicity/SeismicWave"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOcean/OceanPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophod:TidalWave</metadata:prefixIRI>
        <rdfs:label xml:lang="en">tidal wave</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOceanDynamics/Tsunami -->

    <owl:Class rdf:about="http://sweetontology.net/phenOceanDynamics/Tsunami">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenGeolSeismicity/SeismicWave"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOcean/OceanPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophod:Tsunami</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Waves generated by seismic activity.</rdfs:comment>
        <rdfs:label xml:lang="en">tsunami</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOceanDynamics/TurbidityCurrent -->

    <owl:Class rdf:about="http://sweetontology.net/phenOceanDynamics/TurbidityCurrent">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOceanDynamics/OceanCurrent"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophod:TurbidityCurrent</metadata:prefixIRI>
        <rdfs:label xml:lang="en">turbidity current</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOceanDynamics/Upwelling -->

    <owl:Class rdf:about="http://sweetontology.net/phenOceanDynamics/Upwelling">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOceanDynamics/OceanCirculation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/hasDirection"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSpaceDirection/Up"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophod:Upwelling</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">An ascending motion of subsurface water by which water from deeper layers is brought into the surface layer and is removed from the area of upwelling by divergent horizontal flow.</rdfs:comment>
        <rdfs:label xml:lang="en">upwelling</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOceanDynamics/WarmCoreCell -->

    <owl:Class rdf:about="http://sweetontology.net/phenOceanDynamics/WarmCoreCell">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOceanDynamics/OceanGyre"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/hasTemperatureRange"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/stateThermodynamic/Warm"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophod:WarmCoreCell</metadata:prefixIRI>
        <rdfs:label xml:lang="en">warm core cell</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOceanDynamics/WesternBoundaryCurrent -->

    <owl:Class rdf:about="http://sweetontology.net/phenOceanDynamics/WesternBoundaryCurrent">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOceanDynamics/BoundaryCurrent"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophod:WesternBoundaryCurrent</metadata:prefixIRI>
        <rdfs:label xml:lang="en">western boundary current</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOceanDynamics/WesternIntensification -->

    <owl:Class rdf:about="http://sweetontology.net/phenOceanDynamics/WesternIntensification">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOceanDynamics/BoundaryCurrent"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophod:WesternIntensification</metadata:prefixIRI>
        <rdfs:label xml:lang="en">western intensification</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenOceanDynamics/WindDrivenCirculation -->

    <owl:Class rdf:about="http://sweetontology.net/phenOceanDynamics/WindDrivenCirculation">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenOceanDynamics/OceanCirculation"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophod:WindDrivenCirculation</metadata:prefixIRI>
        <rdfs:label xml:lang="en">wind driven circulation</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenPlanetClimate/Climate -->

    <owl:Class rdf:about="http://sweetontology.net/phenPlanetClimate/Climate">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/phenPlanetClimate/ClimateAverage"/>
        <owl:equivalentClass rdf:resource="http://sweetontology.net/phenPlanetClimate/ClimaticAverage"/>
        <owl:equivalentClass rdf:resource="http://sweetontology.net/phenPlanetClimate/ClimatologicalAverage"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phen/PlanetaryPhenomena"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propFunction/TemporalAverage"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propFunction/TemporalMean"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propFunction/TimeAverage"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propFunction/TimeMean"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasQuantity"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/propChemical/Moisture"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasQuantity"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/propTemperature/Temperature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophpc:Climate</metadata:prefixIRI>
        <rdfs:label xml:lang="en">climate</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenPlanetClimate/ClimateAnomaly -->

    <owl:Class rdf:about="http://sweetontology.net/phenPlanetClimate/ClimateAnomaly">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/phenPlanetClimate/ClimaticAnomaly"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenPlanetClimate/ClimatePhenomena"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propDifference/Anomaly"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/deviationFrom"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/phenPlanetClimate/Climate"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophpc:ClimateAnomaly</metadata:prefixIRI>
        <rdfs:label xml:lang="en">climate anomaly</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenPlanetClimate/ClimateAverage -->

    <owl:Class rdf:about="http://sweetontology.net/phenPlanetClimate/ClimateAverage">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phen/PlanetaryPhenomena"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propFunction/TemporalAverage"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propFunction/TemporalMean"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propFunction/TimeAverage"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propFunction/TimeMean"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophpc:ClimateAverage</metadata:prefixIRI>
        <rdfs:label xml:lang="en">climate average</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenPlanetClimate/ClimateChange -->

    <owl:Class rdf:about="http://sweetontology.net/phenPlanetClimate/ClimateChange">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenPlanetClimate/GlobalChange"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophpc:ClimateChange</metadata:prefixIRI>
        <rdfs:label xml:lang="en">climate change</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenPlanetClimate/ClimatePhenomena -->

    <owl:Class rdf:about="http://sweetontology.net/phenPlanetClimate/ClimatePhenomena">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phen/PlanetaryPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophpc:ClimatePhenomena</metadata:prefixIRI>
        <rdfs:label xml:lang="en">climate phenomena</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenPlanetClimate/ClimaticAnomaly -->

    <owl:Class rdf:about="http://sweetontology.net/phenPlanetClimate/ClimaticAnomaly">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenPlanetClimate/ClimatePhenomena"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propDifference/Anomaly"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophpc:ClimaticAnomaly</metadata:prefixIRI>
        <rdfs:label xml:lang="en">climatic anomaly</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenPlanetClimate/ClimaticAverage -->

    <owl:Class rdf:about="http://sweetontology.net/phenPlanetClimate/ClimaticAverage">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phen/PlanetaryPhenomena"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propFunction/TemporalAverage"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propFunction/TemporalMean"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propFunction/TimeAverage"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propFunction/TimeMean"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophpc:ClimaticAverage</metadata:prefixIRI>
        <rdfs:label xml:lang="en">climatic average</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenPlanetClimate/ClimatologicalAverage -->

    <owl:Class rdf:about="http://sweetontology.net/phenPlanetClimate/ClimatologicalAverage">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phen/PlanetaryPhenomena"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propFunction/TemporalAverage"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propFunction/TemporalMean"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propFunction/TimeAverage"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propFunction/TimeMean"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophpc:ClimatologicalAverage</metadata:prefixIRI>
        <rdfs:label xml:lang="en">climatological average</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenPlanetClimate/Drought -->

    <owl:Class rdf:about="http://sweetontology.net/phenPlanetClimate/Drought">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenPlanetClimate/ClimateAnomaly"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenPlanetClimate/ClimaticAnomaly"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophpc:Drought</metadata:prefixIRI>
        <rdfs:label xml:lang="en">drought</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenPlanetClimate/GlobalChange -->

    <owl:Class rdf:about="http://sweetontology.net/phenPlanetClimate/GlobalChange">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenPlanetClimate/ClimatePhenomena"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/hasSpatialScale"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/stateSpaceScale/Global"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophpc:GlobalChange</metadata:prefixIRI>
        <rdfs:label xml:lang="en">global change</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenPlanetClimate/GlobalClimate -->

    <owl:Class rdf:about="http://sweetontology.net/phenPlanetClimate/GlobalClimate">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenPlanetClimate/Climate"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenPlanetClimate/ClimateAverage"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenPlanetClimate/ClimaticAverage"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenPlanetClimate/ClimatologicalAverage"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propFunction/Average"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propFunction/Mean"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/averageOver"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/reprSpace/Space"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/hasSpatialScale"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/stateSpaceScale/Global"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophpc:GlobalClimate</metadata:prefixIRI>
        <rdfs:label xml:lang="en">global climate</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenPlanetClimate/GlobalWarming -->

    <owl:Class rdf:about="http://sweetontology.net/phenPlanetClimate/GlobalWarming">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenPlanetClimate/GlobalChange"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenPlanetClimate/GreenhouseEffect"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophpc:GlobalWarming</metadata:prefixIRI>
        <rdfs:label xml:lang="en">global warming</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenPlanetClimate/GreenhouseEffect -->

    <owl:Class rdf:about="http://sweetontology.net/phenPlanetClimate/GreenhouseEffect">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenPlanetClimate/GlobalWarming"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophpc:GreenhouseEffect</metadata:prefixIRI>
        <rdfs:label xml:lang="en">greenhouse effect</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenPlanetClimate/HeatIsland -->

    <owl:Class rdf:about="http://sweetontology.net/phenPlanetClimate/HeatIsland">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenPlanetClimate/ClimatePhenomena"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/hasSpatialScale"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/stateSpaceScale/Microscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophpc:HeatIsland</metadata:prefixIRI>
        <rdfs:label xml:lang="en">heat island</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenPlanetClimate/LocalClimate -->

    <owl:Class rdf:about="http://sweetontology.net/phenPlanetClimate/LocalClimate">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenPlanetClimate/Climate"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenPlanetClimate/ClimateAverage"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenPlanetClimate/ClimaticAverage"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenPlanetClimate/ClimatologicalAverage"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophpc:LocalClimate</metadata:prefixIRI>
        <rdfs:label xml:lang="en">local climate</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenPlanetClimate/Mesoclimate -->

    <owl:Class rdf:about="http://sweetontology.net/phenPlanetClimate/Mesoclimate">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenPlanetClimate/Climate"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenPlanetClimate/ClimateAverage"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenPlanetClimate/ClimaticAverage"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenPlanetClimate/ClimatologicalAverage"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/hasSpatialScale"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/stateSpaceScale/Mesoscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophpc:Mesoclimate</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The climate of a natural region of small extent, for example, valley, forest, plantation, and park. Because of subtle differences in elevation and exposure, the climate may not be representative of the general climate of the region.</rdfs:comment>
        <rdfs:label xml:lang="en">mesoclimate</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenPlanetClimate/Microclimate -->

    <owl:Class rdf:about="http://sweetontology.net/phenPlanetClimate/Microclimate">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenPlanetClimate/Climate"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenPlanetClimate/ClimateAverage"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenPlanetClimate/ClimaticAverage"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenPlanetClimate/ClimatologicalAverage"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/hasSpatialScale"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/stateSpaceScale/Microscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophpc:Microclimate</metadata:prefixIRI>
        <rdfs:label xml:lang="en">microclimate</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenPlanetClimate/MoistureClimate -->

    <owl:Class rdf:about="http://sweetontology.net/phenPlanetClimate/MoistureClimate">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenPlanetClimate/Climate"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenPlanetClimate/ClimateAverage"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenPlanetClimate/ClimaticAverage"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenPlanetClimate/ClimatologicalAverage"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasQuantity"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/propChemical/Moisture"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophpc:MoistureClimate</metadata:prefixIRI>
        <rdfs:label xml:lang="en">moisture climate</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenPlanetClimate/NuclearWinter -->

    <owl:Class rdf:about="http://sweetontology.net/phenPlanetClimate/NuclearWinter">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenPlanetClimate/ClimatePhenomena"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/hasSpatialScale"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/stateSpaceScale/Global"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophpc:NuclearWinter</metadata:prefixIRI>
        <rdfs:label xml:lang="en">nuclear winter</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenPlanetClimate/Paleoclimate -->

    <owl:Class rdf:about="http://sweetontology.net/phenPlanetClimate/Paleoclimate">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenPlanetClimate/Climate"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenPlanetClimate/ClimateAverage"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenPlanetClimate/ClimaticAverage"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenPlanetClimate/ClimatologicalAverage"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophpc:Paleoclimate</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Climate for periods prior to the development of measuring instruments, including historic and geologic time, for which only proxy climate records are available.</rdfs:comment>
        <rdfs:label xml:lang="en">paleoclimate</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenPlanetClimate/RegionalClimate -->

    <owl:Class rdf:about="http://sweetontology.net/phenPlanetClimate/RegionalClimate">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenPlanetClimate/Climate"/>
