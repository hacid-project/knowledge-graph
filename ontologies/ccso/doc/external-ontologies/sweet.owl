    <!-- http://sweetontology.net/propIndex/StandardizedPrecipitationIndex -->

    <owl:Class rdf:about="http://sweetontology.net/propIndex/StandardizedPrecipitationIndex">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propIndex/DroughtIndex"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropi:StandardizedPrecipitationIndex</metadata:prefixIRI>
        <rdfs:label xml:lang="en">standardized precipitation index</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propIndex/StorageCoefficient -->

    <owl:Class rdf:about="http://sweetontology.net/propIndex/StorageCoefficient">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/propIndex/Storativity"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/prop/HydrogeologicalProperty"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropi:StorageCoefficient</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The volume of water an aquifer releases from or takes into storage per unit surface area of the aquifer per unit change in head (virtually equal to the specific yield in an unconfined aquifer).</rdfs:comment>
        <rdfs:label xml:lang="en">storage coefficient</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propIndex/Storativity -->

    <owl:Class rdf:about="http://sweetontology.net/propIndex/Storativity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/prop/HydrogeologicalProperty"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropi:Storativity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">storativity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propIndex/SurfaceMoistureIndex -->

    <owl:Class rdf:about="http://sweetontology.net/propIndex/SurfaceMoistureIndex">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propIndex/DroughtIndex"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropi:SurfaceMoistureIndex</metadata:prefixIRI>
        <rdfs:label xml:lang="en">surface moisture index</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propIndex/Turbidity -->

    <owl:Class rdf:about="http://sweetontology.net/propIndex/Turbidity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/RadiationMediumInteractionQuantity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/FTU"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropi:Turbidity</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The effect of (primarily) aerosols, through their total optical depth, in reducing the transmission of direct solar radiation to the surface below that through a purely molecular atmosphere. Turbidity is the cloudiness or haziness of a fluid, or of air, caused by individual particles (suspended solids) that are generally invisible to the naked eye, similar to smoke in air.</rdfs:comment>
        <rdfs:label xml:lang="en">turbidity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propIndex/UVIndex -->

    <owl:Class rdf:about="http://sweetontology.net/propIndex/UVIndex">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propIndex/AirQualityIndex"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropi:UVIndex</metadata:prefixIRI>
        <rdfs:label xml:lang="en">u v index</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propIndex/Virulence -->

    <owl:Class rdf:about="http://sweetontology.net/propIndex/Virulence">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propIndex/HealthIndex"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropi:Virulence</metadata:prefixIRI>
        <rdfs:label xml:lang="en">virulence</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propIndex/VitalStatistics -->

    <owl:Class rdf:about="http://sweetontology.net/propIndex/VitalStatistics">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propIndex/HealthIndex"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropi:VitalStatistics</metadata:prefixIRI>
        <rdfs:label xml:lang="en">vital statistics</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propIndex/WaterQualityIndex -->

    <owl:Class rdf:about="http://sweetontology.net/propIndex/WaterQualityIndex">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propIndex/EnvironmentalIndex"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropi:WaterQualityIndex</metadata:prefixIRI>
        <rdfs:label xml:lang="en">water quality index</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propIndex/ZonalIndex -->

    <owl:Class rdf:about="http://sweetontology.net/propIndex/ZonalIndex">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propIndex/IndexDefinedByDifference"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropi:ZonalIndex</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A measure of strength of the middle-latitude westerlies, usually expressed as the horizontal pressure difference between 35 and 55N latitude, or as the corresponding geostrophic wind.</rdfs:comment>
        <rdfs:label xml:lang="en">zonal index</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propMass/BulkDensity -->

    <owl:Class rdf:about="http://sweetontology.net/propMass/BulkDensity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMass/Density"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMass/MassConcentration"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropm:BulkDensity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">bulk density</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propMass/Consistence -->

    <owl:Class rdf:about="http://sweetontology.net/propMass/Consistence">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/propMass/Consistency"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMass/ConsistenceProperty"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropm:Consistence</metadata:prefixIRI>
        <rdfs:label xml:lang="en">consistence</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propMass/ConsistenceProperty -->

    <owl:Class rdf:about="http://sweetontology.net/propMass/ConsistenceProperty">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMass/MaterialProperty"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropm:ConsistenceProperty</metadata:prefixIRI>
        <rdfs:label xml:lang="en">consistence property</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propMass/Consistency -->

    <owl:Class rdf:about="http://sweetontology.net/propMass/Consistency">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMass/ConsistenceProperty"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropm:Consistency</metadata:prefixIRI>
        <rdfs:label xml:lang="en">consistency</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propMass/Content -->

    <owl:Class rdf:about="http://sweetontology.net/propMass/Content">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMass/Density"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMass/MassConcentration"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprMathOperation/Ratio"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/hasSecondOperand"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propSpaceMultidimensional/Area"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropm:Content</metadata:prefixIRI>
        <rdfs:label xml:lang="en">content</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propMass/Density -->

    <owl:Class rdf:about="http://sweetontology.net/propMass/Density">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/propMass/MassConcentration"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/IntensiveProperty"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/kilogramPerMeterCubed"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropm:Density</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">1. The ratio of the mass of any substance to the volume occupied by it (usually expressed in kilograms per cubic meter, but any other unit system may be used); the reciprocal of specific volume.</rdfs:comment>
        <rdfs:label xml:lang="en">density</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propMass/DissolvedConcentration -->

    <owl:Class rdf:about="http://sweetontology.net/propMass/DissolvedConcentration">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMass/Density"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMass/MassConcentration"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropm:DissolvedConcentration</metadata:prefixIRI>
        <rdfs:label xml:lang="en">dissolved concentration</rdfs:label>
    </owl:Class>
    


