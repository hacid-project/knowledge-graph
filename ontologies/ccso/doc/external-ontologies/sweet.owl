        <rdf:type rdf:resource="http://sweetontology.net/propOrdinal/Visibility"/>
        <owl:sameAs rdf:resource="http://sweetontology.net/stateVisibility/Sunshine"/>
        <rdfs:comment xml:lang="en"> When the direct radiation is not blocked by clouds, it is experienced as sunshine, a combination of bright light and heat.</rdfs:comment>
        <rdfs:label xml:lang="en">sunny</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/stateVisibility/Sunshine -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/stateVisibility/Sunshine">
        <rdf:type rdf:resource="http://sweetontology.net/propOrdinal/Visibility"/>
        <rdfs:label xml:lang="en">sunshine</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/stateVisibility/Translucent -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/stateVisibility/Translucent">
        <rdf:type rdf:resource="http://sweetontology.net/propOrdinal/Visibility"/>
        <relaPhysical:moreVisibleThan rdf:resource="http://sweetontology.net/stateVisibility/Opaque"/>
        <rdfs:label xml:lang="en">translucent</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/stateVisibility/Transparent -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/stateVisibility/Transparent">
        <rdf:type rdf:resource="http://sweetontology.net/propOrdinal/Visibility"/>
        <relaPhysical:moreVisibleThan rdf:resource="http://sweetontology.net/stateVisibility/Translucent"/>
        <rdfs:label xml:lang="en">transparent</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://sweetontology.net/stateVisibility/Turbid -->

    <owl:NamedIndividual rdf:about="http://sweetontology.net/stateVisibility/Turbid">
