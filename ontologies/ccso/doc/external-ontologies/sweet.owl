        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophcm:HydrologicCycle</metadata:prefixIRI>
        <rdfs:label xml:lang="en">hydrologic cycle</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenCycleMaterial/HydrologicalCycle -->

