    <!-- http://sweetontology.net/phenStar/CoronalMassEjection -->

    <owl:Class rdf:about="http://sweetontology.net/phenStar/CoronalMassEjection">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenStar/CoronalPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophst:CoronalMassEjection</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A coronal mass ejection (CME) is an ejection of material from the solar corona, usually observed with a white-light coronagraph. The ejected material is a plasma consisting primarily of electrons and protons (in addition to small quantities of heavier elements such as helium, oxygen, and iron), plus the entrained coronal magnetic field.</rdfs:comment>
        <rdfs:label xml:lang="en">coronal mass ejection</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenStar/CoronalPhenomena -->

    <owl:Class rdf:about="http://sweetontology.net/phenStar/CoronalPhenomena">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenStar/StellarPhenomena"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRealm"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmAstroStar/Corona"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophst:CoronalPhenomena</metadata:prefixIRI>
        <rdfs:label xml:lang="en">coronal phenomena</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenStar/CoronalRain -->

    <owl:Class rdf:about="http://sweetontology.net/phenStar/CoronalRain">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenStar/CoronalPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophst:CoronalRain</metadata:prefixIRI>
        <rdfs:label xml:lang="en">coronal rain</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenStar/FMode -->

    <owl:Class rdf:about="http://sweetontology.net/phenStar/FMode">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenStar/SolarPhenomena"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/GravitationalWave"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/GravityWave"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/SurfaceWave"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophst:FMode</metadata:prefixIRI>
        <rdfs:label xml:lang="en">f mode</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenStar/Filament -->

    <owl:Class rdf:about="http://sweetontology.net/phenStar/Filament">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenStar/Prominence"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophst:Filament</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">If a solar prominence occurs on the disc of the sun it appears darker than its background (due to the lower temperature of the plasma). These are referred to as solar filaments.</rdfs:comment>
        <rdfs:label xml:lang="en">filament</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenStar/Flare -->

    <owl:Class rdf:about="http://sweetontology.net/phenStar/Flare">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenStar/StellarPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophst:Flare</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A flare is a violent explosion in the atmosphere of a star. Flares take place in the corona and chromosphere, heating plasma to tens of millions of kelvins and accelerating electrons, protons and heavier ions to near the speed of light. They produce electromagnetic radiation across the electromagnetic spectrum at all wavelengths from long-wave radio to the shortest wavelength gamma rays  Most flares occur in active regions around sunspots, where intense magnetic fields emerge from the surface into the corona. Flares are powered by the sudden (timescales of minutes to tens of minutes) release of magnetic energy stored in the corona.</rdfs:comment>
        <rdfs:label xml:lang="en">flare</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenStar/GMode -->

    <owl:Class rdf:about="http://sweetontology.net/phenStar/GMode">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenStar/SolarPhenomena"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/GravitationalWave"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/GravityWave"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophst:GMode</metadata:prefixIRI>
        <rdfs:label xml:lang="en">g mode</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenStar/Granulation -->

    <owl:Class rdf:about="http://sweetontology.net/phenStar/Granulation">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/phenStar/Granule"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenStar/StellarPhenomena"/>
        <owl:disjointWith rdf:resource="http://sweetontology.net/phenStar/Supergranulation"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophst:Granulation</metadata:prefixIRI>
        <rdfs:label xml:lang="en">granulation</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenStar/Granule -->

    <owl:Class rdf:about="http://sweetontology.net/phenStar/Granule">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenStar/StellarPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophst:Granule</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Granules on the photosphere are caused by convection currents (thermal columns, Bénard cells) of plasma within the Sconvective zone.</rdfs:comment>
        <rdfs:label xml:lang="en">granule</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenStar/Helioseismology -->

    <owl:Class rdf:about="http://sweetontology.net/phenStar/Helioseismology">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenStar/Asteroseismology"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophst:Helioseismology</metadata:prefixIRI>
        <rdfs:label xml:lang="en">helioseismology</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenStar/PMode -->

    <owl:Class rdf:about="http://sweetontology.net/phenStar/PMode">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenStar/SolarPhenomena"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/Acoustic"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/AcousticWave"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/Acoustics"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/Sound"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/SoundWave"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophst:PMode</metadata:prefixIRI>
        <rdfs:label xml:lang="en">p mode</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenStar/Plage -->

    <owl:Class rdf:about="http://sweetontology.net/phenStar/Plage">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenStar/SolarPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophst:Plage</metadata:prefixIRI>
        <rdfs:label xml:lang="en">plage</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenStar/Prominence -->

    <owl:Class rdf:about="http://sweetontology.net/phenStar/Prominence">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenStar/StellarPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophst:Prominence</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A solar prominence is a large bright feature extending outwards from the sun&apos;s surface, often in a loop configuration. Prominences are anchored to the solar surface in the photosphere, and extend outwards into the solar corona. While the corona consists of extremely hot ionized gases, known as plasma, which do not emit much visible light, prominences contain much cooler plasma, similar in composition to that of the chromosphere. A prominence forms over timescales of about a day, and stable prominences may persist in the corona for several months. Some prominences break apart and give rise to coronal mass ejections</rdfs:comment>
        <rdfs:label xml:lang="en">prominence</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenStar/SolarActivity -->

    <owl:Class rdf:about="http://sweetontology.net/phenStar/SolarActivity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenStar/SolarPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophst:SolarActivity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">solar activity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenStar/SolarPhenomena -->

    <owl:Class rdf:about="http://sweetontology.net/phenStar/SolarPhenomena">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenStar/StellarPhenomena"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/hasAstronomicalBody"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/phenStar/Sun"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophst:SolarPhenomena</metadata:prefixIRI>
        <rdfs:label xml:lang="en">solar phenomena</rdfs:label>
    </owl:Class>
    


