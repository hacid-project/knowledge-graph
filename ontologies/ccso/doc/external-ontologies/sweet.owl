        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/DissolvedSubstance"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/SolidSubstance"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soma:DissolvedSolid</metadata:prefixIRI>
