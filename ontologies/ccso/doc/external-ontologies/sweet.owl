            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/diameter"/>
                <owl:hasValue>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://sweetontology.net/propSpaceDistance/SizeRange_micron"/>
                    </rdf:Description>
                </owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somaw:RainDrop</metadata:prefixIRI>
        <rdfs:label xml:lang="en">rain drop</rdfs:label>
    </owl:Class>
    


