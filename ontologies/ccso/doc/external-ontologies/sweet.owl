    <owl:Class rdf:about="http://sweetontology.net/matrInstrument/Telethermometer">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrInstrument/Thermometer"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somains:Telethermometer</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A temperature-measuring system in which the thermally sensitive element is located at a distance from the indicating element.</rdfs:comment>
        <rdfs:label xml:lang="en">telethermometer</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrInstrument/Tensiometer -->

    <owl:Class rdf:about="http://sweetontology.net/matrInstrument/Tensiometer">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrInstrument/Device"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrInstrument/Instrument"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somains:Tensiometer</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A device used to measure the moisture tension in the unsaturated zone.</rdfs:comment>
        <rdfs:label xml:lang="en">tensiometer</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrInstrument/Thermometer -->

    <owl:Class rdf:about="http://sweetontology.net/matrInstrument/Thermometer">
