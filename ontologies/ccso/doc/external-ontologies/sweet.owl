    <owl:Class rdf:about="http://sweetontology.net/reprSciLaw/EmpiricalLaw">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/repr/Knowledge"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorepsl:EmpiricalLaw</metadata:prefixIRI>
        <rdfs:label xml:lang="en">empirical law</rdfs:label>
    </owl:Class>
    


