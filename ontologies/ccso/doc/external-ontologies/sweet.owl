        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrElement/Element"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somael:Nonmetal</metadata:prefixIRI>
