    <!-- http://sweetontology.net/propSpaceHeight/Altitude -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceHeight/Altitude">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/propSpaceHeight/Elevation"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceHeight/Height"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsh:Altitude</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A measure (or condition) of height, especially of great height, as a mountain top or aircraft flight level.</rdfs:comment>
        <rdfs:comment xml:lang="en">The vertical distance above mean sea level of the ground at the meteorological station.</rdfs:comment>
        <rdfs:label xml:lang="en">altitude</rdfs:label>
    </owl:Class>
    


