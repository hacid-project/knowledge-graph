    </owl:Class>
    


    <!-- http://sweetontology.net/propMass/Grade -->

    <owl:Class rdf:about="http://sweetontology.net/propMass/Grade">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMass/Density"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMass/MassConcentration"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropm:Grade</metadata:prefixIRI>
        <rdfs:label xml:lang="en">grade</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propMass/Hardness -->

    <owl:Class rdf:about="http://sweetontology.net/propMass/Hardness">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMass/StrengthProperty"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropm:Hardness</metadata:prefixIRI>
