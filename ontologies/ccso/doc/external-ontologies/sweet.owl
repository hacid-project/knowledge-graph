            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophei:SoilLoss</metadata:prefixIRI>
        <rdfs:label xml:lang="en">soil loss</rdfs:label>
    </owl:Class>
    


