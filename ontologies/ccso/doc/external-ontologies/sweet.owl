        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropef:SpecificIntensity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">specific intensity</rdfs:label>
    </owl:Class>
    


