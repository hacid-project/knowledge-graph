                <owl:allValuesFrom rdf:resource="http://sweetontology.net/reprMathFunction/VectorField"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soproptf:Convergence</metadata:prefixIRI>
        <rdfs:label xml:lang="en">convergence</rdfs:label>
    </owl:Class>
    


