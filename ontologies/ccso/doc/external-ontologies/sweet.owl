    <owl:Class rdf:about="http://sweetontology.net/propSpaceThickness/StaticHead">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceThickness/FluidHead"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropst:StaticHead</metadata:prefixIRI>
        <rdfs:label xml:lang="en">static head</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceThickness/StreamStage -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceThickness/StreamStage">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceThickness/StageHeight"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropst:StreamStage</metadata:prefixIRI>
        <rdfs:label xml:lang="en">stream stage</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceThickness/Thickness -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceThickness/Thickness">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/PhysicalQuantity"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceHeight/VerticalExtent"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropst:Thickness</metadata:prefixIRI>
        <rdfs:label xml:lang="en">thickness</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceThickness/TotalHead -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceThickness/TotalHead">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceThickness/FluidHead"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropst:TotalHead</metadata:prefixIRI>
        <rdfs:label xml:lang="en">total head</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceThickness/WaterContent -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceThickness/WaterContent">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceThickness/Thickness"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaChemical/hasChemical"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/matrWater/LiquidWater"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropst:WaterContent</metadata:prefixIRI>
        <rdfs:label xml:lang="en">water content</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpaceThickness/WaterHeight -->

    <owl:Class rdf:about="http://sweetontology.net/propSpaceThickness/WaterHeight">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceThickness/Thickness"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaChemical/hasSubstance"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/matrWater/LiquidWater"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropst:WaterHeight</metadata:prefixIRI>
        <rdfs:label xml:lang="en">water height</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpeed/Acceleration -->

    <owl:Class rdf:about="http://sweetontology.net/propSpeed/Acceleration">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/prop/MotionProperty"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/PhysicalQuantity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/meterPerSecondSquared"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsp:Acceleration</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The rate of change with time of the velocity vector of a particle.</rdfs:comment>
        <rdfs:label xml:lang="en">acceleration</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpeed/Airspeed -->

    <owl:Class rdf:about="http://sweetontology.net/propSpeed/Airspeed">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpeed/Speed"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsp:Airspeed</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Airspeed is the speed of an aircraft relative to the air. There are several different measures of airspeed: indicated airspeed, calibrated airspeed, equivalent airspeed and true airspeed.</rdfs:comment>
        <rdfs:label xml:lang="en">airspeed</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpeed/AlfvenVelocity -->

    <owl:Class rdf:about="http://sweetontology.net/propSpeed/AlfvenVelocity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpeed/Velocity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsp:AlfvenVelocity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">alfven velocity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpeed/DopplerVelocity -->

    <owl:Class rdf:about="http://sweetontology.net/propSpeed/DopplerVelocity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpeed/Velocity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsp:DopplerVelocity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">doppler velocity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpeed/Drift -->

    <owl:Class rdf:about="http://sweetontology.net/propSpeed/Drift">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpeed/Velocity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsp:Drift</metadata:prefixIRI>
        <rdfs:label xml:lang="en">drift</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpeed/EscapeVelocity -->

    <owl:Class rdf:about="http://sweetontology.net/propSpeed/EscapeVelocity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpeed/Velocity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsp:EscapeVelocity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">escape velocity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpeed/GroundSpeed -->

    <owl:Class rdf:about="http://sweetontology.net/propSpeed/GroundSpeed">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpeed/Speed"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsp:GroundSpeed</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Ground speed is the speed of an aircraft relative to the ground. It is the sum of the aircraft&apos;s true airspeed and the current wind and weather conditions; a headwind subtracts from the ground speed, while a tailwind adds to it. Winds at other angles to the heading will have components of either headwind or tailwind as well as a crosswind component.</rdfs:comment>
        <rdfs:label xml:lang="en">ground speed</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpeed/GroupVelocity -->

    <owl:Class rdf:about="http://sweetontology.net/propSpeed/GroupVelocity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/prop/WaveProperty"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpeed/Velocity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsp:GroupVelocity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">group velocity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpeed/Inertia -->

    <owl:Class rdf:about="http://sweetontology.net/propSpeed/Inertia">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpeed/Momentum"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsp:Inertia</metadata:prefixIRI>
        <rdfs:label xml:lang="en">inertia</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpeed/IonVelocity -->

    <owl:Class rdf:about="http://sweetontology.net/propSpeed/IonVelocity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpeed/Velocity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsp:IonVelocity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">ion velocity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpeed/MagnetiCurvatureDrift -->

    <owl:Class rdf:about="http://sweetontology.net/propSpeed/MagnetiCurvatureDrift">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/ElectromagneticQuantity"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpeed/Drift"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsp:MagnetiCurvatureDrift</metadata:prefixIRI>
        <rdfs:label xml:lang="en">magneti curvature drift</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpeed/Momentum -->

    <owl:Class rdf:about="http://sweetontology.net/propSpeed/Momentum">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/prop/MotionProperty"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/PhysicalQuantity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/kilogramMeterPerSecond"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsp:Momentum</metadata:prefixIRI>
        <rdfs:label xml:lang="en">momentum</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpeed/NeutralVelocity -->

    <owl:Class rdf:about="http://sweetontology.net/propSpeed/NeutralVelocity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpeed/Velocity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsp:NeutralVelocity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">neutral velocity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpeed/Omega -->

    <owl:Class rdf:about="http://sweetontology.net/propSpeed/Omega">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpeed/VerticalVelocity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsp:Omega</metadata:prefixIRI>
        <rdfs:label xml:lang="en">omega</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpeed/PhaseVelocity -->

    <owl:Class rdf:about="http://sweetontology.net/propSpeed/PhaseVelocity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/prop/WaveProperty"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpeed/Velocity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsp:PhaseVelocity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">phase velocity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpeed/ProperMotion -->

    <owl:Class rdf:about="http://sweetontology.net/propSpeed/ProperMotion">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpeed/Speed"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsp:ProperMotion</metadata:prefixIRI>
        <rdfs:label xml:lang="en">proper motion</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpeed/RadialVelocity -->

    <owl:Class rdf:about="http://sweetontology.net/propSpeed/RadialVelocity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpeed/Velocity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsp:RadialVelocity</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The component of a three-dimensional velocity vector oriented along the radial direction from the origin point or axis in polar, cylindrical, or spherical coordinates.  In connection with Doppler radar, the radial velocity component is called Doppler velocity.</rdfs:comment>
        <rdfs:label xml:lang="en">radial velocity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpeed/SeepageVelocity -->

    <owl:Class rdf:about="http://sweetontology.net/propSpeed/SeepageVelocity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/prop/HydrogeologicalProperty"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpeed/Velocity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsp:SeepageVelocity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">seepage velocity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpeed/Speed -->

    <owl:Class rdf:about="http://sweetontology.net/propSpeed/Speed">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/prop/MotionProperty"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/PhysicalQuantity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/meterPerSecond"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsp:Speed</metadata:prefixIRI>
        <rdfs:label xml:lang="en">speed</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpeed/TangentialAcceleration -->

    <owl:Class rdf:about="http://sweetontology.net/propSpeed/TangentialAcceleration">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpeed/Acceleration"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsp:TangentialAcceleration</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The component of the acceleration directed along the velocity vector (streamline), with magnitude equal to the rate of change of speed of the parcel dV/dt, where V is the speed.</rdfs:comment>
        <rdfs:label xml:lang="en">tangential acceleration</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpeed/TerminalVelocity -->

    <owl:Class rdf:about="http://sweetontology.net/propSpeed/TerminalVelocity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpeed/Velocity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsp:TerminalVelocity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">terminal velocity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpeed/ThermalVelocity -->

    <owl:Class rdf:about="http://sweetontology.net/propSpeed/ThermalVelocity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpeed/Velocity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsp:ThermalVelocity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">thermal velocity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpeed/Velocity -->

    <owl:Class rdf:about="http://sweetontology.net/propSpeed/Velocity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/prop/MotionProperty"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/PhysicalQuantity"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprMath/Vector"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/meterPerSecond"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsp:Velocity</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The time rate of change of a position vector; that is, a change of position expressed in terms of speed and direction.</rdfs:comment>
        <rdfs:label xml:lang="en">velocity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpeed/VerticalVelocity -->

    <owl:Class rdf:about="http://sweetontology.net/propSpeed/VerticalVelocity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpeed/Velocity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/hasDirection"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSpaceDirection/Vertical"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsp:VerticalVelocity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">vertical velocity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpeed/WindShear -->

    <owl:Class rdf:about="http://sweetontology.net/propSpeed/WindShear">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/prop/FluidProperty"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsp:WindShear</metadata:prefixIRI>
        <rdfs:label xml:lang="en">wind shear</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propSpeed/WindSpeed -->

    <owl:Class rdf:about="http://sweetontology.net/propSpeed/WindSpeed">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpeed/Speed"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenAtmoWind/Wind"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsp:WindSpeed</metadata:prefixIRI>
        <rdfs:label xml:lang="en">wind speed</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperature/AntennaTemperature -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperature/AntennaTemperature">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTemperature/Temperature"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropt:AntennaTemperature</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Antenna temperature is a way of expressing the brightness of a radiation source - it is proportional to the power per unit area emitted by the source. In most cases where it is used it corresponds to the thermodynamic or physical temperature of the source being observed. It thus relates the power emitted by the source to an interesting physical property of that source.</rdfs:comment>
        <rdfs:label xml:lang="en">antenna temperature</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperature/BoilingPoint -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperature/BoilingPoint">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTemperature/Temperature"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropt:BoilingPoint</metadata:prefixIRI>
        <rdfs:label xml:lang="en">boiling point</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperature/BrightnessTemperature -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperature/BrightnessTemperature">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTemperature/Temperature"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropt:BrightnessTemperature</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A descriptive measure of radiation in terms of the temperature of a hypothetical blackbody emitting an identical amount of radiation at the same wavelength.</rdfs:comment>
        <rdfs:label xml:lang="en">brightness temperature</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperature/ColdestMonthTemperature -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperature/ColdestMonthTemperature">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTemperature/Temperature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/reprTimeSeason/ColdestMonth"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropt:ColdestMonthTemperature</metadata:prefixIRI>
        <rdfs:label xml:lang="en">coldest month temperature</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperature/DewPoint -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperature/DewPoint">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/propTemperature/DewPointTemperature"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTemperature/Temperature"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropt:DewPoint</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The temperature to which a given air parcel must be cooled at constant pressure and constant water vapor content in order for saturation to occur.</rdfs:comment>
        <rdfs:label xml:lang="en">dew point</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperature/DewPointDepression -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperature/DewPointDepression">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTemperature/Temperature"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprMathOperation/Difference"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprMathOperation/Subtraction"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/hasFirstOperand"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propTemperature/DryBulbTemperature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/hasSecondOperand"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propTemperature/DewPointTemperature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropt:DewPointDepression</metadata:prefixIRI>
        <rdfs:label xml:lang="en">dew point depression</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperature/DewPointTemperature -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperature/DewPointTemperature">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTemperature/Temperature"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropt:DewPointTemperature</metadata:prefixIRI>
        <rdfs:label xml:lang="en">dew point temperature</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperature/DryBulbTemperature -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperature/DryBulbTemperature">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTemperature/Temperature"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropt:DryBulbTemperature</metadata:prefixIRI>
        <rdfs:label xml:lang="en">dry bulb temperature</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperature/EffectiveTemperature -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperature/EffectiveTemperature">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTemperature/Temperature"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropt:EffectiveTemperature</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The temperature at which motionless saturated air would induce, in a sedentary worker wearing ordinary indoor clothing, the same sensation of comfort as that induced by the actual conditions of temperature, humidity, and air movement. Effective temperature is used as a guide in air-conditioning practice, and, on the comfort chart (American Society of Heating and Air Conditioning Engineers), it appears as a family of curves that serves as one coordinate in defining comfort zones.</rdfs:comment>
        <rdfs:label xml:lang="en">effective temperature</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperature/ElectronTemperature -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperature/ElectronTemperature">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTemperature/Temperature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaChemical/hasSubstance"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/matrParticle/Electron"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropt:ElectronTemperature</metadata:prefixIRI>
        <rdfs:label xml:lang="en">electron temperature</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperature/EquivalentPotentialTemperature -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperature/EquivalentPotentialTemperature">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTemperature/PotentialTemperature"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropt:EquivalentPotentialTemperature</metadata:prefixIRI>
        <rdfs:label xml:lang="en">equivalent potential temperature</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperature/EquivalentTemperature -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperature/EquivalentTemperature">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTemperature/Temperature"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropt:EquivalentTemperature</metadata:prefixIRI>
        <rdfs:label xml:lang="en">equivalent temperature</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperature/GlobalWarmingPotential -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperature/GlobalWarmingPotential">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTemperature/Temperature"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropt:GlobalWarmingPotential</metadata:prefixIRI>
        <rdfs:label xml:lang="en">global warming potential</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperature/IonTemperature -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperature/IonTemperature">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTemperature/Temperature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasState"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/IonizedState"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropt:IonTemperature</metadata:prefixIRI>
        <rdfs:label xml:lang="en">ion temperature</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperature/KineticTemperature -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperature/KineticTemperature">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTemperature/Temperature"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropt:KineticTemperature</metadata:prefixIRI>
        <rdfs:label xml:lang="en">kinetic temperature</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperature/MeanAnnualTemperature -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperature/MeanAnnualTemperature">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propFunction/AnnualAverage"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTemperature/Temperature"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropt:MeanAnnualTemperature</metadata:prefixIRI>
        <rdfs:label xml:lang="en">mean annual temperature</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperature/MeanMonthlyTemperature -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperature/MeanMonthlyTemperature">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propFunction/MonthlyAverage"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTemperature/Temperature"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropt:MeanMonthlyTemperature</metadata:prefixIRI>
        <rdfs:label xml:lang="en">mean monthly temperature</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperature/MeltingPoint -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperature/MeltingPoint">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTemperature/Temperature"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropt:MeltingPoint</metadata:prefixIRI>
        <rdfs:label xml:lang="en">melting point</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperature/NeutralTemperature -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperature/NeutralTemperature">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTemperature/Temperature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasState"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/NeutralState"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropt:NeutralTemperature</metadata:prefixIRI>
        <rdfs:label xml:lang="en">neutral temperature</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperature/PotentialTemperature -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperature/PotentialTemperature">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTemperature/Temperature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasState"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/stateThermodynamic/Adiabatic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropt:PotentialTemperature</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The temperature that a parcel would have if brought adiabatically and reversibly from its initial state to a standard reference pressure, typically 100 kPa.</rdfs:comment>
        <rdfs:label xml:lang="en">potential temperature</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperature/PseudoEquivalentPotentialTemperature -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperature/PseudoEquivalentPotentialTemperature">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTemperature/Temperature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/approximates"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propTemperature/EquivalentPotentialTemperature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropt:PseudoEquivalentPotentialTemperature</metadata:prefixIRI>
        <rdfs:label xml:lang="en">pseudo equivalent potential temperature</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperature/PseudoEquivalentTemperature -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperature/PseudoEquivalentTemperature">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTemperature/Temperature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/approximates"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propTemperature/EquivalentTemperature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropt:PseudoEquivalentTemperature</metadata:prefixIRI>
        <rdfs:label xml:lang="en">pseudo equivalent temperature</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperature/StaticTemperature -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperature/StaticTemperature">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTemperature/Temperature"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropt:StaticTemperature</metadata:prefixIRI>
        <rdfs:label xml:lang="en">static temperature</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperature/Temperature -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperature/Temperature">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/ThermodynamicQuantity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/measureOf"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propEnergy/Heat"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/kelvin"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropt:Temperature</metadata:prefixIRI>
        <rdfs:label xml:lang="en">temperature</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperature/TemperatureRange -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperature/TemperatureRange">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/IntervalQuantity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/rangeOf"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propTemperature/Temperature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropt:TemperatureRange</metadata:prefixIRI>
        <rdfs:label xml:lang="en">temperature range</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperature/TotalTemperature -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperature/TotalTemperature">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTemperature/Temperature"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropt:TotalTemperature</metadata:prefixIRI>
        <rdfs:label xml:lang="en">total temperature</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperature/TriplePoint -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperature/TriplePoint">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTemperature/Temperature"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropt:TriplePoint</metadata:prefixIRI>
        <rdfs:label xml:lang="en">triple point</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperature/VirtualPotentialTemperature -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperature/VirtualPotentialTemperature">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTemperature/PotentialTemperature"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropt:VirtualPotentialTemperature</metadata:prefixIRI>
        <rdfs:label xml:lang="en">virtual potential temperature</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperature/VirtualTemperature -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperature/VirtualTemperature">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTemperature/Temperature"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropt:VirtualTemperature</metadata:prefixIRI>
        <rdfs:label xml:lang="en">virtual temperature</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperature/WarmestMonthTemperature -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperature/WarmestMonthTemperature">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTemperature/Temperature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/reprTimeSeason/WarmestMonth"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropt:WarmestMonthTemperature</metadata:prefixIRI>
        <rdfs:label xml:lang="en">warmest month temperature</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperature/WetBulbPotentialTemperature -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperature/WetBulbPotentialTemperature">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTemperature/PotentialTemperature"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropt:WetBulbPotentialTemperature</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The temperature an air parcel would have if cooled from its initial state adiabatically to saturation, and thence brought to 1000 mb by a moist-adiabatic process.</rdfs:comment>
        <rdfs:label xml:lang="en">wet bulb potential temperature</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperature/WetBulbTemperature -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperature/WetBulbTemperature">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTemperature/Temperature"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropt:WetBulbTemperature</metadata:prefixIRI>
        <rdfs:label xml:lang="en">wet bulb temperature</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperature/WindChill -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperature/WindChill">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/propTemperature/WindChillIndex"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTemperature/Temperature"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropt:WindChill</metadata:prefixIRI>
        <rdfs:label xml:lang="en">wind chill</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperature/WindChillIndex -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperature/WindChillIndex">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTemperature/Temperature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/measureOf"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenAtmoWind/Wind"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropt:WindChillIndex</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A means of quantifying the threat of rapid cooling during breezy or windy conditions that may result in hypothermia in cold conditions.</rdfs:comment>
        <rdfs:label xml:lang="en">wind chill index</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperatureGradient/AutoConvectiveLapseRate -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperatureGradient/AutoConvectiveLapseRate">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTemperatureGradient/EnvironmentalLapseRate"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soproptg:AutoConvectiveLapseRate</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The environmental lapse rate of temperature in an atmosphere in which the density is constant with height (homogeneous atmosphere), equal to g/R, where g is the acceleration of gravity and R the gas constant.</rdfs:comment>
        <rdfs:label xml:lang="en">auto convective lapse rate</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperatureGradient/DryAdiabaticLapseRate -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperatureGradient/DryAdiabaticLapseRate">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTemperatureGradient/LapseRate"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasState"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/stateThermodynamic/DryAdiabatic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soproptg:DryAdiabaticLapseRate</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A process lapse rate of temperature, the rate of decrease of temperature with height of a parcel of dry air lifted by a reversible adiabatic process through an atmosphere in hydrostatic equilibrium.</rdfs:comment>
        <rdfs:label xml:lang="en">dry adiabatic lapse rate</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperatureGradient/EnvironmentalLapseRate -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperatureGradient/EnvironmentalLapseRate">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTemperatureGradient/LapseRate"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soproptg:EnvironmentalLapseRate</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The rate of decrease of temperature with elevation</rdfs:comment>
        <rdfs:label xml:lang="en">environmental lapse rate</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperatureGradient/LapseRate -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperatureGradient/LapseRate">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTemperatureGradient/TemperatureHeightDerivative"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soproptg:LapseRate</metadata:prefixIRI>
        <rdfs:label xml:lang="en">lapse rate</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperatureGradient/TemperatureDepthDerivative -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperatureGradient/TemperatureDepthDerivative">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTemperatureGradient/TemperatureGradient"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTemperatureGradient/ThermalGradient"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/derivativeWithRespectTo"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propSpaceHeight/Depth"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soproptg:TemperatureDepthDerivative</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The derivative of temperature with respect to depth.</rdfs:comment>
        <rdfs:label xml:lang="en">temperature depth derivative</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperatureGradient/TemperatureGradient -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperatureGradient/TemperatureGradient">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/propTemperatureGradient/ThermalGradient"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/ThermodynamicQuantity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/hasGradient"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propTemperature/Temperature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/kelvinPerMeter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soproptg:TemperatureGradient</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The derivative of temperature.</rdfs:comment>
        <rdfs:label xml:lang="en">temperature gradient</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperatureGradient/TemperatureGradientRange -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperatureGradient/TemperatureGradientRange">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/IntervalQuantity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/rangeOf"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/propTemperatureGradient/TemperatureGradient"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soproptg:TemperatureGradientRange</metadata:prefixIRI>
        <rdfs:label xml:lang="en">temperature gradient range</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperatureGradient/TemperatureHeightDerivative -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperatureGradient/TemperatureHeightDerivative">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTemperatureGradient/TemperatureGradient"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTemperatureGradient/ThermalGradient"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/derivativeWithRespectTo"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propSpaceHeight/Height"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soproptg:TemperatureHeightDerivative</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The derivative of temperature with respect to height.</rdfs:comment>
        <rdfs:label xml:lang="en">temperature height derivative</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperatureGradient/ThermalGradient -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperatureGradient/ThermalGradient">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/ThermodynamicQuantity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soproptg:ThermalGradient</metadata:prefixIRI>
        <rdfs:label xml:lang="en">thermal gradient</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTemperatureGradient/ThermalProfile -->

    <owl:Class rdf:about="http://sweetontology.net/propTemperatureGradient/ThermalProfile">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/ThermodynamicQuantity"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprMathFunction/Horizon"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprMathFunction/Profile"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprMathFunction/VerticalProfile"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soproptg:ThermalProfile</metadata:prefixIRI>
        <rdfs:label xml:lang="en">thermal profile</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTime/Age -->

    <owl:Class rdf:about="http://sweetontology.net/propTime/Age">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2006/time#ProperInterval"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropti:Age</metadata:prefixIRI>
        <rdfs:label xml:lang="en">age</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTime/AverageITCZDominanceDuration -->

    <owl:Class rdf:about="http://sweetontology.net/propTime/AverageITCZDominanceDuration">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propFunction/AnnualAverage"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTime/ITCZDominanceDuration"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropti:AverageITCZDominanceDuration</metadata:prefixIRI>
        <rdfs:label xml:lang="en">average itcz dominance duration</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTime/AverageSnowCoverDuration -->

    <owl:Class rdf:about="http://sweetontology.net/propTime/AverageSnowCoverDuration">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propFunction/AnnualAverage"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTime/SnowCoverDuration"/>
