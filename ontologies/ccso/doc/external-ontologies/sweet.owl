        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergyFlux/EnergyFlux"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/ThermodynamicQuantity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropef:HeatFlux</metadata:prefixIRI>
        <rdfs:label xml:lang="en">heat flux</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergyFlux/Illuminance -->

