        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophei:SaltWaterIntrusion</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The movement of salt water into fresh water aquifers.</rdfs:comment>
        <rdfs:label xml:lang="en">salt water intrusion</rdfs:label>
    </owl:Class>
    


