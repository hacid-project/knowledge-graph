    </owl:Class>
    


    <!-- http://sweetontology.net/realmAstroStar/StellarAtmosphere -->

    <owl:Class rdf:about="http://sweetontology.net/realmAstroStar/StellarAtmosphere">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAstroStar/StellarRealm"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaas:StellarAtmosphere</metadata:prefixIRI>
        <rdfs:label xml:lang="en">stellar atmosphere</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAstroStar/StellarCore -->

    <owl:Class rdf:about="http://sweetontology.net/realmAstroStar/StellarCore">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAstroStar/StellarInterior"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaChemical/hasChemicalReaction"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/procChemical/NuclearFusion"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaas:StellarCore</metadata:prefixIRI>
        <rdfs:label xml:lang="en">stellar core</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAstroStar/StellarInterior -->

    <owl:Class rdf:about="http://sweetontology.net/realmAstroStar/StellarInterior">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAstroStar/StellarRealm"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaas:StellarInterior</metadata:prefixIRI>
        <rdfs:label xml:lang="en">stellar interior</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAstroStar/StellarRealm -->

    <owl:Class rdf:about="http://sweetontology.net/realmAstroStar/StellarRealm">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/Realm"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaas:StellarRealm</metadata:prefixIRI>
        <rdfs:label xml:lang="en">stellar realm</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAstroStar/Tacocline -->

    <owl:Class rdf:about="http://sweetontology.net/realmAstroStar/Tacocline">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAstroStar/StellarInterior"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaas:Tacocline</metadata:prefixIRI>
        <rdfs:label xml:lang="en">tacocline</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmo/AtmosphereLayer -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmo/AtmosphereLayer">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/GlobalPlanetaryLayer"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetaryLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRealm"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/realm/Atmosphere"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaa:AtmosphereLayer</metadata:prefixIRI>
        <rdfs:label xml:lang="en">atmosphere layer</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmo/FreeTroposphere -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmo/FreeTroposphere">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmo/Troposphere"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaa:FreeTroposphere</metadata:prefixIRI>
        <rdfs:label xml:lang="en">free troposphere</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmo/InversionLayer -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmo/InversionLayer">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmAtmo/TemperatureInversionLayer"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmo/AtmosphereLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/phenFluidInstability/Inversion"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaa:InversionLayer</metadata:prefixIRI>
        <rdfs:label xml:lang="en">inversion layer</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmo/JungeAerosolLayer -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmo/JungeAerosolLayer">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmo/AtmosphereLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaChemical/hasSubstance"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/matrAerosol/Aerosol"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaa:JungeAerosolLayer</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A maximum in large-particle concentrations observed in the lower stratosphere between 15 and 25 km.</rdfs:comment>
        <rdfs:label xml:lang="en">junge aerosol layer</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmo/LowerAtmosphere -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmo/LowerAtmosphere">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmo/AtmosphereLayer"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaa:LowerAtmosphere</metadata:prefixIRI>
        <rdfs:label xml:lang="en">lower atmosphere</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmo/Mesopause -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmo/Mesopause">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetaryBoundary"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetarySurfaceLevel"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaa:Mesopause</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The top of the mesosphere and the base of the thermosphere. The mesopause is usually located at heights of 85?95 km, and is the site of the coldest temperatures in the atmosphere. Temperatures as low as 100 K (- 173?C) have been measured at the mesopause by rockets. See atmospheric shell.</rdfs:comment>
        <rdfs:label xml:lang="en">mesopause</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmo/Mesosphere -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmo/Mesosphere">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmo/AtmosphereLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/hasLowerBoundary"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmAtmo/Stratopause"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/hasUpperBoundary"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmAtmo/Mesopause"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/dTdh"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/propTemperatureGradient/NegativeSlope"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaa:Mesosphere</metadata:prefixIRI>
        <rdfs:label xml:lang="en">mesosphere</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmo/MiddleAtmosphere -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmo/MiddleAtmosphere">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmAtmo/OzoneLayer"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmo/AtmosphereLayer"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaa:MiddleAtmosphere</metadata:prefixIRI>
        <rdfs:label xml:lang="en">middle atmosphere</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmo/OzoneLayer -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmo/OzoneLayer">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmo/AtmosphereLayer"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaa:OzoneLayer</metadata:prefixIRI>
        <rdfs:label xml:lang="en">ozone layer</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmo/Stratopause -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmo/Stratopause">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetaryBoundary"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetarySurfaceLevel"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaa:Stratopause</metadata:prefixIRI>
        <rdfs:label xml:lang="en">stratopause</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmo/Stratosphere -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmo/Stratosphere">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmo/AtmosphereLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/hasLowerBoundary"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmAtmo/Tropopause"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/hasUpperBoundary"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmAtmo/Stratopause"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/dTdh"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/propTemperatureGradient/PositiveSlope"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaa:Stratosphere</metadata:prefixIRI>
        <rdfs:label xml:lang="en">stratosphere</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmo/TemperatureInversionLayer -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmo/TemperatureInversionLayer">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmo/AtmosphereLayer"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaa:TemperatureInversionLayer</metadata:prefixIRI>
        <rdfs:label xml:lang="en">temperature inversion layer</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmo/Thermosphere -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmo/Thermosphere">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmo/AtmosphereLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/hasLowerBoundary"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmAtmo/Mesopause"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/dTdh"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/propTemperatureGradient/PositiveSlope"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaa:Thermosphere</metadata:prefixIRI>
        <rdfs:label xml:lang="en">thermosphere</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmo/Tropopause -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmo/Tropopause">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetaryBoundary"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetarySurfaceLevel"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaa:Tropopause</metadata:prefixIRI>
        <rdfs:label xml:lang="en">tropopause</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmo/Troposphere -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmo/Troposphere">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmo/AtmosphereLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/hasLowerBoundary"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realm/PlanetarySurface"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/hasUpperBoundary"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmAtmo/Tropopause"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/dTdh"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/propTemperatureGradient/NegativeSlope"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaa:Troposphere</metadata:prefixIRI>
        <rdfs:label xml:lang="en">troposphere</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmo/UpperAtmosphere -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmo/UpperAtmosphere">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmo/AtmosphereLayer"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaa:UpperAtmosphere</metadata:prefixIRI>
        <rdfs:label xml:lang="en">upper atmosphere</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmoBoundaryLayer/AtmosphericBoundaryLayer -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmoBoundaryLayer/AtmosphericBoundaryLayer">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmAtmoBoundaryLayer/BoundaryLayer"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmo/AtmosphereLayer"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaabl:AtmosphericBoundaryLayer</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The bottom layer of the troposphere that is in contact with the surface of the earth.</rdfs:comment>
        <rdfs:label xml:lang="en">atmospheric boundary layer</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmoBoundaryLayer/BoundaryLayer -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmoBoundaryLayer/BoundaryLayer">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmAtmoBoundaryLayer/PlanetaryBoundaryLayer"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmo/AtmosphereLayer"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaabl:BoundaryLayer</metadata:prefixIRI>
        <rdfs:label xml:lang="en">boundary layer</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmoBoundaryLayer/Cap -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmoBoundaryLayer/Cap">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceHeight/Level"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaabl:Cap</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A region of negative buoyancy below an existing level of free convection (LFC) where energy must be supplied to the parcel to maintain its ascent.</rdfs:comment>
        <rdfs:label xml:lang="en">cap</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmoBoundaryLayer/ConstantFluxLayer -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmoBoundaryLayer/ConstantFluxLayer">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmoBoundaryLayer/AtmosphericBoundaryLayer"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmoBoundaryLayer/BoundaryLayer"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmoBoundaryLayer/PlanetaryBoundaryLayer"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaabl:ConstantFluxLayer</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A layer of air tens of meters thick at the bottom of the atmosphere where the variation of vertical turbulent flux with altitude is less than 10% of its magnitude.</rdfs:comment>
        <rdfs:label xml:lang="en">constant flux layer</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmoBoundaryLayer/InternalBoundaryLayer -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmoBoundaryLayer/InternalBoundaryLayer">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmoBoundaryLayer/AtmosphericBoundaryLayer"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmoBoundaryLayer/BoundaryLayer"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmoBoundaryLayer/PlanetaryBoundaryLayer"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaabl:InternalBoundaryLayer</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A layer within the atmosphere bounded below by the surface, and above by a more or less sharp discontinuity in some atmospheric property. Internal boundary layers are associated with the horizontal advection of air across a discontinuity in some property of the surface (e.g., aerodynamic roughness length or surface heat flux) and can be viewed as layers in which the atmosphere is adjusting to new surface properties. See thermal internal boundary layer, mechanical internal boundary layer.</rdfs:comment>
        <rdfs:label xml:lang="en">internal boundary layer</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmoBoundaryLayer/MechanicalInternalBoundaryLayer -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmoBoundaryLayer/MechanicalInternalBoundaryLayer">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmoBoundaryLayer/InternalBoundaryLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenFluidTransport/Advection"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaabl:MechanicalInternalBoundaryLayer</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">(Abbreviated MIBL.) An internal boundary layer caused by advection of air across a discontinuity in surface roughness. When the new surface is rougher than the old one, the MIBL depth grows roughly as the 0.8 power of the ratio of the two roughness lengths. In this example, the MIBL grows to include the whole surface layer.</rdfs:comment>
        <rdfs:label xml:lang="en">mechanical internal boundary layer</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmoBoundaryLayer/MixedLayer -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmoBoundaryLayer/MixedLayer">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmoBoundaryLayer/AtmosphericBoundaryLayer"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmoBoundaryLayer/BoundaryLayer"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmoBoundaryLayer/PlanetaryBoundaryLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenFluidInstability/Turbulence"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaabl:MixedLayer</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A type of atmospheric boundary layer characterized by vigorous turbulence tending to stir and uniformly mix, primarily in the vertical, quantities such as conservative tracer concentrations, potential temperature, and momentum or wind speed.</rdfs:comment>
        <rdfs:label xml:lang="en">mixed layer</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmoBoundaryLayer/NocturnalBoundaryLayer -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmoBoundaryLayer/NocturnalBoundaryLayer">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmoBoundaryLayer/AtmosphericBoundaryLayer"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmoBoundaryLayer/BoundaryLayer"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmoBoundaryLayer/PlanetaryBoundaryLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/phenAtmo/NocturnalCooling"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaabl:NocturnalBoundaryLayer</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The cool layer of air adjacent to the ground that forms at night. At night under clear skies, radiation to space cools the land surface, which in turn cools the adjacent air through processes of molecular conduction, turbulence, and radiative transfer. This causes a stable boundary layer to form and grow to depths of a few hundreds of meters, depending on the season. Many interacting processes can occur within the statically stable nocturnal boundary layer: patchy sporadic turbulence, internal gravity waves, drainage flows, inertial oscillations, and nocturnal jets.</rdfs:comment>
        <rdfs:label xml:lang="en">nocturnal boundary layer</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmoBoundaryLayer/OuterLayer -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmoBoundaryLayer/OuterLayer">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmoBoundaryLayer/AtmosphericBoundaryLayer"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmoBoundaryLayer/BoundaryLayer"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmoBoundaryLayer/PlanetaryBoundaryLayer"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaabl:OuterLayer</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">For flow over a hill, the top layer in the boundary layer that accelerates relative to its upstream value due to the Bernoulli effect.</rdfs:comment>
        <rdfs:label xml:lang="en">outer layer</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmoBoundaryLayer/PlanetaryBoundaryLayer -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmoBoundaryLayer/PlanetaryBoundaryLayer">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmo/AtmosphereLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRealm"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/realm/Atmosphere"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaabl:PlanetaryBoundaryLayer</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The bottom layer of the troposphere that is in contact with the surface of the earth.   It is often turbulent and is capped by a statically stable layer of air or temperature inversion.</rdfs:comment>
        <rdfs:label xml:lang="en">planetary boundary layer</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmoBoundaryLayer/ResidualLayer -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmoBoundaryLayer/ResidualLayer">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmoBoundaryLayer/AtmosphericBoundaryLayer"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmoBoundaryLayer/BoundaryLayer"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmoBoundaryLayer/PlanetaryBoundaryLayer"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaabl:ResidualLayer</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The middle portion of the nocturnal atmospheric boundary layer characterized by weak sporadic turbulence and initially uniformly mixed potential temperature and pollutants remaining from the mixed layer of the previous day.</rdfs:comment>
        <rdfs:label xml:lang="en">residual layer</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmoBoundaryLayer/RoughnessSublayer -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmoBoundaryLayer/RoughnessSublayer">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmoBoundaryLayer/AtmosphericBoundaryLayer"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmoBoundaryLayer/BoundaryLayer"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmoBoundaryLayer/PlanetaryBoundaryLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasState"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/stateSolid/Rough"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaabl:RoughnessSublayer</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Same as transition layer. The lowest atmospheric layer immediately adjacent to a surface covered with relatively large roughness elements such as stones, vegetation, trees, or buildings.</rdfs:comment>
        <rdfs:label xml:lang="en">roughness sublayer</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmoBoundaryLayer/SkinLayer -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmoBoundaryLayer/SkinLayer">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmoBoundaryLayer/AtmosphericBoundaryLayer"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmoBoundaryLayer/BoundaryLayer"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmoBoundaryLayer/PlanetaryBoundaryLayer"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaabl:SkinLayer</metadata:prefixIRI>
        <rdfs:label xml:lang="en">skin layer</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmoBoundaryLayer/StableBoundaryLayer -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmoBoundaryLayer/StableBoundaryLayer">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmoBoundaryLayer/AtmosphericBoundaryLayer"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmoBoundaryLayer/BoundaryLayer"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmoBoundaryLayer/PlanetaryBoundaryLayer"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaabl:StableBoundaryLayer</metadata:prefixIRI>
        <rdfs:label xml:lang="en">stable boundary layer</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmoBoundaryLayer/WellMixedLayer -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmoBoundaryLayer/WellMixedLayer">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmoBoundaryLayer/AtmosphericBoundaryLayer"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmoBoundaryLayer/BoundaryLayer"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmoBoundaryLayer/PlanetaryBoundaryLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenMixing/Mixing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaabl:WellMixedLayer</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A type of atmospheric boundary layer characterized by vigorous turbulence tending to stir and uniformly mix, primarily in the vertical, quantities such as conservative tracer concentrations, potential temperature, and momentum or wind speed.</rdfs:comment>
        <rdfs:label xml:lang="en">well mixed layer</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmoWeather/AdiabaticCondensationLevel -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmoWeather/AdiabaticCondensationLevel">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmoWeather/CondensationLevel"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaaw:AdiabaticCondensationLevel</metadata:prefixIRI>
        <rdfs:label xml:lang="en">adiabatic condensation level</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmoWeather/CloudBase -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmoWeather/CloudBase">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetaryBoundary"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetarySurfaceLevel"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaaw:CloudBase</metadata:prefixIRI>
        <rdfs:label xml:lang="en">cloud base</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmoWeather/CloudTop -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmoWeather/CloudTop">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetaryBoundary"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetarySurfaceLevel"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaaw:CloudTop</metadata:prefixIRI>
        <rdfs:label xml:lang="en">cloud top</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmoWeather/CondensationLevel -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmoWeather/CondensationLevel">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceHeight/Level"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaaw:CondensationLevel</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Level at which water vapor to condense</rdfs:comment>
        <rdfs:label xml:lang="en">condensation level</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmoWeather/ConvectiveCloudBase -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmoWeather/ConvectiveCloudBase">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetaryBoundary"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetarySurfaceLevel"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaaw:ConvectiveCloudBase</metadata:prefixIRI>
        <rdfs:label xml:lang="en">convective cloud base</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmoWeather/ConvectiveCloudTop -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmoWeather/ConvectiveCloudTop">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetaryBoundary"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetarySurfaceLevel"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaaw:ConvectiveCloudTop</metadata:prefixIRI>
        <rdfs:label xml:lang="en">convective cloud top</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmoWeather/ConvectiveCondensationLevel -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmoWeather/ConvectiveCondensationLevel">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmoWeather/CondensationLevel"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaaw:ConvectiveCondensationLevel</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">On a thermodynamic diagram, the point of intersection of a sounding curve (representing the vertical distribution of temperature in an atmospheric column) with the saturation mixing ratio line corresponding to the average mixing ratio in the surface layer.</rdfs:comment>
        <rdfs:label xml:lang="en">convective condensation level</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmoWeather/FreeConvectiveLayer -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmoWeather/FreeConvectiveLayer">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmo/AtmosphereLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenFluidInstability/FreeInstability"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaaw:FreeConvectiveLayer</metadata:prefixIRI>
        <rdfs:label xml:lang="en">free convective layer</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmoWeather/FreezingLevel -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmoWeather/FreezingLevel">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenAtmo/MeteorologicalPhenomena"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetaryBoundary"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetarySurfaceLevel"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaaw:FreezingLevel</metadata:prefixIRI>
        <rdfs:label xml:lang="en">freezing level</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmoWeather/LFC -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmoWeather/LFC">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmAtmoWeather/LevelOfFreeConvection"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetaryBoundary"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetarySurfaceLevel"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaaw:LFC</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Level of free convection</rdfs:comment>
        <rdfs:label xml:lang="en">lfc</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmoWeather/LevelOfFreeConvection -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmoWeather/LevelOfFreeConvection">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetaryBoundary"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetarySurfaceLevel"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaaw:LevelOfFreeConvection</metadata:prefixIRI>
        <rdfs:label xml:lang="en">level of free convection</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmoWeather/MaximumWindSpeedLevel -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmoWeather/MaximumWindSpeedLevel">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetaryBoundary"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetarySurfaceLevel"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaaw:MaximumWindSpeedLevel</metadata:prefixIRI>
        <rdfs:label xml:lang="en">maximum wind speed level</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmoWeather/MeltingLayer -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmoWeather/MeltingLayer">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/GlobalPlanetaryLayer"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetaryLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/hasStateChange"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/procStateChange/Melting"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaaw:MeltingLayer</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The altitude interval throughout which ice-phase precipitation melts as it descends. The top of the melting layer is the melting level. The melting layer may be several hundred meters deep, reflecting the time it takes for all the hydrometeors to undergo the transition from solid to liquid phase. The temperature of the melting layer is typically 0?C or slightly warmer. See bright band.</rdfs:comment>
        <rdfs:label xml:lang="en">melting layer</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmoWeather/MeltingLevel -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmoWeather/MeltingLevel">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetaryBoundary"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetarySurfaceLevel"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/hasStateChange"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/procStateChange/Melting"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaaw:MeltingLevel</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The altitude at which ice crystals and snowflakes begin to melt as they descend through the atmosphere. In cloud physics and in radar meteorology, this is the accepted term for the 0?C constant-temperature surface (see bright band). It is physically more apt than the corresponding operational term, freezing level, for melting of pure ice must begin very near 0?C, but freezing of liquid water can occur over a broad range of temperatures (between 0? and -40?C; see supercooling). See also freezing point, ice point, melting point.</rdfs:comment>
        <rdfs:label xml:lang="en">melting level</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmoWeather/SnowGeneratingLevel -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmoWeather/SnowGeneratingLevel">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetaryBoundary"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetarySurfaceLevel"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenAtmoPrecipitation/Snowfall"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaaw:SnowGeneratingLevel</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A layer in the middle or upper troposphere in widespread precipitation in which ice crystals form in small convective cells and fall to lower altitudes.</rdfs:comment>
        <rdfs:label xml:lang="en">snow generating level</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAtmoWeather/ZoneOfMaximumPrecipitation -->

    <owl:Class rdf:about="http://sweetontology.net/realmAtmoWeather/ZoneOfMaximumPrecipitation">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAtmo/AtmosphereLayer"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaaw:ZoneOfMaximumPrecipitation</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The elevation band on a mountain or orographic barrier that receives the greatest precipitation for a seasonal or annual average.</rdfs:comment>
        <rdfs:label xml:lang="en">zone of maximum precipitation</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmBiolBiome/Anthromes -->

    <owl:Class rdf:about="http://sweetontology.net/realmBiolBiome/Anthromes">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmBiolBiome/TerrestrialBiome"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaHuman/hasLandUse"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/stateBiological/Anthropogenic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreabb:Anthromes</metadata:prefixIRI>
        <rdfs:label xml:lang="en">anthromes</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmBiolBiome/AquaticEcosystem -->

    <owl:Class rdf:about="http://sweetontology.net/realmBiolBiome/AquaticEcosystem">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmBiolBiome/Ecosystem"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRealm"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realm/Hydrosphere"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreabb:AquaticEcosystem</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">An aquatic ecosystem is an ecosystem located in a body of water. Communities of organisms that are dependent on each other and on their environment live in aquatic ecosystems. The two main types of aquatic ecosystems are marine ecosystems and freshwater ecosystems.</rdfs:comment>
        <rdfs:label xml:lang="en">aquatic ecosystem</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmBiolBiome/Barren -->

    <owl:Class rdf:about="http://sweetontology.net/realmBiolBiome/Barren">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmBiolBiome/Wildlands"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreabb:Barren</metadata:prefixIRI>
        <rdfs:label xml:lang="en">barren</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmBiolBiome/Biome -->

    <owl:Class rdf:about="http://sweetontology.net/realmBiolBiome/Biome">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprSciComponent/Environment"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreabb:Biome</metadata:prefixIRI>
        <rdfs:label xml:lang="en">biome</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmBiolBiome/Biota -->

    <owl:Class rdf:about="http://sweetontology.net/realmBiolBiome/Biota">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmBiolBiome/TerrestrialBiome"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreabb:Biota</metadata:prefixIRI>
        <rdfs:label xml:lang="en">biota</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmBiolBiome/BorealForest -->

    <owl:Class rdf:about="http://sweetontology.net/realmBiolBiome/BorealForest">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmBiolBiome/Taiga"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreabb:BorealForest</metadata:prefixIRI>
        <rdfs:label xml:lang="en">boreal forest</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmBiolBiome/CaveEcosystem -->

    <owl:Class rdf:about="http://sweetontology.net/realmBiolBiome/CaveEcosystem">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmBiolBiome/TerrestrialEcosystem"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreabb:CaveEcosystem</metadata:prefixIRI>
        <rdfs:label xml:lang="en">cave ecosystem</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmBiolBiome/CoralReef -->

    <owl:Class rdf:about="http://sweetontology.net/realmBiolBiome/CoralReef">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmBiolBiome/MarineEcosystem"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasSpecies"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/matrAnimal/Coral"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreabb:CoralReef</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The term coral reef generally refers to a marine ecosystem in which the main organisms are corals that house algal symbionts within their tissues. These ecosystems require: 1) fully marine waters; 2) warm temperatures; and 3) ample sunlight. They are therefore restricted to shallow waters of tropical and subtropical regions. Corals that do not have algal symbionts can also form significant reef communities in deeper, darker, and colder waters, but these communities are distinguished as cold-water coral bioherms. The more technical definition of coral reef includes an additional geological requirement that the reef organisms produce enough calcium carbonate to build the physical reef structure. The coral reef community lives only on the surface veneer of the reef, on top of already existing skeletal material left behind by previous reef-builders. Many processes act to break down the skeletal material and reef as soon it is laid down by organisms. These include mechanical processes such as waves and currents, and a wide array of biological processes (e.g., bioerosion). Some of the best known bioeroders are large organisms such as parrotfish and sponges, but much of the bioerosion occurs at the microscopic scale by organisms such as algae and fungi. A coral reef is produced only if the coral reef community produces more calcium carbonate than is removed. Indeed, some coral reef communities grow too slowly to build a reef.</rdfs:comment>
        <rdfs:label xml:lang="en">coral reef</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmBiolBiome/Croplands -->

    <owl:Class rdf:about="http://sweetontology.net/realmBiolBiome/Croplands">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmBiolBiome/TerrestrialBiome"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreabb:Croplands</metadata:prefixIRI>
        <rdfs:label xml:lang="en">croplands</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmBiolBiome/DenseSettlements -->

    <owl:Class rdf:about="http://sweetontology.net/realmBiolBiome/DenseSettlements">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmBiolBiome/TerrestrialBiome"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreabb:DenseSettlements</metadata:prefixIRI>
        <rdfs:label xml:lang="en">dense settlements</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmBiolBiome/Ecosystem -->

    <owl:Class rdf:about="http://sweetontology.net/realmBiolBiome/Ecosystem">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprSciComponent/Environment"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreabb:Ecosystem</metadata:prefixIRI>
        <rdfs:label xml:lang="en">ecosystem</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmBiolBiome/EmergentLayer -->

    <owl:Class rdf:about="http://sweetontology.net/realmBiolBiome/EmergentLayer">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmBiolBiome/TerrestrialEcosystem"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreabb:EmergentLayer</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">An irregular zone of extremely tall trees, rising above the mean canopy</rdfs:comment>
        <rdfs:label xml:lang="en">emergent layer</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmBiolBiome/Fishery -->

    <owl:Class rdf:about="http://sweetontology.net/realmBiolBiome/Fishery">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmBiolBiome/AquaticEcosystem"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreabb:Fishery</metadata:prefixIRI>
        <rdfs:label xml:lang="en">fishery</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmBiolBiome/Forest -->

    <owl:Class rdf:about="http://sweetontology.net/realmBiolBiome/Forest">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmBiolBiome/TerrestrialEcosystem"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasSpecies"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/matrPlant/Vegetation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreabb:Forest</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A forest is an area with a high density of trees. There are many definitions of a forest, based on various criteria. These plant communities cover large areas of the globe and function as habitats for organisms, hydrologic flow modulators, and soil conservers, constituting one of the most important aspects of the Earth&apos;s biosphere.</rdfs:comment>
        <rdfs:label xml:lang="en">forest</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmBiolBiome/Forested -->

    <owl:Class rdf:about="http://sweetontology.net/realmBiolBiome/Forested">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmBiolBiome/TerrestrialBiome"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreabb:Forested</metadata:prefixIRI>
        <rdfs:label xml:lang="en">forested</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmBiolBiome/FreshwaterEcosystem -->

    <owl:Class rdf:about="http://sweetontology.net/realmBiolBiome/FreshwaterEcosystem">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmBiolBiome/AquaticEcosystem"/>
        <owl:disjointWith rdf:resource="http://sweetontology.net/realmBiolBiome/MarineEcosystem"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreabb:FreshwaterEcosystem</metadata:prefixIRI>
        <rdfs:label xml:lang="en">freshwater ecosystem</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmBiolBiome/Grassland -->

    <owl:Class rdf:about="http://sweetontology.net/realmBiolBiome/Grassland">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmBiolBiome/TerrestrialEcosystem"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasSpecies"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/matrPlant/Grass"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreabb:Grassland</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Grasslands are areas where the vegetation is dominated by grasses (Poaceae) and other herbaceous (non-woody) plants (forbs). Plants of the sedge (Cyperacae) and rush (Juncaceae) families can also be frequent in grasslands. Grasslands occur naturally on all continents except Antarctica, and in many other areas they have replaced the natural vegetation due to human influence. In temperate latitudes, such as north-west Europe, grasslands are dominated by perennial species, whereas in warmer climates annual species form a greater component of the vegetation.</rdfs:comment>
        <rdfs:label xml:lang="en">grassland</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmBiolBiome/MarineEcosystem -->

    <owl:Class rdf:about="http://sweetontology.net/realmBiolBiome/MarineEcosystem">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmBiolBiome/AquaticEcosystem"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreabb:MarineEcosystem</metadata:prefixIRI>
        <rdfs:label xml:lang="en">marine ecosystem</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmBiolBiome/Montane -->

    <owl:Class rdf:about="http://sweetontology.net/realmBiolBiome/Montane">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmBiolBiome/TerrestrialEcosystem"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreabb:Montane</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Montane is a biogeographic term which refers to highland areas located below the subalpine zone.[1] Montane regions generally have cooler temperatures and often have higher rainfall than the adjacent lowland regions, and are frequently home to distinct communities of plants and animals. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">montane</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmBiolBiome/Pasture -->

    <owl:Class rdf:about="http://sweetontology.net/realmBiolBiome/Pasture">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmBiolBiome/TerrestrialEcosystem"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreabb:Pasture</metadata:prefixIRI>
        <rdfs:label xml:lang="en">pasture</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmBiolBiome/Rangelands -->

    <owl:Class rdf:about="http://sweetontology.net/realmBiolBiome/Rangelands">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmBiolBiome/TerrestrialBiome"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreabb:Rangelands</metadata:prefixIRI>
        <rdfs:label xml:lang="en">rangelands</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmBiolBiome/Savanna -->

    <owl:Class rdf:about="http://sweetontology.net/realmBiolBiome/Savanna">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmBiolBiome/TerrestrialEcosystem"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreabb:Savanna</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A savanna or savannah is a tropical or subtropical woodland ecosystem. Savannas are characterised by the trees being sufficiently small or widely spaced so that the canopy does not close. It is often believed that savannas are characterized by widely spaced, scattered trees, however in many savanna communities tree densities are higher and trees are more regularly spaced than in forest communities. The open canopy allows sufficient light to reach the ground to support an unbroken herbaceous layer consisting primarily of C4 grasses. Savannas are also characterised by seasonal water availability, with the majority of rainfall being confined to one season of the year. Savannas can be associated with several types of biomes. Savannas are frequently seen as a transitional zone, occurring between forest regions and desert regions.</rdfs:comment>
        <rdfs:label xml:lang="en">savanna</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmBiolBiome/Scrubland -->

    <owl:Class rdf:about="http://sweetontology.net/realmBiolBiome/Scrubland">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmBiolBiome/TerrestrialEcosystem"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasSpecies"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/matrPlant/Scrub"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreabb:Scrubland</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Scrubland is plant community characterized by scrub vegetation. Scrub consists of low shrubs, mixed with grasses, herbs, and geophytes. Scrublands are sometimes known as heathlands. Scrublands may be either naturally occurring or the result of human activity. They may be the mature vegetation type in a particular region and remain stable over time, or a transitional community that occurs temporarily as the result of a disturbance, such as a major fire. Many people do not live in scrubland because of the fires that can easily occur.</rdfs:comment>
        <rdfs:label xml:lang="en">scrubland</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmBiolBiome/SeaGrass -->

    <owl:Class rdf:about="http://sweetontology.net/realmBiolBiome/SeaGrass">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmBiolBiome/AquaticEcosystem"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreabb:SeaGrass</metadata:prefixIRI>
        <rdfs:label xml:lang="en">sea grass</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmBiolBiome/SparseTrees -->

    <owl:Class rdf:about="http://sweetontology.net/realmBiolBiome/SparseTrees">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmBiolBiome/Wildlands"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreabb:SparseTrees</metadata:prefixIRI>
        <rdfs:label xml:lang="en">sparse trees</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmBiolBiome/Steppe -->

    <owl:Class rdf:about="http://sweetontology.net/realmBiolBiome/Steppe">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmBiolBiome/Grassland"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreabb:Steppe</metadata:prefixIRI>
        <rdfs:label xml:lang="en">steppe</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmBiolBiome/Taiga -->

    <owl:Class rdf:about="http://sweetontology.net/realmBiolBiome/Taiga">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmBiolBiome/Forest"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaClimate/hasClimateZone"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/realmClimateZone/Cfc"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaClimate/hasClimateZone"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/realmClimateZone/Dfb"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaClimate/hasClimateZone"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/realmClimateZone/Dfc"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreabb:Taiga</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">biome characterized by coniferous forests</rdfs:comment>
        <rdfs:label xml:lang="en">taiga</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmBiolBiome/TemperateForest -->

    <owl:Class rdf:about="http://sweetontology.net/realmBiolBiome/TemperateForest">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmBiolBiome/Forest"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaClimate/hasClimateZone"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmClimateZone/C"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreabb:TemperateForest</metadata:prefixIRI>
        <rdfs:label xml:lang="en">temperate forest</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmBiolBiome/Terrain -->

    <owl:Class rdf:about="http://sweetontology.net/realmBiolBiome/Terrain">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmBiolBiome/TerrestrialBiome"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreabb:Terrain</metadata:prefixIRI>
        <rdfs:label xml:lang="en">terrain</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmBiolBiome/TerrestrialBiome -->

    <owl:Class rdf:about="http://sweetontology.net/realmBiolBiome/TerrestrialBiome">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmBiolBiome/Biome"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRealm"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realm/Land"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreabb:TerrestrialBiome</metadata:prefixIRI>
        <rdfs:label xml:lang="en">terrestrial biome</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmBiolBiome/TerrestrialEcosystem -->

    <owl:Class rdf:about="http://sweetontology.net/realmBiolBiome/TerrestrialEcosystem">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmBiolBiome/Ecosystem"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRealm"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realm/Land"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreabb:TerrestrialEcosystem</metadata:prefixIRI>
        <rdfs:label xml:lang="en">terrestrial ecosystem</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmBiolBiome/TropicalForest -->

    <owl:Class rdf:about="http://sweetontology.net/realmBiolBiome/TropicalForest">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmBiolBiome/Forest"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaClimate/hasClimateZone"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/realmClimateZone/TropicalRainForestClimate"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreabb:TropicalForest</metadata:prefixIRI>
        <rdfs:label xml:lang="en">tropical forest</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmBiolBiome/Villages -->

    <owl:Class rdf:about="http://sweetontology.net/realmBiolBiome/Villages">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmBiolBiome/TerrestrialBiome"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreabb:Villages</metadata:prefixIRI>
        <rdfs:label xml:lang="en">villages</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmBiolBiome/Wildlands -->

    <owl:Class rdf:about="http://sweetontology.net/realmBiolBiome/Wildlands">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmBiolBiome/TerrestrialBiome"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreabb:Wildlands</metadata:prefixIRI>
        <rdfs:label xml:lang="en">wildlands</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmBiolBiome/Woodland -->

    <owl:Class rdf:about="http://sweetontology.net/realmBiolBiome/Woodland">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmBiolBiome/Forest"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreabb:Woodland</metadata:prefixIRI>
        <rdfs:label xml:lang="en">woodland</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmClimateZone/A -->

    <owl:Class rdf:about="http://sweetontology.net/realmClimateZone/A">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmClimateZone/TropicalClimate"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmClimateZone/ClimateClassification"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaClimate/hasAverageAnnualPrecipitation"/>
                <owl:hasValue>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://sweetontology.net/propSpaceThickness/PrecipitationRange"/>
                    </rdf:Description>
                </owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaClimate/hasAverageMonthlyTemperature"/>
                <owl:hasValue>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://sweetontology.net/propTemperature/TemperatureRange"/>
                    </rdf:Description>
                </owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreacz:A</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The A climate classification, also known as the Tropical climate classification, is characterized as being consistently warm with all months averaging above 18 degrees C and having annual precipitation exceeds potential evapotranspiration (POTET).</rdfs:comment>
        <rdfs:label xml:lang="en">a</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmClimateZone/B -->

    <owl:Class rdf:about="http://sweetontology.net/realmClimateZone/B">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmClimateZone/DryClimate"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmClimateZone/ClimateClassification"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaClimate/hasAverageAnnualPrecipitation"/>
                <owl:hasValue>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://sweetontology.net/propSpaceThickness/PrecipitationRange"/>
                    </rdf:Description>
                </owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreacz:B</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Potential evapotranspiration (POTET) exceeds precipitation in all B climates. Subdivisions are based on precipitation timing and amount and mean annual temperature.</rdfs:comment>
        <rdfs:label xml:lang="en">b</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmClimateZone/C -->

    <owl:Class rdf:about="http://sweetontology.net/realmClimateZone/C">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmClimateZone/TemperateClimate"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmClimateZone/ClimateClassification"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaClimate/hasAverageColdestMonthTemperature"/>
                <owl:hasValue>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://sweetontology.net/propTemperature/TemperatureRange"/>
                    </rdf:Description>
                </owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaClimate/hasAverageWarmestMonthTemperature"/>
                <owl:hasValue>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://sweetontology.net/propTemperature/TemperatureRange"/>
                    </rdf:Description>
                </owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreacz:C</metadata:prefixIRI>
        <rdfs:label xml:lang="en">c</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmClimateZone/ClimateClassification -->

    <owl:Class rdf:about="http://sweetontology.net/realmClimateZone/ClimateClassification">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propCategorical/Category"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propCategorical/Classification"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreacz:ClimateClassification</metadata:prefixIRI>
        <rdfs:label xml:lang="en">climate classification</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmClimateZone/ClimateZoneType -->

    <owl:Class rdf:about="http://sweetontology.net/realmClimateZone/ClimateZoneType">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmClimateZone/ClimateClassification"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreacz:ClimateZoneType</metadata:prefixIRI>
        <rdfs:label xml:lang="en">climate zone type</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmClimateZone/D -->

    <owl:Class rdf:about="http://sweetontology.net/realmClimateZone/D">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmClimateZone/ClimateClassification"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaClimate/hasAverageColdestMonthTemperature"/>
                <owl:hasValue>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://sweetontology.net/propTemperature/TemperatureRange"/>
                    </rdf:Description>
                </owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaClimate/hasAverageWarmestMonthTemperature"/>
                <owl:hasValue>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://sweetontology.net/propTemperature/TemperatureRange"/>
                    </rdf:Description>
                </owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreacz:D</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The D climate classification, also known as the microthermal climate classification,  is characterized by by having the warmest month of the year above 10 degree C and the coldest below 0 degree C.</rdfs:comment>
        <rdfs:label xml:lang="en">d</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmClimateZone/DesertClimateZone -->

    <owl:Class rdf:about="http://sweetontology.net/realmClimateZone/DesertClimateZone">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmClimateZone/ClimateZoneType"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreacz:DesertClimateZone</metadata:prefixIRI>
        <rdfs:label xml:lang="en">desert climate zone</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmClimateZone/Doldrums -->

    <owl:Class rdf:about="http://sweetontology.net/realmClimateZone/Doldrums">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmClimateZone/ClimateZoneType"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRealm"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/realmRegion/LowLatitude"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreacz:Doldrums</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A nautical term for the equatorial trough, with special reference to the light and variable nature of the winds.</rdfs:comment>
        <rdfs:label xml:lang="en">doldrums</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmClimateZone/DryClimate -->

    <owl:Class rdf:about="http://sweetontology.net/realmClimateZone/DryClimate">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmClimateZone/ClimateClassification"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreacz:DryClimate</metadata:prefixIRI>
        <rdfs:label xml:lang="en">dry climate</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmClimateZone/DryWinterClimate -->

    <owl:Class rdf:about="http://sweetontology.net/realmClimateZone/DryWinterClimate">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmClimateZone/ClimateClassification"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaClimate/hasDrySeason"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprTimeSeason/Winter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreacz:DryWinterClimate</metadata:prefixIRI>
        <rdfs:label xml:lang="en">dry winter climate</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmClimateZone/E -->

    <owl:Class rdf:about="http://sweetontology.net/realmClimateZone/E">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmClimateZone/ClimateClassification"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreacz:E</metadata:prefixIRI>
        <rdfs:label xml:lang="en">e</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmClimateZone/Equator -->

    <owl:Class rdf:about="http://sweetontology.net/realmClimateZone/Equator">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmClimateZone/TropicalClimateZone"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreacz:Equator</metadata:prefixIRI>
        <rdfs:label xml:lang="en">equator</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmClimateZone/ITCZ -->

    <owl:Class rdf:about="http://sweetontology.net/realmClimateZone/ITCZ">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmClimateZone/IntertropicalConvergenceZone"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmClimateZone/ClimateZoneType"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreacz:ITCZ</metadata:prefixIRI>
        <rdfs:label xml:lang="en">itcz</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmClimateZone/IntertropicalConvergenceZone -->

    <owl:Class rdf:about="http://sweetontology.net/realmClimateZone/IntertropicalConvergenceZone">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmClimateZone/ClimateZoneType"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRealm"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmClimateZone/Equator"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreacz:IntertropicalConvergenceZone</metadata:prefixIRI>
        <rdfs:label xml:lang="en">intertropical convergence zone</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmClimateZone/MarineClimate -->

    <owl:Class rdf:about="http://sweetontology.net/realmClimateZone/MarineClimate">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmClimateZone/ClimateClassification"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRealm"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/realm/Ocean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreacz:MarineClimate</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">(Also called maritime climate, oceanic climate.) A regional climate under the predominant influence of the sea, characterized by relatively small seasonal variations and high atmospheric moisture content; the antithesis of a continental climate.</rdfs:comment>
        <rdfs:label xml:lang="en">marine climate</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmClimateZone/RainShadow -->

    <owl:Class rdf:about="http://sweetontology.net/realmClimateZone/RainShadow">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmClimateZone/ClimateZoneType"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreacz:RainShadow</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A region of sharply reduced precipitation on the lee side of an orographic barrier, as compared with regions upwind of the barrier.</rdfs:comment>
        <rdfs:label xml:lang="en">rain shadow</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmClimateZone/SubtropicalClimateZone -->

    <owl:Class rdf:about="http://sweetontology.net/realmClimateZone/SubtropicalClimateZone">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmClimateZone/ClimateZoneType"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreacz:SubtropicalClimateZone</metadata:prefixIRI>
        <rdfs:label xml:lang="en">subtropical climate zone</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmClimateZone/TemperateClimate -->

    <owl:Class rdf:about="http://sweetontology.net/realmClimateZone/TemperateClimate">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmClimateZone/ClimateClassification"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreacz:TemperateClimate</metadata:prefixIRI>
        <rdfs:label xml:lang="en">temperate climate</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmClimateZone/TropicalClimate -->

    <owl:Class rdf:about="http://sweetontology.net/realmClimateZone/TropicalClimate">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmClimateZone/ClimateClassification"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreacz:TropicalClimate</metadata:prefixIRI>
        <rdfs:label xml:lang="en">tropical climate</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmClimateZone/TropicalClimateZone -->

    <owl:Class rdf:about="http://sweetontology.net/realmClimateZone/TropicalClimateZone">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmClimateZone/ClimateZoneType"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreacz:TropicalClimateZone</metadata:prefixIRI>
        <rdfs:label xml:lang="en">tropical climate zone</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmClimateZone/WetSummerClimate -->

    <owl:Class rdf:about="http://sweetontology.net/realmClimateZone/WetSummerClimate">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmClimateZone/ClimateClassification"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaClimate/hasWetSeason"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprTimeSeason/Summer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreacz:WetSummerClimate</metadata:prefixIRI>
        <rdfs:label xml:lang="en">wet summer climate</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmClimateZone/WetSummerDryWinterClimate -->

    <owl:Class rdf:about="http://sweetontology.net/realmClimateZone/WetSummerDryWinterClimate">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmClimateZone/DryWinterClimate"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmClimateZone/WetSummerClimate"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreacz:WetSummerDryWinterClimate</metadata:prefixIRI>
        <rdfs:label xml:lang="en">wet summer dry winter climate</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmCryo/AblationZone -->

    <owl:Class rdf:about="http://sweetontology.net/realmCryo/AblationZone">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmCryo/GlacialRegion"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreac:AblationZone</metadata:prefixIRI>
        <rdfs:label xml:lang="en">ablation zone</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000914"/>
        <skos:definition>
            <rdf:Description>
                <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2019-12-10T06:11:13-08:00</terms:created>
                <terms:creator rdf:resource="https://orcid.org/0000-0003-4091-6059"/>
                <terms:source rdf:resource="https://en.wikipedia.org/wiki/Ablation_zone"/>
                <rdfs:comment xml:lang="en">An environmental zone which overlaps a glacier or an ice sheet, and in which ice loss exceeds ice gain.</rdfs:comment>
                <prov:wasDerivedFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000914"/>
            </rdf:Description>
        </skos:definition>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmCryo/AccumulationZone -->

    <owl:Class rdf:about="http://sweetontology.net/realmCryo/AccumulationZone">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmCryo/GlacialRegion"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreac:AccumulationZone</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">This zone usually occurs at higher elevations and generally overlaps the conversion of snow to glacial ice.</rdfs:comment>
        <rdfs:label xml:lang="en">accumulation zone</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001352"/>
        <skos:definition>
            <rdf:Description>
                <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2019-12-10T06:11:13-08:00</terms:created>
                <terms:creator rdf:resource="https://orcid.org/0000-0003-4091-6059"/>
                <terms:source rdf:resource="https://orcid.org/0000-0003-4808-4736"/>
                <rdfs:comment xml:lang="en">An ice accumulation zone which overlaps part of a glacier.</rdfs:comment>
                <prov:wasDerivedFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001352"/>
            </rdf:Description>
        </skos:definition>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmCryo/AlpineTundra -->

    <owl:Class rdf:about="http://sweetontology.net/realmCryo/AlpineTundra">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmCryo/Tundra"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreac:AlpineTundra</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Alpine tundra is an ecozone that does not contain trees because it has high altitude. Alpine tundra occurs at high enough altitude at any latitude on Earth. Alpine tundra also lacks trees, but the lower part does not have permafrost, and alpine soils are generally better drained than permafrost soils. Alpine tundra transitions to subalpine forests below the tree line; stunted forests occurring at the forest-tundra ecotone are known as Krummholz. Alpine tundra occurs in an alpine zone</rdfs:comment>
        <rdfs:label xml:lang="en">alpine tundra</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001371"/>
        <skos:definition>
            <rdf:Description>
                <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2019-12-10T06:11:13-08:00</terms:created>
                <terms:creator rdf:resource="https://orcid.org/0000-0003-4091-6059"/>
                <terms:source rdf:resource="https://orcid.org/0000-0003-4808-4736"/>
                <rdfs:comment xml:lang="en">A tundra ecosystem which exists at high altitudes and where vegetation is stunted due to low temperatures and high winds.</rdfs:comment>
                <prov:wasDerivedFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001371"/>
            </rdf:Description>
        </skos:definition>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmCryo/Calf -->

    <owl:Class rdf:about="http://sweetontology.net/realmCryo/Calf">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmCryo/SeaIce"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreac:Calf</metadata:prefixIRI>
        <rdfs:label xml:lang="en">calf</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001506"/>
        <skos:definition>
            <rdf:Description>
                <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2019-12-10T06:11:13-08:00</terms:created>
                <terms:creator rdf:resource="https://orcid.org/0000-0003-4091-6059"/>
                <terms:source rdf:resource="https://orcid.org/0000-0003-4808-4736"/>
                <rdfs:comment xml:lang="en">An ice mass which has calved off an larger mass of ice.</rdfs:comment>
                <rdfs:comment xml:lang="en">This definition is intentionally broad to include the multiple existing and used definitions of ice calfs.</rdfs:comment>
                <prov:wasDerivedFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001506"/>
            </rdf:Description>
        </skos:definition>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmCryo/CongelationIce -->

    <owl:Class rdf:about="http://sweetontology.net/realmCryo/CongelationIce">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmCryo/SeaIce"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreac:CongelationIce</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Congelation ice usually forms through the fusion/coalescence of platelets into solid ice.</rdfs:comment>
        <rdfs:label xml:lang="en">congelation ice</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001512"/>
        <skos:definition>
            <rdf:Description>
                <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2019-12-10T08:05:43-08:00</terms:created>
                <terms:creator rdf:resource="https://orcid.org/0000-0003-4091-6059"/>
                <terms:source rdf:resource="https://orcid.org/0000-0003-4808-4736"/>
                <rdfs:comment xml:lang="en">Sea ice which 1) has formed on the submerged surface (i.e. the base) of an existing mass of sea ice and 2) is composed of columnar crystals due to the downward growth of the crystals into the water.</rdfs:comment>
                <prov:wasDerivedFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001512"/>
            </rdf:Description>
        </skos:definition>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmCryo/DriftIce -->

    <owl:Class rdf:about="http://sweetontology.net/realmCryo/DriftIce">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmCryo/SeaIce"/>
        <owl:disjointWith rdf:resource="http://sweetontology.net/realmCryo/FastIce"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreac:DriftIce</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Prior to approximately 2014, drift ice was synonymous with the various grades of pack ice, described as very open (with an ice concentration of 1/10 to 3/10), open (4/10 to 6/10, with many leads and polynyas and the floes generally not in contact with one another), close (7/10 to 8/10, composed of floes mostly in contact), very close (9/10 to less than 10/10), and compact (10/10, with no water visible, called consolidated pack ice if the floes are frozen together). This is deprecated, with pack ice now referring to drift ice with a concentration equal to or above 7/10; however, other usages are still common.</rdfs:comment>
        <rdfs:label xml:lang="en">drift ice</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001517"/>
        <skos:definition>
            <rdf:Description>
                <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2019-12-10T08:45:12-08:00</terms:created>
                <terms:creator rdf:resource="https://orcid.org/0000-0003-4091-6059"/>
                <terms:source rdf:resource="https://orcid.org/0000-0003-4808-4736"/>
                <rdfs:comment xml:lang="en">A floating mass of ice which is 1) unattached to land or land-fast ice and 2) moved by the action of winds or currents.</rdfs:comment>
                <prov:wasDerivedFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001517"/>
            </rdf:Description>
        </skos:definition>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmCryo/FastIce -->

    <owl:Class rdf:about="http://sweetontology.net/realmCryo/FastIce">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmCryo/SeaIce"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreac:FastIce</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Fast ice is central to the livelihoods of Arctic coastal communities who use it to access fishing and hunting grounds. Vertical fluctuations may be observed during changes of sea level. Fast ice may be formed on site from sea water or by freezing of pack ice of any age to the shore, and it may extend a few yards (meters) or several hundred miles (kilometers) from the coast. Fast ice may be more than one year old and may then be prefixed with appropriate age category (old, second- year, or multiyear). If it is thicker than about 7 ft (2 m) above sea level, it is called an ice shelf.</rdfs:comment>
        <rdfs:label xml:lang="en">fast ice</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001522"/>
        <skos:definition>
            <rdf:Description>
                <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2019-12-10T08:50:11-08:00</terms:created>
                <terms:creator rdf:resource="https://orcid.org/0000-0003-4091-6059"/>
                <terms:source rdf:resource="https://orcid.org/0000-0003-4808-4736"/>
                <rdfs:comment xml:lang="en">A mass of sea ice which 1) is less than 2 meters in thickness and 2) forms along the coast, where it is attached to the shore, to an ice wall, to an ice front, or between shoals or grounded icebergs.</rdfs:comment>
                <prov:wasDerivedFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001522"/>
            </rdf:Description>
        </skos:definition>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmCryo/Floe -->

    <owl:Class rdf:about="http://sweetontology.net/realmCryo/Floe">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmCryo/IceFloe"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmCryo/SeaIce"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreac:Floe</metadata:prefixIRI>
        <rdfs:label xml:lang="en">sea ice floe</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/ENVO_03000066"/>
        <skos:definition>
            <rdf:Description>
                <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2019-12-10T08:54:28-08:00</terms:created>
                <terms:creator rdf:resource="https://orcid.org/0000-0003-4091-6059"/>
                <terms:source rdf:resource="https://nsidc.org/cryosphere/glossary/term/ice-floe"/>
                <rdfs:comment xml:lang="en">An ice floe which is formed from frozen sea water, and floats upon the surface of a marine water body.</rdfs:comment>
                <prov:wasDerivedFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_03000066"/>
            </rdf:Description>
        </skos:definition>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmCryo/FrazilIce -->

    <owl:Class rdf:about="http://sweetontology.net/realmCryo/FrazilIce">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmCryo/SeaIce"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreac:FrazilIce</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Typically 3 to 4 millimeters in diameter. These new ice classes refer to both marine water and fresh water ice. If using this term for annotation, use it in conjunction with another envo term to express whether the ice is in a marine, freshwater, or other system.</rdfs:comment>
        <rdfs:label xml:lang="en">frazil ice</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/ENVO_03000046"/>
        <skos:definition>
            <rdf:Description>
                <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2019-12-10T08:57:38-08:00</terms:created>
                <terms:creator rdf:resource="https://orcid.org/0000-0003-4091-6059"/>
                <terms:source rdf:resource="https://nsidc.org/cryosphere/glossary/term/frazil"/>
                <rdfs:comment xml:lang="en">New ice which is composed frazil which has congealed into a thin sheet.</rdfs:comment>
                <prov:wasDerivedFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_03000046"/>
            </rdf:Description>
        </skos:definition>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmCryo/FrozenGround -->

    <owl:Class rdf:about="http://sweetontology.net/realmCryo/FrozenGround">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/Land"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasState"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/Frozen"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreac:FrozenGround</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Perennially and seasonally frozen ground can vary from being partially to extensively frozen depending on the extent of the phase change. It may be described as hard frozen ground, plastic frozen ground, or dry frozen ground, depending on the pore ice and unfrozen water contents and its compressibility under load.</rdfs:comment>
        <rdfs:comment xml:lang="en">Soil within which the moisture has predominantly changed to ice, the unfrozen portion being in vapor phase. Ice within the soil bonds (adfreezes) adjacent soil particles and renders frozen ground very hard. Permanently frozen ground is called permafrost. Dry frozen ground is relatively loose and crumbly because of the lack of bonding ice. Frozen ground is sometimes inadvisedly called frost or ground frost.</rdfs:comment>
        <rdfs:label xml:lang="en">frozen ground</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001524"/>
        <skos:definition>
            <rdf:Description>
                <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2019-12-10T09:00:09-08:00</terms:created>
                <terms:creator rdf:resource="https://orcid.org/0000-0003-4091-6059"/>
                <terms:source rdf:resource="https://orcid.org/0000-0003-4808-4736"/>
                <rdfs:comment xml:lang="en">Land which is below the freezing point of water.</rdfs:comment>
                <prov:wasDerivedFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001524"/>
            </rdf:Description>
        </skos:definition>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmCryo/GlacialRegion -->

    <owl:Class rdf:about="http://sweetontology.net/realmCryo/GlacialRegion">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetaryRealm"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreac:GlacialRegion</metadata:prefixIRI>
        <rdfs:label xml:lang="en">glacial region</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmCryo/Glacier -->

    <owl:Class rdf:about="http://sweetontology.net/realmCryo/Glacier">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrWater/Ice"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreac:Glacier</metadata:prefixIRI>
        <rdfs:label xml:lang="en">glacier</rdfs:label>
        <skos:definition>
            <rdf:Description>
                <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2019-12-10T09:06:36-08:00</terms:created>
                <terms:creator rdf:resource="https://orcid.org/0000-0003-4091-6059"/>
                <terms:source rdf:resource="https://orcid.org/0000-0003-4808-4736"/>
                <rdfs:comment xml:lang="en">The definition of glacier is highly variable. Two main issues exist: 1) Whether or not a mass of ice must currently show movement to be considered a glacier or not and 2) What is the relationship between ice sheets and glaciers (i.e., which is the parent in a parent/child relationship or whether they are distinct terms).</rdfs:comment>
                <prov:wasDerivedFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000133"/>
            </rdf:Description>
        </skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000133"/>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmCryo/GlacierTerminus -->

    <owl:Class rdf:about="http://sweetontology.net/realmCryo/GlacierTerminus">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmCryo/Snout"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmCryo/GlacialRegion"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreac:GlacierTerminus</metadata:prefixIRI>
        <rdfs:label xml:lang="en">glacier terminus</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001529"/>
        <skos:definition>
            <rdf:Description>
                <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2019-12-10T09:09:25-08:00</terms:created>
                <terms:creator rdf:resource="https://orcid.org/0000-0003-4091-6059"/>
                <terms:source rdf:resource="https://orcid.org/0000-0003-4808-4736"/>
                <rdfs:comment xml:lang="en">An ice mass which constitutes that part of a glacier which has the lowest elevation.</rdfs:comment>
                <prov:wasDerivedFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001529"/>
            </rdf:Description>
        </skos:definition>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmCryo/IceBase -->

    <owl:Class rdf:about="http://sweetontology.net/realmCryo/IceBase">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetaryBoundary"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetarySurfaceLevel"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreac:IceBase</metadata:prefixIRI>
        <rdfs:label xml:lang="en">ice base</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmCryo/IceCap -->

    <owl:Class rdf:about="http://sweetontology.net/realmCryo/IceCap">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetaryRealm"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreac:IceCap</metadata:prefixIRI>
        <rdfs:label xml:lang="en">ice cap</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000145"/>
        <skos:definition>
            <rdf:Description>
                <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2019-12-10T09:12:52-08:00</terms:created>
                <terms:creator rdf:resource="https://orcid.org/0000-0003-4091-6059"/>
                <terms:source rdf:resource="https://en.wikipedia.org/wiki/Ice_cap"/>
                <rdfs:comment xml:lang="en">A dome-shaped ice mass that covers less than 50,000 km2 of land area (usually covering a highland area).</rdfs:comment>
                <prov:wasDerivedFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000145"/>
            </rdf:Description>
        </skos:definition>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmCryo/IceCore -->

    <owl:Class rdf:about="http://sweetontology.net/realmCryo/IceCore">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprSciModel/Sample"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/inside"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/matrWater/Ice"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreac:IceCore</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The composition of an ice core can be used to reconstruct past climates and climate change; typically removed from an ice sheet (Antarctica and Greenland) or from high mountain glaciers elsewhere.</rdfs:comment>
        <rdfs:label xml:lang="en">ice core</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001530"/>
        <skos:definition>
            <rdf:Description>
                <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2019-12-13T13:58:24-08:00</terms:created>
                <terms:creator rdf:resource="https://orcid.org/0000-0003-4091-6059"/>
                <terms:source rdf:resource="https://orcid.org/0000-0003-4808-4736"/>
                <rdfs:comment xml:lang="en">An ice mass which has been drilled from an accumulation of snow and ice that has built up over many years and that has recrystallized and has trapped air bubbles from previous time periods.</rdfs:comment>
                <prov:wasDerivedFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001530"/>
            </rdf:Description>
        </skos:definition>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmCryo/IceField -->

    <owl:Class rdf:about="http://sweetontology.net/realmCryo/IceField">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmCryo/SeaIce"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreac:IceField</metadata:prefixIRI>
        <rdfs:label xml:lang="en">ice field</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001531"/>
        <skos:definition>
            <rdf:Description>
                <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2019-12-13T14:02:20-08:00</terms:created>
                <terms:creator rdf:resource="https://orcid.org/0000-0003-4091-6059"/>
                <terms:source rdf:resource="https://orcid.org/0000-0003-4808-4736"/>
                <rdfs:comment xml:lang="en">An ice field which is primarily composoed of sea ice floes greater than 10 kilometers across.</rdfs:comment>
                <prov:wasDerivedFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001531"/>
            </rdf:Description>
        </skos:definition>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmCryo/IceFloe -->

    <owl:Class rdf:about="http://sweetontology.net/realmCryo/IceFloe">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmCryo/SeaIce"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreac:IceFloe</metadata:prefixIRI>
        <rdfs:label xml:lang="en">ice floe</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/ENVO_03000066"/>
        <skos:definition>
            <rdf:Description>
                <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2019-12-10T08:54:28-08:00</terms:created>
                <terms:creator rdf:resource="https://orcid.org/0000-0003-4091-6059"/>
                <terms:source rdf:resource="https://nsidc.org/cryosphere/glossary/term/ice-floe"/>
                <rdfs:comment xml:lang="en">An ice floe which is formed from frozen sea water, and floats upon the surface of a marine water body.</rdfs:comment>
                <prov:wasDerivedFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_03000066"/>
            </rdf:Description>
        </skos:definition>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmCryo/IceSheet -->

    <owl:Class rdf:about="http://sweetontology.net/realmCryo/IceSheet">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmCryo/Glacier"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreac:IceSheet</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">An ice sheet is a mass of glacier ice that covers surrounding terrain and is greater than 50,000 square km (19,305 square mile).</rdfs:comment>
        <rdfs:label xml:lang="en">ice sheet</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000132"/>
        <skos:definition>
            <rdf:Description>
                <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2020-02-12T12:45:11-08:00</terms:created>
                <terms:creator rdf:resource="https://orcid.org/0000-0003-4091-6059"/>
                <terms:source rdf:resource="https://orcid.org/0000-0003-4808-4736"/>
                <rdfs:comment xml:lang="en">A glacier which covers an area of greater than 50,000 square kilometers.</rdfs:comment>
                <prov:wasDerivedFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000132"/>
            </rdf:Description>
        </skos:definition>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmCryo/IceShelf -->

    <owl:Class rdf:about="http://sweetontology.net/realmCryo/IceShelf">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrWater/Ice"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreac:IceShelf</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">An ice shelf may grow hundreds of miles out to sea.  Usually of great horizontal extent and with a level or gently undulating surface. Nourished by annual snow accumulation and also by the seaward extension of land glaciers. Limited areas may be aground. Ice shelves are much thicker than sea ice often filling embayments in the coastline of an ice sheet.. Currently, nearly all ice shelves are in Antarctica, where most of the ice discharged into the ocean flows via ice shelves. The mass balance of an ice shelf may have significant components of both gain and loss at the base. The seaward edge is termed an ice front.  The calving of an ice shelf forms tabular icebergs and ice islands.</rdfs:comment>
        <rdfs:label xml:lang="en">ice shelf</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000380"/>
        <skos:definition>
            <rdf:Description>
                <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2020-02-12T12:52:35-08:00</terms:created>
                <terms:creator rdf:resource="https://orcid.org/0000-0003-4091-6059"/>
                <terms:source rdf:resource="https://orcid.org/0000-0003-4808-4736"/>
                <rdfs:comment xml:lang="en">An ice mass which 1) is attached to the coast 2) at least 2 meters in thickness 3) forms where a glacier or ice mass flows down to a coastline and onto the ocean surface and 4) grows by annual snow accumulation or by the seaward extension of land glaciers.</rdfs:comment>
                <prov:wasDerivedFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000380"/>
            </rdf:Description>
        </skos:definition>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmCryo/IceSnowInterface -->

    <owl:Class rdf:about="http://sweetontology.net/realmCryo/IceSnowInterface">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetaryBoundary"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetarySurfaceLevel"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreac:IceSnowInterface</metadata:prefixIRI>
        <rdfs:label xml:lang="en">ice snow interface</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmCryo/IceStream -->

    <owl:Class rdf:about="http://sweetontology.net/realmCryo/IceStream">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrWater/Ice"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreac:IceStream</metadata:prefixIRI>
        <rdfs:label xml:lang="en">ice stream</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmCryo/IceSurface -->

    <owl:Class rdf:about="http://sweetontology.net/realmCryo/IceSurface">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetaryBoundary"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetarySurfaceLevel"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreac:IceSurface</metadata:prefixIRI>
        <rdfs:label xml:lang="en">ice surface</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001545"/>
        <skos:definition>
            <rdf:Description>
                <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2020-02-12T13:05:30-08:00</terms:created>
                <terms:creator rdf:resource="https://orcid.org/0000-0003-4091-6059"/>
                <terms:source rdf:resource="https://orcid.org/0000-0003-4808-4736"/>
                <rdfs:comment xml:lang="en">A two-dimensional fiat ice surface which is composed primarily of water ice.</rdfs:comment>
                <prov:wasDerivedFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001545"/>
            </rdf:Description>
        </skos:definition>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmCryo/Iceberg -->

    <owl:Class rdf:about="http://sweetontology.net/realmCryo/Iceberg">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmCryo/LandIce"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRealm"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/realm/Ocean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreac:Iceberg</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The greater part of an iceberg&apos;s mass (4/5 to 8/9) is below sea level, which makes them dangerous to shipping in high and mid-latitude regions of the ocean. The top of an ice berg usually protrudes more than 5 m above water-level and typically extends from tens of meters to many tens of kilometres across. Icebergs may be described as tabular, dome-shaped, sloping, pinnacled, dry-docked, blocky, weathered or glacier bergs in addition to having a size qualifier. Icebergs are not sea ice, when they melt they add fresh water to the ocean.  The unmodified term iceberg usually refers to the irregular masses of ice formed by the calving of glaciers along an orographically rough coast, whereas tabular icebergs and ice islands are calved from an ice shelf, while bergs formed from sea ice are called floebergs. In decreasing size, they are classified as: ice island (few thousand square meters to 500 km^2 in area); tabular iceberg; iceberg; bergy bit (less than 5 m above sea level, between 1 and 200 m^2 in area); and growler (less than 1 m above sea level, about 20 m^2 in area). Alaskan icebergs rarely exceed 500 feet in maximum dimension.  Antarctic icebergs originate from the ice mass of the Antarctic continent that has accumulated over many thousands of years.</rdfs:comment>
        <rdfs:label xml:lang="en">iceberg</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001546"/>
        <skos:definition>
            <rdf:Description>
                <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2020-02-12T13:16:09-08:00</terms:created>
                <terms:creator rdf:resource="https://orcid.org/0000-0003-4091-6059"/>
                <terms:source rdf:resource="https://orcid.org/0000-0003-4808-4736"/>
                <rdfs:comment xml:lang="en">An ice mass which has broken away from a larger ice mass on land, such as a glacier or ice shelf, and may be either afloat or aground.</rdfs:comment>
                <prov:wasDerivedFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001546"/>
            </rdf:Description>
        </skos:definition>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmCryo/LandIce -->

    <owl:Class rdf:about="http://sweetontology.net/realmCryo/LandIce">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrWater/Ice"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRealm"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/realm/Land"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreac:LandIce</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Land ice is any part of the Earth&apos;s seasonal or perennial ice cover that has formed over land as the result, principally, of the freezing of precipitation; opposed to sea ice formed by the freezing of seawater.  Thus, an iceberg or tabular iceberg is land ice as well as its parent glacier, ice sheet, or ice shelf. The two major concentrations of land ice are the ice sheets of Greenland and Antarctica. Glaciers and ice caps are the other important forms; however, some members of the glaciology community hold that glaciers (i.e. rock glaciers) need not have any ice.</rdfs:comment>
        <rdfs:label xml:lang="en">land ice</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001547"/>
        <skos:definition>
            <rdf:Description>
                <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2020-02-12T13:18:57-08:00</terms:created>
                <terms:creator rdf:resource="https://orcid.org/0000-0003-4091-6059"/>
                <terms:source rdf:resource="https://orcid.org/0000-0003-4808-4736"/>
                <rdfs:comment xml:lang="en">An ice mass which has formed over land.</rdfs:comment>
                <prov:wasDerivedFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001547"/>
            </rdf:Description>
        </skos:definition>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmCryo/Lead -->

    <owl:Class rdf:about="http://sweetontology.net/realmCryo/Lead">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmCryo/SeaIce"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreac:Lead</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Generally, leads are wide enough (and deep enough) for navigation by surface vessels. The term is generally applied to linear features. If the open area is very large it may be called a polynya, although the application of these terms is under debate.</rdfs:comment>
        <rdfs:label xml:lang="en">lead</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001551"/>
        <skos:definition>
            <rdf:Description>
                <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2020-02-12T13:21:01-08:00</terms:created>
                <terms:creator rdf:resource="https://orcid.org/0000-0003-4091-6059"/>
                <terms:source rdf:resource="https://orcid.org/0000-0003-4808-4736"/>
                <rdfs:comment xml:lang="en">A surface layer of a water body which has been formed as the result of surface ice fracturing and moving apart.</rdfs:comment>
                <prov:wasDerivedFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001551"/>
            </rdf:Description>
        </skos:definition>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmCryo/PackIce -->

    <owl:Class rdf:about="http://sweetontology.net/realmCryo/PackIce">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmCryo/DriftIce"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreac:PackIce</metadata:prefixIRI>
        <rdfs:comment>Has related synonym drift ice. Prior to approximately 2014, pack ice was used for all ranges of drift ice concentrations, thus the terms were in close synonymy.</rdfs:comment>
        <rdfs:label xml:lang="en">pack ice</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001556"/>
        <skos:definition>
            <rdf:Description>
                <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2020-02-12T13:39:40-08:00</terms:created>
                <terms:creator rdf:resource="https://orcid.org/0000-0003-4091-6059"/>
                <terms:source rdf:resource="https://orcid.org/0000-0003-4808-4736"/>
                <rdfs:comment xml:lang="en">A drift ice mass which has an ice concentration above or equal to 7/10: which covers 70% or more of a given area of a water body.</rdfs:comment>
                <prov:wasDerivedFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001556"/>
            </rdf:Description>
        </skos:definition>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmCryo/SeaIce -->

    <owl:Class rdf:about="http://sweetontology.net/realmCryo/SeaIce">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrWater/Ice"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRealm"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/realm/Ocean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreac:SeaIce</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">In the United States, NOAA sea ice operations does not include superstructure icing as being sea ice. In sea ice operations however, sea ice is any form of ice found at sea which has originated from the freezing of sea water. It presents the main kind of floating ice encountered at sea. Except where it forms ridges, sea ice is up to a few metres thick, in which respect it differs from shelf ice.  Sea ice may be discontinuous pieces (ice floes) moved on the ocean surface by wind and currents (pack ice), or a motionless sheet attached to the coast (land-fast ice). In brief, it forms first as lolly ice (frazil crystals), thickens into sludge, and coagulates into sheet ice, pancake ice, or into floes of various shapes and sizes. Thereafter, sea ice may develop into pack ice and/or become a form of pressure ice.  Sea ice less than one year old is called first-year ice. Perennial ice is sea ice that survives at least one summer. It may be subdivided into second-year ice and multi-year ice, where multiyear ice has survived at least two summers.</rdfs:comment>
        <rdfs:comment xml:lang="en">Specifically, ice formed by the freezing of seawater; as opposed, principally, to land ice.  Generally, any ice floating in the sea.</rdfs:comment>
        <rdfs:label xml:lang="en">sea ice</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/ENVO_00002200"/>
        <skos:definition>
            <rdf:Description>
                <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2020-02-12T13:43:39-08:00</terms:created>
                <terms:creator rdf:resource="https://orcid.org/0000-0003-4091-6059"/>
                <terms:source rdf:resource="https://orcid.org/0000-0003-4808-4736"/>
                <rdfs:comment xml:lang="en">Water ice which has formed by the freezing of sea water.</rdfs:comment>
                <prov:wasDerivedFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_00002200"/>
            </rdf:Description>
        </skos:definition>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmCryo/SeasonalIce -->

    <owl:Class rdf:about="http://sweetontology.net/realmCryo/SeasonalIce">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmCryo/SeaIce"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreac:SeasonalIce</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Sea ice develops from young ice; thickness from 0.3 to 2 meters (1 to 6.6 feet).  Sea ice be subdivided into thin first-year ice (white ice), medium first-year ice, and thick first-year ice.  First-year ice is distinguished from older ice primarily by having a higher salinity. Undeformed first-year ice differs from older ice in that it is smoother and lacks refrozen melt ponds. Characteristically level where undisturbed by pressure, but where ridges occur, they  distinguished by being larger, more angular, and more porous than multiyear ridges.</rdfs:comment>
        <rdfs:label xml:lang="en">seasonal ice</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/ENVO_03000071"/>
        <skos:definition>
            <rdf:Description>
                <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2020-02-12T13:45:28-08:00</terms:created>
                <terms:creator rdf:resource="https://orcid.org/0000-0003-4091-6059"/>
                <terms:source rdf:resource="https://orcid.org/0000-0003-4808-4736"/>
                <rdfs:comment xml:lang="en">Sea ice which has formed over a single freezing season.</rdfs:comment>
                <prov:wasDerivedFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_03000071"/>
            </rdf:Description>
        </skos:definition>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmCryo/Snout -->

    <owl:Class rdf:about="http://sweetontology.net/realmCryo/Snout">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmCryo/GlacialRegion"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreac:Snout</metadata:prefixIRI>
        <rdfs:label xml:lang="en">snout</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001529"/>
        <skos:definition>
            <rdf:Description>
                <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2020-02-12T13:48:09-08:00</terms:created>
                <terms:creator rdf:resource="https://orcid.org/0000-0003-4091-6059"/>
                <terms:source rdf:resource="https://orcid.org/0000-0003-4808-4736"/>
                <rdfs:comment xml:lang="en">An ice mass which constitutes that part of a glacier which has the lowest elevation.</rdfs:comment>
                <prov:wasDerivedFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001529"/>
            </rdf:Description>
        </skos:definition>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmCryo/TabularIceberg -->

    <owl:Class rdf:about="http://sweetontology.net/realmCryo/TabularIceberg">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmCryo/Iceberg"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreac:TabularIceberg</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Newly formed tabular icebergs have nearly vertical sides and flat tops. In the Antarctic, they may be tens of kilometers wide, up to 160 km (100 miles) long, and as much as 300 m (1000 ft) thick, with about 30 m (100 ft) exposed above the sea surface. In the Arctic, large icebergs of this type are called ice islands, but they are considerably smaller than the largest of the antarctic variety. Has synonyms tabular berg, table iceberg. Formerly called barrier iceberg.</rdfs:comment>
        <rdfs:label xml:lang="en">tabular iceberg</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001534"/>
        <skos:definition>
            <rdf:Description>
                <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2020-02-12T13:50:16-08:00</terms:created>
                <terms:creator rdf:resource="https://orcid.org/0000-0003-4091-6059"/>
                <terms:source rdf:resource="https://orcid.org/0000-0003-4808-4736"/>
                <rdfs:comment xml:lang="en">An iceberg which 1) has a flat upper surface, 2) is derived from an ice shelf, ice tongue, or floating tidewater glacier via detachment.</rdfs:comment>
                <prov:wasDerivedFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001534"/>
            </rdf:Description>
        </skos:definition>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmCryo/Tundra -->

    <owl:Class rdf:about="http://sweetontology.net/realmCryo/Tundra">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/Land"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRealm"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/realmCryo/FrozenGround"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreac:Tundra</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">In physical geography, tundra is an area where the tree growth is hindered by low temperatures and short growing seasons. There are two types of tundra: Arctic tundra (which also occurs in Antarctica), and alpine tundra. In tundra, the vegetation is composed of dwarf shrubs, sedges and grasses, mosses, and lichens. Scattered trees grow in some tundra. The ecotone (or ecological boundary region) between the tundra and the forest is known as the tree line or timberline.</rdfs:comment>
        <rdfs:label xml:lang="en">tundra</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000112"/>
        <skos:definition>
            <rdf:Description>
                <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2020-02-12T13:52:08-08:00</terms:created>
                <terms:creator rdf:resource="https://orcid.org/0000-0003-4091-6059"/>
                <terms:source rdf:resource="https://orcid.org/0000-0003-4808-4736"/>
                <rdfs:comment xml:lang="en">A vegetated area which is part of a tundra ecosystem.</rdfs:comment>
                <prov:wasDerivedFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000112"/>
            </rdf:Description>
        </skos:definition>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/Asthenosphere -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/Asthenosphere">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmGeol/UpperMantleFlowing"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/UpperMantle"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:Asthenosphere</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The asthenosphere is a portion of the upper mantle just below the lithosphere.  Seismic waves pass relatively slowly through the asthenosphere, compared to the overlying lithospheric mantle, thus it has been called the low-velocity zone. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">asthenosphere</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/Basement -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/Basement">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicStructure"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:Basement</metadata:prefixIRI>
        <rdfs:label xml:lang="en">basement</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/Batholith -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/Batholith">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/PlutonicStructure"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:Batholith</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A batholith is a large emplacement of igneous intrusive (also called plutonic) rock that forms from cooled magma deep in the Earth&apos;s crust. Batholiths are almost always made mostly of felsic or intermediate rock-types, such as granite, quartz monzonite, or diorite (see also granite dome).There is also an important geographic usage of the term batholith. For a geographer, a batholith is an exposed area of mostly continuous plutonic rock that covers an area larger than 100 square kilometers. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">batholith</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/Bedrock -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/Bedrock">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeosphereLayer"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:Bedrock</metadata:prefixIRI>
        <rdfs:label xml:lang="en">bedrock</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/BrittleDuctileTransitionZone -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/BrittleDuctileTransitionZone">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/Crust"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/SkinLayer"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:BrittleDuctileTransitionZone</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">D layer is the layer which separates the mantle from the core. D may consist of material from subducted slabs that descended and came to rest at the core-mantle boundary and/or from a new mineral polymorph discovered in perovskite called post-perovskite.[Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">brittle ductile transition zone</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/Continental -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/Continental">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetaryRealm"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:Continental</metadata:prefixIRI>
        <rdfs:label xml:lang="en">continental</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/Core -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/Core">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeosphereLayer"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:Core</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The central most structure inside the earth. The core does not allow shear waves to pass through it, while the speed of travel (seismic velocity) is different in the other layers. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">core</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/CoreMantleBoundary -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/CoreMantleBoundary">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmGeol/GuttenburgDiscontinuity"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicBoundary"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:CoreMantleBoundary</metadata:prefixIRI>
        <rdfs:label xml:lang="en">core mantle boundary</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/Cover -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/Cover">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicStructure"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:Cover</metadata:prefixIRI>
        <rdfs:label xml:lang="en">cover</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/Crust -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/Crust">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmGeol/SkinLayer"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeosphereLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/hasLowerBoundary"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmGeol/Moho"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:Crust</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The crust is the outermost solid shell of a rocky planet or moon, which is chemically distinct from the underlying mantle.  [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">crust</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/CrustMantleBoundary -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/CrustMantleBoundary">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmGeol/Moho"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicBoundary"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:CrustMantleBoundary</metadata:prefixIRI>
        <rdfs:label xml:lang="en">crust mantle boundary</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/DLayer -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/DLayer">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/Mantle"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:DLayer</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">D layer is the layer which separates the mantle from the core. D may consist of material from subducted slabs that descended and came to rest at the core-mantle boundary and/or from a new mineral polymorph discovered in perovskite called post-perovskite.[Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">d layer</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/Dike -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/Dike">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/PlutonicStructure"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:Dike</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Dikes, long, planar (sheet) igneous intrusions, enter along cracks, and therefore often form in large numbers in areas that are being actively deformed. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">dike</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/Fabric -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/Fabric">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpace/Configuration"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpace/SpatialConfiguration"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:Fabric</metadata:prefixIRI>
        <rdfs:label xml:lang="en">fabric</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/GeologicBoundary -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/GeologicBoundary">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetaryBoundary"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetarySurfaceLevel"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:GeologicBoundary</metadata:prefixIRI>
        <rdfs:label xml:lang="en">geologic boundary</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/GeologicFeature -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/GeologicFeature">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRealm"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realm/Geosphere"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:GeologicFeature</metadata:prefixIRI>
        <terms:contributor>
            <rdf:Description>
                <rdf:type rdf:resource="https://schema.org/Organization"/>
                <schema:identifier rdf:resource="http://linked.data.gov.au/org/gsq"/>
                <schema:name>Geological Survey of Queensland</schema:name>
            </rdf:Description>
        </terms:contributor>
        <rdfs:comment xml:lang="en"> or Surface Feature is a distinct recognizable structure within a larger context such as a stream bed, fissure, dike, etc.</rdfs:comment>
        <rdfs:label xml:lang="en">geologic feature</rdfs:label>
        <skos:altLabel>Geologic Feature</skos:altLabel>
        <skos:altLabel>Geological Feature</skos:altLabel>
        <skos:definition xml:lang="en">A geologic feature is a conceptual feature a that is hypothesized to exist coherently in the Earth that results from geological processes</skos:definition>
        <skos:example xml:lang="en">Individuals: Lake Eyre Basin, Sarmatian Craton, Victoria Point Sandbar, Mount Erebus Volcano. Subclasses: Basin, Craton, Shield, Province, Sub-Province.</skos:example>
        <skos:scopeNote xml:lang="en">Geologic Features include sedimentary basins, stratigraphic units, non-stratigraphic (lithodemic) units, stratigraphic event features, provinces, tectonic and structural features, georesource accumulations, and geologically significant sites, among others</skos:scopeNote>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/GeologicProvince -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/GeologicProvince">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicFeature"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:GeologicProvince</metadata:prefixIRI>
        <rdfs:comment xml:lang="en"> A geologic or geomorphic province is a spatial entity with common geologic/geomorphic attributes. A province may include a single dominant structural element such as a basin or a fold belt, or a number of contiguous related elements. Most commonly, provinces are classified by age, origin, or mineral resource.    [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">geologic province</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/GeologicStructure -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/GeologicStructure">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/Geosphere"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/SolidEarth"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRealm"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realm/Geosphere"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:GeologicStructure</metadata:prefixIRI>
        <rdfs:label xml:lang="en">geologic structure</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/GeosphereLayer -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/GeosphereLayer">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/GlobalPlanetaryLayer"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetaryLayer"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/Subsurface"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRealm"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realm/Geosphere"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:GeosphereLayer</metadata:prefixIRI>
        <rdfs:label xml:lang="en">geosphere layer</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/GiantDikeSwarm -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/GiantDikeSwarm">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/Dike"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:GiantDikeSwarm</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A dike swarm or dyke swarm in geology is a major group of parallel, linear, or radially oriented dikes intruded within continental crust. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">giant dike swarm</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/GuttenburgDiscontinuity -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/GuttenburgDiscontinuity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicBoundary"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:GuttenburgDiscontinuity</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The core-mantle boundary. This discontinuity is due to the differences between the acoustic impedances of the solid mantle and the molten outer core. P-wave velocities are much slower in the outer core than in the deep mantle while S-waves do not exist at all in the liquid portion of the core. Corresponds to top of D``. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">guttenburg discontinuity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/InnerCore -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/InnerCore">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/Mantle"/>
        <owl:disjointWith rdf:resource="http://sweetontology.net/realmGeol/OuterCore"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:InnerCore</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The solid inner core was discovered in 1936 by Inge Lehmann and is generally believed to be composed primarily of iron and some nickel.[Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">inner core</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/Laccolith -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/Laccolith">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/PlutonicStructure"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:Laccolith</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">#Aseismic</rdfs:comment>
        <rdfs:label xml:lang="en">laccolith</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/LehmannDiscontinuity -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/LehmannDiscontinuity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicBoundary"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:LehmannDiscontinuity</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Boundary between Asthenosphere and Lithosphere. It is the discontinuity in seismic velocity near a depth of 220 km. It appears beneath continents, but not usually beneath oceans, and does not readily appear in globally-averaged studies [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">lehmann discontinuity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/Lithosphere -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/Lithosphere">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeosphereLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/containsMaterial"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/matrRock/Rock"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:Lithosphere</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">In the Earth, the lithosphere includes the crust and the uppermost mantle, which constitute the hard and rigid outer layer of the planet. The division of Earth&apos;s outer layers into lithosphere and asthenosphere should not be confused with the chemical subdivision of the outer Earth into mantle, and crust. All crust is in the lithosphere, but lithosphere generally contains more mantle than crust. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">lithosphere</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/Lopolith -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/Lopolith">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/PlutonicStructure"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:Lopolith</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">[Pluton] Igneous intrusion - A lopolith is a large igneous intrusion which is lenticular in shape with a depressed central region. Lopoliths are generally concordant with the intruded strata with dike or funnel-shaped feeder bodies below the body. Lopoliths typically consist of large ultramafic to mafic layered intrusions that range in age from Archean to Eocene. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">lopolith</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/LowerMantle -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/LowerMantle">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/Mantle"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:LowerMantle</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Very little is known about the lower mantle apart from that it appears to be relatively seismically homogeneous. The lower mantle is under tremendous pressure and therefore has a higher viscosity than the upper mantle.[Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">lower mantle</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/Mantle -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/Mantle">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeosphereLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/hasUpperBoundary"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmGeol/Moho"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:Mantle</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The mantle is a highly viscous layer between the crust and the outer core. Earth&apos;s mantle is an approximately 2,970 km thick (~1,800 mi) rocky shell that constitutes approximately 84 percent of Earth&apos;s volume.  [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">mantle</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/Mesosphere -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/Mesosphere">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmGeol/UpperMantleRigid"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/UpperMantle"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:Mesosphere</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The mesosphere refers to the mantle in the region between the asthenosphere and the outer core. The upper boundary is defined as the sharp increase in seismic wave velocities and density at a depth of 660 km. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">mesosphere</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/Moho -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/Moho">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmGeol/Mohorovi_i_Discontinuity"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicBoundary"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:Moho</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The boundary between the crust and mantle is conventionally placed at the Mohorovi_i_ discontinuity, a boundary defined by a contrast in seismic velocity. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">moho</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/Mohorovi_i_Discontinuity -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/Mohorovi_i_Discontinuity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicBoundary"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:Mohorovi_i_Discontinuity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">mohorovicic discontinuity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/OuterCore -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/OuterCore">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/Mantle"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:OuterCore</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The liquid outer core surrounds the inner core and is believed to be composed of iron mixed with nickel and trace amounts of lighter elements. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">outer core</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/PlutonicStructure -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/PlutonicStructure">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicStructure"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:PlutonicStructure</metadata:prefixIRI>
        <rdfs:label xml:lang="en">plutonic structure</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/SeismicZone -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/SeismicZone">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicFeature"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:SeismicZone</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Seismic Zones are broad elongated regions along a fault line where earthquakes take place. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">seismic zone</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/Sill -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/Sill">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/PlutonicStructure"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:Sill</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">[Pluton] Igneous intrusion - A sill is a tabular pluton that has intruded between older layers of sedimentary rock, beds of volcanic lava or tuff, or even along the direction of foliation in metamorphic rock. The term sill is synonymous with concordant intrusive sheet. This means that the sill does not cut across preexisting rocks, in contrast to dikes, which do cut across older rocks. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">sill</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/SkinLayer -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/SkinLayer">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeosphereLayer"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:SkinLayer</metadata:prefixIRI>
        <rdfs:label xml:lang="en">skin layer</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/SolidEarth -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/SolidEarth">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetaryRealm"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:SolidEarth</metadata:prefixIRI>
        <rdfs:label xml:lang="en">solid earth</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/Subsurface -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/Subsurface">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetaryRealm"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:Subsurface</metadata:prefixIRI>
        <rdfs:label xml:lang="en">subsurface</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/TransitionalCrust -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/TransitionalCrust">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/Crust"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/SkinLayer"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:TransitionalCrust</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Transitional crust is crust that is thinned by the upwelling of mantle.  [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">transitional crust</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/TransitionalLithosphere -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/TransitionalLithosphere">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeosphereLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/hasPlanetaryStructure"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/realmGeol/TransitionalCrust"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:TransitionalLithosphere</metadata:prefixIRI>
        <rdfs:label xml:lang="en">transitional lithosphere</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/UpperMantle -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/UpperMantle">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/Mantle"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:UpperMantle</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The mantle is divided into sections based upon results from seismology. The upper mantle is the region from 33–410 km (20 to 254 miles). The upper part of the mantle is composed mostly of peridotite, a rock denser than rocks common in the overlying crust. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">upper mantle</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/UpperMantleFlowing -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/UpperMantleFlowing">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/UpperMantle"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:UpperMantleFlowing</metadata:prefixIRI>
        <rdfs:label xml:lang="en">upper mantle flowing</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeol/UpperMantleRigid -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeol/UpperMantleRigid">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/UpperMantle"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreag:UpperMantleRigid</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The uppermost mantle plus overlying crust are relatively rigid and form the lithosphere, an irregular layer with a maximum thickness of perhaps 200 km. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">upper mantle rigid</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolBasin/BackArcBasin -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolBasin/BackArcBasin">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolBasin/Basin"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagb:BackArcBasin</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Back-arc basins (or retro-arc basins) are geologic features, submarine basins associated with island arcs and subduction zones. They are found at some convergent plate boundaries, presently concentrated in the Western Pacific ocean. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">back arc basin</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolBasin/Basin -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolBasin/Basin">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicFeature"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprSpaceGeometry/Depression"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagb:Basin</metadata:prefixIRI>
        <rdfs:label xml:lang="en">basin</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolBasin/FlyschBasin -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolBasin/FlyschBasin">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolBasin/Basin"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagb:FlyschBasin</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Flysch is a sequence of sedimentary rocks that is deposited in a deep marine facies in the foreland basin of a developing orogen. Flysch is formed under deep marine circumstances, in a quiet and low-energetic depositional environment. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">flysch basin</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolBasin/ForeArcBasin -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolBasin/ForeArcBasin">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolBasin/Basin"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagb:ForeArcBasin</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A forearc is a depression (basin) in the sea floor located between a subduction zone and an associated volcanic arc. It is typically filled with sediments from the adjacent landmass and the island arc in addition to trapped oceanic crustal material. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">fore arc basin</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolBasin/ForelandBasin -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolBasin/ForelandBasin">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolBasin/Basin"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagb:ForelandBasin</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A foreland basin is a depression that develops adjacent and parallel to a mountain belt. Foreland basins form because the immense mass created by crustal thickening associated with the evolution of a mountain belt causes the lithosphere to bend, by a process known as lithospheric flexure. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">foreland basin</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolBasin/IntraArcBasin -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolBasin/IntraArcBasin">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolBasin/Basin"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagb:IntraArcBasin</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Intra-arc basins are basins that occur between Fore-arc basins and back-arc basins [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">intra arc basin</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolBasin/IntracratonicBasin -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolBasin/IntracratonicBasin">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolBasin/Basin"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagb:IntracratonicBasin</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Intracratonic basins are formed by fluvial sedimentation of an intracratonic area which has undergone sediment sag-loading. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">intracratonic basin</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolBasin/PeripheralForelandBasin -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolBasin/PeripheralForelandBasin">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolBasin/Basin"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaChemical/hasSubstance"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/matrRock/Molasse"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/hasPlanetaryStructure"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmGeolBasin/FlyschBasin"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagb:PeripheralForelandBasin</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Peripheral (Pro) foreland basins occur on the plate that is subducted or underthrust during plate collision (i.e. the outer arc of the orogen).</rdfs:comment>
        <rdfs:label xml:lang="en">peripheral foreland basin</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolBasin/RetroarcForelandBasin -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolBasin/RetroarcForelandBasin">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolBasin/Basin"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagb:RetroarcForelandBasin</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Retroarc (Retro) foreland basins occur on the plate that overrides during plate convergence or collision (i.e. situated behind the magmatic arc that is linked with the subduction of oceanic lithosphere). [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">retroarc foreland basin</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolBasin/SuccessorBasin -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolBasin/SuccessorBasin">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolBasin/Basin"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagb:SuccessorBasin</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Successor basins arise from shifting and merging of fore arc, back-arc and intra-arc basins. Basins or sequences that overlap terrane boundaries. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">successor basin</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolBasin/TranspressionalBasin -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolBasin/TranspressionalBasin">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolBasin/Basin"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagb:TranspressionalBasin</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Transpression basins are formed during oblique collision of tectonic plates and during non-orthogonal subduction. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">transpressional basin</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolBasin/TranstensionalBasin -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolBasin/TranstensionalBasin">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolBasin/Basin"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagb:TranstensionalBasin</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Transtension basins are oblique tensional environments where stretching takes place. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">transtensional basin</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolConstituent/ArmoredRelictInclusion -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolConstituent/ArmoredRelictInclusion">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolConstituent/Inclusion"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcons:ArmoredRelictInclusion</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">An inclusion of an earlier rock that is prevented from further reaction in a later rock by a rim of reaction products.</rdfs:comment>
        <rdfs:label xml:lang="en">armored relict inclusion</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolConstituent/ArmouredRelictCrystal -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolConstituent/ArmouredRelictCrystal">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolConstituent/ParticulateConstituent"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcons:ArmouredRelictCrystal</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">a crystal of an earlier rock that is prevented from further reaction in a later rock by a rim of reaction products</rdfs:comment>
        <rdfs:label xml:lang="en">armoured relict crystal</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolConstituent/Chadacryst -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolConstituent/Chadacryst">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolConstituent/ParticulateConstituent"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcons:Chadacryst</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">the enclosed crystal in a poikolitic texture</rdfs:comment>
        <rdfs:label xml:lang="en">chadacryst</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolConstituent/ClastSupportingOrthomatrix -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolConstituent/ClastSupportingOrthomatrix">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolConstituent/Orthomatrix"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcons:ClastSupportingOrthomatrix</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Orthomatrix in matrix supported sedimentary rock.</rdfs:comment>
        <rdfs:label xml:lang="en">clast supporting orthomatrix</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolConstituent/Clot -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolConstituent/Clot">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolConstituent/StructuralConfiguration"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcons:Clot</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A cluster of ferromagnesian minerals in an igneous rock, from several centimeters to decimeters in diameter, that may be a segregation or an altered xenolith.</rdfs:comment>
        <rdfs:label xml:lang="en">clot</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolConstituent/Corona -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolConstituent/Corona">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolConstituent/StructuralConfiguration"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcons:Corona</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Constituent occurs as a concentric envelope enclosing another constituent. Corona is a non-genetic term.</rdfs:comment>
        <rdfs:label xml:lang="en">corona</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolConstituent/CorrosionRim -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolConstituent/CorrosionRim">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolConstituent/Corona"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcons:CorrosionRim</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A corona formed by a secondary mineral around an orginal igneous crystal, formed by modification of the crystal by the corrosive action of its parent magma.</rdfs:comment>
        <rdfs:label xml:lang="en">corrosion rim</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolConstituent/CrystallineFramework -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolConstituent/CrystallineFramework">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolConstituent/ParticulateConstituent"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcons:CrystallineFramework</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Constituent forms an interconnected network of discernible crystals.</rdfs:comment>
        <rdfs:label xml:lang="en">crystalline framework</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolConstituent/Dropstone -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolConstituent/Dropstone">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolConstituent/StructuralConfiguration"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcons:Dropstone</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">An oversized stone in laminated sediment that depresses the underlying laminae and may be covered by -draped laminae.  Most dropstones originate through ice-rafting; other sources are floating tree roots and kelp holdfasts....</rdfs:comment>
        <rdfs:label xml:lang="en">dropstone</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolConstituent/Epimatrix -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolConstituent/Epimatrix">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolConstituent/Matrix"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcons:Epimatrix</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A type of matrix consisting of inhomogeneous interstitial materials grown in originally open interstices during diagenesis, but lacking the homogeneity and clear textural evidence of pore-filling needed to classify as phyllosilicate cement.</rdfs:comment>
        <rdfs:label xml:lang="en">epimatrix</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolConstituent/FloatingClast -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolConstituent/FloatingClast">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolConstituent/StructuralConfiguration"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcons:FloatingClast</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Constituent is a clast that has no visible contacts with other clasts. Interpreted to be largely or completly immersed in matrix or cement.</rdfs:comment>
        <rdfs:label xml:lang="en">floating clast</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolConstituent/GranularFramework -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolConstituent/GranularFramework">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolConstituent/ParticulateConstituent"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcons:GranularFramework</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Constituent forms a rigid arrangement of particles that support one another at their points of contact...constituting a mechanically firm structure capable of supporting open pore spaces, although interstices may be occupied by cement or matrix</rdfs:comment>
        <rdfs:label xml:lang="en">granular framework</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolConstituent/Groundmass -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolConstituent/Groundmass">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolConstituent/RockConstituent"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcons:Groundmass</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Constituent forms an interconnected network of material enclosing other constituents that are disguished by larger grain size.</rdfs:comment>
        <rdfs:label xml:lang="en">groundmass</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolConstituent/Inclusion -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolConstituent/Inclusion">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolConstituent/StructuralConfiguration"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcons:Inclusion</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A fragment of older material within an igneous rock to which it may or may not be genetically related.</rdfs:comment>
        <rdfs:label xml:lang="en">inclusion</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolConstituent/InterstitialConstituent -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolConstituent/InterstitialConstituent">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolConstituent/RockConstituent"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcons:InterstitialConstituent</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Constituent is distributed through the material between other constituent particles</rdfs:comment>
        <rdfs:label xml:lang="en">interstitial constituent</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolConstituent/Irregular -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolConstituent/Irregular">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolConstituent/StructuralConfiguration"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcons:Irregular</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A constituent with irregular distribution and geometry, as in pseudobreccia or patch migmatite.</rdfs:comment>
        <rdfs:label xml:lang="en">irregular</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolConstituent/KelyphiticRim -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolConstituent/KelyphiticRim">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolConstituent/Corona"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcons:KelyphiticRim</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Corona that consists of concentric bands with radial fibrous texture.</rdfs:comment>
        <rdfs:label xml:lang="en">kelyphitic rim</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolConstituent/Layer -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolConstituent/Layer">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolConstituent/StructuralConfiguration"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcons:Layer</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A thin sheet compositionally distinct from the surrounding material, related to primary genesis of rock, e.g. sedimentary layers, metamorphic segregation.</rdfs:comment>
        <rdfs:label xml:lang="en">layer</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolConstituent/Matrix -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolConstituent/Matrix">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolConstituent/RockConstituent"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcons:Matrix</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Constituent forms finer-grained material interstitial to a framework constituent. ‘The finer-grained material enclosing, or filling the interstices between, the larger grains or particles of a sediment or sedimentary rock....The term refers to the relative size and disposition of the particles, and no particular particle size is implied’ (Jackson, 1997, p. 393).  May be classifiable into orthomatrix, protomatrix, epimatrix, pseudomatrix, and unclassified matrix.</rdfs:comment>
        <rdfs:label xml:lang="en">matrix</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolConstituent/Megacryst -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolConstituent/Megacryst">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolConstituent/ParticulateConstituent"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcons:Megacryst</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">constituent occurs as a collection of particles that are characterized by average properties of the individual particles</rdfs:comment>
        <rdfs:label xml:lang="en">megacryst</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolConstituent/Oikocryst -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolConstituent/Oikocryst">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolConstituent/ParticulateConstituent"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcons:Oikocryst</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Constituent occurs as crystals that poikilitically enclose crystals of other phases in an igneous rock.</rdfs:comment>
        <rdfs:label xml:lang="en">oikocryst</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolConstituent/Orthomatrix -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolConstituent/Orthomatrix">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolConstituent/Matrix"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcons:Orthomatrix</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A type of matrix consisting of recrystallized detrital lutum  (clay fraction, less than 2 micron) or protomatrix.</rdfs:comment>
        <rdfs:label xml:lang="en">orthomatrix</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolConstituent/Overgrowth -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolConstituent/Overgrowth">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolConstituent/StructuralConfiguration"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcons:Overgrowth</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Constituent crystallized in crystallographic continuity with some other mineral constituent, typically quartz or calcite. In a clastic rock, commonly forms cement as well, but this should be represented using two role attribute links, &apos;overgrowth&apos; and cement, because overgrowth does not necessarily imply cement.</rdfs:comment>
        <rdfs:label xml:lang="en">overgrowth</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolConstituent/ParticulateConstituent -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolConstituent/ParticulateConstituent">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolConstituent/RockConstituent"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcons:ParticulateConstituent</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">any crystal in an igneous or metamorphic rock that is sgnificantly larger than the surounding groundmass.  May be a phenocryst, xenocryst, porphyroblast or porphyroclast.</rdfs:comment>
        <rdfs:label xml:lang="en">particulate constituent</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolConstituent/Phenoclast -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolConstituent/Phenoclast">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolConstituent/ParticulateConstituent"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcons:Phenoclast</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">a relatively large and conspicuous fragment in a sediment or sedimentary rock</rdfs:comment>
        <rdfs:label xml:lang="en">phenoclast</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolConstituent/Phenocryst -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolConstituent/Phenocryst">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolConstituent/Megacryst"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcons:Phenocryst</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A phenocryst is a relatively large and usually conspicuous crystal distinctly larger than the grains of the rock groundmass of a porphyritic igneous rock. Phenocrysts often have euhedral forms either due to early growth within a magma or by post-emplacement recrystallization. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">phenocryst</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolConstituent/Porphyroblast -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolConstituent/Porphyroblast">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolConstituent/Megacryst"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcons:Porphyroblast</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Constituent occurs as crystals formed by metamorphic crystallization, set in a finer-grained groundmass.</rdfs:comment>
        <rdfs:label xml:lang="en">porphyroblast</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolConstituent/Porphyroclast -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolConstituent/Porphyroclast">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolConstituent/Megacryst"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcons:Porphyroclast</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Relict crystal in metamorphic rock, in groundmass of relatively finer-grained material. Connotes that groundmass is result of tectonic reduction in grain size.</rdfs:comment>
        <rdfs:label xml:lang="en">porphyroclast</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolConstituent/Protomatrix -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolConstituent/Protomatrix">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolConstituent/Matrix"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcons:Protomatrix</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A type of matrix consisting of un-recrystallized detrital clayey lutum  (clay fraction, less than 2 micron) in weakly consolidated rocks.</rdfs:comment>
        <rdfs:label xml:lang="en">protomatrix</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolConstituent/Pseudomatrix -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolConstituent/Pseudomatrix">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolConstituent/Matrix"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcons:Pseudomatrix</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A type of matrix consisting of soft deformable framework grains that are squeezed and flattened between stronger framework grains.</rdfs:comment>
        <rdfs:label xml:lang="en">pseudomatrix</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolConstituent/RockConstituent -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolConstituent/RockConstituent">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propChemical/Constituent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaChemical/hasSubstance"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/matrRock/Rock"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcons:RockConstituent</metadata:prefixIRI>
        <rdfs:label xml:lang="en">rock constituent</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolConstituent/SedimentaryRockCement -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolConstituent/SedimentaryRockCement">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolConstituent/RockConstituent"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcons:SedimentaryRockCement</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A constituent that occupies space between individual grains of a consolidated sedimentary rock, and binds the grains together as a rigid, coherent mass; it may be derived from the sediment or its entrapped waters, or it may be brought in by solution from outside sources. Material is usually chemically precipitated (Jackson, 1997, p. 103). Distinguished from matrix by clearly secondary origin and generally monomineralic charactera</rdfs:comment>
        <rdfs:label xml:lang="en">sedimentary rock cement</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolConstituent/SmallConcretion -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolConstituent/SmallConcretion">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolConstituent/StructuralConfiguration"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcons:SmallConcretion</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A hard, compact mass or aggregate of mineral matter, normally subsperical but commonly oblate, disc-shaped or irregular.  Formed by precipitation of mineral from solution in the pores of a granular rock, localized around a nucleus or center, to define a discrete, sharply separated object. Size ranges from cm to decimeter for application as a compoundMaterialConstituentPart; larger concretions should be considered GeologicUnit parts.</rdfs:comment>
        <rdfs:label xml:lang="en">small concretion</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolConstituent/StructuralConfiguration -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolConstituent/StructuralConfiguration">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolConstituent/RockConstituent"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcons:StructuralConfiguration</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Constituent occurs in a structural configuration integral to the rock, such as layering, veinlets, overgrowths. The &apos;material&apos; composition of these parts will often be other rock materials, not minerals, and  &apos;ParticleGeometryDescription&apos; associated with these describes the geometry of the constituent, not the particles the it is made of. These roles are mostly useful for RockMaterial descriptions that apply to individual samples, because their distribution is unlikely to be pervasive enought to be considered characteristic of a large mass of material.</rdfs:comment>
        <rdfs:label xml:lang="en">structural configuration</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolConstituent/Vein -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolConstituent/Vein">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolConstituent/StructuralConfiguration"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcons:Vein</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Thin sheet of material intruded into the rock. May be hydrothermal, magmatic, or sedimentary.</rdfs:comment>
        <rdfs:label xml:lang="en">vein</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolConstituent/Vug -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolConstituent/Vug">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolConstituent/StructuralConfiguration"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprSpaceGeometry3D/Cavity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcons:Vug</metadata:prefixIRI>
        <rdfs:label xml:lang="en">vug</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolContinental/ActiveContinent -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolContinental/ActiveContinent">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicProvince"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/partOf"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmGeolContinental/ContinentalLithosphere"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcont:ActiveContinent</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A distinction of whether the continental margins are active (subducting).  [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">active continent</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolContinental/ContinentalCrust -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolContinental/ContinentalCrust">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/Continental"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/Crust"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/SkinLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasRock"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/matrRockIgneous/Felsic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/partOf"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmGeolContinental/ContinentalLithosphere"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcont:ContinentalCrust</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The continental crust is typically from 30 km (20 mi) to 50 km (30 mi) thick, and it is mostly composed of less dense rocks, such as granite, than is the oceanic crust. The continental crust has an average composition similar to that of the igneous rock, andesite.[Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">continental crust</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolContinental/ContinentalLithosphere -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolContinental/ContinentalLithosphere">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/Continental"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/Lithosphere"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/hasPlanetaryStructure"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmGeolContinental/Craton"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcont:ContinentalLithosphere</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">[Mechanical or Seismic Definition of Structure] In the Earth, the lithosphere includes the crust and the uppermost mantle, which constitute the hard and rigid outer layer of the planet. The [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">continental lithosphere</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolContinental/ContinentalMargin -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolContinental/ContinentalMargin">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/stateRoleGeographic/Margin"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcont:ContinentalMargin</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The continental margin is the zone of the ocean floor that separates the thin oceanic crust from thick continental crust. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">continental margin</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolContinental/ContinentalPlatform -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolContinental/ContinentalPlatform">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicProvince"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcont:ContinentalPlatform</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The extensive central cratons of continents may consist of both shields and platforms, and the crystalline basement. A platform is that part of the craton for which the basement is overlain by horizontal or subhorizontal sediments. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">continental platform</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolContinental/ContinentalRift -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolContinental/ContinentalRift">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandTectonic/DivergentBoundary"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandTectonic/DivergentPlateBoundary"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandTectonic/Rift"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcont:ContinentalRift</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A long, narrow fissure in the Earth marking a zone of the lithosphere that has become thinner due to extensional forces associated with plate teconics. Continental rifts are thousands of kilometers in length and hundreds of kilometers in width, and they are associated with normal faults and with grabens. [FreeDictionary]</rdfs:comment>
        <rdfs:label xml:lang="en">continental rift</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolContinental/Craton -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolContinental/Craton">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicProvince"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/partOf"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmGeolContinental/ContinentalCrust"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaChemical/hasSubstance"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/matrRockIgneous/Kimberlite"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/hasPlanetaryStructure"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmGeolBasin/IntracratonicBasin"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/hasPlanetaryStructure"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmGeolContinental/ContinentalPlatform"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/hasPlanetaryStructure"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmGeolContinental/Shield"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcont:Craton</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A craton is an old and stable part of the continental crust that has survived the merging and splitting of continents and supercontinents for at least 500 million years. Some are over two billion years old. Cratons are generally found in the interiors of continents and are characteristically composed of ancient crystalline basement crust of lightweight felsic igneous rock such as granite. They have a thick crust and deep roots that extend into the mantle beneath to depths of 200 km. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">craton</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolContinental/Shield -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolContinental/Shield">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicProvince"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcont:Shield</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The extensive central cratons of continents may consist of both shields and platforms, and the crystalline basement. A shield is that part of a craton in which the usually Precambrian basement rocks crop out extensively at the surface.  [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">shield</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolContinental/StableContinent -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolContinental/StableContinent">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicProvince"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/partOf"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmGeolContinental/ContinentalLithosphere"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcont:StableContinent</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A distinction of whether the continental is on a stable paltform, i.e., over millions of years. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">stable continent</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolContinental/Supercontinent -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolContinental/Supercontinent">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicProvince"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRealm"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmGeolContinental/ContinentalLithosphere"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/hasPlanetaryStructure"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmGeolContinental/Craton"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagcont:Supercontinent</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">In geology, a supercontinent is a land mass comprising more than one continental core, or craton. The assembly of cratons and accreted terranes that form Eurasia qualifies as a supercontinent today.</rdfs:comment>
        <rdfs:label xml:lang="en">supercontinent</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolOrogen/Arc -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolOrogen/Arc">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicFeature"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprSpaceGeometry/Arc"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagor:Arc</metadata:prefixIRI>
        <rdfs:label xml:lang="en">arc</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolOrogen/ArcAxis -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolOrogen/ArcAxis">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propSpaceDirection/Axis"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagor:ArcAxis</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">In a Back-arc basin the arc axis is the line where spreading occurs on the overlying plate of the subduction zone. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">arc axis</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolOrogen/BackArc -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolOrogen/BackArc">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmGeolOrogen/RearArc"/>
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmGeolOrogen/RetroArc"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolOrogen/Arc"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagor:BackArc</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Back-arc basins (or retro-arc basins) are geologic features, submarine basins associated with island arcs and subduction zones. They are found at some convergent plate boundaries, presently concentrated in the Western Pacific ocean. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">back arc</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolOrogen/ForeArc -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolOrogen/ForeArc">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolOrogen/Arc"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmLandTectonic/SupraSubductionZoneComplex"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagor:ForeArc</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A forearc is a depression in the sea floor located between a subduction zone and an associated volcanic arc. It is typically filled with sediments from the adjacent landmass and the island arc in addition to trapped oceanic crustal material.  [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">fore arc</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolOrogen/MagmaticArc -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolOrogen/MagmaticArc">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolOrogen/Arc"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/hasPlanetaryStructure"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/realmGeolOrogen/ForeArc"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/hasPlanetaryStructure"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/realmGeolOrogen/RearArc"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/hasAxis"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmGeolOrogen/ArcAxis"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagor:MagmaticArc</metadata:prefixIRI>
        <rdfs:label xml:lang="en">magmatic arc</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolOrogen/Orogen -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolOrogen/Orogen">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/GeologicProvince"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/phenGeol/OrogenicCollapse"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/phenGeol/Orogeny"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasPhenomena"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/phenSolid/Deformation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaChemical/hasSubstance"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/matrRock/Melange"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/hasPlanetaryStructure"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/phenGeolTectonic/Terrane"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/hasPlanetaryStructure"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/realmGeolBasin/ForelandBasin"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/hasPlanetaryStructure"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/realmLandTectonic/Suture"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/hasPlanetaryStructure"/>
                <owl:someValuesFrom rdf:resource="http://sweetontology.net/realmLandTectonic/ThrustSystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagor:Orogen</metadata:prefixIRI>
        <rdfs:label xml:lang="en">orogen</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolOrogen/RearArc -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolOrogen/RearArc">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolOrogen/Arc"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagor:RearArc</metadata:prefixIRI>
        <rdfs:label xml:lang="en">rear arc</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolOrogen/RemnantArc -->

    <owl:Class rdf:about="http://sweetontology.net/realmGeolOrogen/RemnantArc">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeolOrogen/Arc"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreagor:RemnantArc</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The remnant arc is what is left on the rear side of the speading zone as athe basin broadens. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">remnant arc</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmGeolOrogen/RetroArc -->

