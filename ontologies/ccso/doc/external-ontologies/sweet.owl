        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somael:Chalcophile</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">An element such as copper that forms sulphide minerals if sufficient sulphur is available.</rdfs:comment>
        <rdfs:label xml:lang="en">chalcophile</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrElement/ChemicalElement -->

    <owl:Class rdf:about="http://sweetontology.net/matrElement/ChemicalElement">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/matrElement/Element"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/Chemical"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/ChemicalSubstance"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somael:ChemicalElement</metadata:prefixIRI>
        <rdfs:label xml:lang="en">chemical element</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrElement/Element -->

    <owl:Class rdf:about="http://sweetontology.net/matrElement/Element">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/Chemical"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matr/ChemicalSubstance"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somael:Element</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A chemical element is a pure chemical substance consisting of one type of atom distinguished by its atomic number, which is the number of protons in its nucleus. The term is also used to refer to a pure chemical substance composed of atoms with the same number of protons. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">element</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrElement/Ha -->

    <owl:Class rdf:about="http://sweetontology.net/matrElement/Ha">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/matrElement/Halogen"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrElement/ChemicalElement"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrElement/Element"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somael:Ha</metadata:prefixIRI>
        <rdfs:label xml:lang="en">ha</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/matrElement/Halogen -->

