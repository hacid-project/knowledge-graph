                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorepm:Point</metadata:prefixIRI>
        <rdfs:label xml:lang="en">point</rdfs:label>
    </owl:Class>
    


