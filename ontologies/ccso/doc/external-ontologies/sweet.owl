        <owl:disjointWith rdf:resource="http://sweetontology.net/repr/OrdinalScale"/>
        <owl:disjointWith rdf:resource="http://sweetontology.net/repr/QuantitativeScale"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorep:CategoricalScale</metadata:prefixIRI>
