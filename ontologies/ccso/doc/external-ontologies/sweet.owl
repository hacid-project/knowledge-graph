            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophcy:AnnualCycle</metadata:prefixIRI>
        <rdfs:label xml:lang="en">annual cycle</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/phenCycle/AntarcticOscillation -->

    <owl:Class rdf:about="http://sweetontology.net/phenCycle/AntarcticOscillation">
