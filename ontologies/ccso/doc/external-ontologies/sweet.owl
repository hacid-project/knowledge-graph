        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropst:Evapotranspiration</metadata:prefixIRI>
        <rdfs:label xml:lang="en">evapotranspiration</rdfs:label>
    </owl:Class>
    


