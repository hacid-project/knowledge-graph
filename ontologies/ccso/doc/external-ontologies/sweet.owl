        <rdfs:subClassOf rdf:resource="http://sweetontology.net/matrInstrument/Instrument"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/measures"/>
