                <owl:someValuesFrom rdf:resource="http://sweetontology.net/propSpaceDistance/Dispersivity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsdis:DispersionCoeffienct</metadata:prefixIRI>
