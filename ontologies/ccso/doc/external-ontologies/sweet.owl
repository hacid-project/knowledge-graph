        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprMath/Array"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/eachElementHasType"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/repr/Coordinate"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorep:Coordinates</metadata:prefixIRI>
