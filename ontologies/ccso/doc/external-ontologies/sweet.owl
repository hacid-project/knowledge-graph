    </owl:Class>
    


    <!-- http://sweetontology.net/propFraction/Reflectance -->

    <owl:Class rdf:about="http://sweetontology.net/propFraction/Reflectance">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/prop/WaveProperty"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propFraction/FractionalQuantity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropfr:Reflectance</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A general term referring to the radiation reflected from, or scattered back through, a given surface in response to radiation incident on the surface with the same wavelength or wavelength range.</rdfs:comment>
        <rdfs:label xml:lang="en">reflectance</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propFraction/Reflectivity -->

