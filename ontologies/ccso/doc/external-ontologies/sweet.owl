        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenBiol/BiologicalPhenomena"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophb:PlantStress</metadata:prefixIRI>
