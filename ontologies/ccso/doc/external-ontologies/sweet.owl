        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sophei:MassExtinctionEvent</metadata:prefixIRI>
        <rdfs:label xml:lang="en">mass extinction event</rdfs:label>
    </owl:Class>
    


