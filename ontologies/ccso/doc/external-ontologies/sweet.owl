        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTime/DurationDescription"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTime/TimeInterval"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaTime/hasTime"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprTimeSeason/Winter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropti:WinterDuration</metadata:prefixIRI>
        <rdfs:label xml:lang="en">winter duration</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTimeFrequency/Bandwidth -->

    <owl:Class rdf:about="http://sweetontology.net/propTimeFrequency/Bandwidth">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/prop/WaveProperty"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTimeFrequency/Frequency"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soproptf:Bandwidth</metadata:prefixIRI>
        <rdfs:label xml:lang="en">bandwidth</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTimeFrequency/BruntVaisalaFrequency -->

    <owl:Class rdf:about="http://sweetontology.net/propTimeFrequency/BruntVaisalaFrequency">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTimeFrequency/Frequency"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/measureOf"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/phenFluidInstability/StaticStability"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soproptf:BruntVaisalaFrequency</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The frequency at which a displaced parcel will oscillate when displaced vertically within a statically stable environment.</rdfs:comment>
        <rdfs:label xml:lang="en">brunt vaisala frequency</rdfs:label>
    </owl:Class>
    


