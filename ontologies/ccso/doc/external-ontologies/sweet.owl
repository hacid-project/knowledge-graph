        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropsdis:MixingLength</metadata:prefixIRI>
        <rdfs:label xml:lang="en">mixing length</rdfs:label>
    </owl:Class>
    


