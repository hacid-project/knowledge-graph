    </owl:Class>
    


    <!-- http://sweetontology.net/procPhysical/Conduction -->

    <owl:Class rdf:about="http://sweetontology.net/procPhysical/Conduction">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procPhysical/PhysicalProcess"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprocp:Conduction</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Transport of energy (charge) solely as a consequence of random motions of individual molecules (ions, electrons) not moving together in coherent groups.</rdfs:comment>
        <rdfs:label xml:lang="en">conduction</rdfs:label>
