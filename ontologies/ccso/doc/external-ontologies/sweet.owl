        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/Acoustic"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/AcousticWave"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/Acoustics"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/GravitationalWave"/>
