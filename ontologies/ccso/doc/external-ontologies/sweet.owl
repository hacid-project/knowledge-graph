    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergyFlux/TerrestrialRadiation -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergyFlux/TerrestrialRadiation">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergyFlux/RadiativeFlux"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropef:TerrestrialRadiation</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Longwave radiation originating by thermal emission from a planetary surface and/or its atmosphere</rdfs:comment>
        <rdfs:label xml:lang="en">terrestrial radiation</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propEnergyFlux/ThermalFlux -->

    <owl:Class rdf:about="http://sweetontology.net/propEnergyFlux/ThermalFlux">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propEnergyFlux/EnergyFlux"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/ThermodynamicQuantity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropef:ThermalFlux</metadata:prefixIRI>
