        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaofl:ColdSeep</metadata:prefixIRI>
        <rdfs:label xml:lang="en">cold seep</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmOceanFloor/ContinentalRise -->

    <owl:Class rdf:about="http://sweetontology.net/realmOceanFloor/ContinentalRise">
