                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propEnergy/Heat"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sohukd:Thermodynamics</metadata:prefixIRI>
        <rdfs:label xml:lang="en">thermodynamics</rdfs:label>
    </owl:Class>
    


