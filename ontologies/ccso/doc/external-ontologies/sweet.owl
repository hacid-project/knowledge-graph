        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procChemical/ChemicalReaction"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procChemical/Reaction"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprocc:Solvation</metadata:prefixIRI>
        <rdfs:label xml:lang="en">solvation</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/procChemical/Sorption -->

    <owl:Class rdf:about="http://sweetontology.net/procChemical/Sorption">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://sweetontology.net/procChemical/Absorption"/>
                    <rdf:Description rdf:about="http://sweetontology.net/procChemical/Adsorption"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprocc:Sorption</metadata:prefixIRI>
        <rdfs:label xml:lang="en">sorption</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/procChemical/Thermoluminescence -->

    <owl:Class rdf:about="http://sweetontology.net/procChemical/Thermoluminescence">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procChemical/Luminescence"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprocc:Thermoluminescence</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Glows when heated</rdfs:comment>
        <rdfs:label xml:lang="en">thermoluminescence</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/procChemical/Titration -->

    <owl:Class rdf:about="http://sweetontology.net/procChemical/Titration">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procChemical/ChemicalProcess"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procChemical/ChemicalReaction"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procChemical/Reaction"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprocc:Titration</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Titration is a common laboratory method of quantitative chemical analysis that is used to determine the unknown concentration of a known reactant.</rdfs:comment>
        <rdfs:label xml:lang="en">titration</rdfs:label>
    </owl:Class>
    


