    <!-- http://sweetontology.net/humanKnowledgeDomain/PlanetaryScience -->

    <owl:Class rdf:about="http://sweetontology.net/humanKnowledgeDomain/PlanetaryScience">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/humanKnowledgeDomain/Planetology"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/humanKnowledgeDomain/Science"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sohukd:PlanetaryScience</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Planetary science, also known as planetology and closely related to planetary astronomy, is the science of planets, or planetary systems, and the solar system. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">planetary science</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/humanKnowledgeDomain/Planetology -->

    <owl:Class rdf:about="http://sweetontology.net/humanKnowledgeDomain/Planetology">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/humanKnowledgeDomain/Science"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sohukd:Planetology</metadata:prefixIRI>
        <rdfs:label xml:lang="en">planetology</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/humanKnowledgeDomain/PlateTectonics -->

    <owl:Class rdf:about="http://sweetontology.net/humanKnowledgeDomain/PlateTectonics">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/humanKnowledgeDomain/Tectonics"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasRealm"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmGeol/Lithosphere"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sohukd:PlateTectonics</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">In plate tectonic theory earth history, at its simplest, is one of plates rifting into pieces diverging apart and new ocean basins being born, followed by motion reversal, convergence back together, subduction of the oceanic crust, plate collision, and mountain building. This cycle of opening and closing ocean basins is the Wilson Cycle . [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">plate tectonics</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/humanKnowledgeDomain/Psychology -->

    <owl:Class rdf:about="http://sweetontology.net/humanKnowledgeDomain/Psychology">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/humanKnowledgeDomain/BehavioralScience"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sohukd:Psychology</metadata:prefixIRI>
        <rdfs:label xml:lang="en">psychology</rdfs:label>
    </owl:Class>
    


