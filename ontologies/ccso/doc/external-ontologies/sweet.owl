        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/Potential"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropq:ScalarPotential</metadata:prefixIRI>
        <rdfs:label xml:lang="en">scalar potential</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propQuantity/ScientificQuantity -->

    <owl:Class rdf:about="http://sweetontology.net/propQuantity/ScientificQuantity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/prop/Property"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasUnit"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropq:ScientificQuantity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">scientific quantity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propQuantity/StokesParameters -->

    <owl:Class rdf:about="http://sweetontology.net/propQuantity/StokesParameters">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/VectorQuantity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropq:StokesParameters</metadata:prefixIRI>
        <rdfs:label xml:lang="en">stokes parameters</rdfs:label>
    </owl:Class>
    


