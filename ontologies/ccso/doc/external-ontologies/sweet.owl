    </owl:Class>
    


    <!-- http://sweetontology.net/humanKnowledgeDomain/Neotectonics -->

    <owl:Class rdf:about="http://sweetontology.net/humanKnowledgeDomain/Neotectonics">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/humanKnowledgeDomain/Tectonics"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaTime/hasTimeReference"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/stateTime/NeotectonicPeriod"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sohukd:Neotectonics</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Neotectonics is a subdiscipline of tectonics. It is the study of the motions and deformations of the Earth&apos;s crust (geological and geomorphological processes) which are current or recent in geologic time.[1] The term may also refer to the motions/deformations in question themselves. The corresponding time frame is referred to as the neotectonic period.</rdfs:comment>
        <rdfs:label xml:lang="en">neotectonics</rdfs:label>
    </owl:Class>
    


