    </owl:Class>
    


    <!-- http://sweetontology.net/propMass/Malleability -->

    <owl:Class rdf:about="http://sweetontology.net/propMass/Malleability">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMass/StrengthProperty"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropm:Malleability</metadata:prefixIRI>
        <rdfs:label xml:lang="en">malleability</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propMass/Mass -->

    <owl:Class rdf:about="http://sweetontology.net/propMass/Mass">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/ExtensiveProperty"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/kilogram"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropm:Mass</metadata:prefixIRI>
        <rdfs:label xml:lang="en">mass</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propMass/MassConcentration -->

    <owl:Class rdf:about="http://sweetontology.net/propMass/MassConcentration">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/IntensiveProperty"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropm:MassConcentration</metadata:prefixIRI>
        <rdfs:label xml:lang="en">mass concentration</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propMass/MassContent -->

    <owl:Class rdf:about="http://sweetontology.net/propMass/MassContent">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMass/Content"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/hasFirstOperand"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propMass/Mass"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/kilogramPerMeterSquared"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropm:MassContent</metadata:prefixIRI>
        <rdfs:label xml:lang="en">mass content</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propMass/MaterialProperty -->

    <owl:Class rdf:about="http://sweetontology.net/propMass/MaterialProperty">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/prop/PhysicalProperty"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropm:MaterialProperty</metadata:prefixIRI>
        <rdfs:label xml:lang="en">material property</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propMass/MeanMolecularWeight -->

    <owl:Class rdf:about="http://sweetontology.net/propMass/MeanMolecularWeight">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMass/MolecularWeight"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropm:MeanMolecularWeight</metadata:prefixIRI>
        <rdfs:label xml:lang="en">mean molecular weight</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propMass/MolecularWeight -->

    <owl:Class rdf:about="http://sweetontology.net/propMass/MolecularWeight">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMass/Density"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMass/MassConcentration"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropm:MolecularWeight</metadata:prefixIRI>
        <rdfs:label xml:lang="en">molecular weight</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propMass/Moles -->

    <owl:Class rdf:about="http://sweetontology.net/propMass/Moles">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/QuantitativeProperty"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/Quantity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/mole"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropm:Moles</metadata:prefixIRI>
        <rdfs:label xml:lang="en">moles</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propMass/OpticalMass -->

    <owl:Class rdf:about="http://sweetontology.net/propMass/OpticalMass">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/RadiationMediumInteractionQuantity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/kilogram"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropm:OpticalMass</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The vertical integral of the density of absorbers between two altitudes; used mainly in determining the transmission through an absorbing gas.</rdfs:comment>
        <rdfs:label xml:lang="en">optical mass</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propMass/Plasticity -->

    <owl:Class rdf:about="http://sweetontology.net/propMass/Plasticity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMass/StrengthProperty"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropm:Plasticity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">plasticity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propMass/PotentialDensity -->

    <owl:Class rdf:about="http://sweetontology.net/propMass/PotentialDensity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMass/Density"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMass/MassConcentration"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropm:PotentialDensity</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The density of a unit of water after it is raised by an adiabatic process to the surface, i.e., determined from in-situ salinity and potential temperature (AGI, 1980). Density that would be reached by a compressible fluid if it were adiabatically compressed or expanded to a standard pressure.</rdfs:comment>
        <rdfs:label xml:lang="en">potential density</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propMass/Roughness -->

    <owl:Class rdf:about="http://sweetontology.net/propMass/Roughness">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMass/MaterialProperty"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropm:Roughness</metadata:prefixIRI>
        <rdfs:label xml:lang="en">roughness</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propMass/SigmaT -->

    <owl:Class rdf:about="http://sweetontology.net/propMass/SigmaT">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMass/Density"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMass/MassConcentration"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropm:SigmaT</metadata:prefixIRI>
        <rdfs:label xml:lang="en">sigma t</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propMass/Softness -->

    <owl:Class rdf:about="http://sweetontology.net/propMass/Softness">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMass/StrengthProperty"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropm:Softness</metadata:prefixIRI>
        <rdfs:label xml:lang="en">softness</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propMass/SolidProperty -->

    <owl:Class rdf:about="http://sweetontology.net/propMass/SolidProperty">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMass/MaterialProperty"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropm:SolidProperty</metadata:prefixIRI>
        <rdfs:label xml:lang="en">solid property</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propMass/Solidity -->

    <owl:Class rdf:about="http://sweetontology.net/propMass/Solidity">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/propMass/Solidness"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMass/StrengthProperty"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropm:Solidity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">solidity</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propMass/Solidness -->

    <owl:Class rdf:about="http://sweetontology.net/propMass/Solidness">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMass/StrengthProperty"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropm:Solidness</metadata:prefixIRI>
        <rdfs:label xml:lang="en">solidness</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propMass/SpecificVolume -->

    <owl:Class rdf:about="http://sweetontology.net/propMass/SpecificVolume">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/IntensiveProperty"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/meterCubedPerKilogram"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropm:SpecificVolume</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">1. The ratio of the mass of any substance to the volume occupied by it (usually expressed in kilograms per cubic meter, but any other unit system may be used); the reciprocal of specific volume.</rdfs:comment>
        <rdfs:label xml:lang="en">specific volume</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propMass/StrengthProperty -->

    <owl:Class rdf:about="http://sweetontology.net/propMass/StrengthProperty">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propMass/SolidProperty"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropm:StrengthProperty</metadata:prefixIRI>
        <rdfs:label xml:lang="en">strength property</rdfs:label>
    </owl:Class>
    


