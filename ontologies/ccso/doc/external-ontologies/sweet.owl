        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTime/DurationDescription"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTime/TimeInterval"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaTime/hasEndTime"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/reprTime/Time"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaTime/hasStartTime"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propTime/Time"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropti:TimePeriod</metadata:prefixIRI>
        <rdfs:label xml:lang="en">time period</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTime/TimeRange -->

    <owl:Class rdf:about="http://sweetontology.net/propTime/TimeRange">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/IntervalQuantity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropti:TimeRange</metadata:prefixIRI>
        <rdfs:label xml:lang="en">time range</rdfs:label>
    </owl:Class>
    


