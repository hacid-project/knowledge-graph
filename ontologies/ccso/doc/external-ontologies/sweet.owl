        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/IntervalQuantity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/rangeOf"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propTime/Time"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropti:TemporalRange</metadata:prefixIRI>
        <rdfs:label xml:lang="en">temporal range</rdfs:label>
    </owl:Class>
    


