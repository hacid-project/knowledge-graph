    <owl:Class rdf:about="http://sweetontology.net/reprMath/OrderedPair">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/repr/D"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprMath/Array"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/hasFirstOperand"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/hasSecondOperand"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorepm:OrderedPair</metadata:prefixIRI>
        <rdfs:label xml:lang="en">ordered pair</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/reprMath/OrderedTriple -->

    <owl:Class rdf:about="http://sweetontology.net/reprMath/OrderedTriple">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/repr/D"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprMath/Array"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/hasFirstOperand"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/hasSecondOperand"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/hasThirdOperand"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorepm:OrderedTriple</metadata:prefixIRI>
        <rdfs:label xml:lang="en">ordered triple</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/reprMath/Point -->

    <owl:Class rdf:about="http://sweetontology.net/reprMath/Point">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprMath/NumericalEntity"/>
