        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprocc:Phosphorescence</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Continues to glow after light source is removed</rdfs:comment>
        <rdfs:label xml:lang="en">phosphorescence</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/procChemical/Photodecomposition -->

    <owl:Class rdf:about="http://sweetontology.net/procChemical/Photodecomposition">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/procChemical/Photolysis"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procChemical/ChemicalProcess"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procChemical/ChemicalReaction"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procChemical/Reaction"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprocc:Photodecomposition</metadata:prefixIRI>
        <rdfs:label xml:lang="en">photodecomposition</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/procChemical/Photodissociation -->

    <owl:Class rdf:about="http://sweetontology.net/procChemical/Photodissociation">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/procChemical/Photolysis"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procChemical/ChemicalProcess"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procChemical/ChemicalReaction"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procChemical/Reaction"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprocc:Photodissociation</metadata:prefixIRI>
        <rdfs:label xml:lang="en">photodissociation</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/procChemical/Photolysis -->

    <owl:Class rdf:about="http://sweetontology.net/procChemical/Photolysis">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procChemical/ChemicalProcess"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procChemical/ChemicalReaction"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procChemical/Reaction"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasProcess"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/procChemical/Absorption"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprocc:Photolysis</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Photodissociation, photolysis, or photodecomposition is a chemical reaction in which a chemical compound is broken down by photons. It is defined as the interaction of one or more photons with one target molecule. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">photolysis</rdfs:label>
    </owl:Class>
    


