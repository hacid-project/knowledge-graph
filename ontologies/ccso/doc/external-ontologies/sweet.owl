    <owl:Class rdf:about="http://sweetontology.net/propQuantity/ThermodynamicQuantity">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/prop/ThermodynamicProperty"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/QuantitativeProperty"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/Quantity"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sopropq:ThermodynamicQuantity</metadata:prefixIRI>
        <rdfs:label xml:lang="en">thermodynamic quantity</rdfs:label>
    </owl:Class>
    


