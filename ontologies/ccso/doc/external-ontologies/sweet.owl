    <owl:Class rdf:about="http://sweetontology.net/procStateChange/Photoionization">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procStateChange/Ionization"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprocsc:Photoionization</metadata:prefixIRI>
        <rdfs:label xml:lang="en">photoionization</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/procStateChange/Refreezing -->

    <owl:Class rdf:about="http://sweetontology.net/procStateChange/Refreezing">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procStateChange/Freezing"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprocsc:Refreezing</metadata:prefixIRI>
        <rdfs:label xml:lang="en">refreezing</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/procStateChange/StateChange -->

    <owl:Class rdf:about="http://sweetontology.net/procStateChange/StateChange">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procPhysical/PhysicalProcess"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/from"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/statePhysical/StateOfMatter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/to"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/statePhysical/StateOfMatter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprocsc:StateChange</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">change of state by state variable change</rdfs:comment>
        <rdfs:label xml:lang="en">state change</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/procStateChange/Sublimation -->

    <owl:Class rdf:about="http://sweetontology.net/procStateChange/Sublimation">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procStateChange/PhaseTransition"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procStateChange/StateChange"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/from"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/Solid"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/to"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/Gas"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprocsc:Sublimation</metadata:prefixIRI>
        <rdfs:label xml:lang="en">sublimation</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/procStateChange/Thawing -->

    <owl:Class rdf:about="http://sweetontology.net/procStateChange/Thawing">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procStateChange/Melting"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprocsc:Thawing</metadata:prefixIRI>
        <rdfs:label xml:lang="en">thawing</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/procStateChange/Vaporization -->

    <owl:Class rdf:about="http://sweetontology.net/procStateChange/Vaporization">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procStateChange/PhaseTransition"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procStateChange/StateChange"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/from"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/Liquid"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/to"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/Gas"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprocsc:Vaporization</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The physical process by which a liquid is transformed to the gaseous state; the opposite of condensation.</rdfs:comment>
        <rdfs:label xml:lang="en">vaporization</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/procWave/Absorption -->

    <owl:Class rdf:about="http://sweetontology.net/procWave/Absorption">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procWave/MediumWaveInteractionProcess"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprocw:Absorption</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The process in which incident radiant energy is retained by a substance.</rdfs:comment>
        <rdfs:label xml:lang="en">absorption</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/procWave/AcousticBackScattering -->

    <owl:Class rdf:about="http://sweetontology.net/procWave/AcousticBackScattering">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procWave/Backscattering"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprocw:AcousticBackScattering</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">Scattering of sound or ultrasound in the direction of the source.</rdfs:comment>
        <rdfs:label xml:lang="en">acoustic back scattering</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/procWave/Attenuation -->

    <owl:Class rdf:about="http://sweetontology.net/procWave/Attenuation">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/procWave/Extinction"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procWave/MediumWaveInteractionProcess"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprocw:Attenuation</metadata:prefixIRI>
        <rdfs:label xml:lang="en">attenuation</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/procWave/Backscattering -->

    <owl:Class rdf:about="http://sweetontology.net/procWave/Backscattering">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procWave/Scattering"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprocw:Backscattering</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">scattering of waves (photons) that reverse the direction of propagation</rdfs:comment>
        <rdfs:label xml:lang="en">backscattering</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/procWave/BraggDiffraction -->

    <owl:Class rdf:about="http://sweetontology.net/procWave/BraggDiffraction">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procWave/Diffraction"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprocw:BraggDiffraction</metadata:prefixIRI>
        <rdfs:label xml:lang="en">bragg diffraction</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/procWave/Damping -->

    <owl:Class rdf:about="http://sweetontology.net/procWave/Damping">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procWave/WaveProcess"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprocw:Damping</metadata:prefixIRI>
        <rdfs:label xml:lang="en">damping</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/procWave/Diffraction -->

    <owl:Class rdf:about="http://sweetontology.net/procWave/Diffraction">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procWave/MediumWaveInteractionProcess"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprocw:Diffraction</metadata:prefixIRI>
        <rdfs:label xml:lang="en">diffraction</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/procWave/Dispersion -->

    <owl:Class rdf:about="http://sweetontology.net/procWave/Dispersion">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procWave/MediumWaveInteractionProcess"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprocw:Dispersion</metadata:prefixIRI>
        <rdfs:label xml:lang="en">dispersion</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/procWave/Dissipation -->

    <owl:Class rdf:about="http://sweetontology.net/procWave/Dissipation">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procWave/MediumWaveInteractionProcess"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprocw:Dissipation</metadata:prefixIRI>
        <rdfs:label xml:lang="en">dissipation</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/procWave/Echo -->

    <owl:Class rdf:about="http://sweetontology.net/procWave/Echo">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procWave/Reflection"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprocw:Echo</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">In radar, a general term for the appearance, on a radar display, of the radio signal scattered or reflected from a target. The characteristics of a radar echo are determined by 1) the waveform, frequency, and power of the incident wave; 2) the range and velocity of the target with respect to the radar; and 3) the size, shape, and composition of the target.</rdfs:comment>
        <rdfs:label xml:lang="en">echo</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/procWave/ElectromagneticRadiation -->

    <owl:Class rdf:about="http://sweetontology.net/procWave/ElectromagneticRadiation">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/procWave/ElectromagneticWave"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phenWave/Wave"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/procPhysical/PhysicalProcess"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soprocw:ElectromagneticRadiation</metadata:prefixIRI>
