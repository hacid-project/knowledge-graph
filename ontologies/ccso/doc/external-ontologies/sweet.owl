        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprMathOperation/VectorFieldOperation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/hasInput"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/reprMathFunction/ScalarField"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/hasOutput"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/reprMathFunction/VectorField"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soproptf:Divergence</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The expansion or spreading out of a vector field; also, a precise measure thereof.</rdfs:comment>
        <rdfs:label xml:lang="en">divergence</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTimeFrequency/Fertility -->

    <owl:Class rdf:about="http://sweetontology.net/propTimeFrequency/Fertility">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTimeFrequency/Rate"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTimeFrequency/Tendency"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soproptf:Fertility</metadata:prefixIRI>
        <rdfs:label xml:lang="en">fertility</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTimeFrequency/Frequency -->

    <owl:Class rdf:about="http://sweetontology.net/propTimeFrequency/Frequency">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/PhysicalQuantity"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTimeFrequency/Rate"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTimeFrequency/Tendency"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/hertz"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soproptf:Frequency</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The rate of recurrence of any periodic phenomenon, often associated with waves of all kinds. Without qualification frequency often means temporal frequency, the rate of recurrence of a time-varying function, but could mean spatial frequency, the rate of recurrence of a space-varying function. Spatial frequency is the reciprocal of the repeat distance (sometimes the wavelength). The dimensions of (temporal) frequency are inverse time. A common unit for frequency is cycle per second, formerly abbreviated cps, but superseded by hertz, abbreviated as Hz.</rdfs:comment>
        <rdfs:label xml:lang="en">frequency</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTimeFrequency/FrequencyBand -->

    <owl:Class rdf:about="http://sweetontology.net/propTimeFrequency/FrequencyBand">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propQuantity/IntervalQuantity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/rangeOf"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/propTimeFrequency/Frequency"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soproptf:FrequencyBand</metadata:prefixIRI>
        <rdfs:label xml:lang="en">frequency band</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTimeFrequency/FrequencyBand_MHz -->

    <owl:Class rdf:about="http://sweetontology.net/propTimeFrequency/FrequencyBand_MHz">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTimeFrequency/FrequencyBand"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/MHz"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soproptf:FrequencyBand_MHz</metadata:prefixIRI>
        <rdfs:label xml:lang="en">frequency band mhz</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTimeFrequency/Incidence -->

    <owl:Class rdf:about="http://sweetontology.net/propTimeFrequency/Incidence">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTimeFrequency/Frequency"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soproptf:Incidence</metadata:prefixIRI>
        <rdfs:label xml:lang="en">incidence</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTimeFrequency/Rate -->

    <owl:Class rdf:about="http://sweetontology.net/propTimeFrequency/Rate">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/propTimeFrequency/Tendency"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprMathOperation/PartialDerivative"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaMath/derivativeWithRespectTo"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/reprTime/Time"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSci/hasDefaultUnit"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/reprSciUnits/perSecond"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soproptf:Rate</metadata:prefixIRI>
        <rdfs:label xml:lang="en">rate</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTimeFrequency/SpreadingRate -->

    <owl:Class rdf:about="http://sweetontology.net/propTimeFrequency/SpreadingRate">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTimeFrequency/Rate"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/propTimeFrequency/Tendency"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soproptf:SpreadingRate</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The spreading rate is a measure of how fast plate divergence is occurring. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">spreading rate</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/propTimeFrequency/Tendency -->

    <owl:Class rdf:about="http://sweetontology.net/propTimeFrequency/Tendency">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprMathOperation/PartialDerivative"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soproptf:Tendency</metadata:prefixIRI>
        <rdfs:label xml:lang="en">tendency</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realm/Atmosphere -->

    <owl:Class rdf:about="http://sweetontology.net/realm/Atmosphere">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetaryRealm"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/hasLowerBoundary"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realm/PlanetarySurface"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasState"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/Gas"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorea:Atmosphere</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">An atmosphere is a layer of gases that may surround a material body of sufficient mass,[1] by the gravity of the body, and are retained for a longer duration if gravity is high and the atmosphere&apos;s temperature is low. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">atmosphere</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realm/CriticalZone -->

    <owl:Class rdf:about="http://sweetontology.net/realm/CriticalZone">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetaryRealm"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorea:CriticalZone</metadata:prefixIRI>
        <rdfs:label xml:lang="en">critical zone</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realm/Cryosphere -->

    <owl:Class rdf:about="http://sweetontology.net/realm/Cryosphere">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/Hydrosphere"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaChemical/hasSubstance"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/matrWater/Ice"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/hasUpperBoundary"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realm/PlanetarySurface"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorea:Cryosphere</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The cryosphere collectively describes the portions of a planetary surface in frozen form, including sea ice, lake ice, river ice, snow cover, glaciers, ice caps and ice sheets, and frozen ground (which includes permafrost).  [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">cryosphere</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realm/Geosphere -->

    <owl:Class rdf:about="http://sweetontology.net/realm/Geosphere">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realmGeol/SolidEarth"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetaryRealm"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/hasUpperBoundary"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realm/PlanetarySurface"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasState"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/Solid"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorea:Geosphere</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The term Geosphere is often used to refer to the densest (solid) parts of a planet, which consist mostly of rock and regolith [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">geosphere</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realm/GlobalPlanetaryLayer -->

    <owl:Class rdf:about="http://sweetontology.net/realm/GlobalPlanetaryLayer">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realm/PlanetaryLayer"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprSpaceGeometry3D/Layer"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorea:GlobalPlanetaryLayer</metadata:prefixIRI>
        <rdfs:label xml:lang="en">global planetary layer</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realm/Hydrosphere -->

    <owl:Class rdf:about="http://sweetontology.net/realm/Hydrosphere">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetaryRealm"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaChemical/hasSubstance"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/matrCompound/Water"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorea:Hydrosphere</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A hydrosphere in physical geography describes the combined mass of water found on, under, and over the surface of a planet. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">hydrosphere</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realm/Land -->

    <owl:Class rdf:about="http://sweetontology.net/realm/Land">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/Geosphere"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmGeol/SolidEarth"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasState"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/Solid"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorea:Land</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The part of a planetary surface that is a solid</rdfs:comment>
        <rdfs:label xml:lang="en">land</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realm/Ocean -->

    <owl:Class rdf:about="http://sweetontology.net/realm/Ocean">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/Hydrosphere"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaSpace/hasUpperBoundary"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realm/PlanetarySurface"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasState"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/Liquid"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorea:Ocean</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">An ocean is a major body of saline water, and a principal component of the hydrosphere. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">ocean</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realm/PlanetaryBoundary -->

    <owl:Class rdf:about="http://sweetontology.net/realm/PlanetaryBoundary">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realm/PlanetarySurfaceLevel"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/CriticalZone"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprSpaceGeometry/Surface"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorea:PlanetaryBoundary</metadata:prefixIRI>
        <rdfs:label xml:lang="en">planetary boundary</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realm/PlanetaryLayer -->

    <owl:Class rdf:about="http://sweetontology.net/realm/PlanetaryLayer">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprSpaceGeometry3D/Layer"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorea:PlanetaryLayer</metadata:prefixIRI>
        <rdfs:label xml:lang="en">planetary layer</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realm/PlanetaryRealm -->

    <owl:Class rdf:about="http://sweetontology.net/realm/PlanetaryRealm">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/Realm"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorea:PlanetaryRealm</metadata:prefixIRI>
        <rdfs:label xml:lang="en">planetary realm</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realm/PlanetaryStructure -->

    <owl:Class rdf:about="http://sweetontology.net/realm/PlanetaryStructure">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetaryRealm"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorea:PlanetaryStructure</metadata:prefixIRI>
        <rdfs:label xml:lang="en">planetary structure</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realm/PlanetarySurface -->

    <owl:Class rdf:about="http://sweetontology.net/realm/PlanetarySurface">
        <owl:equivalentClass rdf:resource="http://sweetontology.net/realm/Subaerial"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetaryBoundary"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetarySurfaceLevel"/>
        <owl:disjointWith rdf:resource="http://sweetontology.net/realmGeol/Subsurface"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorea:PlanetarySurface</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">The surface of the planet defined by solid and/or liquid layers</rdfs:comment>
        <rdfs:label xml:lang="en">planetary surface</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realm/PlanetarySurfaceLevel -->

    <owl:Class rdf:about="http://sweetontology.net/realm/PlanetarySurfaceLevel">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/CriticalZone"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprSpaceGeometry/Surface"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorea:PlanetarySurfaceLevel</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A qusai-horizontal surface spanning all or part of a planet that corresponds to a constant value of some parameter</rdfs:comment>
        <rdfs:label xml:lang="en">planetary surface level</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realm/Realm -->

    <owl:Class rdf:about="http://sweetontology.net/realm/Realm">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorea:Realm</metadata:prefixIRI>
        <rdfs:label xml:lang="en">realm</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realm/Ring -->

    <owl:Class rdf:about="http://sweetontology.net/realm/Ring">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetaryRealm"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/rela/hasState"/>
                <owl:hasValue rdf:resource="http://sweetontology.net/statePhysical/Solid"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorea:Ring</metadata:prefixIRI>
        <rdfs:label xml:lang="en">ring</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realm/Subaerial -->

    <owl:Class rdf:about="http://sweetontology.net/realm/Subaerial">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetaryBoundary"/>
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/PlanetarySurfaceLevel"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorea:Subaerial</metadata:prefixIRI>
        <rdfs:label xml:lang="en">subaerial</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAstroBody/Asteroid -->

    <owl:Class rdf:about="http://sweetontology.net/realmAstroBody/Asteroid">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAstroBody/AstronomicalBody"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaab:Asteroid</metadata:prefixIRI>
        <rdfs:label xml:lang="en">asteroid</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAstroBody/AstronomicalBody -->

    <owl:Class rdf:about="http://sweetontology.net/realmAstroBody/AstronomicalBody">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/reprSpaceGeometry3D/Body"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaab:AstronomicalBody</metadata:prefixIRI>
        <rdfs:label xml:lang="en">astronomical body</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAstroBody/Comet -->

    <owl:Class rdf:about="http://sweetontology.net/realmAstroBody/Comet">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAstroBody/AstronomicalBody"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaab:Comet</metadata:prefixIRI>
        <rdfs:label xml:lang="en">comet</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAstroBody/Extraterrestrial -->

    <owl:Class rdf:about="http://sweetontology.net/realmAstroBody/Extraterrestrial">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAstroBody/AstronomicalBody"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaab:Extraterrestrial</metadata:prefixIRI>
        <rdfs:comment xml:lang="en">A body or substance which does not originate from Earth. [Wikipedia]</rdfs:comment>
        <rdfs:label xml:lang="en">extraterrestrial</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAstroBody/Galaxy -->

    <owl:Class rdf:about="http://sweetontology.net/realmAstroBody/Galaxy">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAstroBody/AstronomicalBody"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaab:Galaxy</metadata:prefixIRI>
        <rdfs:label xml:lang="en">galaxy</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAstroBody/Moon -->

    <owl:Class rdf:about="http://sweetontology.net/realmAstroBody/Moon">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAstroBody/AstronomicalBody"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/revolvesAround"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmAstroBody/Planet"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaab:Moon</metadata:prefixIRI>
        <rdfs:label xml:lang="en">moon</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAstroBody/OuterSpace -->

    <owl:Class rdf:about="http://sweetontology.net/realmAstroBody/OuterSpace">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realm/Realm"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaab:OuterSpace</metadata:prefixIRI>
        <rdfs:label xml:lang="en">outer space</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAstroBody/Planet -->

    <owl:Class rdf:about="http://sweetontology.net/realmAstroBody/Planet">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAstroBody/AstronomicalBody"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://sweetontology.net/relaPhysical/revolvesAround"/>
                <owl:allValuesFrom rdf:resource="http://sweetontology.net/realmAstroBody/Star"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaab:Planet</metadata:prefixIRI>
        <rdfs:label xml:lang="en">planet</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAstroBody/Satellite -->

    <owl:Class rdf:about="http://sweetontology.net/realmAstroBody/Satellite">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAstroBody/AstronomicalBody"/>
        <metadata:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soreaab:Satellite</metadata:prefixIRI>
        <rdfs:label xml:lang="en">satellite</rdfs:label>
    </owl:Class>
    


    <!-- http://sweetontology.net/realmAstroBody/Star -->

    <owl:Class rdf:about="http://sweetontology.net/realmAstroBody/Star">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/realmAstroBody/AstronomicalBody"/>
